#!/bin/sh
set -eu

# Repository convenience entry point.  Production services must execute the
# root-owned path sealed by launcher-profile-v2.json, not this mutable wrapper.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)

exec /usr/bin/python3 -B -I "$repository_root/pipeline/gpu/trusted_launcher_v2.py" "$@"
