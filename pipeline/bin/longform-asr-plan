#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
if [ -n "${PYTHONPATH:-}" ]; then
  export PYTHONPATH="$REPOSITORY_ROOT/corpus/src:$PYTHONPATH"
else
  export PYTHONPATH="$REPOSITORY_ROOT/corpus/src"
fi
exec python3 -m himr_corpus.longform_asr_planner_cli "$@"
