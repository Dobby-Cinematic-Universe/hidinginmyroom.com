#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
builder="$repository_root/pipeline/gpu/build_execution_image.py"
python=/usr/bin/python3.14

if [ ! -x "$python" ]; then
  echo "exact system Python is unavailable or not executable: $python" >&2
  exit 127
fi

export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1

exec "$python" -B -I "$builder" "$@"
