#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
runtime_python="$repository_root/research/corpus/gpu-runtime/env/bin/python"
admission="$repository_root/pipeline/gpu/admit_runtime.py"

if [ ! -x "$runtime_python" ]; then
  echo "managed GPU Python is unavailable: $runtime_python" >&2
  exit 127
fi

exec "$runtime_python" -B -I "$admission" "$@"
