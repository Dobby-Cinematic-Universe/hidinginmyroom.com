{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate guided CPU/CUDA speaker-screen request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "work_orders",
    "guidance",
    "state_root",
    "execution",
    "max_target_windows"
  ],
  "properties": {
    "kind": {
      "const": "himr_guided_speaker_screen_request"
    },
    "schema_version": {
      "const": 1
    },
    "work_orders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/fileBinding"
      }
    },
    "guidance": {
      "$ref": "#/$defs/fileBinding"
    },
    "state_root": {
      "type": "string",
      "pattern": "^/[^\\u0000-\\u001f]+$",
      "maxLength": 4096
    },
    "max_target_windows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": {
          "enum": [
            "cpu",
            "cuda"
          ]
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "decode_prefetch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "max_run_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400
        },
        "cuda_memory_fraction": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.75
        },
        "gpu_uuid": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^GPU-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_memory_max_bytes": {
          "const": 4294967296
        }
      }
    }
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f]+$",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
