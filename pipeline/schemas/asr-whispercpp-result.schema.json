{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/asr-whispercpp-result-v1.json",
  "title": "HIMR whisper.cpp ASR result envelope",
  "oneOf": [
    { "$ref": "#/$defs/plannedResult" },
    { "$ref": "#/$defs/completedResult" },
    { "$ref": "#/$defs/failureResult" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "zonedTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode", "byte_count", "mtime_ns"],
      "properties": {
        "device": { "type": "integer" },
        "inode": { "type": "integer", "minimum": 0 },
        "byte_count": { "type": "integer", "minimum": 0 },
        "mtime_ns": { "type": "integer" }
      }
    },
    "observationFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 0 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stat" }]
        },
        "unchanged": { "type": ["boolean", "null"] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ffprobe_path",
        "codec_name",
        "sample_format",
        "sample_rate_hz",
        "channels",
        "channel_layout",
        "format_name",
        "duration_ms"
      ],
      "properties": {
        "ffprobe_path": { "type": "string", "pattern": "^/" },
        "codec_name": { "const": "flac" },
        "sample_format": { "const": "s16" },
        "sample_rate_hz": { "const": 16000 },
        "channels": { "const": 1 },
        "channel_layout": { "type": ["string", "null"] },
        "format_name": { "type": ["string", "null"] },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      }
    },
    "inputObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged",
        "media_id",
        "artifact_id",
        "parent_processing_run_id",
        "probe"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stat" }]
        },
        "unchanged": { "type": ["boolean", "null"] },
        "media_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "parent_processing_run_id": { "$ref": "#/$defs/identifier" },
        "probe": { "$ref": "#/$defs/probe" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "target", "configuration"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "configuration": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "engineObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged",
        "version",
        "version_evidence",
        "build"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stat" }]
        },
        "unchanged": { "type": ["boolean", "null"] },
        "version": { "type": "string", "minLength": 1 },
        "version_evidence": {
          "const": "source_revision_plus_executable_sha256"
        },
        "build": { "$ref": "#/$defs/build" }
      }
    },
    "modelObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged",
        "model_id",
        "name",
        "revision",
        "source",
        "license_label"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stat" }]
        },
        "unchanged": { "type": ["boolean", "null"] },
        "model_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "license_label": { "type": "string", "minLength": 1 }
      }
    },
    "glossaryObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged",
        "glossary_revision_id",
        "revision",
        "language",
        "prompt_sha256",
        "term_count"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stat" }]
        },
        "unchanged": { "type": ["boolean", "null"] },
        "glossary_revision_id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "term_count": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "catalogContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recording_id", "rendition_id"],
      "properties": {
        "recording_id": { "$ref": "#/$defs/identifier" },
        "rendition_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }]
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_ms", "duration_ms", "end_ms"],
      "properties": {
        "offset_ms": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "end_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "processingRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_run_id",
        "stage",
        "implementation_version",
        "model_id",
        "glossary_revision_id",
        "parameters_json",
        "environment_json",
        "random_seed",
        "started_at",
        "completed_at",
        "status",
        "error_text"
      ],
      "properties": {
        "processing_run_id": {
          "type": "string",
          "pattern": "^run_asr_whispercpp_[0-9a-f]{32}$"
        },
        "stage": { "const": "asr_whispercpp" },
        "implementation_version": { "type": "string", "minLength": 1 },
        "model_id": { "$ref": "#/$defs/identifier" },
        "glossary_revision_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }]
        },
        "parameters_json": { "type": "string", "minLength": 2 },
        "environment_json": { "type": "string", "minLength": 2 },
        "random_seed": { "type": ["integer", "null"] },
        "started_at": { "$ref": "#/$defs/zonedTime" },
        "completed_at": { "$ref": "#/$defs/zonedTime" },
        "status": { "enum": ["queued", "completed"] },
        "error_text": { "type": "null" }
      }
    },
    "runInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_input_id",
        "processing_run_id",
        "object_type",
        "object_id",
        "input_role",
        "input_sha256"
      ],
      "properties": {
        "run_input_id": { "$ref": "#/$defs/identifier" },
        "processing_run_id": {
          "type": "string",
          "pattern": "^run_asr_whispercpp_[0-9a-f]{32}$"
        },
        "object_type": { "const": "media" },
        "object_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "input_role": { "const": "normalized_audio" },
        "input_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "processing_run_id",
        "artifact_kind",
        "storage_uri",
        "sha256",
        "byte_count",
        "schema_version",
        "visibility",
        "metadata_json"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "processing_run_id": {
          "type": "string",
          "pattern": "^run_asr_whispercpp_[0-9a-f]{32}$"
        },
        "artifact_kind": {
          "enum": [
            "whispercpp_output_json_full",
            "transcript_normalized_json"
          ]
        },
        "storage_uri": { "type": "string", "pattern": "^file://" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "schema_version": { "const": 1 },
        "visibility": { "const": "private" },
        "metadata_json": { "type": "string", "minLength": 2 }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "detected"],
      "properties": {
        "requested": { "type": "string", "minLength": 2 },
        "detected": { "type": "string", "minLength": 2 }
      }
    },
    "token": {
      "oneOf": [
        { "$ref": "#/$defs/tokenV022" },
        { "$ref": "#/$defs/tokenV023" }
      ]
    },
    "tokenV022": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "start_ms",
        "end_ms",
        "text",
        "token_id",
        "raw_probability",
        "raw_dtw_timestamp",
        "metadata_json"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "start_ms": { "type": ["integer", "null"], "minimum": 0 },
        "end_ms": { "type": ["integer", "null"], "minimum": 0 },
        "text": { "type": "string" },
        "token_id": { "type": "integer" },
        "raw_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "raw_dtw_timestamp": { "type": "number" },
        "metadata_json": { "type": "string", "minLength": 2 }
      }
    },
    "tokenV023": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "start_ms",
        "end_ms",
        "text",
        "token_id",
        "raw_probability",
        "raw_dtw_timestamp",
        "timing_state",
        "timing_quality_flags",
        "original_offsets",
        "metadata_json"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "start_ms": { "type": "null" },
        "end_ms": { "type": "null" },
        "text": { "type": "string" },
        "token_id": { "type": "integer" },
        "raw_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "raw_dtw_timestamp": { "type": "number" },
        "timing_state": { "const": "unavailable" },
        "timing_quality_flags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "const": "invalid_upstream_inverted" }
        },
        "original_offsets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "integer", "minimum": 0, "maximum": 86400000 },
            "to": { "type": "integer", "minimum": 0, "maximum": 86400000 }
            }
        },
        "metadata_json": { "type": "string", "minLength": 2 }
      }
    },
    "normalizedSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "start_ms",
        "end_ms",
        "text",
        "tokens",
        "quality_flags",
        "window_overrun_ms",
        "metadata_json"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" },
        "tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/token" }
        },
        "quality_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["end_after_requested_window", "token_timing_unavailable"]
          }
        },
        "window_overrun_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "metadata_json": { "type": "string", "minLength": 2 }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "language",
        "window",
        "segment_count",
        "token_count",
        "quality_flags",
        "segments",
        "engine_metadata_json"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "language": { "$ref": "#/$defs/language" },
        "window": { "$ref": "#/$defs/window" },
        "segment_count": { "type": "integer", "minimum": 0 },
        "token_count": { "type": "integer", "minimum": 0 },
        "quality_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "segment_end_after_requested_window",
              "token_timing_unavailable"
            ]
          }
        },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/normalizedSegment" }
        },
        "engine_metadata_json": { "type": "string", "minLength": 2 }
      }
    },
    "transcriptRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "recording_id",
        "rendition_id",
        "processing_run_id",
        "revision_kind",
        "origin",
        "language",
        "glossary_revision_id",
        "review_state",
        "created_at",
        "metadata_json"
      ],
      "properties": {
        "revision_id": { "$ref": "#/$defs/identifier" },
        "recording_id": { "$ref": "#/$defs/identifier" },
        "rendition_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }]
        },
        "processing_run_id": {
          "type": "string",
          "pattern": "^run_asr_whispercpp_[0-9a-f]{32}$"
        },
        "revision_kind": { "enum": ["raw_asr", "contextual_asr"] },
        "origin": { "const": "whisper.cpp output-json-full" },
        "language": { "type": "string", "minLength": 2 },
        "glossary_revision_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }]
        },
        "review_state": { "const": "machine" },
        "created_at": { "$ref": "#/$defs/zonedTime" },
        "metadata_json": { "type": "string", "minLength": 2 }
      }
    },
    "transcriptSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "revision_id",
        "ordinal",
        "start_ms",
        "end_ms",
        "text",
        "normalized_text",
        "speaker_label",
        "language",
        "confidence_band",
        "calibrated_probability",
        "metadata_json"
      ],
      "properties": {
        "segment_id": { "$ref": "#/$defs/identifier" },
        "revision_id": { "$ref": "#/$defs/identifier" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" },
        "normalized_text": { "type": "null" },
        "speaker_label": { "type": "null" },
        "language": { "type": "string", "minLength": 2 },
        "confidence_band": { "type": "null" },
        "calibrated_probability": { "type": "null" },
        "metadata_json": { "type": "string", "minLength": 2 }
      }
    },
    "transcriptWord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word_id",
        "segment_id",
        "ordinal",
        "start_ms",
        "end_ms",
        "token",
        "normalized_token",
        "asr_log_probability",
        "alignment_score",
        "calibrated_probability"
      ],
      "properties": {
        "word_id": { "$ref": "#/$defs/identifier" },
        "segment_id": { "$ref": "#/$defs/identifier" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "start_ms": { "type": ["integer", "null"], "minimum": 0 },
        "end_ms": { "type": ["integer", "null"], "minimum": 0 },
        "token": { "type": "string" },
        "normalized_token": { "type": "null" },
        "asr_log_probability": { "type": ["number", "null"], "maximum": 0 },
        "alignment_score": { "type": "null" },
        "calibrated_probability": { "type": "null" }
      }
    },
    "catalogRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processing_runs", "run_inputs", "artifacts"],
      "properties": {
        "processing_runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/processingRun" }
        },
        "run_inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/runInput" }
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "transcript_revisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/transcriptRevision" }
        },
        "transcript_segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/transcriptSegment" }
        },
        "transcript_words": {
          "type": "array",
          "items": { "$ref": "#/$defs/transcriptWord" }
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    },
    "quarantine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_key",
        "receipt_kind",
        "receipt_path",
        "receipt_sha256",
        "invalid_utf8",
        "raw_artifact"
      ],
      "properties": {
        "failure_key": { "$ref": "#/$defs/sha256" },
        "receipt_kind": { "const": "whispercpp_output_json_full_invalid_utf8" },
        "receipt_path": { "type": "string", "pattern": "^/" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "invalid_utf8": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decoder", "start_byte", "end_byte", "reason"],
          "properties": {
            "decoder": { "const": "utf-8-strict" },
            "start_byte": { "type": "integer", "minimum": 0 },
            "end_byte": { "type": "integer", "minimum": 1 },
            "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "raw_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_kind",
            "path",
            "storage_uri",
            "byte_count",
            "sha256",
            "visibility"
          ],
          "properties": {
            "artifact_kind": { "const": "whispercpp_output_json_full_quarantine" },
            "path": { "type": "string", "pattern": "^/" },
            "storage_uri": { "type": "string", "pattern": "^file:///" },
            "byte_count": { "type": "integer", "minimum": 1, "maximum": 536870912 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "visibility": { "const": "private" }
          }
        }
      }
    },
    "plannedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "job_id",
        "status",
        "dry_run",
        "work_order_sha256",
        "recipe_id",
        "recipe_sha256",
        "result_key",
        "processing_run",
        "input",
        "engine",
        "model",
        "glossary",
        "catalog_context",
        "window",
        "commands",
        "artifacts",
        "transcript",
        "catalog_records",
        "result_path",
        "duration_ms",
        "errors"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "job_id": { "$ref": "#/$defs/identifier" },
        "status": { "const": "planned" },
        "dry_run": { "const": true },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "recipe_id": {
          "type": "string",
          "pattern": "^recipe_asr_whispercpp_[0-9a-f]{32}$"
        },
        "recipe_sha256": { "$ref": "#/$defs/sha256" },
        "result_key": { "$ref": "#/$defs/sha256" },
        "processing_run": { "$ref": "#/$defs/processingRun" },
