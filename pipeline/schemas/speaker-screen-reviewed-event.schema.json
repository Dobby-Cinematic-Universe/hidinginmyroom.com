{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit reviewed event used only for screening priority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "event_id",
    "date",
    "radius_days",
    "reviewed",
    "reviewer",
    "evidence"
  ],
  "properties": {
    "kind": {
      "const": "himr_speaker_screen_reviewed_event"
    },
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "radius_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 14
    },
    "reviewed": {
      "const": true
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "evidence": {
      "$ref": "#/$defs/fileBinding"
    }
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f]+$",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
