{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/contextual-asr-result-seal-receipt-v1.json",
  "title": "Manifest-bound contextual-ASR completed-result seal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applied_at",
    "authority",
    "batch_id",
    "identity_sha256",
    "kind",
    "plan",
    "policy",
    "receipt_id",
    "result_count",
    "results",
    "schema_version",
    "state"
  ],
  "properties": {
    "applied_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "authority": { "$ref": "#/$defs/authority" },
    "batch_id": { "type": "string", "pattern": "^ctxasrbatch_[0-9a-f]{32}$" },
    "identity_sha256": { "$ref": "#/$defs/sha256" },
    "kind": { "const": "contextual_asr_completed_result_seal_receipt" },
    "plan": { "$ref": "#/$defs/planReference" },
    "policy": { "$ref": "#/$defs/policy" },
    "receipt_id": { "type": "string", "pattern": "^ctxasrsealreceipt_[0-9a-f]{32}$" },
    "result_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/result" }
    },
    "schema_version": { "const": 1 },
    "state": { "const": "applied_content_and_mtime_preserved" }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$",
      "maxLength": 4096
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asr_execution",
        "catalog_import",
        "database_writes",
        "human_review_authority",
        "identity_authority",
        "network_access",
        "publication_authority",
        "transcript_preference_authority"
      ],
      "properties": {
        "asr_execution": { "const": false },
        "catalog_import": { "const": false },
        "database_writes": { "const": false },
        "human_review_authority": { "const": "none" },
        "identity_authority": { "const": "none" },
        "network_access": { "const": "none" },
        "publication_authority": { "const": "none" },
        "transcript_preference_authority": { "const": "none" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apply_lock_policy",
        "allowed_entries",
        "catalog_validation",
        "directory_mode_after",
        "directory_mode_before",
        "file_mode_after",
        "file_modes_before",
        "hardlink_policy",
        "result_set_policy",
        "rollback_policy",
        "symlink_policy",
        "transition_policy"
      ],
      "properties": {
        "apply_lock_policy": { "const": "retained_single_link_control_root_flock_receipt_check_through_commit" },
        "allowed_entries": {
          "type": "array",
          "prefixItems": [
            { "const": "result.json" },
            { "const": "transcript.normalized.json" },
            { "const": "whisper.raw.json" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "catalog_validation": { "const": "validate_asr_whispercpp_result_file_catalog_free" },
        "directory_mode_after": { "const": 320 },
        "directory_mode_before": { "const": 448 },
        "file_mode_after": { "const": 256 },
        "file_modes_before": {
          "type": "array",
          "prefixItems": [{ "const": 384 }, { "const": 420 }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "hardlink_policy": { "const": "source_control_and_result_files_require_nlink_1" },
        "result_set_policy": { "const": "one_explicit_result_per_contextual_manifest_work_order" },
        "rollback_policy": { "const": "best_effort_restore_exact_recorded_modes_before_receipt_commit" },
        "symlink_policy": { "const": "resolved_absolute_paths_plus_O_NOFOLLOW_retained_descriptors" },
        "transition_policy": { "const": "mode_only_two_phase_plan_then_apply" }
      }
    },
    "planReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_count", "identity_sha256", "path", "plan_id", "sha256"],
      "properties": {
        "byte_count": { "type": "integer", "minimum": 1 },
        "identity_sha256": { "$ref": "#/$defs/sha256" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "plan_id": { "type": "string", "pattern": "^ctxasrsealplan_[0-9a-f]{32}$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "directoryAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_entries_unchanged",
        "ctime_ns_after",
        "device",
        "inode",
        "mode_after",
        "mtime_ns",
        "mtime_unchanged",
        "nlink",
        "path"
      ],
      "properties": {
        "content_entries_unchanged": { "const": true },
        "ctime_ns_after": { "type": "integer", "minimum": 0 },
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 1 },
        "mode_after": { "const": 320 },
        "mtime_ns": { "type": "integer", "minimum": 0 },
        "mtime_unchanged": { "const": true },
        "nlink": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "fileAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_count",
        "content_unchanged",
        "ctime_ns_after",
        "device",
        "inode",
        "mode_after",
        "mtime_ns",
        "mtime_unchanged",
        "name",
        "nlink",
        "path",
        "sha256"
      ],
      "properties": {
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "content_unchanged": { "const": true },
        "ctime_ns_after": { "type": "integer", "minimum": 0 },
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 1 },
        "mode_after": { "const": 256 },
        "mtime_ns": { "type": "integer", "minimum": 0 },
        "mtime_unchanged": { "const": true },
        "name": { "enum": ["result.json", "transcript.normalized.json", "whisper.raw.json"] },
        "nlink": { "const": 1 },
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "files",
        "job_id",
        "ordinal",
        "result_key",
        "result_path",
        "source_ordinal",
        "work_order_sha256"
      ],
      "properties": {
        "directory": { "$ref": "#/$defs/directoryAfter" },
        "files": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/fileAfter" },
            { "$ref": "#/$defs/fileAfter" },
            { "$ref": "#/$defs/fileAfter" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "job_id": { "$ref": "#/$defs/identifier" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "result_key": { "$ref": "#/$defs/sha256" },
        "result_path": { "$ref": "#/$defs/absolutePath" },
        "source_ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "work_order_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
