{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/longform-asr-campaign-config.schema.json",
  "title": "Long-form ASR campaign deployment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "implementation_version",
    "source_controller",
    "planning_policy",
    "tools",
    "deployment",
    "execution",
    "safety",
    "identity_sha256",
    "config_id"
  ],
  "properties": {
    "kind": {"const": "himr_longform_asr_campaign_config"},
    "schema_version": {"const": 1},
    "implementation_version": {"const": "0.1.0"},
    "source_controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_id",
        "identity_sha256",
        "path",
        "physical_sha256",
        "gpu_queue_root",
        "gpu_lock_root",
        "root_registration",
        "root_registration_sha256",
        "production_profile",
        "production_profile_sha256",
        "writable_roots"
      ],
      "properties": {
        "config_id": {"type": "string", "pattern": "^himrautocfg_[0-9a-f]{32}$"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "path": {"$ref": "#/$defs/absolutePath"},
        "physical_sha256": {"$ref": "#/$defs/sha256"},
        "gpu_queue_root": {"$ref": "#/$defs/absolutePath"},
        "gpu_lock_root": {"$ref": "#/$defs/absolutePath"},
        "root_registration": {"$ref": "#/$defs/absolutePath"},
        "root_registration_sha256": {"$ref": "#/$defs/sha256"},
        "production_profile": {"$ref": "#/$defs/absolutePath"},
        "production_profile_sha256": {"$ref": "#/$defs/sha256"},
        "writable_roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/absolutePath"}
        }
      }
    },
    "planning_policy": {"$ref": "#/$defs/fileReference"},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ffmpeg", "ffprobe"],
      "properties": {
        "ffmpeg": {"$ref": "#/$defs/fileReference"},
        "ffprobe": {"$ref": "#/$defs/fileReference"}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "jobs_root",
        "dispatch_lock",
        "discovery_root",
        "cold_locator_manifest",
        "cold_locator_manifest_sha256",
        "candidate_receipt_root",
        "queue_receipt_root",
        "status_path"
      ],
      "properties": {
        "root": {"$ref": "#/$defs/absolutePath"},
        "jobs_root": {"$ref": "#/$defs/absolutePath"},
        "dispatch_lock": {"$ref": "#/$defs/absolutePath"},
        "discovery_root": {"$ref": "#/$defs/absolutePath"},
        "cold_locator_manifest": {"$ref": "#/$defs/absolutePath"},
        "cold_locator_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_receipt_root": {"$ref": "#/$defs/absolutePath"},
        "queue_receipt_root": {"$ref": "#/$defs/absolutePath"},
        "status_path": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_recordings_per_cycle", "max_run_seconds", "initial_prompt", "hotwords"],
      "properties": {
        "max_recordings_per_cycle": {"const": 1},
        "max_run_seconds": {"type": "integer", "minimum": 60, "maximum": 604800},
        "initial_prompt": {"type": ["string", "null"], "maxLength": 16384},
        "hotwords": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "safety": {
      "const": {
        "archive_authority": "none",
        "catalogue_mutation_authority": "none",
        "deletion_authority": "completed_job_derived_preprocess_scratch_only",
        "identity_authority": "none",
        "network_access": false,
        "publication_authority": "none",
        "source_controller_mutation_authority": "none",
        "source_selection": "validated_requires_chunking_gpu_queue_members_or_completed_cold_schedule_results",
        "visibility": "private",
        "wiki_authority": "none"
      }
    },
    "identity_sha256": {"$ref": "#/$defs/sha256"},
    "config_id": {"type": "string", "pattern": "^himrlongcfg_[0-9a-f]{32}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/[^\\u0000]*$", "maxLength": 4096},
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
