{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/preprocess-asr-queue-run-v1.json",
  "title": "Sealed preprocess-audio ASR queue validation and sequential dispatch summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation_version",
    "runner_name",
    "mode",
    "queue_id",
    "manifest_path",
    "manifest_sha256",
    "status",
    "dry_run",
    "include_near_silent",
    "job_count",
    "selected_count",
    "review_count",
    "adapter_invocation_count",
    "reused_count",
    "results",
    "runner",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "implementation_version": { "const": "0.2.0" },
    "runner_name": { "const": "himr-preprocess-asr-queue-runner" },
    "mode": { "enum": ["validate", "dry_run", "run"] },
    "queue_id": {
      "type": "string",
      "pattern": "^asrppqueue_[0-9a-f]{32}$"
    },
    "manifest_path": { "$ref": "#/$defs/path" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["validated", "planned", "completed", "failed"] },
    "dry_run": { "type": ["boolean", "null"] },
    "include_near_silent": { "type": "boolean" },
    "job_count": { "type": "integer", "minimum": 1, "maximum": 128 },
    "selected_count": { "type": "integer", "minimum": 0, "maximum": 128 },
    "review_count": { "type": "integer", "minimum": 0, "maximum": 128 },
    "adapter_invocation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "reused_count": { "type": "integer", "minimum": 0, "maximum": 128 },
    "results": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/resultItem" }
    },
    "handling_control": { "$ref": "#/$defs/handlingControl" },
    "failed_job": { "$ref": "#/$defs/failedJob" },
    "runner": { "$ref": "#/$defs/runner" },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1,
      "maxLength": 4096
    },
    "handlingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_scope", "publication_disposition", "publication_authority", "basis"
      ],
      "properties": {
        "storage_scope": { "const": "private_canonical_cache" },
        "publication_disposition": {
          "enum": ["no_publication_authority", "never_publish"]
        },
        "publication_authority": { "const": "none" },
        "basis": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "privateSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "platform", "source_kind", "native_id", "access_state"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "native_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "access_state": { "const": "unknown" }
      }
    },
    "privateAcquisitionSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_root", "receipt_path", "receipt_sha256", "receipt_byte_count",
        "plan_sha256", "validated_at", "result_physical_sha256",
        "result_canonical_sha256", "work_order_sha256", "media_id",
        "media_sha256", "media_byte_count", "source",
        "source_byte_identity_claimed"
      ],
      "properties": {
        "artifact_root": { "$ref": "#/$defs/path" },
        "receipt_path": { "$ref": "#/$defs/path" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_byte_count": {
          "type": "integer", "minimum": 1, "maximum": 33554432
        },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "validated_at": {
          "type": "string", "format": "date-time", "minLength": 1, "maxLength": 100
        },
        "result_physical_sha256": { "$ref": "#/$defs/sha256" },
        "result_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "media_id": {
          "type": "string", "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "media_sha256": { "$ref": "#/$defs/sha256" },
        "media_byte_count": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/privateSource" },
        "source_byte_identity_claimed": { "const": false }
      }
    },
    "handlingBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handling_policy", "private_acquisition_seal"],
      "properties": {
        "handling_policy": { "$ref": "#/$defs/handlingPolicy" },
        "private_acquisition_seal": { "$ref": "#/$defs/privateAcquisitionSeal" }
      }
    },
    "handlingControlEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "entry_id", "handling_policy", "handling_boundary_sha256",
        "seal_receipt_sha256", "seal_plan_sha256", "source_byte_identity_claimed"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 128 },
        "entry_id": { "type": "string", "pattern": "^pbe_[0-9a-f]{32}$" },
        "handling_policy": { "$ref": "#/$defs/handlingPolicy" },
        "handling_boundary_sha256": { "$ref": "#/$defs/sha256" },
        "seal_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "seal_plan_sha256": { "$ref": "#/$defs/sha256" },
        "source_byte_identity_claimed": { "const": false }
      }
    },
    "handlingControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "private_entry_count", "entries", "seal_receipt_replay_required",
        "handling_policy_propagation_required", "publication_authority",
        "identity_sha256"
      ],
      "properties": {
        "kind": { "const": "v30_private_acquisition_handling_control" },
        "private_entry_count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "entries": {
          "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": { "$ref": "#/$defs/handlingControlEntry" }
        },
        "seal_receipt_replay_required": { "const": true },
        "handling_policy_propagation_required": { "const": true },
        "publication_authority": { "const": "none" },
        "identity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "handlingDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preprocess_control_entry", "handling_boundary"],
      "properties": {
        "preprocess_control_entry": { "$ref": "#/$defs/handlingControlEntry" },
        "handling_boundary": { "$ref": "#/$defs/handlingBoundary" }
      }
    },
    "nullableIdentifier": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256", "byte_count"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 4194304 }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "implementation_version",
        "completed_result_validator",
        "path",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "name": { "const": "himr-preprocess-asr-queue-runner" },
        "implementation_version": { "const": "0.2.0" },
        "completed_result_validator": { "$ref": "#/$defs/component" },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 4194304 }
      }
    },
    "resultItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "job_id",
        "routing_hint",
        "action",
        "adapter_invoked",
        "work_order_sha256",
        "recipe_id",
        "result_key",
        "result_path",
        "processing_run_id",
        "result_sha256"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 128 },
        "job_id": {
          "type": "string",
          "pattern": "^asr-preprocess-[0-9a-f]{32}$"
        },
        "routing_hint": {
          "enum": ["process", "review_near_silent_candidate"]
        },
        "action": {
          "enum": [
            "review_required",
            "validated_for_dispatch",
            "validated_reuse",
            "planned",
            "would_reuse",
            "completed",
            "reused"
          ]
        },
        "adapter_invoked": { "type": "boolean" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "recipe_id": {
          "type": "string",
          "pattern": "^recipe_asr_whispercpp_[0-9a-f]{32}$"
        },
        "result_key": { "$ref": "#/$defs/sha256" },
        "result_path": { "$ref": "#/$defs/path" },
        "processing_run_id": { "$ref": "#/$defs/nullableIdentifier" },
        "result_sha256": { "$ref": "#/$defs/nullableSha256" },
        "handling": { "$ref": "#/$defs/handlingDescriptor" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["review_required", "validated_for_dispatch", "planned"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "processing_run_id": { "type": "null" },
              "result_sha256": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["validated_reuse", "would_reuse", "completed", "reused"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "processing_run_id": {
                "type": "string",
                "pattern": "^run_asr_whispercpp_[0-9a-f]{32}$"
              },
              "result_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["review_required", "validated_for_dispatch", "validated_reuse", "would_reuse"]
              }
            },
            "required": ["action"]
          },
          "then": { "properties": { "adapter_invoked": { "const": false } } }
        },
        {
          "if": {
            "properties": { "action": { "enum": ["planned", "completed", "reused"] } },
            "required": ["action"]
          },
          "then": { "properties": { "adapter_invoked": { "const": true } } }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 256 },
        "message": { "type": "string", "minLength": 1, "maxLength": 16384 }
      }
    },
    "invalidUtf8": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decoder", "start_byte", "end_byte", "reason"],
      "properties": {
        "decoder": { "const": "utf-8-strict" },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "rawArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "path",
        "storage_uri",
        "byte_count",
        "sha256",
        "visibility"
      ],
      "properties": {
        "artifact_kind": { "const": "whispercpp_output_json_full_quarantine" },
        "path": { "$ref": "#/$defs/path" },
        "storage_uri": { "type": "string", "pattern": "^file:///" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "visibility": { "const": "private" }
      }
    },
    "quarantine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_key",
        "receipt_kind",
        "receipt_path",
        "receipt_sha256",
        "invalid_utf8",
        "raw_artifact"
      ],
      "properties": {
        "failure_key": { "$ref": "#/$defs/sha256" },
        "receipt_kind": { "const": "whispercpp_output_json_full_invalid_utf8" },
        "receipt_path": { "$ref": "#/$defs/path" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "invalid_utf8": { "$ref": "#/$defs/invalidUtf8" },
        "raw_artifact": { "$ref": "#/$defs/rawArtifact" }
      }
    },
    "failedJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "job_id", "work_order_sha256", "error", "quarantine"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 128 },
        "job_id": {
          "type": "string",
          "pattern": "^asr-preprocess-[0-9a-f]{32}$"
        },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "error": { "$ref": "#/$defs/error" },
        "handling": { "$ref": "#/$defs/handlingDescriptor" },
        "quarantine": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/quarantine" }
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_access",
        "catalog_writes",
        "credentials_used",
        "dispatch_order",
        "identity_writes",
        "maximum_concurrency",
        "network_access",
        "near_silent_default",
        "publication_authority",
        "resume_policy",
        "runner_state_writes"
      ],
      "properties": {
        "catalog_access": { "const": "forbidden_sealed_receipt_queues_only" },
        "catalog_writes": { "const": false },
        "credentials_used": { "const": false },
        "dispatch_order": { "const": "sealed_ordinal_sequential_fail_fast" },
        "identity_writes": { "const": false },
        "maximum_concurrency": { "const": 1 },
        "network_access": { "const": "forbidden_by_runner_and_adapter_contract" },
        "near_silent_default": { "const": "route_to_review_without_adapter_invocation" },
        "publication_authority": { "const": "none" },
        "resume_policy": {
          "const": "strictly_validate_then_reuse_content_addressed_completed_results"
        },
        "runner_state_writes": { "const": false },
        "private_acquisition_seal_replay_required": { "const": true },
        "handling_policy_propagation_required": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "validate" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "status": { "const": "validated" },
          "dry_run": { "type": "null" },
          "adapter_invocation_count": { "const": 0 },
          "results": {
            "items": {
              "properties": {
                "action": {
                  "enum": ["review_required", "validated_for_dispatch", "validated_reuse"]
                }
              }
            }
          }
        },
        "not": { "required": ["failed_job"] }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "dry_run" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "status": { "enum": ["planned", "failed"] },
          "dry_run": { "const": true },
          "results": {
            "items": {
              "properties": {
                "action": { "enum": ["review_required", "planned", "would_reuse"] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "run" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "status": { "enum": ["completed", "failed"] },
          "dry_run": { "const": false },
          "results": {
            "items": {
              "properties": {
                "action": { "enum": ["review_required", "completed", "reused"] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "required": ["failed_job"] },
      "else": { "not": { "required": ["failed_job"] } }
    }
  ]
}
