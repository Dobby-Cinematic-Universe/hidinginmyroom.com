{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/audio-fingerprint-compare-result-v2.schema.json",
  "title": "Cross-recording sealed-envelope raw-fingerprint comparison result v2",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "not": {"pattern": "://"}},
    "timestamp": {"type": "string", "format": "date-time"},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["recording_id", "rendition_id"],
      "properties": {
        "recording_id": {"$ref": "#/$defs/identifier"},
        "rendition_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "pairContext": {
      "type": "object", "additionalProperties": false,
      "required": ["query", "candidate"],
      "properties": {
        "query": {"$ref": "#/$defs/context"},
        "candidate": {"$ref": "#/$defs/context"}
      }
    },
    "extractionResult": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "storage_uri", "sha256", "byte_count", "recipe_id", "recipe_sha256", "processing_run_id", "implementation_version", "unchanged"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "storage_uri": {"type": "string", "pattern": "^file:///"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "recipe_id": {"type": "string", "pattern": "^recipe_audio_fingerprint_[0-9a-f]{32}$"},
        "recipe_sha256": {"$ref": "#/$defs/sha256"},
        "processing_run_id": {"$ref": "#/$defs/identifier"},
        "implementation_version": {"const": "0.1.0"},
        "unchanged": {"const": true}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "storage_uri", "sha256", "byte_count", "media_id", "artifact_id", "parent_processing_run_id", "unchanged"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "storage_uri": {"type": "string", "pattern": "^file:///"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "media_id": {"$ref": "#/$defs/identifier"},
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "parent_processing_run_id": {"$ref": "#/$defs/identifier"},
        "unchanged": {"const": true}
      }
    },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "path", "sha256", "byte_count", "version_label", "version_output_sha256", "build_configuration", "muxer_help_sha256", "unchanged"],
      "properties": {
        "name": {"const": "ffmpeg"},
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "version_label": {"type": "string", "minLength": 1},
        "version_output_sha256": {"$ref": "#/$defs/sha256"},
        "build_configuration": {"type": ["string", "null"]},
        "muxer_help_sha256": {"$ref": "#/$defs/sha256"},
        "unchanged": {"const": true}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "processing_run_id", "path", "storage_uri", "sha256", "byte_count", "visibility", "unchanged"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "processing_run_id": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/absolutePath"},
        "storage_uri": {"type": "string", "pattern": "^file:///"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "visibility": {"const": "private"},
        "unchanged": {"const": true}
      }
    },
    "fingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint_id", "producer_implementation_version", "window_id", "window_kind", "start_ms", "end_ms", "algorithm", "raw_format", "sample_rate_hz", "channels", "fingerprint_word_count", "quality_flags", "artifact"],
      "properties": {
        "fingerprint_id": {"$ref": "#/$defs/identifier"},
        "producer_implementation_version": {"type": "string", "pattern": "^ffmpeg-chromaprint/0\\.1\\.0/recipe_audio_fingerprint_[0-9a-f]{32}$"},
        "window_id": {"$ref": "#/$defs/identifier"},
        "window_kind": {"enum": ["full_track", "explicit_window", "fixed_chunk", "partial_tail_chunk"]},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "algorithm": {"type": "integer", "minimum": 0},
        "raw_format": {"const": "ffmpeg_chromaprint_fp_format_raw"},
        "sample_rate_hz": {"const": 16000},
        "channels": {"const": 1},
        "fingerprint_word_count": {"type": "integer", "minimum": 0},
        "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "side": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "extraction_result", "catalog_context", "input", "engine", "fingerprint"],
      "properties": {
        "role": {"enum": ["query", "candidate"]},
        "extraction_result": {"$ref": "#/$defs/extractionResult"},
        "catalog_context": {"$ref": "#/$defs/context"},
        "input": {"$ref": "#/$defs/input"},
        "engine": {"$ref": "#/$defs/engine"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["processing_run_id", "execution_nonce", "started_at", "completed_at", "status"],
      "properties": {
        "processing_run_id": {"$ref": "#/$defs/identifier"},
        "execution_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "completed_at": {"$ref": "#/$defs/timestamp"},
        "status": {"const": "completed"}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["match_candidate_id", "exact_raw_equal", "raw_score", "score_semantics", "calibration_state", "calibrated_probability", "quality_flags", "decision_state", "requires_human_review", "relationship_asserted", "visibility", "publication_authority"],
      "properties": {
        "match_candidate_id": {"$ref": "#/$defs/identifier"},
        "exact_raw_equal": {"type": "boolean"},
        "raw_score": {"enum": [0.0, 1.0]},
        "score_semantics": {"const": "boolean_raw_byte_equality_not_probability"},
        "calibration_state": {"const": "not_calibrated"},
        "calibrated_probability": {"type": "null"},
        "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "decision_state": {"const": "candidate"},
        "requires_human_review": {"const": true},
        "relationship_asserted": {"const": false},
        "visibility": {"const": "private"},
        "publication_authority": {"const": "none"}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "stage", "implementation_version", "status", "dry_run", "job_id", "recipe_id", "recipe_sha256", "method", "compatibility_contract", "query", "candidate", "comparison", "processing_run", "catalog_context", "visibility", "publication_authority", "result_path", "errors"],
  "allOf": [
    {
      "properties": {
        "query": {"properties": {"role": {"const": "query"}}},
        "candidate": {"properties": {"role": {"const": "candidate"}}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "planned"}}, "required": ["status"]},
      "then": {
        "properties": {
          "dry_run": {"const": true},
          "comparison": {"type": "null"},
          "processing_run": {"type": "null"},
          "result_path": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "dry_run": {"const": false},
          "comparison": {"$ref": "#/$defs/comparison"},
          "processing_run": {"$ref": "#/$defs/run"},
          "result_path": {"$ref": "#/$defs/absolutePath"}
        }
      }
    }
  ],
  "properties": {
    "schema_version": {"const": 2},
    "stage": {"const": "audio_fingerprint_exact_compare_v2"},
    "implementation_version": {"const": "0.2.0"},
    "status": {"enum": ["planned", "completed"]},
    "dry_run": {"type": "boolean"},
    "job_id": {"$ref": "#/$defs/identifier"},
    "recipe_id": {"type": "string", "pattern": "^recipe_audio_fingerprint_compare_v2_[0-9a-f]{32}$"},
    "recipe_sha256": {"$ref": "#/$defs/sha256"},
    "method": {"const": "exact_raw_bytes_v2"},
    "compatibility_contract": {"const": "engine_build_algorithm_format_normalization_v2"},
    "query": {"$ref": "#/$defs/side"},
    "candidate": {"$ref": "#/$defs/side"},
    "comparison": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/comparison"}]},
    "processing_run": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/run"}]},
    "catalog_context": {"$ref": "#/$defs/pairContext"},
    "visibility": {"const": "private"},
    "publication_authority": {"const": "none"},
    "result_path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/absolutePath"}]},
    "errors": {"type": "array", "maxItems": 0}
  }
}
