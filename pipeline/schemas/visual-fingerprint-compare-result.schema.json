{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/visual-fingerprint-compare-result-v1.schema.json",
  "title": "Conservative visual-fingerprint comparison result v1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "not": {"pattern": "://"}},
    "implementation": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "byte_count", "python_version"],
      "properties": {"path": {"$ref": "#/$defs/absolutePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_count": {"type": "integer", "minimum": 1}, "python_version": {"type": "string", "minLength": 1}}
    },
    "threshold": {
      "type": "object", "additionalProperties": false, "required": ["maximum_hamming_distance", "top_k", "max_pairwise_comparisons"],
      "properties": {"maximum_hamming_distance": {"type": "integer", "minimum": 0, "maximum": 64}, "top_k": {"type": "integer", "minimum": 1, "maximum": 100}, "max_pairwise_comparisons": {"type": "integer", "minimum": 1, "maximum": 65536}}
    },
    "sideFrame": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint_id", "sample_id", "requested_timestamp_ms", "decoded_relative_timestamp_ms", "phash_hex", "exact_gray_sha256", "quality_flags"],
      "properties": {"fingerprint_id": {"$ref": "#/$defs/identifier"}, "sample_id": {"$ref": "#/$defs/identifier"}, "requested_timestamp_ms": {"type": "integer", "minimum": 0}, "decoded_relative_timestamp_ms": {"type": "integer"}, "phash_hex": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "exact_gray_sha256": {"$ref": "#/$defs/sha256"}, "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "side": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "result_path", "result_sha256", "result_key", "media_id", "algorithm", "phash_bits", "frames", "unchanged"],
      "properties": {"role": {"enum": ["query", "candidate"]}, "result_path": {"$ref": "#/$defs/absolutePath"}, "result_sha256": {"$ref": "#/$defs/sha256"}, "result_key": {"$ref": "#/$defs/sha256"}, "media_id": {"$ref": "#/$defs/identifier"}, "algorithm": {"const": "fixed_q20_dct_phash_8x8_v1"}, "phash_bits": {"const": 64}, "frames": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/sideFrame"}}, "unchanged": {"const": true}}
    },
    "recipe": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "stage", "implementation_version", "implementation_sha256", "method", "algorithm", "phash_bits", "query_result_sha256", "candidate_result_sha256", "query_frame_ids", "candidate_frame_ids", "threshold", "calibration_state"],
      "properties": {"schema_version": {"const": 1}, "stage": {"const": "visual_fingerprint_compare"}, "implementation_version": {"type": "string", "minLength": 1}, "implementation_sha256": {"$ref": "#/$defs/sha256"}, "method": {"const": "minimum_pairwise_phash_hamming_v1"}, "algorithm": {"const": "fixed_q20_dct_phash_8x8_v1"}, "phash_bits": {"const": 64}, "query_result_sha256": {"$ref": "#/$defs/sha256"}, "candidate_result_sha256": {"$ref": "#/$defs/sha256"}, "query_frame_ids": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/identifier"}}, "candidate_frame_ids": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/identifier"}}, "threshold": {"$ref": "#/$defs/threshold"}, "calibration_state": {"const": "not_calibrated"}}
    },
    "pair": {
      "type": "object", "additionalProperties": false,
      "required": ["query_fingerprint_id", "candidate_fingerprint_id", "hamming_distance", "normalized_hamming_distance", "raw_similarity", "exact_gray_equal"],
      "properties": {"query_fingerprint_id": {"$ref": "#/$defs/identifier"}, "candidate_fingerprint_id": {"$ref": "#/$defs/identifier"}, "hamming_distance": {"type": "integer", "minimum": 0, "maximum": 64}, "normalized_hamming_distance": {"type": "number", "minimum": 0, "maximum": 1}, "raw_similarity": {"type": "number", "minimum": 0, "maximum": 1}, "exact_gray_equal": {"type": "boolean"}}
    },
    "assertions": {
      "type": "object", "additionalProperties": false, "required": ["person_identity", "duplicate", "parent", "ownership", "relationship", "unrelated"],
      "properties": {"person_identity": {"const": false}, "duplicate": {"const": false}, "parent": {"const": false}, "ownership": {"const": false}, "relationship": {"const": false}, "unrelated": {"const": false}}
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["match_candidate_id", "pairwise_comparisons", "best_hamming_distance", "best_normalized_hamming_distance", "best_raw_similarity", "exact_gray_pair_count", "top_pairs", "threshold_state", "candidate_emitted", "decision_state", "score_semantics", "calibration_state", "calibrated_probability", "requires_human_review", "assertions", "warning"],
      "properties": {"match_candidate_id": {"$ref": "#/$defs/identifier"}, "pairwise_comparisons": {"type": "integer", "minimum": 1, "maximum": 65536}, "best_hamming_distance": {"type": "integer", "minimum": 0, "maximum": 64}, "best_normalized_hamming_distance": {"type": "number", "minimum": 0, "maximum": 1}, "best_raw_similarity": {"type": "number", "minimum": 0, "maximum": 1}, "exact_gray_pair_count": {"type": "integer", "minimum": 0}, "top_pairs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/pair"}}, "threshold_state": {"enum": ["meets_configured_threshold", "does_not_meet_configured_threshold"]}, "candidate_emitted": {"type": "boolean"}, "decision_state": {"enum": ["candidate_for_human_review", "below_configured_threshold"]}, "score_semantics": {"const": "raw_64_bit_phash_hamming_not_probability"}, "calibration_state": {"const": "not_calibrated"}, "calibrated_probability": {"type": "null"}, "requires_human_review": {"const": true}, "assertions": {"$ref": "#/$defs/assertions"}, "warning": {"type": "string", "minLength": 1}}
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["processing_run_id", "started_at", "completed_at", "status"],
      "properties": {"processing_run_id": {"$ref": "#/$defs/identifier"}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "status": {"const": "completed"}}
    },
    "contextSide": {
      "type": "object", "additionalProperties": false, "required": ["recording_id", "rendition_id"],
      "properties": {"recording_id": {"$ref": "#/$defs/identifier"}, "rendition_id": {"$ref": "#/$defs/identifier"}}
    },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["query", "candidate"],
      "properties": {"query": {"$ref": "#/$defs/contextSide"}, "candidate": {"$ref": "#/$defs/contextSide"}}
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "stage", "implementation_version", "status", "dry_run", "job_id", "work_order_sha256", "recipe", "recipe_id", "recipe_sha256", "result_key", "implementation", "method", "query", "candidate", "threshold", "comparison", "processing_run", "catalog_context", "result_path", "errors"],
  "properties": {
    "schema_version": {"const": 1}, "stage": {"const": "visual_fingerprint_compare"}, "implementation_version": {"type": "string", "minLength": 1}, "status": {"enum": ["planned", "completed"]}, "dry_run": {"type": "boolean"}, "job_id": {"$ref": "#/$defs/identifier"}, "work_order_sha256": {"$ref": "#/$defs/sha256"}, "recipe": {"$ref": "#/$defs/recipe"}, "recipe_id": {"type": "string", "pattern": "^recipe_visual_fingerprint_compare_[0-9a-f]{32}$"}, "recipe_sha256": {"$ref": "#/$defs/sha256"}, "result_key": {"$ref": "#/$defs/sha256"}, "implementation": {"$ref": "#/$defs/implementation"}, "method": {"const": "minimum_pairwise_phash_hamming_v1"}, "query": {"$ref": "#/$defs/side"}, "candidate": {"$ref": "#/$defs/side"}, "threshold": {"$ref": "#/$defs/threshold"}, "comparison": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/comparison"}]}, "processing_run": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/run"}]}, "catalog_context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/context"}]}, "result_path": {"$ref": "#/$defs/absolutePath"}, "errors": {"type": "array", "maxItems": 0}
  }
}
