{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/longform-span-transcript-bindings-v1.json",
  "title": "HIMR private long-form span transcript bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "parent_manifest_sha256",
    "spans",
    "policy"
  ],
  "properties": {
    "kind": { "const": "himr_longform_span_transcript_bindings" },
    "schema_version": { "const": 1 },
    "parent_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "spans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/spanBinding" }
    },
    "policy": {
      "const": {
        "visibility": "private",
        "source_artifact_mutation": false,
        "catalogue_mutation_authority": "none",
        "publication_authority": "none"
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "spanBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_id", "status", "result", "transcript", "failure_code"],
      "properties": {
        "span_id": { "type": "string", "pattern": "^lfspan_[0-9a-f]{32}$" },
        "status": { "enum": ["completed", "failed", "pending"] },
        "result": {
          "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }]
        },
        "transcript": {
          "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }]
        },
        "failure_code": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } } },
          "then": {
            "properties": {
              "result": { "$ref": "#/$defs/artifact" },
              "transcript": { "$ref": "#/$defs/artifact" },
              "failure_code": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } } },
          "then": {
            "properties": {
              "result": { "type": "null" },
              "transcript": { "type": "null" },
              "failure_code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,127}$"
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": {
            "properties": {
              "result": { "type": "null" },
              "transcript": { "type": "null" },
              "failure_code": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
