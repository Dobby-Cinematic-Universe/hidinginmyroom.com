{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/asr-whispercpp-batch-run-v1.json",
  "title": "Private raw whisper.cpp ASR batch dispatch summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation_version", "batch_id", "manifest_sha256", "status", "dry_run", "job_count", "results", "safety"],
  "properties": {
    "schema_version": { "const": 1 },
    "implementation_version": { "const": "0.2.0" },
    "batch_id": { "type": "string", "pattern": "^asrbatch_[0-9a-f]{32}$" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["planned", "completed", "failed"] },
    "dry_run": { "type": "boolean" },
    "job_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "results": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/resultItem" }
    },
    "failed_job": { "$ref": "#/$defs/failedJob" },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^/", "minLength": 1, "maxLength": 4096 },
    "resultItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "job_id", "work_order_sha256", "status", "recipe_id", "result_key", "result_path", "processing_run_id"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "job_id": { "type": "string", "pattern": "^asr-raw-[0-9a-f]{32}$" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["planned", "completed"] },
        "recipe_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "result_key": { "$ref": "#/$defs/sha256" },
        "result_path": { "$ref": "#/$defs/path" },
        "processing_run_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 256 },
        "message": { "type": "string", "minLength": 1, "maxLength": 16384 }
      }
    },
    "invalidUtf8": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decoder", "start_byte", "end_byte", "reason"],
      "properties": {
        "decoder": { "const": "utf-8-strict" },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "rawArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "path", "storage_uri", "byte_count", "sha256", "visibility"],
      "properties": {
        "artifact_kind": { "const": "whispercpp_output_json_full_quarantine" },
        "path": { "$ref": "#/$defs/path" },
        "storage_uri": { "type": "string", "pattern": "^file:///" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "visibility": { "const": "private" }
      }
    },
    "quarantine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_key", "receipt_kind", "receipt_path", "receipt_sha256", "invalid_utf8", "raw_artifact"],
      "properties": {
        "failure_key": { "$ref": "#/$defs/sha256" },
        "receipt_kind": { "const": "whispercpp_output_json_full_invalid_utf8" },
        "receipt_path": { "$ref": "#/$defs/path" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "invalid_utf8": { "$ref": "#/$defs/invalidUtf8" },
        "raw_artifact": { "$ref": "#/$defs/rawArtifact" }
      }
    },
    "failedJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "job_id", "work_order_sha256", "error", "quarantine"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "job_id": { "type": "string", "pattern": "^asr-raw-[0-9a-f]{32}$" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "error": { "$ref": "#/$defs/error" },
        "quarantine": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/quarantine" }
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatch_order", "network_access", "publication_authority", "catalog_writes", "resume_policy", "subset_policy"],
      "properties": {
        "dispatch_order": { "const": "sealed_ordinal_fail_fast" },
        "network_access": { "const": "forbidden_by_batch_contract" },
        "publication_authority": { "const": "none" },
        "catalog_writes": { "const": false },
        "resume_policy": { "const": "replay_manifest_reuses_content_addressed_completed_results" },
        "subset_policy": { "const": "materialize_explicit_sealed_input_subset" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "planned" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "dry_run": { "const": true },
          "results": {
            "items": {
              "properties": { "status": { "const": "planned" } }
            }
          }
        },
        "not": { "required": ["failed_job"] }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "dry_run": { "const": false },
          "results": {
            "items": {
              "properties": { "status": { "const": "completed" } }
            }
          }
        },
        "not": { "required": ["failed_job"] }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": { "required": ["failed_job"] }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "failed" },
          "dry_run": { "const": true }
        },
        "required": ["status", "dry_run"]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "properties": { "status": { "const": "planned" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "failed" },
          "dry_run": { "const": false }
        },
        "required": ["status", "dry_run"]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "properties": { "status": { "const": "completed" } }
            }
          }
        }
      }
    }
  ]
}
