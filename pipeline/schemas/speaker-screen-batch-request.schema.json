{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit private speaker-screen batch request",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "work_orders", "state_root", "resources"],
  "properties": {
    "kind": {"const": "himr_speaker_screen_batch_request"},
    "schema_version": {"const": 1},
    "state_root": {"type": "string", "pattern": "^/", "maxLength": 4096},
    "work_orders": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {"path": {"type": "string", "pattern": "^/", "maxLength": 4096},
                       "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "properties": {"concurrency": {"type": "integer", "minimum": 1, "maximum": 4, "default": 2},
                     "max_run_seconds": {"type": "integer", "minimum": 10, "maximum": 86400, "default": 3600}}
    }
  }
}
