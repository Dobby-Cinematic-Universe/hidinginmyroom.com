{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/result-v1.json",
  "title": "HIMR media preprocessing result envelope",
  "oneOf": [
    { "$ref": "#/$defs/fullResult" },
    { "$ref": "#/$defs/failureResult" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mediaId": { "type": "string", "pattern": "^media_sha256_[0-9a-f]{64}$" },
    "runId": { "type": "string", "pattern": "^run_preprocess_[0-9a-f]{32}$" },
    "recipeId": { "type": "string", "pattern": "^recipe_preprocess_[0-9a-f]{32}$" },
    "artifactId": { "type": "string", "pattern": "^artifact_[0-9a-f]{32}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNonNegativeInteger": { "type": ["integer", "null"], "minimum": 0 },
    "fileStat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode", "byte_count", "mtime_ns"],
      "properties": {
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 0 },
        "byte_count": { "type": "integer", "minimum": 0 },
        "mtime_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "audio_flac", "proxy", "routing"],
      "properties": {
        "probe": { "const": true },
        "audio_flac": { "type": "boolean" },
        "proxy": { "type": "boolean" },
        "routing": { "type": "boolean" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id", "ffmpeg_threads", "audio_sample_rate_hz", "audio_channels",
        "audio_sample_format", "flac_compression_level", "proxy_width", "proxy_height",
        "proxy_fps", "proxy_video_codec", "proxy_preset", "proxy_crf",
        "proxy_audio_codec", "proxy_audio_bitrate", "scene_threshold_percent",
        "silence_noise_db", "silence_min_duration_ms", "near_silent_fraction"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/nonEmptyString" },
        "ffmpeg_threads": { "type": "integer", "minimum": 1, "maximum": 32 },
        "audio_sample_rate_hz": { "const": 16000 },
        "audio_channels": { "const": 1 },
        "audio_sample_format": { "const": "s16" },
        "flac_compression_level": { "type": "integer", "minimum": 0, "maximum": 12 },
        "proxy_width": { "type": "integer", "minimum": 2, "maximum": 1280 },
        "proxy_height": { "type": "integer", "minimum": 2, "maximum": 1280 },
        "proxy_fps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "proxy_video_codec": { "$ref": "#/$defs/nonEmptyString" },
        "proxy_preset": { "$ref": "#/$defs/nonEmptyString" },
        "proxy_crf": { "type": "integer", "minimum": 0, "maximum": 51 },
        "proxy_audio_codec": { "$ref": "#/$defs/nonEmptyString" },
        "proxy_audio_bitrate": { "$ref": "#/$defs/nonEmptyString" },
        "scene_threshold_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "silence_noise_db": { "type": "number", "minimum": -100, "maximum": 0 },
        "silence_min_duration_ms": { "type": "integer", "minimum": 1 },
        "near_silent_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "toolProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "executable_sha256", "executable_byte_count", "version",
        "version_output", "version_output_sha256", "build_configuration"
      ],
      "properties": {
        "name": { "enum": ["ffmpeg", "ffprobe"] },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "executable_byte_count": { "type": "integer", "minimum": 1 },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "version_output": { "$ref": "#/$defs/nonEmptyString" },
        "version_output_sha256": { "$ref": "#/$defs/sha256" },
        "build_configuration": { "$ref": "#/$defs/nullableString" }
      }
    },
    "runParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "implementation_version", "operations", "profile", "tools"],
      "properties": {
        "contract_version": { "const": 1 },
        "implementation_version": { "$ref": "#/$defs/nonEmptyString" },
        "operations": { "$ref": "#/$defs/operations" },
        "profile": { "$ref": "#/$defs/profile" },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ffmpeg", "ffprobe"],
          "properties": {
            "ffmpeg": { "$ref": "#/$defs/toolProvenance" },
            "ffprobe": { "$ref": "#/$defs/toolProvenance" }
          }
        }
      }
    },
    "runEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "python", "cpu_only", "execution_nonce", "tool_paths"],
      "properties": {
        "platform": { "$ref": "#/$defs/nonEmptyString" },
        "python": { "$ref": "#/$defs/nonEmptyString" },
        "cpu_only": { "const": true },
        "execution_nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "tool_paths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ffmpeg", "ffprobe"],
          "properties": {
            "ffmpeg": { "type": "string", "pattern": "^/" },
            "ffprobe": { "type": "string", "pattern": "^/" }
          }
        }
      }
    },
    "processingRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_run_id", "stage", "implementation_version", "parameters_json",
        "environment_json", "started_at", "completed_at", "status"
      ],
      "properties": {
        "processing_run_id": { "$ref": "#/$defs/runId" },
        "stage": { "const": "media_preprocess" },
        "implementation_version": { "$ref": "#/$defs/nonEmptyString" },
        "parameters_json": { "$ref": "#/$defs/runParameters" },
        "environment_json": { "$ref": "#/$defs/runEnvironment" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "status": { "enum": ["queued", "running", "completed", "failed"] }
      }
    },
    "catalogObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_cataloged_at", "basis", "acquisition_timestamp_state"],
      "properties": {
        "first_cataloged_at": { "$ref": "#/$defs/timestamp" },
        "basis": { "enum": ["upstream_work_order", "preprocessing_observation"] },
        "acquisition_timestamp_state": { "const": "not_claimed_by_preprocessing" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "storage_uri", "media_id", "sha256", "byte_count", "stat_before",
        "stat_after", "unchanged", "catalog_observation"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "storage_uri": { "type": "string", "pattern": "^file://" },
        "media_id": { "$ref": "#/$defs/mediaId" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 0 },
        "stat_before": { "$ref": "#/$defs/fileStat" },
        "stat_after": {
          "oneOf": [{ "$ref": "#/$defs/fileStat" }, { "type": "null" }]
        },
        "unchanged": { "type": ["boolean", "null"] },
        "catalog_observation": { "$ref": "#/$defs/catalogObservation" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root", "object_dir", "recipe_dir", "run_dir", "recipe_id",
        "recipe_sha256"
      ],
      "properties": {
        "output_root": { "type": "string", "pattern": "^/" },
        "object_dir": { "type": "string", "pattern": "^/" },
        "recipe_dir": { "type": "string", "pattern": "^/" },
        "run_dir": { "type": "string", "pattern": "^/" },
        "recipe_id": { "$ref": "#/$defs/recipeId" },
        "recipe_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "prior_processing_run_id", "prior_result_path",
        "prior_result_sha256", "verified_at"
      ],
      "properties": {
        "mode": { "enum": ["none", "verified_prior_result"] },
        "prior_processing_run_id": {
          "oneOf": [{ "$ref": "#/$defs/runId" }, { "type": "null" }]
        },
        "prior_result_path": {
          "oneOf": [{ "type": "string", "pattern": "^/" }, { "type": "null" }]
        },
        "prior_result_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "verified_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "none" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "prior_processing_run_id": { "type": "null" },
              "prior_result_path": { "type": "null" },
              "prior_result_sha256": { "type": "null" },
              "verified_at": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "verified_prior_result" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "prior_processing_run_id": { "$ref": "#/$defs/runId" },
              "prior_result_path": { "type": "string", "pattern": "^/" },
              "prior_result_sha256": { "$ref": "#/$defs/sha256" },
              "verified_at": { "$ref": "#/$defs/timestamp" }
            }
          }
        }
      ]
    },
    "command": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "command", "output_path"],
      "properties": {
        "name": { "enum": ["probe", "audio_flac", "proxy", "routing"] },
        "status": {
          "enum": ["planned", "completed_read_only", "completed", "reused", "not_applicable", "disabled"]
        },
        "command": { "$ref": "#/$defs/command" },
        "output_path": {
          "oneOf": [{ "type": "string", "pattern": "^/" }, { "type": "null" }]
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(language|title|handler_name)$": { "type": "string" }
      }
    },
    "probeTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "ffprobe" },
        "version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "probeMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_id", "sha256", "byte_count", "basename"],
      "properties": {
        "media_id": { "$ref": "#/$defs/mediaId" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 0 },
        "basename": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "probeFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_name", "format_long_name", "duration_ms", "start_ms", "bit_rate_bps",
        "probe_score", "tags"
      ],
      "properties": {
        "format_name": { "$ref": "#/$defs/nullableString" },
        "format_long_name": { "$ref": "#/$defs/nullableString" },
        "duration_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "start_ms": { "$ref": "#/$defs/nullableInteger" },
        "bit_rate_bps": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "probe_score": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "rational": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "numerator", "denominator", "decimal"],
          "properties": {
            "text": { "$ref": "#/$defs/nonEmptyString" },
            "numerator": { "type": "integer" },
            "denominator": { "type": "integer", "not": { "const": 0 } },
            "decimal": { "type": "number" }
          }
        }
      ]
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "forced", "attached_pic"],
      "properties": {
        "default": { "enum": [0, 1] },
        "forced": { "enum": [0, 1] },
        "attached_pic": { "enum": [0, 1] }
      }
    },
    "sideData": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "side_data_type": { "$ref": "#/$defs/nonEmptyString" },
        "rotation": { "type": ["number", "string", "null"] }
      }
    },
    "videoDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width", "height", "pixel_format", "sample_aspect_ratio", "display_aspect_ratio",
        "average_frame_rate", "reported_frame_rate", "frame_count"
      ],
      "properties": {
        "width": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "height": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "pixel_format": { "$ref": "#/$defs/nullableString" },
        "sample_aspect_ratio": { "$ref": "#/$defs/nullableString" },
        "display_aspect_ratio": { "$ref": "#/$defs/nullableString" },
        "average_frame_rate": { "$ref": "#/$defs/rational" },
        "reported_frame_rate": { "$ref": "#/$defs/rational" },
        "frame_count": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      }
    },
    "audioDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate_hz", "channels", "channel_layout", "sample_format"],
      "properties": {
        "sample_rate_hz": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "channels": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "channel_layout": { "$ref": "#/$defs/nullableString" },
        "sample_format": { "$ref": "#/$defs/nullableString" }
      }
    },
    "probeStreamCommon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index", "codec_type", "codec_name", "codec_long_name", "profile", "duration_ms",
        "start_ms", "bit_rate_bps", "time_base", "disposition", "tags", "side_data"
      ],
      "properties": {
        "index": { "type": ["integer", "null"], "minimum": 0 },
        "codec_type": { "$ref": "#/$defs/nullableString" },
        "codec_name": { "$ref": "#/$defs/nullableString" },
        "codec_long_name": { "$ref": "#/$defs/nullableString" },
        "profile": { "$ref": "#/$defs/nullableString" },
        "duration_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "start_ms": { "$ref": "#/$defs/nullableInteger" },
        "bit_rate_bps": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "time_base": { "$ref": "#/$defs/nullableString" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "tags": { "$ref": "#/$defs/tags" },
        "side_data": { "type": "array", "items": { "$ref": "#/$defs/sideData" } }
      }
    },
    "probeStreamVideo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index", "codec_type", "codec_name", "codec_long_name", "profile", "duration_ms",
        "start_ms", "bit_rate_bps", "time_base", "disposition", "tags", "side_data", "video"
      ],
      "properties": {
        "index": { "type": ["integer", "null"], "minimum": 0 },
        "codec_type": { "const": "video" },
        "codec_name": { "$ref": "#/$defs/nullableString" },
        "codec_long_name": { "$ref": "#/$defs/nullableString" },
        "profile": { "$ref": "#/$defs/nullableString" },
        "duration_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "start_ms": { "$ref": "#/$defs/nullableInteger" },
        "bit_rate_bps": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "time_base": { "$ref": "#/$defs/nullableString" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "tags": { "$ref": "#/$defs/tags" },
        "side_data": { "type": "array", "items": { "$ref": "#/$defs/sideData" } },
        "video": { "$ref": "#/$defs/videoDetails" }
      }
    },
    "probeStreamAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index", "codec_type", "codec_name", "codec_long_name", "profile", "duration_ms",
        "start_ms", "bit_rate_bps", "time_base", "disposition", "tags", "side_data", "audio"
      ],
      "properties": {
        "index": { "type": ["integer", "null"], "minimum": 0 },
        "codec_type": { "const": "audio" },
        "codec_name": { "$ref": "#/$defs/nullableString" },
        "codec_long_name": { "$ref": "#/$defs/nullableString" },
        "profile": { "$ref": "#/$defs/nullableString" },
        "duration_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "start_ms": { "$ref": "#/$defs/nullableInteger" },
        "bit_rate_bps": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "time_base": { "$ref": "#/$defs/nullableString" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "tags": { "$ref": "#/$defs/tags" },
        "side_data": { "type": "array", "items": { "$ref": "#/$defs/sideData" } },
        "audio": { "$ref": "#/$defs/audioDetails" }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "start_ms", "end_ms", "tags"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "start_ms": { "$ref": "#/$defs/nullableInteger" },
        "end_ms": { "$ref": "#/$defs/nullableInteger" },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "normalizedProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "media", "tool", "format", "primary_streams", "streams", "chapters"],
      "properties": {
        "schema_version": { "const": 1 },
        "media": { "$ref": "#/$defs/probeMedia" },
        "tool": { "$ref": "#/$defs/probeTool" },
        "format": { "$ref": "#/$defs/probeFormat" },
        "primary_streams": {
          "type": "object",
          "additionalProperties": false,
          "required": ["video_index", "audio_index"],
          "properties": {
            "video_index": { "type": ["integer", "null"], "minimum": 0 },
            "audio_index": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "streams": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/probeStreamVideo" },
              { "$ref": "#/$defs/probeStreamAudio" },
              { "$ref": "#/$defs/probeStreamCommon" }
            ]
          }
        },
        "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } }
      }
    },
    "artifactDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id", "processing_run_id", "artifact_kind", "storage_uri", "path",
        "sha256", "byte_count", "schema_version", "visibility", "media_kind",
        "mime_type", "normalized_probe"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "processing_run_id": { "$ref": "#/$defs/runId" },
        "artifact_kind": {
          "enum": ["ffprobe_normalized_json", "audio_16khz_mono_flac", "low_resolution_cfr_proxy", "scene_silence_routing_json"]
        },
        "storage_uri": { "type": "string", "pattern": "^file://" },
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 0 },
        "schema_version": { "const": 1 },
        "visibility": { "const": "private" },
        "media_kind": { "enum": ["video", "audio", "document"] },
        "mime_type": { "$ref": "#/$defs/nullableString" },
        "normalized_probe": {
          "oneOf": [{ "$ref": "#/$defs/normalizedProbe" }, { "type": "null" }]
        }
      }
    },
    "sceneChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_ms", "score_percent"],
      "properties": {
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "score_percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "silenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "duration_ms"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "parameters", "coverage", "scene_changes", "silence_intervals",
        "summary", "routing_candidates", "warning", "source_media_id"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene_threshold_percent", "silence_noise_db", "silence_min_duration_ms", "near_silent_fraction"],
          "properties": {
            "scene_threshold_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "silence_noise_db": { "type": "number", "minimum": -100, "maximum": 0 },
            "silence_min_duration_ms": { "type": "integer", "minimum": 1 },
            "near_silent_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_ms", "has_video", "has_audio"],
          "properties": {
            "duration_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" },
            "has_video": { "type": "boolean" },
            "has_audio": { "type": "boolean" }
          }
        },
        "scene_changes": { "type": "array", "items": { "$ref": "#/$defs/sceneChange" } },
        "silence_intervals": { "type": "array", "items": { "$ref": "#/$defs/silenceInterval" } },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene_change_count", "silence_interval_count", "silent_duration_ms", "silent_fraction"],
          "properties": {
            "scene_change_count": { "type": "integer", "minimum": 0 },
            "silence_interval_count": { "type": "integer", "minimum": 0 },
            "silent_duration_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" },
            "silent_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
          }
        },
        "routing_candidates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asr", "ocr", "visual", "diarization", "active_speaker"],
          "properties": {
            "asr": { "enum": ["process", "skip_no_audio", "review_near_silent_candidate"] },
            "ocr": { "enum": ["scene_keyframes", "sparse_keyframes", "skip_no_video"] },
            "visual": { "enum": ["scene_and_speech_windows", "scene_keyframes", "skip_no_video"] },
            "diarization": { "const": "router_pending" },
            "active_speaker": { "const": "router_pending" }
          }
        },
        "warning": { "$ref": "#/$defs/nonEmptyString" },
        "source_media_id": { "$ref": "#/$defs/mediaId" }
      }
    },
    "mediaObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_id", "sha256", "byte_count", "media_kind", "mime_type", "container",
        "duration_ms", "ffprobe_json", "first_cataloged_at", "integrity_state"
      ],
      "properties": {
        "media_id": { "$ref": "#/$defs/mediaId" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 0 },
        "media_kind": { "enum": ["video", "audio", "other"] },
        "mime_type": { "$ref": "#/$defs/nullableString" },
        "container": { "$ref": "#/$defs/nullableString" },
        "duration_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "ffprobe_json": { "$ref": "#/$defs/normalizedProbe" },
        "first_cataloged_at": { "$ref": "#/$defs/timestamp" },
        "integrity_state": { "const": "verified" }
      }
    },
    "mediaLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_location_id", "media_id", "storage_uri", "storage_class", "verified_at", "is_primary"],
      "properties": {
        "media_location_id": { "type": "string", "pattern": "^media_location_[0-9a-f]{32}$" },
        "media_id": { "$ref": "#/$defs/mediaId" },
        "storage_uri": { "type": "string", "pattern": "^file://" },
        "storage_class": { "enum": ["local", "local_derived"] },
        "verified_at": { "$ref": "#/$defs/timestamp" },
        "is_primary": { "const": 1 }
      }
    },
    "mediaDerivation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["child_media_id", "parent_media_id", "derivation_kind", "processing_run_id", "metadata_json"],
          "properties": {
            "child_media_id": { "$ref": "#/$defs/mediaId" },
            "parent_media_id": { "$ref": "#/$defs/mediaId" },
            "derivation_kind": { "const": "audio_normalization_16khz_mono_flac" },
            "processing_run_id": { "$ref": "#/$defs/runId" },
            "metadata_json": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sample_rate_hz", "channels", "sample_format"],
              "properties": {
                "sample_rate_hz": { "const": 16000 },
                "channels": { "const": 1 },
                "sample_format": { "const": "s16" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["child_media_id", "parent_media_id", "derivation_kind", "processing_run_id", "metadata_json"],
          "properties": {
            "child_media_id": { "$ref": "#/$defs/mediaId" },
            "parent_media_id": { "$ref": "#/$defs/mediaId" },
            "derivation_kind": { "const": "low_resolution_cfr_proxy" },
            "processing_run_id": { "$ref": "#/$defs/runId" },
            "metadata_json": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height", "fps"],
              "properties": {
                "width": { "type": "integer", "minimum": 2 },
                "height": { "type": "integer", "minimum": 2 },
                "fps": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      ]
    },
    "runInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_input_id", "processing_run_id", "object_type", "object_id", "input_role", "input_sha256"],
      "properties": {
        "run_input_id": { "type": "string", "pattern": "^run_input_[0-9a-f]{32}$" },
        "processing_run_id": { "$ref": "#/$defs/runId" },
        "object_type": { "const": "media" },
        "object_id": { "$ref": "#/$defs/mediaId" },
        "input_role": { "const": "source_media" },
        "input_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "catalogArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "processing_run_id", "artifact_kind", "storage_uri", "sha256", "byte_count", "schema_version", "visibility"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "processing_run_id": { "$ref": "#/$defs/runId" },
        "artifact_kind": {
          "enum": ["ffprobe_normalized_json", "audio_16khz_mono_flac", "low_resolution_cfr_proxy", "scene_silence_routing_json"]
        },
        "storage_uri": { "type": "string", "pattern": "^file://" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 0 },
        "schema_version": { "const": 1 },
        "visibility": { "const": "private" }
      }
    },
    "catalogRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processing_runs", "run_inputs", "media_objects", "media_locations", "media_derivations", "artifacts"],
      "properties": {
        "processing_runs": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/processingRun" } },
        "run_inputs": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/runInput" } },
        "media_objects": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/mediaObject" } },
        "media_locations": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/mediaLocation" } },
        "media_derivations": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/mediaDerivation" } },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/catalogArtifact" } }
      }
    },
    "fullResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "job_id", "status", "dry_run", "duration_ms", "processing_run",
        "input", "layout", "steps", "artifacts", "routing", "reuse",
        "catalog_records", "errors"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "job_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "status": { "enum": ["planned", "completed"] },
        "dry_run": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "processing_run": { "$ref": "#/$defs/processingRun" },
        "input": { "$ref": "#/$defs/input" },
        "layout": { "$ref": "#/$defs/layout" },
        "steps": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/step" } },
        "artifacts": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/artifactDescriptor" } },
        "routing": { "oneOf": [{ "$ref": "#/$defs/routing" }, { "type": "null" }] },
        "reuse": { "$ref": "#/$defs/reuse" },
        "catalog_records": { "oneOf": [{ "$ref": "#/$defs/catalogRecords" }, { "type": "null" }] },
        "errors": { "type": "array", "maxItems": 0 },
        "result_path": { "type": "string", "pattern": "^/" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "planned" } }, "required": ["status"] },
          "then": {
            "properties": {
              "dry_run": { "const": true },
              "artifacts": { "maxItems": 0 },
              "routing": { "type": "null" },
              "catalog_records": { "type": "null" },
              "processing_run": { "properties": { "status": { "const": "queued" } } },
              "input": { "properties": { "stat_after": { "type": "null" }, "unchanged": { "type": "null" } } }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": {
            "required": ["result_path"],
            "properties": {
              "dry_run": { "const": false },
              "catalog_records": { "$ref": "#/$defs/catalogRecords" },
              "processing_run": { "properties": { "status": { "const": "completed" } } },
              "input": { "properties": { "stat_after": { "$ref": "#/$defs/fileStat" }, "unchanged": { "const": true } } }
            }
          }
        }
      ]
    },
    "failureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "error"],
      "properties": {
        "schema_version": { "const": 1 },
        "status": { "const": "failed" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "message"],
          "properties": {
            "type": { "$ref": "#/$defs/nonEmptyString" },
            "message": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    }
  }
}
