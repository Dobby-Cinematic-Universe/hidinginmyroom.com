{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/preprocess-asr-queue-manifest-v1.json",
  "title": "Private preprocess-audio ASR queue manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation_version",
    "materializer",
    "queue_id",
    "identity_sha256",
    "queue_relative_path",
    "origin",
    "software",
    "engine",
    "model",
    "profile",
    "output",
    "work_order_count",
    "totals",
    "work_orders",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "implementation_version": { "const": "0.2.0" },
    "materializer": { "const": "himr-preprocess-asr-queue" },
    "queue_id": {
      "type": "string",
      "pattern": "^asrppqueue_[0-9a-f]{32}$"
    },
    "identity_sha256": { "$ref": "#/$defs/sha256" },
    "queue_relative_path": {
      "type": "string",
      "pattern": "^queues/asrppqueue_[0-9a-f]{32}$"
    },
    "origin": { "$ref": "#/$defs/origin" },
    "handling_control": { "$ref": "#/$defs/handlingControl" },
    "software": { "$ref": "#/$defs/software" },
    "engine": { "$ref": "#/$defs/engine" },
    "model": { "$ref": "#/$defs/model" },
    "profile": { "$ref": "#/$defs/profile" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_root", "asr_output_root"],
      "properties": {
        "queue_root": { "$ref": "#/$defs/path" },
        "asr_output_root": { "$ref": "#/$defs/path" }
      }
    },
    "work_order_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_byte_count", "audio_duration_ms"],
      "properties": {
        "audio_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 274877906944
        },
        "audio_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800000
        }
      }
    },
    "work_orders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/workOrderEntry" }
    },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1,
      "maxLength": 16384
    },
    "uri": {
      "type": "string",
      "pattern": "^file:///",
      "minLength": 8,
      "maxLength": 32768
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "handlingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_scope", "publication_disposition", "publication_authority", "basis"
      ],
      "properties": {
        "storage_scope": { "const": "private_canonical_cache" },
        "publication_disposition": {
          "enum": ["no_publication_authority", "never_publish"]
        },
        "publication_authority": { "const": "none" },
        "basis": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "privateSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "platform", "source_kind", "native_id", "access_state"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "native_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "access_state": { "const": "unknown" }
      }
    },
    "privateAcquisitionSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_root", "receipt_path", "receipt_sha256", "receipt_byte_count",
        "plan_sha256", "validated_at", "result_physical_sha256",
        "result_canonical_sha256", "work_order_sha256", "media_id",
        "media_sha256", "media_byte_count", "source",
        "source_byte_identity_claimed"
      ],
      "properties": {
        "artifact_root": { "$ref": "#/$defs/path" },
        "receipt_path": { "$ref": "#/$defs/path" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_byte_count": {
          "type": "integer", "minimum": 1, "maximum": 33554432
        },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "validated_at": { "$ref": "#/$defs/timestamp" },
        "result_physical_sha256": { "$ref": "#/$defs/sha256" },
        "result_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "media_id": {
          "type": "string", "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "media_sha256": { "$ref": "#/$defs/sha256" },
        "media_byte_count": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/privateSource" },
        "source_byte_identity_claimed": { "const": false }
      }
    },
    "handlingBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handling_policy", "private_acquisition_seal"],
      "properties": {
        "handling_policy": { "$ref": "#/$defs/handlingPolicy" },
        "private_acquisition_seal": { "$ref": "#/$defs/privateAcquisitionSeal" }
      }
    },
    "handlingControlEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "entry_id", "handling_policy", "handling_boundary_sha256",
        "seal_receipt_sha256", "seal_plan_sha256", "source_byte_identity_claimed"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 128 },
        "entry_id": { "type": "string", "pattern": "^pbe_[0-9a-f]{32}$" },
        "handling_policy": { "$ref": "#/$defs/handlingPolicy" },
        "handling_boundary_sha256": { "$ref": "#/$defs/sha256" },
        "seal_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "seal_plan_sha256": { "$ref": "#/$defs/sha256" },
        "source_byte_identity_claimed": { "const": false }
      }
    },
    "handlingControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "private_entry_count", "entries", "seal_receipt_replay_required",
        "handling_policy_propagation_required", "publication_authority",
        "identity_sha256"
      ],
      "properties": {
        "kind": { "const": "v30_private_acquisition_handling_control" },
        "private_entry_count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "entries": {
          "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": { "$ref": "#/$defs/handlingControlEntry" }
        },
        "seal_receipt_replay_required": { "const": true },
        "handling_policy_propagation_required": { "const": true },
        "publication_authority": { "const": "none" },
        "identity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "handlingDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preprocess_control_entry", "handling_boundary"],
      "properties": {
        "preprocess_control_entry": { "$ref": "#/$defs/handlingControlEntry" },
        "handling_boundary": { "$ref": "#/$defs/handlingBoundary" }
      }
    },
    "resultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "uri", "sha256", "byte_count", "job_id",
        "processing_run_id", "recipe_sha256"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "uri": { "$ref": "#/$defs/uri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "job_id": { "$ref": "#/$defs/identifier" },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "recipe_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_id", "sha256", "byte_count", "path", "storage_uri",
        "duration_ms", "first_cataloged_at"
      ],
      "properties": {
        "media_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/path" },
        "storage_uri": { "$ref": "#/$defs/uri" },
        "duration_ms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 604800000
        },
        "first_cataloged_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "audioArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id", "artifact_kind", "processing_run_id", "media_id",
        "path", "uri", "sha256", "byte_count", "duration_ms",
        "normalized_probe_sha256", "visibility"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "artifact_kind": { "const": "audio_16khz_mono_flac" },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "media_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "path": { "$ref": "#/$defs/path" },
        "uri": { "$ref": "#/$defs/uri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 17179869184 },
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "normalized_probe_sha256": { "$ref": "#/$defs/sha256" },
        "visibility": { "const": "private" }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_coordinate_system", "artifact_start_ms", "artifact_end_ms",
        "boundary", "recording_transform_state", "recording_start_ms",
        "recording_end_ms", "translation_basis",
        "duration_equality_is_translation_evidence"
      ],
      "properties": {
        "artifact_coordinate_system": { "const": "artifact_local_milliseconds" },
        "artifact_start_ms": { "const": 0 },
        "artifact_end_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "boundary": { "const": "half_open" },
        "recording_transform_state": { "const": "unresolved" },
        "recording_start_ms": { "type": "null" },
        "recording_end_ms": { "type": "null" },
        "translation_basis": { "const": "not_claimed_by_preprocess_asr_queue" },
        "duration_equality_is_translation_evidence": { "const": false }
      }
    },
    "receiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "uri", "physical_sha256", "receipt_id", "receipt_sha256", "ordinal"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "uri": { "$ref": "#/$defs/uri" },
        "physical_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_id": {
          "type": "string",
          "pattern": "^ppreceipt_[0-9a-f]{32}$"
        },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "nullableText": {
      "type": ["string", "null"],
      "maxLength": 32768
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 1,
      "maxLength": 100
    },
    "catalogArtifactSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id", "processing_run_id", "artifact_kind", "storage_uri",
        "sha256", "byte_count", "schema_version", "visibility",
        "metadata_json_sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "artifact_kind": { "const": "audio_16khz_mono_flac" },
        "storage_uri": { "$ref": "#/$defs/uri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "schema_version": { "const": 1 },
        "visibility": { "const": "private" },
        "metadata_json_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "catalogProcessingRunSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_run_id", "stage", "implementation_version", "model_id",
        "glossary_revision_id", "parameters_json_sha256",
        "environment_json_sha256", "random_seed", "started_at", "completed_at",
        "status", "error_text"
      ],
      "properties": {
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "stage": { "const": "media_preprocess" },
        "implementation_version": { "type": "string", "minLength": 1 },
        "model_id": { "$ref": "#/$defs/nullableText" },
        "glossary_revision_id": { "$ref": "#/$defs/nullableText" },
        "parameters_json_sha256": { "$ref": "#/$defs/sha256" },
        "environment_json_sha256": { "$ref": "#/$defs/sha256" },
        "random_seed": { "type": ["integer", "null"] },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": { "$ref": "#/$defs/timestamp" },
        "status": { "const": "completed" },
        "error_text": { "type": "null" }
      }
    },
    "catalogRunInputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_input_id", "processing_run_id", "object_type", "object_id",
        "input_role", "input_sha256"
      ],
      "properties": {
        "run_input_id": { "$ref": "#/$defs/identifier" },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "object_type": { "const": "media" },
        "object_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "input_role": { "const": "source_media" },
        "input_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "catalogMediaSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_id", "sha256", "byte_count", "media_kind", "mime_type",
        "container", "duration_ms", "first_cataloged_at", "integrity_state",
        "ffprobe_json_sha256"
      ],
      "properties": {
        "media_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "media_kind": {
          "enum": ["video", "audio", "image", "subtitle", "document", "other"]
        },
        "mime_type": { "$ref": "#/$defs/nullableText" },
        "container": { "$ref": "#/$defs/nullableText" },
        "duration_ms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 604800000
        },
        "first_cataloged_at": { "$ref": "#/$defs/timestamp" },
        "integrity_state": { "const": "verified" },
        "ffprobe_json_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "catalogLocationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_location_id", "media_id", "storage_uri", "storage_class",
        "verified_at", "is_primary"
      ],
      "properties": {
        "media_location_id": { "$ref": "#/$defs/identifier" },
        "media_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "storage_uri": { "$ref": "#/$defs/uri" },
        "storage_class": { "type": "string", "minLength": 1, "maxLength": 128 },
        "verified_at": { "$ref": "#/$defs/timestamp" },
        "is_primary": { "const": 1 }
      }
    },
    "catalogDerivationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_media_id", "child_media_id", "derivation_kind",
        "processing_run_id", "metadata_json_sha256"
      ],
      "properties": {
        "parent_media_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "child_media_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "derivation_kind": { "const": "audio_normalization_16khz_mono_flac" },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "metadata_json_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "catalogBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "binding_sha256"],
      "properties": {
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact", "processing_run", "run_input", "source_media",
            "source_location", "producer_source_media", "producer_source_location",
            "media", "location", "derivation", "rendition_count",
            "renditions_sha256", "timeline_span_count", "timeline_spans_sha256"
          ],
          "properties": {
            "artifact": { "$ref": "#/$defs/catalogArtifactSnapshot" },
            "processing_run": { "$ref": "#/$defs/catalogProcessingRunSnapshot" },
            "run_input": { "$ref": "#/$defs/catalogRunInputSnapshot" },
            "source_media": { "$ref": "#/$defs/catalogMediaSnapshot" },
            "source_location": { "$ref": "#/$defs/catalogLocationSnapshot" },
            "producer_source_media": { "$ref": "#/$defs/catalogMediaSnapshot" },
            "producer_source_location": { "$ref": "#/$defs/catalogLocationSnapshot" },
            "media": { "$ref": "#/$defs/catalogMediaSnapshot" },
            "location": { "$ref": "#/$defs/catalogLocationSnapshot" },
            "derivation": { "$ref": "#/$defs/catalogDerivationSnapshot" },
            "rendition_count": { "type": "integer", "minimum": 0 },
            "renditions_sha256": { "$ref": "#/$defs/sha256" },
            "timeline_span_count": { "type": "integer", "minimum": 0 },
            "timeline_spans_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "binding_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "receipt", "preprocess_result", "source_media"],
          "properties": {
            "mode": { "const": "sealed_preprocess_receipt" },
            "receipt": { "$ref": "#/$defs/receiptRef" },
            "preprocess_result": { "$ref": "#/$defs/resultRef" },
            "source_media": { "$ref": "#/$defs/sourceMedia" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "preprocess_result", "source_media", "catalog_binding"],
          "properties": {
            "mode": { "const": "catalog_admitted_preprocess_result" },
            "preprocess_result": { "$ref": "#/$defs/resultRef" },
            "source_media": { "$ref": "#/$defs/sourceMedia" },
            "catalog_binding": { "$ref": "#/$defs/catalogBinding" }
          }
        }
      ]
    },
    "workOrderEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "job_id", "path", "sha256", "canonical_sha256",
        "byte_count", "audio_artifact", "preprocess_result", "source_media",
        "coordinate_provenance", "routing_hint", "admission_evidence"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 128 },
        "job_id": {
          "type": "string",
          "pattern": "^asr-preprocess-[0-9a-f]{32}$"
        },
        "path": {
          "type": "string",
          "pattern": "^work-orders/[0-9]{6}\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "adapter_work_order_sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "audio_artifact": { "$ref": "#/$defs/audioArtifact" },
        "preprocess_result": { "$ref": "#/$defs/resultRef" },
        "source_media": { "$ref": "#/$defs/sourceMedia" },
        "coordinate_provenance": { "$ref": "#/$defs/coordinates" },
        "routing_hint": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "admission_evidence": { "$ref": "#/$defs/evidence" },
        "handling": { "$ref": "#/$defs/handlingDescriptor" }
      }
    },
    "sealedOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "preprocess_bundle", "state_root", "receipt_count",
        "receipt_state_sha256", "receipt_refs_sha256"
      ],
      "properties": {
        "mode": { "const": "sealed_preprocess_receipts" },
        "preprocess_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path", "manifest_path", "manifest_physical_sha256", "bundle_id",
            "identity_sha256", "manifest_sha256"
          ],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "manifest_path": { "$ref": "#/$defs/path" },
            "manifest_physical_sha256": { "$ref": "#/$defs/sha256" },
            "bundle_id": {
              "type": "string",
              "pattern": "^ppbatch_[0-9a-f]{32}$"
            },
            "identity_sha256": { "$ref": "#/$defs/sha256" },
            "manifest_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "state_root": { "$ref": "#/$defs/path" },
        "receipt_count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "receipt_state_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_refs_sha256": { "$ref": "#/$defs/sha256" },
        "handling_control": { "$ref": "#/$defs/handlingControl" }
      }
    },
    "catalogOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "catalog", "result_paths"],
      "properties": {
        "mode": { "const": "catalog_admitted_preprocess_results" },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "database_path", "access_mode", "query_contract_version", "binding_sha256"
          ],
          "properties": {
            "database_path": { "$ref": "#/$defs/path" },
            "access_mode": { "const": "read_only_snapshot" },
            "query_contract_version": { "const": 1 },
            "binding_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "result_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "origin": {
      "oneOf": [
        { "$ref": "#/$defs/sealedOrigin" },
        { "$ref": "#/$defs/catalogOrigin" }
      ]
    },
    "engineBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "target", "configuration"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "target": { "type": "string", "minLength": 1, "maxLength": 256 },
        "configuration": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "rawInference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language", "threads", "translate", "split_on_word", "best_of",
        "beam_size", "max_segment_characters", "word_threshold",
        "entropy_threshold", "logprob_threshold", "no_speech_threshold",
        "temperature", "temperature_increment", "no_fallback", "timeout_seconds"
      ],
      "properties": {
        "language": { "const": "en" },
        "threads": { "const": 6 },
        "translate": { "const": false },
        "split_on_word": { "const": true },
        "best_of": { "const": 5 },
        "beam_size": { "const": 5 },
        "max_segment_characters": { "const": 0 },
        "word_threshold": { "const": 0.01 },
        "entropy_threshold": { "const": 2.4 },
        "logprob_threshold": { "const": -1.0 },
        "no_speech_threshold": { "const": 0.6 },
        "temperature": { "const": 0.0 },
        "temperature_increment": { "const": 0.2 },
        "no_fallback": { "const": false },
        "timeout_seconds": { "const": 7200 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "implementation_version", "path", "sha256", "byte_count"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "implementation_version": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 4194304 }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materializer", "asr_adapter", "engine_profiles"],
      "properties": {
        "materializer": {
          "allOf": [
            { "$ref": "#/$defs/component" },
            { "properties": { "name": { "const": "himr-preprocess-asr-queue" } } }
          ]
        },
        "asr_adapter": {
          "allOf": [
            { "$ref": "#/$defs/component" },
            {
              "required": ["contract_version"],
              "properties": {
                "name": { "const": "himr-asr-whispercpp" },
                "contract_version": { "const": 1 }
              }
            }
          ]
        },
        "engine_profiles": {
          "allOf": [
            { "$ref": "#/$defs/component" },
            {
              "required": ["contract_version"],
              "properties": {
                "name": { "const": "himr-whispercpp-engine-profiles" },
                "contract_version": { "const": 1 }
              }
            }
          ]
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable", "expected_sha256", "byte_count", "version_label",
        "version_evidence", "build", "profile_contract_version",
        "profile_implementation_version", "selected_profile",
        "selected_profile_sha256"
      ],
      "properties": {
        "executable": { "$ref": "#/$defs/path" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "version_label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version_evidence": { "const": "source_revision_plus_executable_sha256" },
        "build": { "$ref": "#/$defs/engineBuild" },
        "profile_contract_version": { "const": 1 },
        "profile_implementation_version": { "type": "string", "minLength": 1 },
        "selected_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_id", "admission", "expected_sha256", "byte_count",
            "version_label", "version_evidence", "build",
            "output_json_full_utf8_token_boundary_merge"
          ],
          "properties": {
            "profile_id": { "$ref": "#/$defs/identifier" },
            "admission": { "const": "current_new_batch" },
            "expected_sha256": { "$ref": "#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 1 },
            "version_label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version_evidence": { "const": "source_revision_plus_executable_sha256" },
            "build": { "$ref": "#/$defs/engineBuild" },
            "output_json_full_utf8_token_boundary_merge": { "const": true }
          }
        },
        "selected_profile_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "expected_sha256", "byte_count", "model_id", "name",
        "revision", "source", "license_label"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "model_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "license_label": { "type": "string", "minLength": 1 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass_kind", "coordinate_system", "window_offset_ms", "duration_basis",
        "recording_transform_state", "catalog_context_policy", "routing_hint_policy",
        "inference", "glossary"
      ],
      "properties": {
        "pass_kind": { "const": "raw_full_preprocess_artifact" },
        "coordinate_system": { "const": "artifact_local_milliseconds" },
        "window_offset_ms": { "const": 0 },
        "duration_basis": { "const": "exact_preprocess_normalized_probe_full_duration" },
        "recording_transform_state": { "const": "unresolved" },
        "catalog_context_policy": {
          "const": "always_null_until_separate_translation_admission"
        },
        "routing_hint_policy": {
          "const": "advisory_only_all_explicitly_admitted_audio_is_queued"
        },
        "inference": { "$ref": "#/$defs/rawInference" },
        "glossary": { "type": "null" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_writes", "credentials_used", "identity_authority", "network_access",
        "publication_authority", "raw_or_source_media_copied", "source_bytes_preserved",
        "timestamp_translation_authority", "visibility"
      ],
      "properties": {
        "catalog_writes": { "const": false },
        "credentials_used": { "const": false },
        "identity_authority": { "const": "none" },
        "network_access": {
          "const": "forbidden_by_contract_not_performed_by_materializer"
        },
        "publication_authority": { "const": "none" },
        "raw_or_source_media_copied": { "const": false },
        "source_bytes_preserved": { "const": true },
        "timestamp_translation_authority": { "const": "none" },
        "visibility": { "const": "private" },
        "private_acquisition_seal_required": { "const": true },
        "handling_policy_propagation_required": { "const": true }
      }
    }
  }
}
