{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himr.example/schemas/asr-whispercpp-result-seal-receipt.schema.json",
  "title": "whisper.cpp completed-result seal receipt (v1 two-source, v2 queue-only, or v3 batch-only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applied_at",
    "authority",
    "identity_sha256",
    "kind",
    "plan",
    "policy",
    "receipt_id",
    "result_count",
    "results",
    "schema_version",
    "state"
  ],
  "properties": {
    "applied_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "authority": { "$ref": "#/$defs/authority" },
    "identity_sha256": { "$ref": "#/$defs/sha256" },
    "kind": { "const": "asr_whispercpp_completed_result_seal_receipt" },
    "plan": { "$ref": "#/$defs/planReference" },
    "policy": { "$ref": "#/$defs/policy" },
    "receipt_id": {
      "type": "string",
      "pattern": "^asrsealreceipt_[0-9a-f]{32}$"
    },
    "result_count": { "type": "integer", "minimum": 1 },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resultAfter" }
    },
    "schema_version": { "type": "integer", "enum": [1, 2, 3] },
    "source_authority": {
      "oneOf": [
        { "$ref": "#/$defs/sourceAuthority" },
        { "$ref": "#/$defs/batchSourceAuthority" }
      ]
    },
    "state": { "const": "applied_content_and_mtime_preserved" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 1 } },
        "required": ["schema_version"]
      },
      "then": {
        "not": { "required": ["source_authority"] }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": 2 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["source_authority"],
        "properties": {
          "results": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/resultAfter" },
                {
                  "properties": {
                    "source_id": { "pattern": "^asrppqueue_[0-9a-f]{32}$" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": 3 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["source_authority"],
        "properties": {
          "results": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/resultAfter" },
                {
                  "properties": {
                    "source_id": { "pattern": "^asrbatch_[0-9a-f]{32}$" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asr_execution",
        "catalog_import",
        "database_writes",
        "identity_authority",
        "network_access",
        "publication_authority"
      ],
      "properties": {
        "asr_execution": { "const": false },
        "catalog_import": { "const": false },
        "database_writes": { "const": false },
        "identity_authority": { "const": "none" },
        "network_access": { "const": "none" },
        "publication_authority": { "const": "none" }
      }
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "queue_id",
        "queue_identity_sha256",
        "queue_contract",
        "queue_manifest_path",
        "queue_manifest_sha256",
        "schema_version",
        "selection_policy"
      ],
      "properties": {
        "mode": { "const": "queue_only" },
        "queue_id": {
          "type": "string",
          "pattern": "^asrppqueue_[0-9a-f]{32}$"
        },
        "queue_identity_sha256": { "$ref": "#/$defs/sha256" },
        "queue_contract": { "$ref": "#/$defs/queueContract" },
        "queue_manifest_path": { "$ref": "#/$defs/absolutePath" },
        "queue_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "type": "integer", "const": 1 },
        "selection_policy": {
          "const": "all_and_only_routing_hint_process_entries"
        }
      }
    },
    "queueContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_schema_version",
        "materializer",
        "materializer_implementation_version",
        "queue_manifest_schema",
        "queue_validator",
        "safety_sha256"
      ],
      "properties": {
        "manifest_schema_version": { "type": "integer", "minimum": 1 },
        "materializer": { "type": "string", "minLength": 1 },
        "materializer_implementation_version": {
          "type": "string",
          "minLength": 1
        },
        "queue_manifest_schema": { "$ref": "#/$defs/fileIdentity" },
        "queue_validator": { "$ref": "#/$defs/fileIdentity" },
        "safety_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "batchSourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_contract",
        "batch_id",
        "batch_identity_sha256",
        "batch_manifest_path",
        "batch_manifest_sha256",
        "mode",
        "schema_version",
        "selection_policy"
      ],
      "properties": {
        "batch_contract": { "$ref": "#/$defs/batchContract" },
        "batch_id": {
          "type": "string",
          "pattern": "^asrbatch_[0-9a-f]{32}$"
        },
        "batch_identity_sha256": { "$ref": "#/$defs/sha256" },
        "batch_manifest_path": { "$ref": "#/$defs/absolutePath" },
        "batch_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "const": "batch_only" },
        "schema_version": { "type": "integer", "const": 1 },
        "selection_policy": { "const": "all_batch_work_orders" }
      }
    },
    "batchContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_manifest_schema",
        "batch_validator",
        "catalog_binding_sha256",
        "manifest_schema_version",
        "materializer",
        "materializer_implementation_version",
        "safety_sha256"
      ],
      "properties": {
        "batch_manifest_schema": { "$ref": "#/$defs/fileIdentity" },
        "batch_validator": { "$ref": "#/$defs/fileIdentity" },
        "catalog_binding_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_schema_version": { "type": "integer", "minimum": 1 },
        "materializer": { "type": "string", "minLength": 1 },
        "materializer_implementation_version": {
          "type": "string",
          "minLength": 1
        },
        "safety_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_count", "path", "sha256"],
      "properties": {
        "byte_count": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_entries",
        "catalog_validation",
        "container_changes",
        "container_policy",
        "directory_mode_after",
        "directory_mode_before",
        "file_mode_after",
        "file_mode_before",
        "hardlink_policy",
        "symlink_policy"
      ],
      "properties": {
        "allowed_entries": {
          "type": "array",
          "prefixItems": [
            { "const": "result.json" },
            { "const": "transcript.normalized.json" },
            { "const": "whisper.raw.json" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "catalog_validation": {
          "const": "validate_asr_whispercpp_result_file_catalog_free"
        },
        "container_changes": { "type": "array", "maxItems": 0 },
        "container_policy": {
          "const": "no_descendant_container_change_private_store_root_already_mode_0700"
        },
        "directory_mode_after": { "const": 320 },
        "directory_mode_before": { "const": 448 },
        "file_mode_after": { "const": 256 },
        "file_mode_before": { "const": 420 },
        "hardlink_policy": { "const": "all_three_files_must_have_nlink_1" },
        "symlink_policy": { "const": "resolved_absolute_paths_and_O_NOFOLLOW" }
      }
    },
    "planReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_count", "identity_sha256", "path", "plan_id", "sha256"],
      "properties": {
        "byte_count": { "type": "integer", "minimum": 1 },
        "identity_sha256": { "$ref": "#/$defs/sha256" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "plan_id": { "type": "string", "pattern": "^asrsealplan_[0-9a-f]{32}$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "directoryAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_entries_unchanged",
        "ctime_ns_after",
        "device",
        "inode",
        "mode_after",
        "mtime_ns",
        "mtime_unchanged",
        "nlink",
        "path"
      ],
      "properties": {
        "content_entries_unchanged": { "const": true },
        "ctime_ns_after": { "type": "integer", "minimum": 0 },
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 1 },
        "mode_after": { "const": 320 },
        "mtime_ns": { "type": "integer", "minimum": 0 },
        "mtime_unchanged": { "const": true },
        "nlink": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "fileAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_count",
        "content_unchanged",
        "ctime_ns_after",
        "device",
        "inode",
        "mode_after",
        "mtime_ns",
        "mtime_unchanged",
        "name",
        "nlink",
        "path",
        "sha256"
      ],
      "properties": {
        "byte_count": { "type": "integer", "minimum": 1 },
        "content_unchanged": { "const": true },
        "ctime_ns_after": { "type": "integer", "minimum": 0 },
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 1 },
        "mode_after": { "const": 256 },
        "mtime_ns": { "type": "integer", "minimum": 0 },
        "mtime_unchanged": { "const": true },
        "name": {
          "enum": ["result.json", "transcript.normalized.json", "whisper.raw.json"]
        },
        "nlink": { "const": 1 },
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resultAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "files",
        "input_sha256",
        "job_id",
        "ordinal",
        "result_key",
        "result_path",
        "source_id",
        "source_ordinal",
        "work_order_sha256"
      ],
      "properties": {
        "directory": { "$ref": "#/$defs/directoryAfter" },
        "files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/fileAfter" }
        },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "job_id": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "result_key": { "$ref": "#/$defs/sha256" },
        "result_path": { "$ref": "#/$defs/absolutePath" },
        "source_id": { "type": "string", "minLength": 1 },
        "source_ordinal": { "type": "integer", "minimum": 1 },
        "work_order_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
