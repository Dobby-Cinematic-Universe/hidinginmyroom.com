{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/contextual-asr-batch-manifest-v1.json",
  "title": "Private paired contextual whisper.cpp ASR batch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation_version",
    "materializer",
    "batch_id",
    "identity_sha256",
    "batch_relative_path",
    "software",
    "glossary",
    "engine",
    "model",
    "inference",
    "profile",
    "output",
    "work_order_count",
    "totals",
    "work_orders",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "implementation_version": { "const": "0.1.0" },
    "materializer": { "const": "himr-contextual-asr-batch" },
    "batch_id": { "$ref": "#/$defs/batchId" },
    "identity_sha256": { "$ref": "#/$defs/sha256" },
    "batch_relative_path": {
      "type": "string",
      "pattern": "^batches/ctxasrbatch_[0-9a-f]{32}$"
    },
    "software": { "$ref": "#/$defs/software" },
    "glossary": { "$ref": "#/$defs/glossary" },
    "engine": { "$ref": "#/$defs/engine" },
    "model": { "$ref": "#/$defs/model" },
    "inference": { "$ref": "#/$defs/inference" },
    "profile": { "$ref": "#/$defs/profile" },
    "output": { "$ref": "#/$defs/output" },
    "work_order_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "totals": { "$ref": "#/$defs/totals" },
    "work_orders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/workOrder" }
    },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "batchId": {
      "type": "string",
      "pattern": "^ctxasrbatch_[0-9a-f]{32}$"
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1,
      "maxLength": 4096
    },
    "softwarePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count", "name"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "contract_version": { "type": "integer", "minimum": 1 },
        "implementation_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextual_batch",
        "asr_adapter",
        "engine_profiles",
        "catalog_free_validator"
      ],
      "properties": {
        "contextual_batch": { "$ref": "#/$defs/softwarePin" },
        "asr_adapter": { "$ref": "#/$defs/softwarePin" },
        "engine_profiles": { "$ref": "#/$defs/softwarePin" },
        "catalog_free_validator": { "$ref": "#/$defs/softwarePin" }
      }
    },
    "glossary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "raw_sha256",
        "canonical_sha256",
        "byte_count",
        "schema_version",
        "glossary_revision_id",
        "revision_sha256",
        "language",
        "term_count",
        "prompt_sha256",
        "terms_in_manifest"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "schema_version": { "const": 1 },
        "glossary_revision_id": { "$ref": "#/$defs/identifier" },
        "revision_sha256": { "$ref": "#/$defs/sha256" },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
        },
        "term_count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "terms_in_manifest": { "const": false }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "target", "configuration"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "target": { "type": "string", "minLength": 1, "maxLength": 256 },
        "configuration": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "expected_sha256",
        "byte_count",
        "version_label",
        "version_evidence",
        "build",
        "profile_id",
        "admission",
        "output_json_full_utf8_token_boundary_merge"
      ],
      "properties": {
        "executable": { "$ref": "#/$defs/path" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "version_label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "version_evidence": { "const": "source_revision_plus_executable_sha256" },
        "build": { "$ref": "#/$defs/build" },
        "profile_id": { "$ref": "#/$defs/identifier" },
        "admission": { "const": "current_new_batch" },
        "output_json_full_utf8_token_boundary_merge": { "const": true }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expected_sha256",
        "model_id",
        "name",
        "revision",
        "source",
        "license_label",
        "byte_count"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "model_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 500 },
        "source": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "license_label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "byte_count": { "type": "integer", "minimum": 1 }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "threads",
        "translate",
        "split_on_word",
        "best_of",
        "beam_size",
        "max_segment_characters",
        "word_threshold",
        "entropy_threshold",
        "logprob_threshold",
        "no_speech_threshold",
        "temperature",
        "temperature_increment",
        "no_fallback",
        "timeout_seconds"
      ],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
        },
        "threads": { "type": "integer", "minimum": 1, "maximum": 32 },
        "translate": { "const": false },
        "split_on_word": { "type": "boolean" },
        "best_of": { "type": "integer", "minimum": 1, "maximum": 20 },
        "beam_size": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_segment_characters": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "word_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "entropy_threshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "logprob_threshold": { "type": "number", "minimum": -100, "maximum": 0 },
        "no_speech_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 1 },
        "temperature_increment": { "type": "number", "minimum": 0, "maximum": 1 },
        "no_fallback": { "type": "boolean" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass_kind",
        "selection_basis",
        "baseline_policy",
        "pairing_policy",
        "text_selection",
        "confidence_calibration"
      ],
      "properties": {
        "pass_kind": { "const": "contextual_full_input_paired_pilot" },
        "selection_basis": {
          "const": "explicit_full_input_pilot_no_uncertainty_or_accuracy_claim"
        },
        "baseline_policy": { "const": "sealed_completed_current_raw_no_glossary" },
        "pairing_policy": {
          "const": "same_input_engine_model_window_inference_and_catalog_context;new_job_output_and_exact_neutral_glossary_only"
        },
        "text_selection": { "const": "none_machine_hypotheses_remain_separate" },
        "confidence_calibration": { "const": "none" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_root", "asr_output_root"],
      "properties": {
        "batch_root": { "$ref": "#/$defs/path" },
        "asr_output_root": { "$ref": "#/$defs/path" }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_byte_count",
        "input_duration_ms",
        "baseline_result_byte_count"
      ],
      "properties": {
        "input_byte_count": { "type": "integer", "minimum": 1, "maximum": 274877906944 },
        "input_duration_ms": { "type": "integer", "minimum": 1, "maximum": 604800000 },
        "baseline_result_byte_count": { "type": "integer", "minimum": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "path", "sha256", "byte_count"],
      "properties": {
        "artifact_kind": {
          "enum": ["transcript_normalized_json", "whispercpp_output_json_full"]
        },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 536870912 }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_path",
        "raw_sha256",
        "canonical_sha256",
        "byte_count",
        "job_id",
        "work_order_sha256",
        "recipe_id",
        "result_key",
        "processing_run_id",
        "artifacts"
      ],
      "properties": {
        "result_path": { "$ref": "#/$defs/path" },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "job_id": { "$ref": "#/$defs/identifier" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "recipe_id": { "$ref": "#/$defs/identifier" },
        "result_key": { "$ref": "#/$defs/sha256" },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count",
        "media_id",
        "artifact_id",
        "parent_processing_run_id",
        "duration_ms"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "media_id": { "$ref": "#/$defs/identifier" },
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "parent_processing_run_id": { "$ref": "#/$defs/identifier" },
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_ms", "duration_ms", "end_ms"],
      "properties": {
        "offset_ms": { "const": 0 },
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "end_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 }
      }
    },
    "catalogContext": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["recording_id", "rendition_id"],
          "properties": {
            "recording_id": { "$ref": "#/$defs/identifier" },
            "rendition_id": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/identifier" }
              ]
            }
          }
        }
      ]
    },
    "workOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "path",
        "job_id",
        "sha256",
        "canonical_sha256",
        "byte_count",
        "pair_projection_sha256",
        "baseline",
        "input",
        "window",
        "catalog_context"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "path": { "type": "string", "pattern": "^work-orders/[0-9]{6}\\.json$" },
        "job_id": { "type": "string", "pattern": "^asr-contextual-[0-9a-f]{32}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "pair_projection_sha256": { "$ref": "#/$defs/sha256" },
        "baseline": { "$ref": "#/$defs/baseline" },
        "input": { "$ref": "#/$defs/input" },
        "window": { "$ref": "#/$defs/window" },
        "catalog_context": { "$ref": "#/$defs/catalogContext" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_writes",
        "database_access",
        "identity_authority",
        "manifest_contains_glossary_terms",
        "manifest_contains_transcript_text",
        "network_access",
        "publication_authority",
        "review_authority",
        "transcript_preference_authority",
        "visibility"
      ],
      "properties": {
        "catalog_writes": { "const": false },
        "database_access": { "const": "none" },
        "identity_authority": { "const": "none" },
        "manifest_contains_glossary_terms": { "const": false },
        "manifest_contains_transcript_text": { "const": false },
        "network_access": {
          "const": "none_by_controller_external_engine_sandbox_required"
        },
        "publication_authority": { "const": "none" },
        "review_authority": { "const": "none" },
        "transcript_preference_authority": { "const": "none" },
        "visibility": { "const": "private" }
      }
    }
  }
}
