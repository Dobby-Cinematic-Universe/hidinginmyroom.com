{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/local-window-result-v1.json",
  "title": "HIMR local long-recording window result",
  "oneOf": [
    { "$ref": "#/$defs/planned" },
    { "$ref": "#/$defs/completed" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "stat": {
      "type": "object", "additionalProperties": false,
      "required": ["device", "inode", "byte_count", "mtime_ns"],
      "properties": {
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 0 },
        "byte_count": { "type": "integer", "minimum": 0 },
        "mtime_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceBase": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "expected_sha256", "byte_count", "media_id", "duration_ms", "acquisition_result_path", "acquisition_result_sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "media_id": { "type": "string", "pattern": "^media_sha256_[0-9a-f]{64}$" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "acquisition_result_path": { "type": "string", "pattern": "^/" },
        "acquisition_result_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceCompleted": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "expected_sha256", "byte_count", "media_id", "duration_ms", "acquisition_result_path", "acquisition_result_sha256", "stat_before", "stat_after", "unchanged"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "media_id": { "type": "string", "pattern": "^media_sha256_[0-9a-f]{64}$" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "acquisition_result_path": { "type": "string", "pattern": "^/" },
        "acquisition_result_sha256": { "$ref": "#/$defs/sha256" },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": { "$ref": "#/$defs/stat" },
        "unchanged": { "const": true }
      }
    },
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["window_id", "ordinal", "start_ms", "end_ms", "boundary", "is_partial_tail"],
      "properties": {
        "window_id": { "type": "string", "pattern": "^window_[0-9]{6}$" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 256 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "boundary": { "const": "half_open" },
        "is_partial_tail": { "type": "boolean" }
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "byte_count", "version_output_sha256", "version_first_line"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "version_output_sha256": { "$ref": "#/$defs/sha256" },
        "version_first_line": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "tools": {
      "type": "object", "additionalProperties": false, "required": ["ffmpeg", "ffprobe"],
      "properties": { "ffmpeg": { "$ref": "#/$defs/tool" }, "ffprobe": { "$ref": "#/$defs/tool" } }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "ffmpeg_threads", "audio_sample_rate_hz", "audio_channels", "audio_sample_format", "flac_compression_level", "proxy_width", "proxy_height", "proxy_fps", "proxy_video_codec", "proxy_preset", "proxy_crf", "proxy_audio_codec", "proxy_audio_bitrate", "video_stream_index", "audio_stream_index"],
      "properties": {
        "profile_id": { "const": "long-window-cpu-v1" },
        "ffmpeg_threads": { "type": "integer", "minimum": 1, "maximum": 32 },
        "audio_sample_rate_hz": { "const": 16000 },
        "audio_channels": { "const": 1 },
        "audio_sample_format": { "const": "s16" },
        "flac_compression_level": { "type": "integer", "minimum": 0, "maximum": 12 },
        "proxy_width": { "type": "integer", "minimum": 2, "maximum": 1280 },
        "proxy_height": { "type": "integer", "minimum": 2, "maximum": 1280 },
        "proxy_fps": { "type": "integer", "minimum": 1, "maximum": 60 },
        "proxy_video_codec": { "type": "string", "minLength": 1, "maxLength": 100 },
        "proxy_preset": { "type": "string", "minLength": 1, "maxLength": 100 },
        "proxy_crf": { "type": "integer", "minimum": 0, "maximum": 51 },
        "proxy_audio_codec": { "type": "string", "minLength": 1, "maxLength": 100 },
        "proxy_audio_bitrate": { "type": "string", "minLength": 1, "maxLength": 100 },
        "video_stream_index": { "type": ["integer", "null"], "minimum": 0 },
        "audio_stream_index": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_window_output_bytes", "free_space_floor_bytes", "timeout_seconds"],
      "properties": {
        "max_window_output_bytes": { "type": "integer", "minimum": 1 },
        "free_space_floor_bytes": { "type": "integer", "minimum": 0 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_ms", "video_stream_index", "audio_stream_index", "video", "audio"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 1 },
        "video_stream_index": { "type": ["integer", "null"], "minimum": 0 },
        "audio_stream_index": { "type": ["integer", "null"], "minimum": 0 },
        "video": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["codec_name", "width", "height", "pixel_format", "average_frame_rate"],
              "properties": {
                "codec_name": { "type": ["string", "null"] },
                "width": { "type": ["integer", "null"], "minimum": 0 },
                "height": { "type": ["integer", "null"], "minimum": 0 },
                "pixel_format": { "type": ["string", "null"] },
                "average_frame_rate": { "type": ["number", "null"], "minimum": 0 }
              }
            }
          ]
        },
        "audio": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["codec_name", "sample_rate_hz", "channels", "sample_format"],
              "properties": {
                "codec_name": { "type": ["string", "null"] },
                "sample_rate_hz": { "type": ["integer", "null"], "minimum": 0 },
                "channels": { "type": ["integer", "null"], "minimum": 0 },
                "sample_format": { "type": ["string", "null"] }
              }
            }
          ]
        }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_kind", "path", "sha256", "byte_count", "visibility", "normalized_probe"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "artifact_kind": { "enum": ["window_audio_16khz_mono_flac", "window_low_resolution_cfr_proxy"] },
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "visibility": { "const": "private" },
        "normalized_probe": { "$ref": "#/$defs/probe" }
      }
    },
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary", "source_start_ms", "source_end_ms", "artifact_zero_maps_to_source_ms", "coordinate_precision", "extraction_method", "byte_exact_source_fragment"],
      "properties": {
        "boundary": { "const": "half_open" },
        "source_start_ms": { "type": "integer", "minimum": 0 },
        "source_end_ms": { "type": "integer", "minimum": 1 },
        "artifact_zero_maps_to_source_ms": { "type": "integer", "minimum": 0 },
        "coordinate_precision": { "const": "integer_millisecond_contract" },
        "extraction_method": { "const": "ffmpeg_accurate_seek_transcode" },
        "byte_exact_source_fragment": { "const": false }
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["network_allowed", "credentials_allowed", "publication_authority", "identity_claims_allowed", "source_bytes_preserved", "remote_section_download"],
      "properties": {
        "network_allowed": { "const": false },
        "credentials_allowed": { "const": false },
        "publication_authority": { "const": "none" },
        "identity_claims_allowed": { "const": false },
        "source_bytes_preserved": { "const": true },
        "remote_section_download": { "const": false }
      }
    },
    "planned": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "implementation_version", "status", "dry_run", "job_id", "bundle_id", "work_order_sha256", "source", "window", "tools", "profile", "limits", "commands", "artifacts", "time_mapping", "safety", "result_path"],
      "properties": {
        "schema_version": { "const": 1 }, "implementation_version": { "type": "string" },
        "status": { "const": "planned" }, "dry_run": { "const": true },
        "job_id": { "$ref": "#/$defs/identifier" }, "bundle_id": { "type": "string", "pattern": "^windowbundle_[0-9a-f]{32}$" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" }, "source": { "$ref": "#/$defs/sourceBase" },
        "window": { "$ref": "#/$defs/window" }, "tools": { "$ref": "#/$defs/tools" }, "profile": { "$ref": "#/$defs/profile" },
        "limits": { "$ref": "#/$defs/limits" }, "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/command" } },
        "artifacts": { "type": "array", "maxItems": 0 }, "time_mapping": { "$ref": "#/$defs/mapping" }, "safety": { "$ref": "#/$defs/safety" }, "result_path": { "type": "null" }
      }
    },
    "completed": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "implementation_version", "status", "dry_run", "job_id", "bundle_id", "work_order_sha256", "source", "window", "tools", "profile", "limits", "commands", "artifacts", "time_mapping", "safety", "result_path"],
      "properties": {
        "schema_version": { "const": 1 }, "implementation_version": { "type": "string" },
        "status": { "const": "completed" }, "dry_run": { "const": false },
        "job_id": { "$ref": "#/$defs/identifier" }, "bundle_id": { "type": "string", "pattern": "^windowbundle_[0-9a-f]{32}$" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" }, "source": { "$ref": "#/$defs/sourceCompleted" },
        "window": { "$ref": "#/$defs/window" }, "tools": { "$ref": "#/$defs/tools" }, "profile": { "$ref": "#/$defs/profile" },
        "limits": { "$ref": "#/$defs/limits" }, "commands": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/command" } },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/artifact" } },
        "time_mapping": { "$ref": "#/$defs/mapping" }, "safety": { "$ref": "#/$defs/safety" }, "result_path": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
