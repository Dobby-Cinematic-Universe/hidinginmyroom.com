{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/sparse-frame-work-order-v1.json",
  "title": "HIMR sparse frame and OCR-candidate routing work order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "preprocess_result",
    "ffmpeg",
    "sampling",
    "limits",
    "output"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "preprocess_result": { "$ref": "#/$defs/fileReference" },
    "ffmpeg": { "$ref": "#/$defs/ffmpeg" },
    "sampling": { "$ref": "#/$defs/sampling" },
    "limits": { "$ref": "#/$defs/limits" },
    "output": { "$ref": "#/$defs/output" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "expected_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ffmpeg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expected_sha256",
        "expected_version_output_sha256"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "expected_version_output_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sceneSampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_frames", "offset_ms"],
      "properties": {
        "enabled": { "type": "boolean" },
        "max_frames": { "type": "integer", "minimum": 0, "maximum": 255 },
        "offset_ms": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "periodicSampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "interval_ms", "max_frames"],
      "properties": {
        "enabled": { "type": "boolean" },
        "interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "max_frames": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_recording_start",
        "scene_changes",
        "periodic",
        "min_separation_ms"
      ],
      "properties": {
        "include_recording_start": { "const": true },
        "scene_changes": { "$ref": "#/$defs/sceneSampling" },
        "periodic": { "$ref": "#/$defs/periodicSampling" },
        "min_separation_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_frames",
        "max_media_duration_ms",
        "max_input_pixels",
        "max_frame_bytes",
        "max_timestamp_drift_ms",
        "timeout_seconds_per_frame"
      ],
      "properties": {
        "max_frames": { "type": "integer", "minimum": 1, "maximum": 256 },
        "max_media_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800000
        },
        "max_input_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 921600
        },
        "max_frame_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "max_timestamp_drift_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "timeout_seconds_per_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
