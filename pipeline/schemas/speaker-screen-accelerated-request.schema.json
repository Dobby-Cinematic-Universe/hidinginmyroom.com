{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himr.local/schemas/speaker-screen-accelerated-request.schema.json",
  "title": "Explicit private resident CPU/CUDA speaker-screen request",
  "description": "Structure only. Runtime enforces isolation, pinned inputs/runtime, CUDA memory scope, and immutable recording-local proof. No execution or publication is authorized by schema validity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "work_orders", "state_root", "execution"],
  "properties": {
    "kind": {"const": "himr_resident_speaker_screen_request"},
    "schema_version": {"type": "integer", "const": 1},
    "state_root": {"$ref": "#/$defs/absolutePath"},
    "work_orders": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/fileBinding"}},
    "execution": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "device": {"enum": ["cpu", "cuda"], "default": "cpu"},
        "threads": {"type": "integer", "minimum": 1, "maximum": 2, "default": 1},
        "batch_size": {"type": "integer", "minimum": 1, "maximum": 16, "default": 8},
        "decode_prefetch": {"type": "integer", "minimum": 1, "maximum": 2, "default": 2,
          "description": "Number of spawned CPU decoder workers. One fixed future probe batch may overlap inference."},
        "max_run_seconds": {"type": "integer", "minimum": 10, "maximum": 86400, "default": 3600},
        "cuda_memory_fraction": {"type": "number", "minimum": 0.1, "maximum": 0.75, "default": 0.5},
        "gpu_uuid": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^GPU-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$(?![\\s\\S])"}], "default": null},
        "host_memory_max_bytes": {"type": "integer", "const": 4294967296, "default": 4294967296}
      },
      "allOf": [{
        "if": {"required": ["device"], "properties": {"device": {"const": "cuda"}}},
        "then": {"required": ["gpu_uuid"], "properties": {"gpu_uuid": {"type": "string"}}},
        "else": {"properties": {"gpu_uuid": {"type": "null"}}}
      }]
    }
  },
  "$defs": {
    "absolutePath": {"type": "string", "maxLength": 4096,
      "pattern": "^/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+)*$(?![\\s\\S])"},
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/absolutePath"}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
