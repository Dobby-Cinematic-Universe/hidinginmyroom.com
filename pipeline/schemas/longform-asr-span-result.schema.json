{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/longform-asr-span-result.schema.json",
  "title": "HIMR long-form ASR span result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "implementation_version", "status", "work_order", "plan", "recording", "span", "execution_lineage", "engine", "execution", "coverage", "dispositions", "artifacts", "policy", "identity_sha256", "result_id"],
  "properties": {
    "kind": {"const": "himr_longform_asr_span_result"},
    "schema_version": {"const": 1},
    "implementation_version": {"const": "0.1.0"},
    "status": {"const": "completed"},
    "work_order": {"$ref": "#/$defs/workOrderBinding"},
    "plan": {"$ref": "#/$defs/planBinding"},
    "recording": {
      "type": "object", "additionalProperties": false,
      "required": ["recording_id", "media_id", "input_sha256", "total_samples"],
      "properties": {
        "recording_id": {"$ref": "#/$defs/identifier"},
        "media_id": {"$ref": "#/$defs/identifier"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "total_samples": {"type": "integer", "minimum": 1}
      }
    },
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["span_id", "ordinal", "analysis", "core", "core_local"],
      "properties": {
        "span_id": {"type": "string", "pattern": "^lfspan_[0-9a-f]{32}$"},
        "ordinal": {"type": "integer", "minimum": 0},
        "analysis": {"$ref": "#/$defs/interval"},
        "core": {"$ref": "#/$defs/interval"},
        "core_local": {"$ref": "#/$defs/interval"}
      }
    },
    "execution_lineage": {"$ref": "#/$defs/executionLineage"},
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["library", "library_version", "model_revision", "model_identity_sha256", "input_decoder"],
      "properties": {
        "library": {"type": "string", "minLength": 1, "maxLength": 128},
        "library_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_revision": {"type": "string", "minLength": 1, "maxLength": 512},
        "model_identity_sha256": {"$ref": "#/$defs/sha256"},
        "input_decoder": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "executable_path", "executable_sha256", "execution_mode", "persistent_audio_chunks"],
          "properties": {
            "kind": {"$ref": "#/$defs/identifier"},
            "executable_path": {"type": ["string", "null"], "maxLength": 4096},
            "executable_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
            "execution_mode": {"$ref": "#/$defs/identifier"},
            "persistent_audio_chunks": {"const": false}
          }
        }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "started_at", "completed_at", "wall_seconds", "engine_call_count", "input_mode", "persistent_audio_chunks_created"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/identifier"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "wall_seconds": {"type": "number", "minimum": 0},
        "engine_call_count": {"const": 1},
        "input_mode": {"enum": ["parent_path_once", "ephemeral_in_memory_logical_span"]},
        "persistent_audio_chunks_created": {"const": false}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis_start_sample", "analysis_end_sample", "analysis_sample_count", "core_start_sample", "core_end_sample", "core_sample_count", "coordinate_system", "engine_reported_analysis_complete"],
      "properties": {
        "analysis_start_sample": {"type": "integer", "minimum": 0},
        "analysis_end_sample": {"type": "integer", "minimum": 1},
        "analysis_sample_count": {"type": "integer", "minimum": 1},
        "core_start_sample": {"type": "integer", "minimum": 0},
        "core_end_sample": {"type": "integer", "minimum": 1},
        "core_sample_count": {"type": "integer", "minimum": 1},
        "coordinate_system": {"const": "parent_media_16000hz_half_open_samples"},
        "engine_reported_analysis_complete": {"const": true}
      }
    },
    "dispositions": {
      "type": "object", "additionalProperties": false,
      "required": ["segment_counts", "unknown_word_timing_count", "ownership_decision"],
      "properties": {
        "segment_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["core_owned", "crosses_both_core_boundaries", "crosses_left_core_boundary", "crosses_right_core_boundary", "left_context_only", "right_context_only"],
          "properties": {
            "core_owned": {"type": "integer", "minimum": 0},
            "crosses_both_core_boundaries": {"type": "integer", "minimum": 0},
            "crosses_left_core_boundary": {"type": "integer", "minimum": 0},
            "crosses_right_core_boundary": {"type": "integer", "minimum": 0},
            "left_context_only": {"type": "integer", "minimum": 0},
            "right_context_only": {"type": "integer", "minimum": 0}
          }
        },
        "unknown_word_timing_count": {"type": "integer", "minimum": 0},
        "ownership_decision": {"const": "deferred_to_downstream_assembler"}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_kind", "path", "sha256", "byte_count", "identity_sha256"],
        "properties": {
          "artifact_kind": {"const": "longform_span_transcript_json"},
          "path": {"type": "string", "pattern": "^/", "maxLength": 4096},
          "sha256": {"$ref": "#/$defs/sha256"},
          "byte_count": {"type": "integer", "minimum": 1},
          "identity_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "policy": {
      "const": {
        "visibility": "private",
        "machine_generated": true,
        "scores_calibrated": false,
        "network_access": false,
        "persistent_audio_chunks": false,
        "input_authority": "immutable_parent_audio_logical_view_only",
        "coordinate_authority": "exact_16000hz_half_open_samples",
        "overlap_ownership_authority": "downstream_assembler_only",
        "publication_authority": "none",
        "catalogue_mutation_authority": "none",
        "identity_authority": "none",
        "biometric_authority": "none",
        "wiki_authority": "none",
        "archive_authority": "none",
        "deletion_authority": "none"
      }
    },
    "identity_sha256": {"$ref": "#/$defs/sha256"},
    "result_id": {"type": "string", "pattern": "^longasrresult1_[0-9a-f]{32}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "workOrderBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["work_order_id", "identity_sha256"],
      "properties": {"work_order_id": {"type": "string", "pattern": "^longasrwo1_[0-9a-f]{32}$"}, "identity_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "planBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "identity_sha256"],
      "properties": {"plan_id": {"type": "string", "pattern": "^lfplan_[0-9a-f]{32}$"}, "identity_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["start_sample", "end_sample", "sample_count"],
      "properties": {
        "start_sample": {"type": "integer", "minimum": 0},
        "end_sample": {"type": "integer", "minimum": 1},
        "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "executionLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longform_scope_status", "production_profile", "runtime_admission", "model"],
      "properties": {
        "longform_scope_status": {"const": "candidate_unsoaked"},
        "production_profile": {
          "type": "object", "additionalProperties": false,
          "required": ["profile_id", "identity_sha256", "physical_sha256"],
          "properties": {
            "profile_id": {"$ref": "#/$defs/identifier"},
            "identity_sha256": {"$ref": "#/$defs/sha256"},
            "physical_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "runtime_admission": {
          "type": "object", "additionalProperties": false,
          "required": ["receipt_id", "identity_sha256", "physical_sha256", "status"],
          "properties": {
            "receipt_id": {"$ref": "#/$defs/identifier"},
            "identity_sha256": {"$ref": "#/$defs/sha256"},
            "physical_sha256": {"$ref": "#/$defs/sha256"},
            "status": {"enum": ["candidate", "admitted"]}
          }
        },
        "model": {
          "type": "object", "additionalProperties": false,
          "required": ["repository", "revision", "identity_sha256"],
          "properties": {
            "repository": {"type": "string", "minLength": 1, "maxLength": 512},
            "revision": {"type": "string", "minLength": 1, "maxLength": 512},
            "identity_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
