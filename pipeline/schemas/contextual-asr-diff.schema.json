{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/contextual-asr-diff-v1.json",
  "title": "HIMR text-private contextual ASR diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation_version",
    "comparator",
    "pair_id",
    "identity_sha256",
    "baseline",
    "contextual",
    "glossary",
    "alignment",
    "summary",
    "changed_block_metrics",
    "policy"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "implementation_version": { "const": "0.1.0" },
    "comparator": { "const": "himr-contextual-asr-text-private-diff" },
    "pair_id": { "type": "string", "pattern": "^contextual_asr_diff_[0-9a-f]{32}$" },
    "identity_sha256": { "$ref": "#/$defs/sha256" },
    "baseline": { "$ref": "#/$defs/resultBinding" },
    "contextual": { "$ref": "#/$defs/resultBinding" },
    "glossary": { "$ref": "#/$defs/glossary" },
    "alignment": { "$ref": "#/$defs/alignment" },
    "summary": { "$ref": "#/$defs/summary" },
    "changed_block_metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/changedBlock" }
    },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "nonnegative": { "type": "integer", "minimum": 0 },
    "nullableInteger": { "oneOf": [{ "type": "null" }, { "type": "integer" }] },
    "nullableScore": {
      "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 1 }]
    },
    "resultBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_path", "result_sha256", "result_byte_count", "result_key", "processing_run_id"],
      "properties": {
        "result_path": { "type": "string", "pattern": "^/" },
        "result_sha256": { "$ref": "#/$defs/sha256" },
        "result_byte_count": { "type": "integer", "minimum": 1 },
        "result_key": { "$ref": "#/$defs/sha256" },
        "processing_run_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "glossary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "glossary_revision_id", "revision", "language", "sha256", "byte_count", "prompt_sha256", "term_count"],
      "properties": {
        "schema_version": { "const": 1 },
        "glossary_revision_id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "term_count": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "termDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "baseline_count", "contextual_count", "delta"],
      "properties": {
        "term": { "type": "string", "minLength": 1, "maxLength": 80 },
        "baseline_count": { "$ref": "#/$defs/nonnegative" },
        "contextual_count": { "$ref": "#/$defs/nonnegative" },
        "delta": { "type": "integer" }
      }
    },
    "aggregateTermDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "baseline_count_in_changed_blocks", "contextual_count_in_changed_blocks", "delta"],
      "properties": {
        "term": { "type": "string", "minLength": 1, "maxLength": 80 },
        "baseline_count_in_changed_blocks": { "$ref": "#/$defs/nonnegative" },
        "contextual_count_in_changed_blocks": { "$ref": "#/$defs/nonnegative" },
        "delta": { "type": "integer" }
      }
    },
    "scoreSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "minimum", "mean", "median"],
      "properties": {
        "count": { "$ref": "#/$defs/nonnegative" },
        "minimum": { "$ref": "#/$defs/nullableScore" },
        "mean": { "$ref": "#/$defs/nullableScore" },
        "median": { "$ref": "#/$defs/nullableScore" }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_system", "window_start_ms", "window_end_ms", "block_ms", "token_assignment", "untimed_token_assignment", "segmentation_independent_accuracy_claim"],
      "properties": {
        "coordinate_system": { "const": "input_media_milliseconds" },
        "window_start_ms": { "$ref": "#/$defs/nonnegative" },
        "window_end_ms": { "type": "integer", "minimum": 1 },
        "block_ms": { "type": "integer", "minimum": 5000, "maximum": 120000 },
        "token_assignment": { "const": "lexical_token_midpoint_fixed_half_open_block" },
        "untimed_token_assignment": { "const": "parent_segment_midpoint" },
        "segmentation_independent_accuracy_claim": { "const": false }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_blocks", "changed_blocks", "unchanged_blocks", "total_character_edit_distance", "empty_nonempty_transitions", "maximum_absolute_first_token_start_drift_ms", "maximum_absolute_last_token_end_drift_ms", "baseline_lexical_tokens", "contextual_lexical_tokens", "baseline_untimed_lexical_tokens", "contextual_untimed_lexical_tokens", "glossary_term_counts"],
      "properties": {
        "total_blocks": { "$ref": "#/$defs/nonnegative" },
        "changed_blocks": { "$ref": "#/$defs/nonnegative" },
        "unchanged_blocks": { "$ref": "#/$defs/nonnegative" },
        "total_character_edit_distance": { "$ref": "#/$defs/nonnegative" },
        "empty_nonempty_transitions": { "$ref": "#/$defs/nonnegative" },
        "maximum_absolute_first_token_start_drift_ms": { "$ref": "#/$defs/nonnegative" },
        "maximum_absolute_last_token_end_drift_ms": { "$ref": "#/$defs/nonnegative" },
        "baseline_lexical_tokens": { "$ref": "#/$defs/nonnegative" },
        "contextual_lexical_tokens": { "$ref": "#/$defs/nonnegative" },
        "baseline_untimed_lexical_tokens": { "$ref": "#/$defs/nonnegative" },
        "contextual_untimed_lexical_tokens": { "$ref": "#/$defs/nonnegative" },
        "glossary_term_counts": { "type": "array", "items": { "$ref": "#/$defs/aggregateTermDelta" } }
      }
    },
    "changedBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_index", "start_ms", "end_ms", "baseline_character_count", "contextual_character_count", "baseline_lexical_token_count", "contextual_lexical_token_count", "character_edit_distance", "distance_over_max_characters", "empty_transition", "baseline_raw_score_summary", "contextual_raw_score_summary", "baseline_untimed_lexical_tokens", "contextual_untimed_lexical_tokens", "baseline_max_repeated_word_run", "contextual_max_repeated_word_run", "first_timed_token_start_drift_ms", "last_timed_token_end_drift_ms", "glossary_term_counts"],
      "properties": {
        "block_index": { "$ref": "#/$defs/nonnegative" },
        "start_ms": { "$ref": "#/$defs/nonnegative" },
        "end_ms": { "type": "integer", "minimum": 1 },
        "baseline_character_count": { "$ref": "#/$defs/nonnegative" },
        "contextual_character_count": { "$ref": "#/$defs/nonnegative" },
        "baseline_lexical_token_count": { "$ref": "#/$defs/nonnegative" },
        "contextual_lexical_token_count": { "$ref": "#/$defs/nonnegative" },
        "character_edit_distance": { "$ref": "#/$defs/nonnegative" },
        "distance_over_max_characters": { "type": "number", "minimum": 0, "maximum": 1 },
        "empty_transition": { "enum": ["neither_empty", "baseline_empty_contextual_nonempty", "baseline_nonempty_contextual_empty"] },
        "baseline_raw_score_summary": { "$ref": "#/$defs/scoreSummary" },
        "contextual_raw_score_summary": { "$ref": "#/$defs/scoreSummary" },
        "baseline_untimed_lexical_tokens": { "$ref": "#/$defs/nonnegative" },
        "contextual_untimed_lexical_tokens": { "$ref": "#/$defs/nonnegative" },
        "baseline_max_repeated_word_run": { "$ref": "#/$defs/nonnegative" },
        "contextual_max_repeated_word_run": { "$ref": "#/$defs/nonnegative" },
        "first_timed_token_start_drift_ms": { "$ref": "#/$defs/nullableInteger" },
        "last_timed_token_end_drift_ms": { "$ref": "#/$defs/nullableInteger" },
        "glossary_term_counts": { "type": "array", "items": { "$ref": "#/$defs/termDelta" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "transcript_text_included", "decoder_scores_calibrated", "accuracy_claimed", "improvement_claimed", "preferred_revision_selected", "human_review_claimed", "automatic_merge_allowed", "publication_authority"],
      "properties": {
        "visibility": { "const": "private" },
        "transcript_text_included": { "const": false },
        "decoder_scores_calibrated": { "const": false },
        "accuracy_claimed": { "const": false },
        "improvement_claimed": { "const": false },
        "preferred_revision_selected": { "const": false },
        "human_review_claimed": { "const": false },
        "automatic_merge_allowed": { "const": false },
        "publication_authority": { "const": "none" }
      }
    }
  }
}
