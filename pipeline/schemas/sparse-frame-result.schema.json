{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/sparse-frame-result-v1.json",
  "title": "HIMR sparse frame and OCR-candidate routing result",
  "oneOf": [
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "zonedTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode", "byte_count", "mtime_ns"],
      "properties": {
        "device": { "type": "integer" },
        "inode": { "type": "integer", "minimum": 0 },
        "byte_count": { "type": "integer", "minimum": 0 },
        "mtime_ns": { "type": "integer" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stat" }]
        },
        "unchanged": { "type": ["boolean", "null"] }
      }
    },
    "preprocessObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged",
        "processing_run_id",
        "implementation_version"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stat" }]
        },
        "unchanged": { "type": ["boolean", "null"] },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "implementation_version": { "type": "string", "minLength": 1 }
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "numerator", "denominator", "decimal"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "numerator": { "type": "integer" },
        "denominator": { "type": "integer", "minimum": 1 },
        "decimal": { "type": "number" }
      }
    },
    "proxyProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video_stream_index",
        "width",
        "height",
        "pixel_format",
        "average_frame_rate",
        "duration_ms",
        "start_ms",
        "video_start_ms"
      ],
      "properties": {
        "video_stream_index": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1, "maximum": 1280 },
        "height": { "type": "integer", "minimum": 1, "maximum": 1280 },
        "pixel_format": { "type": ["string", "null"] },
        "average_frame_rate": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/rational" }]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800000
        },
        "start_ms": { "type": ["integer", "null"] },
        "video_start_ms": { "type": ["integer", "null"] }
      }
    },
    "proxyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged",
        "media_id",
        "artifact_id",
        "parent_processing_run_id",
        "probe"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stat" }]
        },
        "unchanged": { "type": ["boolean", "null"] },
        "media_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "parent_processing_run_id": { "$ref": "#/$defs/identifier" },
        "probe": { "$ref": "#/$defs/proxyProbe" }
      }
    },
    "ffmpegObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged",
        "version",
        "version_output",
        "version_output_sha256"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stat" }]
        },
        "unchanged": { "type": ["boolean", "null"] },
        "version": { "type": "string", "minLength": 1 },
        "version_output": { "type": "string", "minLength": 1 },
        "version_output_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sceneSampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_frames", "offset_ms"],
      "properties": {
        "enabled": { "type": "boolean" },
        "max_frames": { "type": "integer", "minimum": 0, "maximum": 255 },
        "offset_ms": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "periodicSampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "interval_ms", "max_frames"],
      "properties": {
        "enabled": { "type": "boolean" },
        "interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "max_frames": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_recording_start",
        "scene_changes",
        "periodic",
        "min_separation_ms"
      ],
      "properties": {
        "include_recording_start": { "const": true },
        "scene_changes": { "$ref": "#/$defs/sceneSampling" },
        "periodic": { "$ref": "#/$defs/periodicSampling" },
        "min_separation_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "selectionFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "requested_timestamp_ms",
        "selection_reason_codes",
        "source_scene_timestamps_ms"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 255 },
        "requested_timestamp_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "selection_reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "FRAME_RECORDING_START",
              "FRAME_SCENE_CHANGE",
              "FRAME_PERIODIC_COVERAGE"
            ]
          }
        },
        "source_scene_timestamps_ms": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 604800000
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "timeline_origin_ms"],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800000
        },
        "timeline_origin_ms": { "const": 0 }
      }
    },
    "candidateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preprocess_scene_changes",
        "eligible_scene_candidates",
        "retained_scene_candidates",
        "periodic_candidates",
        "retained_periodic_candidates",
        "merged_candidates",
        "planned_frames"
      ],
      "properties": {
        "preprocess_scene_changes": { "type": "integer", "minimum": 0 },
        "eligible_scene_candidates": { "type": "integer", "minimum": 0 },
        "retained_scene_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "periodic_candidates": { "type": "integer", "minimum": 0 },
        "retained_periodic_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "merged_candidates": { "type": "integer", "minimum": 0 },
        "planned_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameters",
        "coverage",
        "candidate_counts",
        "limit_reason_codes",
        "planned_frames"
      ],
      "properties": {
        "parameters": { "$ref": "#/$defs/sampling" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "candidate_counts": { "$ref": "#/$defs/candidateCounts" },
        "limit_reason_codes": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SCENE_CANDIDATES_UNIFORMLY_CAPPED",
              "PERIODIC_CANDIDATES_UNIFORMLY_CAPPED",
              "NEARBY_CANDIDATES_MERGED"
            ]
          }
        },
        "planned_frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/selectionFrame" }
        }
      }
    },
    "processingRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_run_id",
        "stage",
        "implementation_version",
        "parameters_json",
        "environment_json",
        "started_at",
        "completed_at",
        "status",
        "error_text"
      ],
      "properties": {
        "processing_run_id": {
          "type": "string",
          "pattern": "^run_sparse_frames_[0-9a-f]{32}$"
        },
        "stage": { "const": "sparse_frame_router" },
        "implementation_version": { "type": "string", "minLength": 1 },
        "parameters_json": { "type": "string", "minLength": 1 },
        "environment_json": { "$ref": "#/$defs/environment" },
        "started_at": { "$ref": "#/$defs/zonedTime" },
        "completed_at": { "$ref": "#/$defs/zonedTime" },
        "status": { "enum": ["queued", "completed"] },
        "error_text": { "type": "null" }
      }
    },
    "toolPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ffmpeg"],
      "properties": {
        "ffmpeg": { "type": "string", "pattern": "^/" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "cpu_only", "network", "tool_paths"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "cpu_only": { "const": true },
        "network": { "const": "not_used" },
        "tool_paths": { "$ref": "#/$defs/toolPaths" }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pts",
        "duration_pts",
        "time_base_numerator",
        "time_base_denominator",
        "timestamp_us",
        "timestamp_ms",
        "duration_us"
      ],
      "properties": {
        "pts": { "type": "integer", "minimum": 0 },
        "duration_pts": { "type": "integer", "minimum": 1 },
        "time_base_numerator": { "type": "integer", "minimum": 1 },
        "time_base_denominator": { "type": "integer", "minimum": 1 },
        "timestamp_us": { "type": "integer", "minimum": 0 },
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "duration_us": { "type": "integer", "minimum": 1 }
      }
    },
    "ocrRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "evaluation_state",
        "text_presence",
        "reason_codes",
        "warning"
      ],
      "properties": {
        "route": { "const": "queue_candidate" },
        "evaluation_state": { "const": "not_evaluated" },
        "text_presence": { "const": "unknown" },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "OCR_CANDIDATE_RECORDING_START",
              "OCR_CANDIDATE_SCENE_CHANGE",
              "OCR_CANDIDATE_PERIODIC_COVERAGE"
            ]
          }
        },
        "warning": { "type": "string", "minLength": 1 }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "ordinal",
        "requested_timestamp_ms",
        "selection_reason_codes",
        "source_scene_timestamps_ms",
        "timestamp",
        "timestamp_drift_ms",
        "artifact_id",
        "ocr_routing"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "pattern": "^frame_[0-9a-f]{32}$"
        },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 255 },
        "requested_timestamp_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "selection_reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "FRAME_RECORDING_START",
              "FRAME_SCENE_CHANGE",
              "FRAME_PERIODIC_COVERAGE"
            ]
          }
        },
        "source_scene_timestamps_ms": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 604800000
          }
        },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "timestamp_drift_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "ocr_routing": { "$ref": "#/$defs/ocrRouting" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "pixel_format",
        "bit_depth",
        "color_type",
        "interlaced"
      ],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 1280 },
        "height": { "type": "integer", "minimum": 1, "maximum": 1280 },
        "pixel_format": { "const": "rgb24" },
        "bit_depth": { "const": 8 },
        "color_type": { "const": "truecolor" },
        "interlaced": { "const": false }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "processing_run_id",
        "artifact_kind",
        "ordinal",
        "storage_uri",
        "path",
        "sha256",
        "byte_count",
        "schema_version",
        "visibility",
        "media_kind",
        "mime_type",
        "image"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "processing_run_id": {
          "type": "string",
          "pattern": "^run_sparse_frames_[0-9a-f]{32}$"
        },
        "artifact_kind": { "const": "sparse_frame_png" },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 255 },
        "storage_uri": { "type": "string", "pattern": "^file://" },
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "schema_version": { "const": 1 },
        "visibility": { "const": "private" },
        "media_kind": { "const": "image" },
        "mime_type": { "const": "image/png" },
        "image": { "$ref": "#/$defs/image" }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": { "type": "string" }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "status": { "const": "planned" },
                "dry_run": { "const": true },
                "processing_run": {
                  "properties": { "status": { "const": "queued" } }
                },
                "frames": { "maxItems": 0 },
                "artifacts": { "maxItems": 0 }
              }
            },
            {
              "properties": {
                "status": { "const": "completed" },
                "dry_run": { "const": false },
                "processing_run": {
                  "properties": { "status": { "const": "completed" } }
                },
                "commands": { "minItems": 1 },
                "frames": { "minItems": 1 },
                "artifacts": { "minItems": 1 }
              }
            }
          ]
        }
      ],
      "required": [
        "schema_version",
        "job_id",
        "status",
        "dry_run",
        "work_order_sha256",
        "recipe_id",
        "recipe_sha256",
        "result_key",
        "processing_run",
        "preprocess_result",
        "input_proxy",
        "ffmpeg",
        "selection",
        "commands",
        "frames",
        "artifacts",
        "result_path",
        "duration_ms",
        "errors"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "status": { "enum": ["planned", "completed"] },
        "dry_run": { "type": "boolean" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "recipe_id": {
          "type": "string",
          "pattern": "^recipe_sparse_frames_[0-9a-f]{32}$"
        },
        "recipe_sha256": { "$ref": "#/$defs/sha256" },
        "result_key": { "$ref": "#/$defs/sha256" },
        "processing_run": { "$ref": "#/$defs/processingRun" },
        "preprocess_result": { "$ref": "#/$defs/preprocessObservation" },
        "input_proxy": { "$ref": "#/$defs/proxyInput" },
        "ffmpeg": { "$ref": "#/$defs/ffmpegObservation" },
        "selection": { "$ref": "#/$defs/selection" },
        "commands": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/command" }
        },
        "frames": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/frame" }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "result_path": { "type": "string", "pattern": "^/" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array", "maxItems": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "job_id", "error", "errors"],
      "properties": {
        "schema_version": { "const": 1 },
        "status": { "const": "failed" },
        "job_id": { "type": ["string", "null"] },
        "error": { "$ref": "#/$defs/error" },
        "errors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/error" }
        }
      }
    }
  }
}
