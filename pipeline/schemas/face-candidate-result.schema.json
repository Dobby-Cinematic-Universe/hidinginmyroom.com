{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/face-candidate-result.schema.json",
  "title": "Private YuNet/SFace face-candidate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation_version",
    "stage",
    "status",
    "dry_run",
    "job_id",
    "work_order_sha256",
    "result_key",
    "result_path",
    "implementation",
    "policy",
    "runtime",
    "models",
    "parameters",
    "frames",
    "comparisons",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "implementation_version": { "type": "string" },
    "stage": { "const": "face_candidate_yunet_sface" },
    "status": { "const": "completed" },
    "dry_run": { "const": false },
    "job_id": { "$ref": "#/$defs/id" },
    "work_order_sha256": { "$ref": "#/$defs/sha256" },
    "result_key": { "$ref": "#/$defs/sha256" },
    "result_path": { "$ref": "#/$defs/absolutePath" },
    "implementation": { "$ref": "#/$defs/implementation" },
    "policy": { "$ref": "#/$defs/policy" },
    "runtime": { "$ref": "#/$defs/runtimeResult" },
    "models": { "$ref": "#/$defs/modelsResult" },
    "parameters": { "$ref": "#/$defs/parameters" },
    "frames": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/frameResult" }
    },
    "comparisons": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/comparisonResult" }
    },
    "authority": { "$ref": "#/$defs/authority" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/" },
    "fileObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "storage_uri", "sha256", "byte_count", "visibility"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "storage_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^file:///"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "visibility": { "const": "private" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count", "implementation_version"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "implementation_version": { "type": "string" }
      }
    },
    "pythonRuntimeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "storage_uri",
        "sha256",
        "byte_count",
        "visibility",
        "expected_version"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "storage_uri": { "type": "string", "format": "uri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "visibility": { "const": "private" },
        "expected_version": { "type": "string" }
      }
    },
    "packageRuntimeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wheel", "binary", "expected_version"],
      "properties": {
        "wheel": { "$ref": "#/$defs/fileObservation" },
        "binary": { "$ref": "#/$defs/fileObservation" },
        "expected_version": { "type": "string" }
      }
    },
    "opencvRuntimeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wheel",
        "binary",
        "expected_version",
        "expected_build_information_sha256"
      ],
      "properties": {
        "wheel": { "$ref": "#/$defs/fileObservation" },
        "binary": { "$ref": "#/$defs/fileObservation" },
        "expected_version": { "type": "string" },
        "expected_build_information_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "opencv_version",
        "numpy_version",
        "opencv_build_information_sha256",
        "opencv_threads",
        "opencl_enabled",
        "network_used"
      ],
      "properties": {
        "python_version": { "type": "string" },
        "opencv_version": { "type": "string" },
        "numpy_version": { "type": "string" },
        "opencv_build_information_sha256": { "$ref": "#/$defs/sha256" },
        "opencv_threads": { "const": 1 },
        "opencl_enabled": { "const": false },
        "network_used": { "const": false }
      }
    },
    "runtimeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_root", "python", "opencv", "numpy", "observation"],
      "properties": {
        "module_root": { "$ref": "#/$defs/absolutePath" },
        "python": { "$ref": "#/$defs/pythonRuntimeResult" },
        "opencv": { "$ref": "#/$defs/opencvRuntimeResult" },
        "numpy": { "$ref": "#/$defs/packageRuntimeResult" },
        "observation": { "$ref": "#/$defs/runtimeObservation" }
      }
    },
    "modelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "license",
        "upstream_url",
        "upstream_commit",
        "license_expression"
      ],
      "properties": {
        "artifact": { "$ref": "#/$defs/fileObservation" },
        "license": { "$ref": "#/$defs/fileObservation" },
        "upstream_url": { "type": "string", "format": "uri" },
        "upstream_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license_expression": { "enum": ["MIT", "Apache-2.0"] }
      }
    },
    "modelsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yunet", "sface"],
      "properties": {
        "yunet": { "$ref": "#/$defs/modelResult" },
        "sface": { "$ref": "#/$defs/modelResult" }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score_threshold",
        "nms_threshold",
        "top_k",
        "threads",
        "max_frames",
        "max_detections_per_frame",
        "comparison_metric",
        "embedding_format"
      ],
      "properties": {
        "score_threshold": { "type": "number" },
        "nms_threshold": { "type": "number" },
        "top_k": { "type": "integer" },
        "threads": { "const": 1 },
        "max_frames": { "type": "integer", "minimum": 1, "maximum": 32 },
        "max_detections_per_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "comparison_metric": { "const": "cosine_similarity_raw_v1" },
        "embedding_format": { "const": "float32_little_endian_v1" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "network_allowed",
        "publication_authority",
        "identity_decision_allowed",
        "human_review_required",
        "calibration_state",
        "calibrated_probability",
        "source_context_is_identity"
      ],
      "properties": {
        "visibility": { "const": "private" },
        "network_allowed": { "const": false },
        "publication_authority": { "const": "none" },
        "identity_decision_allowed": { "const": false },
        "human_review_required": { "const": true },
        "calibration_state": { "const": "not_calibrated" },
        "calibrated_probability": { "type": "null" },
        "source_context_is_identity": { "const": false }
      }
    },
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_role",
        "source_native_id",
        "source_url",
        "source_context_label",
        "basis",
        "human_identity_attestation"
      ],
      "properties": {
        "context_role": {
          "enum": ["source_context_anchor", "comparison_query"]
        },
        "source_native_id": { "$ref": "#/$defs/id" },
        "source_url": { "type": "string", "format": "uri" },
        "source_context_label": { "type": ["string", "null"] },
        "basis": { "type": "string" },
        "human_identity_attestation": { "const": false }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "path",
        "storage_uri",
        "sha256",
        "byte_count",
        "visibility",
        "dimension",
        "dtype",
        "byte_order",
        "l2_norm"
      ],
      "properties": {
        "artifact_kind": { "const": "sface_embedding_float32_little_endian" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "storage_uri": { "type": "string", "format": "uri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "visibility": { "const": "private" },
        "dimension": { "type": "integer", "minimum": 16 },
        "dtype": { "const": "float32" },
        "byte_order": { "const": "little" },
        "l2_norm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "path",
        "storage_uri",
        "sha256",
        "byte_count",
        "visibility"
      ],
      "properties": {
        "artifact_kind": { "const": "aligned_face_crop_png" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "storage_uri": { "type": "string", "format": "uri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "visibility": { "const": "private" }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detection_id",
        "ordinal",
        "bounding_box_pixels",
        "landmarks_pixels",
        "raw_detector_score",
        "detector_score_semantics",
        "calibration_state",
        "calibrated_probability",
        "identity_label",
        "identity_decision",
        "aligned_crop",
        "embedding"
      ],
      "properties": {
        "detection_id": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "bounding_box_pixels": { "$ref": "#/$defs/box" },
        "landmarks_pixels": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/point" }
        },
        "raw_detector_score": { "type": "number" },
        "detector_score_semantics": {
          "const": "raw_model_score_not_calibrated_probability"
        },
        "calibration_state": { "const": "not_calibrated" },
        "calibrated_probability": { "type": "null" },
        "identity_label": { "type": "null" },
        "identity_decision": { "const": false },
        "aligned_crop": { "$ref": "#/$defs/crop" },
        "embedding": { "$ref": "#/$defs/embedding" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "format"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "format": { "const": "png" }
      }
    },
    "frameResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "ordinal",
        "input",
        "image",
        "requested_timestamp_ms",
        "observed_timestamp_ms",
        "timestamp_drift_ms",
        "coordinate_system",
        "source_context",
        "detections",
        "comparison_eligibility",
        "identity_decision"
      ],
      "properties": {
        "frame_id": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "input": { "$ref": "#/$defs/fileObservation" },
        "image": { "$ref": "#/$defs/image" },
        "requested_timestamp_ms": { "type": "integer", "minimum": 0 },
        "observed_timestamp_ms": { "type": "integer", "minimum": 0 },
        "timestamp_drift_ms": { "type": "integer" },
        "coordinate_system": { "$ref": "#/$defs/id" },
        "source_context": { "$ref": "#/$defs/sourceContext" },
        "detections": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/detection" }
        },
        "comparison_eligibility": {
          "enum": [
            "single_detection_candidate",
            "abstained_no_detection",
            "abstained_multiple_detections"
          ]
        },
        "identity_decision": { "const": false }
      }
    },
    "candidateMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_source_timestamp_ms",
        "right_artifact_timestamp_ms",
        "basis",
        "recording_relationship_decision"
      ],
      "properties": {
        "left_source_timestamp_ms": { "type": "integer", "minimum": 0 },
        "right_artifact_timestamp_ms": { "type": "integer", "minimum": 0 },
        "basis": { "type": "string" },
        "recording_relationship_decision": { "const": false }
      }
    },
    "contextBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_source_context_label",
        "right_source_context_label",
        "label_forwarded_by_model",
        "human_identity_attestation"
      ],
      "properties": {
        "left_source_context_label": { "type": ["string", "null"] },
        "right_source_context_label": { "type": ["string", "null"] },
        "label_forwarded_by_model": { "const": false },
        "human_identity_attestation": { "const": false }
      }
    },
    "comparisonResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "left_frame_id",
        "right_frame_id",
        "candidate_coordinate_mapping",
        "calibration_state",
        "calibrated_probability",
        "threshold_decision",
        "identity_label",
        "identity_decision",
        "source_context_bridge",
        "warning",
        "state",
        "left_detection_id",
        "right_detection_id",
        "raw_cosine_similarity"
      ],
      "properties": {
        "comparison_id": { "$ref": "#/$defs/id" },
        "left_frame_id": { "$ref": "#/$defs/id" },
        "right_frame_id": { "$ref": "#/$defs/id" },
        "candidate_coordinate_mapping": { "$ref": "#/$defs/candidateMapping" },
        "calibration_state": { "const": "not_calibrated" },
        "calibrated_probability": { "type": "null" },
        "threshold_decision": { "type": "null" },
        "identity_label": { "type": "null" },
        "identity_decision": { "const": false },
        "source_context_bridge": { "$ref": "#/$defs/contextBridge" },
        "warning": { "type": "string" },
        "state": {
          "enum": [
            "candidate_only_single_detection_each",
            "abstained_detection_cardinality"
          ]
        },
        "left_detection_id": { "type": ["string", "null"] },
        "right_detection_id": { "type": ["string", "null"] },
        "raw_cosine_similarity": {
          "type": ["number", "null"],
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication",
        "identity_decision",
        "recording_relationship_decision",
        "human_review_required"
      ],
      "properties": {
        "publication": { "const": false },
        "identity_decision": { "const": false },
        "recording_relationship_decision": { "const": false },
        "human_review_required": { "const": true }
      }
    }
  }
}
