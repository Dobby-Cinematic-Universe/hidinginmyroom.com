{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/audio-fingerprint-compare-work-order-v1.schema.json",
  "title": "Conservative raw-fingerprint comparison work order v1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "not": {"pattern": "://"}},
    "side": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "expected_sha256", "expected_byte_count", "artifact_id", "fingerprint_id", "media_id", "implementation_version", "algorithm", "raw_format", "sample_rate_hz", "channels", "window_kind", "start_ms", "end_ms", "fingerprint_word_count", "quality_flags"],
      "properties": {
        "role": {"enum": ["query", "candidate"]}, "path": {"$ref": "#/$defs/absolutePath"}, "expected_sha256": {"$ref": "#/$defs/sha256"},
        "expected_byte_count": {"type": "integer", "minimum": 0, "maximum": 67108864}, "artifact_id": {"$ref": "#/$defs/identifier"}, "fingerprint_id": {"$ref": "#/$defs/identifier"},
        "media_id": {"$ref": "#/$defs/identifier"}, "implementation_version": {"type": "string", "minLength": 1}, "algorithm": {"type": "integer", "minimum": 0},
        "raw_format": {"const": "ffmpeg_chromaprint_fp_format_raw"}, "sample_rate_hz": {"const": 16000}, "channels": {"const": 1},
        "window_kind": {"type": "string", "minLength": 1}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1},
        "fingerprint_word_count": {"type": "integer", "minimum": 0}, "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "contextSide": {
      "type": "object", "additionalProperties": false, "required": ["recording_id", "rendition_id"],
      "properties": {"recording_id": {"$ref": "#/$defs/identifier"}, "rendition_id": {"$ref": "#/$defs/identifier"}}
    },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["query", "candidate"],
      "properties": {"query": {"$ref": "#/$defs/contextSide"}, "candidate": {"$ref": "#/$defs/contextSide"}}
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["root"],
      "properties": {"root": {"$ref": "#/$defs/absolutePath"}}
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "job_id", "method", "query", "candidate", "catalog_context", "output"],
  "properties": {
    "schema_version": {"const": 1}, "job_id": {"$ref": "#/$defs/identifier"}, "method": {"const": "exact_raw_bytes_v1"},
    "query": {"$ref": "#/$defs/side"}, "candidate": {"$ref": "#/$defs/side"},
    "catalog_context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/context"}]}, "output": {"$ref": "#/$defs/output"}
  }
}
