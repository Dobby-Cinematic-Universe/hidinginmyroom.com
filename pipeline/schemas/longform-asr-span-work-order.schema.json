{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/longform-asr-span-work-order.schema.json",
  "title": "HIMR long-form ASR span work order v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "implementation_version", "job_id", "plan", "recording", "strategy", "span", "decoding", "execution_lineage", "output", "policy", "identity_sha256", "work_order_id"],
  "properties": {
    "kind": {"const": "himr_longform_asr_span_work_order"},
    "schema_version": {"const": 1},
    "implementation_version": {"const": "0.1.0"},
    "job_id": {"$ref": "#/$defs/identifier"},
    "plan": {"$ref": "#/$defs/planBinding"},
    "recording": {"$ref": "#/$defs/recording"},
    "strategy": {"enum": ["direct", "adaptive_spans"]},
    "span": {"$ref": "#/$defs/span"},
    "decoding": {"$ref": "#/$defs/decoding"},
    "execution_lineage": {"$ref": "#/$defs/executionLineage"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "layout", "atomic_no_replace"],
      "properties": {
        "root": {"$ref": "#/$defs/absolutePath"},
        "layout": {"const": "asr/longform-span-v1/sha256-v1"},
        "atomic_no_replace": {"const": true}
      }
    },
    "policy": {"$ref": "#/$defs/policy"},
    "identity_sha256": {"$ref": "#/$defs/sha256"},
    "work_order_id": {"type": "string", "pattern": "^longasrwo1_[0-9a-f]{32}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "absolutePath": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/"},
    "planBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "identity_sha256"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^lfplan_[0-9a-f]{32}$"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_sample", "end_sample", "sample_count"],
      "properties": {
        "start_sample": {"type": "integer", "minimum": 0},
        "end_sample": {"type": "integer", "minimum": 1},
        "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recording_id", "media_id", "input"],
      "properties": {
        "recording_id": {"$ref": "#/$defs/identifier"},
        "media_id": {"$ref": "#/$defs/identifier"},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "path", "sha256", "byte_count", "sample_rate_hz", "channels", "total_samples", "duration_ms"],
          "properties": {
            "artifact_id": {"$ref": "#/$defs/identifier"},
            "path": {"$ref": "#/$defs/absolutePath"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "byte_count": {"type": "integer", "minimum": 1},
            "sample_rate_hz": {"const": 16000},
            "channels": {"const": 1},
            "total_samples": {"type": "integer", "minimum": 1},
            "duration_ms": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_id", "ordinal", "analysis", "core", "padding", "boundary"],
      "properties": {
        "span_id": {"type": "string", "pattern": "^lfspan_[0-9a-f]{32}$"},
        "ordinal": {"type": "integer", "minimum": 0},
        "analysis": {"$ref": "#/$defs/interval"},
        "core": {"$ref": "#/$defs/interval"},
        "padding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested_left_samples", "requested_right_samples", "applied_left_samples", "applied_right_samples", "clipped_left_samples", "clipped_right_samples"],
          "properties": {
            "requested_left_samples": {"type": "integer", "minimum": 0},
            "requested_right_samples": {"type": "integer", "minimum": 0},
            "applied_left_samples": {"type": "integer", "minimum": 0},
            "applied_right_samples": {"type": "integer", "minimum": 0},
            "clipped_left_samples": {"type": "integer", "minimum": 0},
            "clipped_right_samples": {"type": "integer", "minimum": 0}
          }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "confidence_millionths"],
          "properties": {
            "reason": {"type": "string", "maxLength": 128},
            "confidence_millionths": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000}
          }
        }
      }
    },
    "decoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "beam_size", "best_of", "temperature", "word_timestamps", "vad_filter", "condition_on_previous_text", "initial_prompt", "hotwords"],
      "properties": {
        "language": {"const": "en"},
        "beam_size": {"type": "integer", "minimum": 1, "maximum": 32},
        "best_of": {"type": "integer", "minimum": 1, "maximum": 32},
        "temperature": {"type": "number", "minimum": 0, "maximum": 10},
        "word_timestamps": {"const": true},
        "vad_filter": {"const": false},
        "condition_on_previous_text": {"type": "boolean"},
        "initial_prompt": {"type": ["string", "null"], "maxLength": 8192},
        "hotwords": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "executionLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longform_scope_status", "production_profile", "runtime_admission", "model"],
      "properties": {
        "longform_scope_status": {"const": "candidate_unsoaked"},
        "production_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_id", "identity_sha256", "physical_sha256"],
          "properties": {
            "profile_id": {"$ref": "#/$defs/identifier"},
            "identity_sha256": {"$ref": "#/$defs/sha256"},
            "physical_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "runtime_admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipt_id", "identity_sha256", "physical_sha256", "status"],
          "properties": {
            "receipt_id": {"$ref": "#/$defs/identifier"},
            "identity_sha256": {"$ref": "#/$defs/sha256"},
            "physical_sha256": {"$ref": "#/$defs/sha256"},
            "status": {"enum": ["candidate", "admitted"]}
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision", "identity_sha256"],
          "properties": {
            "repository": {"type": "string", "minLength": 1, "maxLength": 512},
            "revision": {"type": "string", "minLength": 1, "maxLength": 512},
            "identity_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "policy": {
      "const": {
        "visibility": "private",
        "machine_generated": true,
        "scores_calibrated": false,
        "network_access": false,
        "persistent_audio_chunks": false,
        "input_authority": "immutable_parent_audio_logical_view_only",
        "coordinate_authority": "exact_16000hz_half_open_samples",
        "overlap_ownership_authority": "downstream_assembler_only",
        "publication_authority": "none",
        "catalogue_mutation_authority": "none",
        "identity_authority": "none",
        "biometric_authority": "none",
        "wiki_authority": "none",
        "archive_authority": "none",
        "deletion_authority": "none"
      }
    }
  }
}
