{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/contextual-asr-batch-run-v1.json",
  "title": "Private paired contextual whisper.cpp ASR batch run summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation_version",
    "batch_id",
    "manifest_sha256",
    "status",
    "dry_run",
    "job_count",
    "results",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "implementation_version": { "const": "0.1.0" },
    "batch_id": { "$ref": "#/$defs/batchId" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["planned", "completed", "failed"] },
    "dry_run": { "type": "boolean" },
    "job_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "results": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/result" }
    },
    "failed_job": { "$ref": "#/$defs/failedJob" },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "batchId": {
      "type": "string",
      "pattern": "^ctxasrbatch_[0-9a-f]{32}$"
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1,
      "maxLength": 4096
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "job_id",
        "work_order_sha256",
        "status",
        "recipe_id",
        "result_key",
        "result_path",
        "processing_run_id",
        "baseline_result_canonical_sha256",
        "glossary_revision_id"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "job_id": { "type": "string", "pattern": "^asr-contextual-[0-9a-f]{32}$" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["planned", "completed"] },
        "recipe_id": { "$ref": "#/$defs/identifier" },
        "result_key": { "$ref": "#/$defs/sha256" },
        "result_path": { "$ref": "#/$defs/path" },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "baseline_result_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "glossary_revision_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 256 },
        "message": { "type": "string", "minLength": 1, "maxLength": 16384 }
      }
    },
    "invalidUtf8": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decoder", "start_byte", "end_byte", "reason"],
      "properties": {
        "decoder": { "const": "utf-8-strict" },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "rawArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "path",
        "storage_uri",
        "byte_count",
        "sha256",
        "visibility"
      ],
      "properties": {
        "artifact_kind": { "const": "whispercpp_output_json_full_quarantine" },
        "path": { "$ref": "#/$defs/path" },
        "storage_uri": { "type": "string", "pattern": "^file:///" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "visibility": { "const": "private" }
      }
    },
    "quarantine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_key",
        "receipt_kind",
        "receipt_path",
        "receipt_sha256",
        "invalid_utf8",
        "raw_artifact"
      ],
      "properties": {
        "failure_key": { "$ref": "#/$defs/sha256" },
        "receipt_kind": { "const": "whispercpp_output_json_full_invalid_utf8" },
        "receipt_path": { "$ref": "#/$defs/path" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "invalid_utf8": { "$ref": "#/$defs/invalidUtf8" },
        "raw_artifact": { "$ref": "#/$defs/rawArtifact" }
      }
    },
    "failedJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "job_id",
        "work_order_sha256",
        "baseline_result_canonical_sha256",
        "error",
        "quarantine"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "job_id": { "type": "string", "pattern": "^asr-contextual-[0-9a-f]{32}$" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "baseline_result_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "error": { "$ref": "#/$defs/error" },
        "quarantine": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/quarantine" }
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_writes",
        "database_access",
        "dispatch_order",
        "network_access",
        "publication_authority",
        "resume_policy",
        "review_authority",
        "transcript_preference_authority"
      ],
      "properties": {
        "catalog_writes": { "const": false },
        "database_access": { "const": "none" },
        "dispatch_order": { "const": "sealed_ordinal_fail_fast" },
        "network_access": {
          "const": "none_by_controller_external_engine_sandbox_required"
        },
        "publication_authority": { "const": "none" },
        "resume_policy": {
          "const": "replay_manifest_reuses_content_addressed_completed_results"
        },
        "review_authority": { "const": "none" },
        "transcript_preference_authority": { "const": "none" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "planned" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "dry_run": { "const": true },
          "results": {
            "items": {
              "properties": { "status": { "const": "planned" } }
            }
          }
        },
        "not": { "required": ["failed_job"] }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "dry_run": { "const": false },
          "results": {
            "items": {
              "properties": { "status": { "const": "completed" } }
            }
          }
        },
        "not": { "required": ["failed_job"] }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": { "required": ["failed_job"] }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "failed" },
          "dry_run": { "const": true }
        },
        "required": ["status", "dry_run"]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "properties": { "status": { "const": "planned" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "failed" },
          "dry_run": { "const": false }
        },
        "required": ["status", "dry_run"]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "properties": { "status": { "const": "completed" } }
            }
          }
        }
      }
    }
  ]
}
