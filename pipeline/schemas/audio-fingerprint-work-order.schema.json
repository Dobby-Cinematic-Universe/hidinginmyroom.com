{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/audio-fingerprint-work-order-v1.schema.json",
  "title": "Offline FFmpeg Chromaprint work order v1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "not": {"pattern": "://"}},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_sha256", "expected_byte_count", "media_id", "artifact_id", "parent_processing_run_id", "duration_ms", "sample_rate_hz", "channels", "sample_format"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "expected_byte_count": {"type": "integer", "minimum": 1},
        "media_id": {"$ref": "#/$defs/identifier"},
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "parent_processing_run_id": {"$ref": "#/$defs/identifier"},
        "duration_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "sample_rate_hz": {"const": 16000},
        "channels": {"const": 1},
        "sample_format": {"const": "s16"}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "expected_sha256", "expected_byte_count", "expected_version_output_sha256", "expected_muxer_help_sha256", "version_label"],
      "properties": {
        "executable": {"$ref": "#/$defs/absolutePath"},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "expected_byte_count": {"type": "integer", "minimum": 1},
        "expected_version_output_sha256": {"$ref": "#/$defs/sha256"},
        "expected_muxer_help_sha256": {"$ref": "#/$defs/sha256"},
        "version_label": {"type": "string", "minLength": 1}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_id", "start_ms", "end_ms"],
      "properties": {
        "window_id": {"$ref": "#/$defs/identifier"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1}
      }
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "full_track"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "windows"],
          "properties": {
            "mode": {"const": "explicit_windows"},
            "windows": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/window"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "chunk_duration_ms", "hop_ms", "include_partial_tail", "minimum_tail_ms"],
          "properties": {
            "mode": {"const": "fixed_chunks"},
            "chunk_duration_ms": {"type": "integer", "minimum": 1000, "maximum": 3600000},
            "hop_ms": {"type": "integer", "minimum": 1},
            "include_partial_tail": {"type": "boolean"},
            "minimum_tail_ms": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "raw_format", "threads", "timeout_seconds", "selection"],
      "properties": {
        "algorithm": {"type": "integer", "minimum": 0},
        "raw_format": {"const": "ffmpeg_chromaprint_fp_format_raw"},
        "threads": {"type": "integer", "minimum": 1, "maximum": 64},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "selection": {"$ref": "#/$defs/selection"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recording_id", "rendition_id"],
      "properties": {
        "recording_id": {"$ref": "#/$defs/identifier"},
        "rendition_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {"root": {"$ref": "#/$defs/absolutePath"}}
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "input", "engine", "fingerprint", "catalog_context", "output"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"$ref": "#/$defs/identifier"},
    "input": {"$ref": "#/$defs/input"},
    "engine": {"$ref": "#/$defs/engine"},
    "fingerprint": {"$ref": "#/$defs/fingerprint"},
    "catalog_context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/context"}]},
    "output": {"$ref": "#/$defs/output"}
  }
}
