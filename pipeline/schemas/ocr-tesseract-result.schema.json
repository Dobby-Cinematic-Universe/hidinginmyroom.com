{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/ocr-tesseract-result-v1.json",
  "title": "HIMR private Tesseract TSV OCR execution result",
  "oneOf": [
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
    },
    "zonedTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode", "byte_count", "mtime_ns"],
      "properties": {
        "device": { "type": "integer" },
        "inode": { "type": "integer", "minimum": 0 },
        "byte_count": { "type": "integer", "minimum": 0 },
        "mtime_ns": { "type": "integer" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": { "$ref": "#/$defs/stat" },
        "unchanged": { "const": true }
      }
    },
    "modelObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged"
      ],
      "properties": {
        "language": { "$ref": "#/$defs/language" },
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": { "$ref": "#/$defs/stat" },
        "unchanged": { "const": true }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "sha256",
        "byte_count",
        "stat_before",
        "stat_after",
        "unchanged",
        "version_label",
        "version_output",
        "version_output_sha256",
        "tessdata_dir",
        "models"
      ],
      "properties": {
        "name": { "const": "tesseract" },
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "stat_before": { "$ref": "#/$defs/stat" },
        "stat_after": { "$ref": "#/$defs/stat" },
        "unchanged": { "const": true },
        "version_label": { "type": "string", "minLength": 1 },
        "version_output": { "type": "string", "minLength": 1 },
        "version_output_sha256": { "$ref": "#/$defs/sha256" },
        "tessdata_dir": { "type": "string", "pattern": "^/" },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/modelObservation" }
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "oem",
        "psm",
        "dpi",
        "preserve_interword_spaces",
        "thread_limit",
        "tsv_creation"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/language" }
        },
        "oem": { "type": "integer", "minimum": 0, "maximum": 3 },
        "psm": { "enum": [3, 4, 5, 6, 7, 8, 9, 10, 11, 13] },
        "dpi": { "type": "integer", "minimum": 70, "maximum": 1200 },
        "preserve_interword_spaces": { "type": "boolean" },
        "thread_limit": { "const": 1 },
        "tsv_creation": { "const": "explicit_tessedit_create_tsv_1" }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pts",
        "duration_pts",
        "time_base_numerator",
        "time_base_denominator",
        "timestamp_us",
        "timestamp_ms",
        "duration_us"
      ],
      "properties": {
        "pts": { "type": "integer", "minimum": 0 },
        "duration_pts": { "type": "integer", "minimum": 1 },
        "time_base_numerator": { "type": "integer", "minimum": 1 },
        "time_base_denominator": { "type": "integer", "minimum": 1 },
        "timestamp_us": { "type": "integer", "minimum": 0 },
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "duration_us": { "type": "integer", "minimum": 1 }
      }
    },
    "frameLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_media_id",
        "proxy_artifact_id",
        "proxy_parent_processing_run_id",
        "preprocess_processing_run_id",
        "sparse_frame_result_key",
        "sparse_frame_processing_run_id",
        "frame_id",
        "frame_artifact_id",
        "frame_png_sha256",
        "ordinal",
        "requested_timestamp_ms",
        "selection_reason_codes",
        "source_scene_timestamps_ms",
        "timestamp",
        "rounded_source_timestamp_ms",
        "timestamp_drift_ms",
        "ocr_routing_reason_codes"
      ],
      "properties": {
        "source_media_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "proxy_artifact_id": { "$ref": "#/$defs/identifier" },
        "proxy_parent_processing_run_id": { "$ref": "#/$defs/identifier" },
        "preprocess_processing_run_id": { "$ref": "#/$defs/identifier" },
        "sparse_frame_result_key": { "$ref": "#/$defs/sha256" },
        "sparse_frame_processing_run_id": {
          "type": "string",
          "pattern": "^run_sparse_frames_[0-9a-f]{32}$"
        },
        "frame_id": { "type": "string", "pattern": "^frame_[0-9a-f]{32}$" },
        "frame_artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "frame_png_sha256": { "$ref": "#/$defs/sha256" },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 255 },
        "requested_timestamp_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "selection_reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "FRAME_RECORDING_START",
              "FRAME_SCENE_CHANGE",
              "FRAME_PERIODIC_COVERAGE"
            ]
          }
        },
        "source_scene_timestamps_ms": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 604800000 }
        },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "rounded_source_timestamp_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "timestamp_drift_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "ocr_routing_reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "OCR_CANDIDATE_RECORDING_START",
              "OCR_CANDIDATE_SCENE_CHANGE",
              "OCR_CANDIDATE_PERIODIC_COVERAGE"
            ]
          }
        }
      }
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height", "right", "bottom", "coordinate_space"],
      "properties": {
        "left": { "type": "integer", "minimum": 0 },
        "top": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "right": { "type": "integer", "minimum": 1 },
        "bottom": { "type": "integer", "minimum": 1 },
        "coordinate_space": { "const": "source_frame_pixels" }
      }
    },
    "readingOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "page_num", "block_num", "par_num", "line_num", "word_num"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "page_num": { "type": "integer", "minimum": 1 },
        "block_num": { "type": "integer", "minimum": 1 },
        "par_num": { "type": "integer", "minimum": 1 },
        "line_num": { "type": "integer", "minimum": 1 },
        "word_num": { "type": "integer", "minimum": 1 }
      }
    },
    "languageChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "tesseract_language_expression", "evidence_code"],
      "properties": {
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/language" }
        },
        "tesseract_language_expression": { "type": "string", "minLength": 1 },
        "evidence_code": { "const": "WORK_ORDER_EXPLICIT_NOT_WORD_DETECTED" }
      }
    },
    "scriptChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "evidence_code"],
      "properties": {
        "script": { "const": "unknown" },
        "evidence_code": { "const": "NOT_EMITTED_BY_TESSERACT_TSV" }
      }
    },
    "modelDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "sha256"],
      "properties": {
        "language": { "$ref": "#/$defs/language" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "regionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_name",
        "executable_sha256",
        "version_output_sha256",
        "models",
        "parameters"
      ],
      "properties": {
        "engine_name": { "const": "tesseract" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "version_output_sha256": { "$ref": "#/$defs/sha256" },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/modelDigest" }
        },
        "parameters": { "$ref": "#/$defs/parameters" }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "processing_run_id",
        "frame_locator",
        "raw_text",
        "raw_score",
        "raw_score_text",
        "score_scale",
        "rectangle",
        "reading_order",
        "language_choice",
        "script_choice",
        "engine_provenance"
      ],
      "properties": {
        "region_id": { "type": "string", "pattern": "^ocr_region_[0-9a-f]{32}$" },
        "processing_run_id": {
          "type": "string",
          "pattern": "^run_ocr_tesseract_[0-9a-f]{32}$"
        },
        "frame_locator": { "$ref": "#/$defs/frameLocator" },
        "raw_text": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "raw_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "raw_score_text": {
          "type": "string",
          "pattern": "^(?:0(?:\\.[0-9]+)?|[1-9][0-9]?(?:\\.[0-9]+)?|100(?:\\.0+)?)$"
        },
        "score_scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum", "label", "calibration_state", "probability_interpretation"],
          "properties": {
            "minimum": { "const": 0 },
            "maximum": { "const": 100 },
            "label": { "const": "tesseract_raw_0_100" },
            "calibration_state": { "const": "not_calibrated" },
            "probability_interpretation": { "const": "not_a_probability" }
          }
        },
        "rectangle": { "$ref": "#/$defs/rectangle" },
        "reading_order": { "$ref": "#/$defs/readingOrder" },
        "language_choice": { "$ref": "#/$defs/languageChoice" },
        "script_choice": { "$ref": "#/$defs/scriptChoice" },
        "engine_provenance": { "$ref": "#/$defs/regionProvenance" }
      }
    },
    "tsvArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "processing_run_id",
        "frame_id",
        "path",
        "storage_uri",
        "sha256",
        "byte_count",
        "mime_type",
        "visibility"
      ],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^artifact_[0-9a-f]{32}$" },
        "processing_run_id": {
          "type": "string",
          "pattern": "^run_ocr_tesseract_[0-9a-f]{32}$"
        },
        "frame_id": { "type": "string", "pattern": "^frame_[0-9a-f]{32}$" },
        "path": { "type": "string", "pattern": "^/" },
        "storage_uri": { "type": "string", "pattern": "^file://" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "mime_type": { "const": "text/tab-separated-values; charset=utf-8" },
        "visibility": { "const": "private" }
      }
    },
    "ocrFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_locator",
        "source_png",
        "tsv_artifact",
        "text_presence",
        "word_count",
        "words"
      ],
      "properties": {
        "frame_locator": { "$ref": "#/$defs/frameLocator" },
        "source_png": { "$ref": "#/$defs/observation" },
        "tsv_artifact": { "$ref": "#/$defs/tsvArtifact" },
        "text_presence": { "enum": ["detected", "not_detected"] },
        "word_count": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "words": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/word" }
        }
      }
    },
    "processingRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_run_id",
        "stage",
        "implementation_version",
        "parameters_json",
        "environment_json",
        "started_at",
        "completed_at",
        "status",
        "error_text"
      ],
      "properties": {
        "processing_run_id": {
          "type": "string",
          "pattern": "^run_ocr_tesseract_[0-9a-f]{32}$"
        },
        "stage": { "const": "ocr_tesseract_tsv" },
        "implementation_version": { "type": "string", "minLength": 1 },
        "parameters_json": { "type": "string", "minLength": 1 },
        "environment_json": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python", "cpu_only", "network", "database", "publication", "identity_inference", "thread_limit"],
          "properties": {
            "python": { "type": "string", "minLength": 1 },
            "cpu_only": { "const": true },
            "network": { "const": "not_used" },
            "database": { "const": "not_opened" },
            "publication": { "const": "not_authorized" },
            "identity_inference": { "const": "not_performed" },
            "thread_limit": { "const": 1 }
          }
        },
        "started_at": { "$ref": "#/$defs/zonedTime" },
        "completed_at": { "$ref": "#/$defs/zonedTime" },
        "status": { "enum": ["queued", "completed"] },
        "error_text": { "type": "null" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "human_review",
        "publication_authority",
        "identity_inference",
        "score_calibration"
      ],
      "properties": {
        "visibility": { "const": "private" },
        "human_review": { "const": "required" },
        "publication_authority": { "const": "none" },
        "identity_inference": { "const": "not_performed" },
        "score_calibration": { "const": "not_calibrated" }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "type": "string", "minLength": 1 }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "status": { "const": "planned" },
                "dry_run": { "const": true },
                "processing_run": { "properties": { "status": { "const": "queued" } } },
                "ocr_frames": { "maxItems": 0 }
              }
            },
            {
              "properties": {
                "status": { "const": "completed" },
                "dry_run": { "const": false },
                "processing_run": { "properties": { "status": { "const": "completed" } } },
                "ocr_frames": { "minItems": 1 }
              }
            }
          ]
        }
      ],
      "required": [
        "schema_version",
        "job_id",
        "status",
        "dry_run",
        "work_order_sha256",
        "recipe_id",
        "recipe_sha256",
        "result_key",
        "processing_run",
        "sparse_frame_result",
        "source_lineage",
        "tesseract",
        "execution_selection",
        "parameters",
        "commands",
        "ocr_frames",
        "policy",
        "result_path",
        "duration_ms",
        "errors"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "status": { "enum": ["planned", "completed"] },
        "dry_run": { "type": "boolean" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "recipe_id": { "type": "string", "pattern": "^recipe_ocr_tesseract_[0-9a-f]{32}$" },
        "recipe_sha256": { "$ref": "#/$defs/sha256" },
        "result_key": { "$ref": "#/$defs/sha256" },
        "processing_run": { "$ref": "#/$defs/processingRun" },
        "sparse_frame_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "byte_count",
            "stat_before",
            "stat_after",
            "unchanged",
            "result_key",
            "processing_run_id"
          ],
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 1 },
            "stat_before": { "$ref": "#/$defs/stat" },
            "stat_after": { "$ref": "#/$defs/stat" },
            "unchanged": { "const": true },
            "result_key": { "$ref": "#/$defs/sha256" },
            "processing_run_id": {
              "type": "string",
              "pattern": "^run_sparse_frames_[0-9a-f]{32}$"
            }
          }
        },
        "source_lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_media_id",
            "proxy_artifact_id",
            "proxy_parent_processing_run_id",
            "preprocess_processing_run_id",
            "sparse_frame_result_key",
            "sparse_frame_processing_run_id"
          ],
          "properties": {
            "source_media_id": { "type": "string", "pattern": "^media_sha256_[0-9a-f]{64}$" },
            "proxy_artifact_id": { "$ref": "#/$defs/identifier" },
            "proxy_parent_processing_run_id": { "$ref": "#/$defs/identifier" },
            "preprocess_processing_run_id": { "$ref": "#/$defs/identifier" },
            "sparse_frame_result_key": { "$ref": "#/$defs/sha256" },
            "sparse_frame_processing_run_id": { "type": "string", "pattern": "^run_sparse_frames_[0-9a-f]{32}$" }
          }
        },
        "tesseract": { "$ref": "#/$defs/engine" },
        "execution_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "basis", "frame_ids"],
          "properties": {
            "mode": { "const": "explicit_frame_ids" },
            "basis": {
              "enum": [
                "external_text_presence_candidate",
                "reviewer_selected"
              ]
            },
            "frame_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^frame_[0-9a-f]{32}$"
              }
            }
          }
        },
        "parameters": { "$ref": "#/$defs/parameters" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/command" }
        },
        "ocr_frames": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/ocrFrame" }
        },
        "policy": { "$ref": "#/$defs/policy" },
        "result_path": { "type": "string", "pattern": "^/" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array", "maxItems": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "job_id", "error", "errors"],
      "properties": {
        "schema_version": { "const": 1 },
        "status": { "const": "failed" },
        "job_id": { "type": ["string", "null"] },
        "error": { "$ref": "#/$defs/error" },
        "errors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/error" }
        }
      }
    }
  }
}
