{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/speaker-reviewed-hints-v1.json",
  "title": "HIMR human-reviewed speaker routing hints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_batch_id",
    "recording_id",
    "duration_ms",
    "review_state",
    "reviewer_id",
    "reviewed_at",
    "source_identity_attestation",
    "intervals"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "review_batch_id": { "$ref": "#/$defs/identifier" },
    "recording_id": { "$ref": "#/$defs/identifier" },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800000
    },
    "review_state": { "const": "human_reviewed" },
    "reviewer_id": { "$ref": "#/$defs/identifier" },
    "reviewed_at": { "$ref": "#/$defs/zonedTime" },
    "source_identity_attestation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sourceIdentityAttestation" }
      ]
    },
    "intervals": {
      "type": "array",
      "maxItems": 200000,
      "items": { "$ref": "#/$defs/hint" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "zonedTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sourceIdentityAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id",
        "source_confirmation",
        "source_confirmation_evidence",
        "public_label",
        "basis",
        "review_scope",
        "reviewed_live_speaker_count",
        "title_context_assessment",
        "reviewer_id",
        "reviewer_kind",
        "reviewed_at",
        "comment"
      ],
      "properties": {
        "attestation_id": { "$ref": "#/$defs/identifier" },
        "source_confirmation": {
          "const": "confirmed_daniel_owned_source"
        },
        "source_confirmation_evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "public_label": { "const": "Daniel" },
        "basis": {
          "const": "confirmed_daniel_source_solo_presumption"
        },
        "review_scope": { "const": "complete_recording" },
        "reviewed_live_speaker_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "title_context_assessment": {
          "enum": [
            "no_contradiction_found",
            "contradicts_solo_daniel_presumption",
            "ambiguous_or_unresolved"
          ]
        },
        "reviewer_id": { "$ref": "#/$defs/identifier" },
        "reviewer_kind": { "const": "human" },
        "reviewed_at": { "$ref": "#/$defs/zonedTime" },
        "comment": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 1000 }
          ]
        }
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hint_id",
        "start_ms",
        "end_ms",
        "speech_presence",
        "speech_multiplicity",
        "audio_origin",
        "face_visibility",
        "speaker_visual_relation",
        "review_confidence",
        "comment"
      ],
      "properties": {
        "hint_id": { "$ref": "#/$defs/identifier" },
        "start_ms": { "type": "integer", "minimum": 0, "maximum": 604799999 },
        "end_ms": { "type": "integer", "minimum": 1, "maximum": 604800000 },
        "speech_presence": { "enum": ["absent", "present", "unknown"] },
        "speech_multiplicity": {
          "enum": ["none", "single", "overlap", "unknown"]
        },
        "audio_origin": {
          "enum": [
            "live_voice",
            "playback_voice",
            "reaction_insert_voice",
            "tts_voice",
            "synthetic_voice",
            "unknown"
          ]
        },
        "face_visibility": {
          "enum": ["none", "single_face", "multiple_faces", "unknown"]
        },
        "speaker_visual_relation": {
          "enum": ["onscreen", "offscreen", "mixed", "unknown"]
        },
        "review_confidence": { "enum": ["high", "medium", "low"] },
        "comment": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 1000 }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "speech_presence": { "const": "absent" } },
            "required": ["speech_presence"]
          },
          "then": {
            "properties": { "speech_multiplicity": { "const": "none" } }
          }
        },
        {
          "if": {
            "properties": { "speech_presence": { "const": "present" } },
            "required": ["speech_presence"]
          },
          "then": {
            "properties": {
              "speech_multiplicity": {
                "enum": ["single", "overlap", "unknown"]
              }
            }
          }
        }
      ]
    }
  }
}
