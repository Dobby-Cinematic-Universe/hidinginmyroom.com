{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/asr-whispercpp-batch-manifest-v1.json",
  "title": "Immutable private raw whisper.cpp ASR batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation_version", "materializer", "batch_id", "identity_sha256", "batch_relative_path", "catalog", "software", "engine", "model", "profile", "output", "work_order_count", "totals", "work_orders", "safety"],
  "properties": {
    "schema_version": { "const": 1 },
    "implementation_version": { "enum": ["0.1.0", "0.2.0"] },
    "materializer": { "const": "himr-asr-whispercpp-raw-batch" },
    "batch_id": { "type": "string", "pattern": "^asrbatch_[0-9a-f]{32}$" },
    "identity_sha256": { "$ref": "#/$defs/sha256" },
    "batch_relative_path": { "type": "string", "pattern": "^batches/asrbatch_[0-9a-f]{32}$", "maxLength": 256 },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_path", "access_mode", "query_contract_version", "binding_sha256", "model_registry"],
      "properties": {
        "database_path": { "$ref": "#/$defs/path" },
        "access_mode": { "const": "read_only_snapshot" },
        "query_contract_version": { "const": 1 },
        "binding_sha256": { "$ref": "#/$defs/sha256" },
        "model_registry": { "$ref": "#/$defs/model_registry" }
      }
    },
    "software": {
      "oneOf": [
        { "$ref": "#/$defs/software_legacy" },
        { "$ref": "#/$defs/software_current" }
      ]
    },
    "engine": {
      "oneOf": [
        { "$ref": "#/$defs/engine_legacy" },
        { "$ref": "#/$defs/engine_current" }
      ]
    },
    "model": { "$ref": "#/$defs/model" },
    "profile": { "$ref": "#/$defs/profile" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_root", "asr_output_root"],
      "properties": {
        "batch_root": { "$ref": "#/$defs/path" },
        "asr_output_root": { "$ref": "#/$defs/path" }
      }
    },
    "work_order_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_byte_count", "audio_duration_ms"],
      "properties": {
        "audio_byte_count": { "type": "integer", "minimum": 1, "maximum": 274877906944 },
        "audio_duration_ms": { "type": "integer", "minimum": 1, "maximum": 604800000 }
      }
    },
    "work_orders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/work_order_entry" }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentials_used", "network_access", "publication_authority", "visibility", "identity_authority", "catalog_writes", "source_bytes_preserved", "dispatch_order"],
      "properties": {
        "credentials_used": { "const": false },
        "network_access": { "const": "forbidden_by_contract_not_performed_by_materializer" },
        "publication_authority": { "const": "none" },
        "visibility": { "const": "private" },
        "identity_authority": { "const": "none" },
        "catalog_writes": { "const": false },
        "source_bytes_preserved": { "const": true },
        "dispatch_order": { "const": "sealed_ordinal_fail_fast" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "implementation_version": { "const": "0.1.0" } },
        "required": ["implementation_version"]
      },
      "then": {
        "properties": {
          "software": { "$ref": "#/$defs/software_legacy" },
          "engine": { "$ref": "#/$defs/engine_legacy" }
        }
      }
    },
    {
      "if": {
        "properties": { "implementation_version": { "const": "0.2.0" } },
        "required": ["implementation_version"]
      },
      "then": {
        "properties": {
          "software": { "$ref": "#/$defs/software_current" },
          "engine": { "$ref": "#/$defs/engine_current" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^/", "minLength": 1, "maxLength": 4096 },
    "uri": { "type": "string", "pattern": "^file:///", "minLength": 8, "maxLength": 8192 },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "nullable_string": { "type": ["string", "null"], "maxLength": 8192 },
    "database_json": { "type": "string", "minLength": 2, "maxLength": 16777216 },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "end_ms", "is_partial_tail", "ordinal", "start_ms", "window_id"],
      "properties": {
        "boundary": { "const": "half_open" },
        "end_ms": { "type": "integer", "minimum": 1, "maximum": 604800000 },
        "is_partial_tail": { "type": "boolean" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 999999 },
        "start_ms": { "type": "integer", "minimum": 0, "maximum": 604800000 },
        "window_id": { "type": "string", "pattern": "^window_[0-9]{6}$" }
      }
    },
    "source_time_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_zero_maps_to_source_ms", "boundary", "byte_exact_source_fragment", "coordinate_precision", "extraction_method", "source_end_ms", "source_start_ms"],
      "properties": {
        "artifact_zero_maps_to_source_ms": { "type": "integer", "minimum": 0, "maximum": 604800000 },
        "boundary": { "const": "half_open" },
        "byte_exact_source_fragment": { "const": false },
        "coordinate_precision": { "const": "integer_millisecond_contract" },
        "extraction_method": { "const": "ffmpeg_accurate_seek_transcode" },
        "source_end_ms": { "type": "integer", "minimum": 1, "maximum": 604800000 },
        "source_start_ms": { "type": "integer", "minimum": 0, "maximum": 604800000 }
      }
    },
    "audio_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio", "audio_stream_index", "duration_ms", "video", "video_stream_index"],
      "properties": {
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channels", "codec_name", "sample_format", "sample_rate_hz"],
          "properties": {
            "channels": { "const": 1 },
            "codec_name": { "const": "flac" },
            "sample_format": { "const": "s16" },
            "sample_rate_hz": { "const": 16000 }
          }
        },
        "audio_stream_index": { "const": 0 },
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "video": { "type": "null" },
        "video_stream_index": { "type": "null" }
      }
    },
    "audio_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_kind", "byte_count", "normalized_probe", "path", "sha256", "visibility"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "artifact_kind": { "const": "window_audio_16khz_mono_flac" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 17179869184 },
        "normalized_probe": { "$ref": "#/$defs/audio_probe" },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "visibility": { "const": "private" }
      }
    },
    "engine_build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "target", "configuration"],
      "properties": {
        "repository": { "const": "https://github.com/ggml-org/whisper.cpp" },
        "revision": {
          "enum": [
            "2eeeba56e9edd762b4b38467bab96c2517163158",
            "48f628a84833905ee4a0658ee6d4a5c915ce1997"
          ]
        },
        "target": { "const": "whisper-cli" },
        "configuration": {
          "const": ["CMAKE_BUILD_TYPE=Release", "CC=/usr/bin/gcc", "CXX=/usr/bin/g++", "CCACHE_DISABLE=1", "GGML_BLAS=OFF", "GGML_CUDA=OFF", "GGML_NATIVE=ON", "GGML_OPENMP=ON", "GGML_VULKAN=OFF", "WHISPER_FFMPEG=OFF"]
        }
      }
    },
    "software_legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materializer", "asr_adapter"],
      "properties": {
        "materializer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "implementation_version", "path", "sha256", "byte_count"],
          "properties": {
            "name": { "const": "himr-asr-whispercpp-raw-batch" },
            "implementation_version": { "const": "0.1.0" },
            "path": { "$ref": "#/$defs/path" },
            "sha256": { "const": "c940b93d11a22f057c4c244d0d17d0e933050f9dafe8f1c5ef8ede2bcf971df5" },
            "byte_count": { "const": 71128 }
          }
        },
        "asr_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "contract_version", "implementation_version", "path", "sha256", "byte_count"],
          "properties": {
            "name": { "const": "himr-asr-whispercpp" },
            "contract_version": { "const": 1 },
            "implementation_version": { "const": "0.2.3" },
            "path": { "$ref": "#/$defs/path" },
            "sha256": { "const": "781f481a0f5ff155417795640ae089d484db0f56e7ec8e9e6e8375ef46c260f0" },
            "byte_count": { "const": 57311 }
          }
        }
      }
    },
    "software_current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materializer", "asr_adapter", "engine_profiles"],
      "properties": {
        "materializer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "implementation_version", "path", "sha256", "byte_count"],
          "properties": {
            "name": { "const": "himr-asr-whispercpp-raw-batch" },
            "implementation_version": { "const": "0.2.0" },
            "path": { "$ref": "#/$defs/path" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 1, "maximum": 4194304 }
          }
        },
        "asr_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "contract_version", "implementation_version", "path", "sha256", "byte_count"],
          "properties": {
            "name": { "const": "himr-asr-whispercpp" },
            "contract_version": { "const": 1 },
            "implementation_version": { "const": "0.3.0" },
            "path": { "$ref": "#/$defs/path" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 1, "maximum": 4194304 }
          }
        },
        "engine_profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "contract_version", "implementation_version", "path", "sha256", "byte_count"],
          "properties": {
            "name": { "const": "himr-whispercpp-engine-profiles" },
            "contract_version": { "const": 1 },
            "implementation_version": { "const": "1.0.0" },
            "path": { "$ref": "#/$defs/path" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 1, "maximum": 4194304 }
          }
        }
      }
    },
    "engine_legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "expected_sha256", "byte_count", "version_label", "version_evidence", "build"],
      "properties": {
        "executable": { "$ref": "#/$defs/path" },
        "expected_sha256": { "const": "4831024debb4e60e9433d27967ba6dae033d4b0c770c4ef208c16fc5a8fe77d6" },
        "byte_count": { "const": 1010544 },
        "version_label": { "const": "whisper.cpp v1.8.3" },
        "version_evidence": { "const": "source_revision_plus_executable_sha256" },
        "build": {
          "allOf": [
            { "$ref": "#/$defs/engine_build" },
            {
              "properties": {
                "revision": { "const": "2eeeba56e9edd762b4b38467bab96c2517163158" }
              }
            }
          ]
        }
      }
    },
    "engine_current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "expected_sha256", "byte_count", "version_label", "version_evidence", "build"],
      "properties": {
        "executable": { "$ref": "#/$defs/path" },
        "expected_sha256": { "const": "36be94accd60116933073e8069964c02e888e3681967184ce7fecfd5f980ae1a" },
        "byte_count": { "const": 1020432 },
        "version_label": { "const": "whisper.cpp v1.8.7" },
        "version_evidence": { "const": "source_revision_plus_executable_sha256" },
        "build": {
          "allOf": [
            { "$ref": "#/$defs/engine_build" },
            {
              "properties": {
                "revision": { "const": "48f628a84833905ee4a0658ee6d4a5c915ce1997" }
              }
            }
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_sha256", "byte_count", "model_id", "name", "revision", "source", "license_label"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "expected_sha256": { "const": "c6138d6d58ecc8322097e0f987c32f1be8bb0a18532a3f88f734d1bbf9c41e5d" },
        "byte_count": { "const": 487614201 },
        "model_id": { "const": "model_whispercpp_small_en_c6138d6d58ec" },
        "name": { "const": "Whisper small.en ggml" },
        "revision": { "const": "ggerganov/whisper.cpp@5359861c739e955e79d9a303bcbc70fb988958b1" },
        "source": { "const": "https://huggingface.co/ggerganov/whisper.cpp/blob/5359861c739e955e79d9a303bcbc70fb988958b1/ggml-small.en.bin" },
        "license_label": { "const": "MIT (model repository card reviewed 2026-08-26)" }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "threads", "translate", "split_on_word", "best_of", "beam_size", "max_segment_characters", "word_threshold", "entropy_threshold", "logprob_threshold", "no_speech_threshold", "temperature", "temperature_increment", "no_fallback", "timeout_seconds"],
      "properties": {
        "language": { "const": "en" },
        "threads": { "const": 6 },
        "translate": { "const": false },
        "split_on_word": { "const": true },
        "best_of": { "const": 5 },
        "beam_size": { "const": 5 },
        "max_segment_characters": { "const": 0 },
        "word_threshold": { "const": 0.01 },
        "entropy_threshold": { "const": 2.4 },
        "logprob_threshold": { "const": -1.0 },
        "no_speech_threshold": { "const": 0.6 },
        "temperature": { "const": 0.0 },
        "temperature_increment": { "const": 0.2 },
        "no_fallback": { "const": false },
        "timeout_seconds": { "const": 7200 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_kind", "coordinate_system", "window_offset_ms", "duration_basis", "inference", "glossary"],
      "properties": {
        "pass_kind": { "const": "raw_full_local_window" },
        "coordinate_system": { "const": "artifact_local_milliseconds" },
        "window_offset_ms": { "const": 0 },
        "duration_basis": { "const": "sealed_normalized_probe_full_duration" },
        "inference": { "$ref": "#/$defs/inference" },
        "glossary": { "type": "null" }
      }
    },
    "model_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "registry", "binding_sha256"],
      "properties": {
        "model": { "$ref": "#/$defs/catalog_model" },
        "registry": { "$ref": "#/$defs/registry_row" },
        "binding_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "catalog_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "task", "name", "version", "weights_sha256", "license_label", "configuration_json"],
      "properties": {
        "model_id": { "$ref": "#/$defs/identifier" },
        "task": { "const": "asr" },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "version": { "type": "string", "minLength": 1, "maxLength": 500 },
        "weights_sha256": { "$ref": "#/$defs/sha256" },
        "license_label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "configuration_json": { "$ref": "#/$defs/database_json" }
      }
    },
    "registry_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "input_sha256", "schema_version", "manifest_created_at", "imported_at", "registered_by", "basis", "model_count", "ordinal", "model_id", "model_snapshot_json"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": 1 },
        "manifest_created_at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "imported_at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "registered_by": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "basis": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "model_count": { "const": 1 },
        "ordinal": { "const": 0 },
        "model_id": { "$ref": "#/$defs/identifier" },
        "model_snapshot_json": { "$ref": "#/$defs/database_json" }
      }
    },
    "local_window_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "uri", "sha256", "byte_count", "job_id", "bundle_id", "work_order_sha256", "window", "source_time_mapping", "audio"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "uri": { "$ref": "#/$defs/uri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "job_id": { "$ref": "#/$defs/identifier" },
        "bundle_id": { "type": "string", "pattern": "^windowbundle_[0-9a-f]{32}$" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "window": { "$ref": "#/$defs/window" },
        "source_time_mapping": { "$ref": "#/$defs/source_time_mapping" },
        "audio": { "$ref": "#/$defs/audio_artifact" }
      }
    },
    "artifact_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "processing_run_id", "artifact_kind", "storage_uri", "sha256", "byte_count", "schema_version", "visibility", "metadata_json"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "artifact_kind": { "const": "window_audio_16khz_mono_flac" },
        "storage_uri": { "$ref": "#/$defs/uri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "schema_version": { "const": 1 },
        "visibility": { "const": "private" },
        "metadata_json": { "$ref": "#/$defs/database_json" }
      }
    },
    "processing_run_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processing_run_id", "stage", "implementation_version", "model_id", "glossary_revision_id", "parameters_json", "environment_json", "random_seed", "started_at", "completed_at", "status", "error_text"],
      "properties": {
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "stage": { "const": "local_window_result_admission" },
        "implementation_version": { "const": "local-window-catalog-bridge/1" },
        "model_id": { "type": "null" },
        "glossary_revision_id": { "type": "null" },
        "parameters_json": { "$ref": "#/$defs/database_json" },
        "environment_json": { "$ref": "#/$defs/database_json" },
        "random_seed": { "type": "null" },
        "started_at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "completed_at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "const": "completed" },
        "error_text": { "type": "null" }
      }
    },
    "media_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_id", "sha256", "byte_count", "media_kind", "mime_type", "container", "duration_ms", "ffprobe_json", "first_cataloged_at", "integrity_state"],
      "properties": {
        "media_id": { "$ref": "#/$defs/identifier" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "media_kind": { "const": "audio" },
        "mime_type": { "const": "audio/flac" },
        "container": { "const": "flac" },
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "ffprobe_json": { "$ref": "#/$defs/database_json" },
        "first_cataloged_at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "integrity_state": { "const": "verified" }
      }
    },
    "media_location_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_location_id", "media_id", "storage_uri", "storage_class", "verified_at", "is_primary"],
      "properties": {
        "media_location_id": { "$ref": "#/$defs/identifier" },
        "media_id": { "$ref": "#/$defs/identifier" },
        "storage_uri": { "$ref": "#/$defs/uri" },
        "storage_class": { "const": "private_local" },
        "verified_at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "is_primary": { "const": 1 }
      }
    },
    "rendition_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendition_id", "recording_id", "media_id", "rendition_kind", "label", "review_state", "metadata_json"],
      "properties": {
        "rendition_id": { "$ref": "#/$defs/identifier" },
        "recording_id": { "$ref": "#/$defs/identifier" },
        "media_id": { "$ref": "#/$defs/identifier" },
        "rendition_kind": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "label": { "$ref": "#/$defs/nullable_string" },
        "review_state": { "enum": ["unreviewed", "reviewed"] },
        "metadata_json": { "$ref": "#/$defs/database_json" }
      }
    },
    "recording_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recording_id", "canonical_key", "slug", "title", "date_label", "date_year", "date_basis", "duration_ms", "recording_type", "review_state", "merged_into_recording_id", "metadata_json", "created_at", "updated_at", "current_metadata_observation_id"],
      "properties": {
        "recording_id": { "$ref": "#/$defs/identifier" },
        "canonical_key": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "title": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "date_label": { "$ref": "#/$defs/nullable_string" },
        "date_year": { "type": ["integer", "null"] },
        "date_basis": { "type": "string", "minLength": 1, "maxLength": 256 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "recording_type": { "type": "string", "minLength": 1, "maxLength": 256 },
        "review_state": { "enum": ["metadata_only", "unreviewed", "reviewed"] },
        "merged_into_recording_id": { "type": "null" },
        "metadata_json": { "$ref": "#/$defs/database_json" },
        "created_at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "updated_at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "current_metadata_observation_id": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "timeline_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeline_map_span_id", "rendition_id", "ordinal", "media_start_ms", "media_end_ms", "recording_start_ms", "recording_end_ms", "mapping_kind", "confidence_state"],
      "properties": {
        "timeline_map_span_id": { "$ref": "#/$defs/identifier" },
        "rendition_id": { "$ref": "#/$defs/identifier" },
        "ordinal": { "const": 0 },
        "media_start_ms": { "const": 0 },
        "media_end_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "recording_start_ms": { "type": ["integer", "null"], "minimum": 0 },
        "recording_end_ms": { "type": ["integer", "null"], "minimum": 1 },
        "mapping_kind": { "enum": ["exact", "estimated", "edited", "gap", "unknown"] },
        "confidence_state": { "enum": ["metadata_only", "candidate", "reviewed"] }
      }
    },
    "derivation_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_media_id", "parent_media_id", "derivation_kind", "processing_run_id", "metadata_json"],
      "properties": {
        "child_media_id": { "$ref": "#/$defs/identifier" },
        "parent_media_id": { "$ref": "#/$defs/identifier" },
        "derivation_kind": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "metadata_json": { "$ref": "#/$defs/database_json" }
      }
    },
    "catalog_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "processing_run", "media", "media_location", "rendition", "recording", "timeline_span", "media_derivation", "binding_sha256"],
      "properties": {
        "artifact": { "$ref": "#/$defs/artifact_row" },
        "processing_run": { "$ref": "#/$defs/processing_run_row" },
        "media": { "$ref": "#/$defs/media_row" },
        "media_location": { "$ref": "#/$defs/media_location_row" },
        "rendition": { "$ref": "#/$defs/rendition_row" },
        "recording": { "$ref": "#/$defs/recording_row" },
        "timeline_span": { "$ref": "#/$defs/timeline_row" },
        "media_derivation": { "$ref": "#/$defs/derivation_row" },
        "binding_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "work_order_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "job_id", "path", "sha256", "canonical_sha256", "byte_count", "local_window_result", "catalog_binding"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "job_id": { "type": "string", "pattern": "^asr-raw-[0-9a-f]{32}$" },
        "path": { "type": "string", "pattern": "^work-orders/[0-9]{6}\\.json$", "maxLength": 256 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "local_window_result": { "$ref": "#/$defs/local_window_result" },
        "catalog_binding": { "$ref": "#/$defs/catalog_binding" }
      }
    }
  }
}
