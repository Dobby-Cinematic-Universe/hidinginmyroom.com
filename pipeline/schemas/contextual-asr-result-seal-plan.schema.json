{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/contextual-asr-result-seal-plan-v1.json",
  "title": "Manifest-bound contextual-ASR completed-result seal plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "created_at",
    "identity_sha256",
    "implementation",
    "importer_validator",
    "kind",
    "plan_id",
    "policy",
    "receipt_path",
    "result_count",
    "results",
    "schema_version",
    "source",
    "state",
    "store_root"
  ],
  "properties": {
    "authority": { "$ref": "#/$defs/authority" },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "identity_sha256": { "$ref": "#/$defs/sha256" },
    "implementation": { "$ref": "#/$defs/fileIdentity" },
    "importer_validator": { "$ref": "#/$defs/fileIdentity" },
    "kind": { "const": "contextual_asr_completed_result_seal_plan" },
    "plan_id": { "type": "string", "pattern": "^ctxasrsealplan_[0-9a-f]{32}$" },
    "policy": { "$ref": "#/$defs/policy" },
    "receipt_path": { "$ref": "#/$defs/absolutePath" },
    "result_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/result" }
    },
    "schema_version": { "const": 1 },
    "source": { "$ref": "#/$defs/source" },
    "state": { "const": "prepared_not_applied" },
    "store_root": { "$ref": "#/$defs/absolutePath" }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$",
      "maxLength": 4096
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "nullableIdentifier": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asr_execution",
        "catalog_import",
        "database_writes",
        "human_review_authority",
        "identity_authority",
        "network_access",
        "publication_authority",
        "transcript_preference_authority"
      ],
      "properties": {
        "asr_execution": { "const": false },
        "catalog_import": { "const": false },
        "database_writes": { "const": false },
        "human_review_authority": { "const": "none" },
        "identity_authority": { "const": "none" },
        "network_access": { "const": "none" },
        "publication_authority": { "const": "none" },
        "transcript_preference_authority": { "const": "none" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apply_lock_policy",
        "allowed_entries",
        "catalog_validation",
        "directory_mode_after",
        "directory_mode_before",
        "file_mode_after",
        "file_modes_before",
        "hardlink_policy",
        "result_set_policy",
        "rollback_policy",
        "symlink_policy",
        "transition_policy"
      ],
      "properties": {
        "apply_lock_policy": { "const": "retained_single_link_control_root_flock_receipt_check_through_commit" },
        "allowed_entries": {
          "type": "array",
          "prefixItems": [
            { "const": "result.json" },
            { "const": "transcript.normalized.json" },
            { "const": "whisper.raw.json" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "catalog_validation": { "const": "validate_asr_whispercpp_result_file_catalog_free" },
        "directory_mode_after": { "const": 320 },
        "directory_mode_before": { "const": 448 },
        "file_mode_after": { "const": 256 },
        "file_modes_before": {
          "type": "array",
          "prefixItems": [{ "const": 384 }, { "const": 420 }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "hardlink_policy": { "const": "source_control_and_result_files_require_nlink_1" },
        "result_set_policy": { "const": "one_explicit_result_per_contextual_manifest_work_order" },
        "rollback_policy": { "const": "best_effort_restore_exact_recorded_modes_before_receipt_commit" },
        "symlink_policy": { "const": "resolved_absolute_paths_plus_O_NOFOLLOW_retained_descriptors" },
        "transition_policy": { "const": "mode_only_two_phase_plan_then_apply" }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_count", "path", "sha256"],
      "properties": {
        "byte_count": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceWorkOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_count",
        "canonical_sha256",
        "input_sha256",
        "job_id",
        "ordinal",
        "path",
        "sha256"
      ],
      "properties": {
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "job_id": { "$ref": "#/$defs/identifier" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asr_output_root",
        "batch_id",
        "byte_count",
        "canonical_sha256",
        "glossary_revision_id",
        "identity_sha256",
        "manifest_path",
        "sha256",
        "work_order_count",
        "work_orders"
      ],
      "properties": {
        "asr_output_root": { "$ref": "#/$defs/absolutePath" },
        "batch_id": { "type": "string", "pattern": "^ctxasrbatch_[0-9a-f]{32}$" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "glossary_revision_id": { "$ref": "#/$defs/identifier" },
        "identity_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "work_order_count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "work_orders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/sourceWorkOrder" }
        }
      }
    },
    "directoryBefore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ctime_ns_before",
        "device",
        "inode",
        "mode_after",
        "mode_before",
        "mtime_ns",
        "nlink",
        "path"
      ],
      "properties": {
        "ctime_ns_before": { "type": "integer", "minimum": 0 },
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 1 },
        "mode_after": { "const": 320 },
        "mode_before": { "const": 448 },
        "mtime_ns": { "type": "integer", "minimum": 0 },
        "nlink": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "fileBefore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_count",
        "ctime_ns_before",
        "device",
        "inode",
        "mode_after",
        "mode_before",
        "mtime_ns",
        "name",
        "nlink",
        "path",
        "role",
        "sha256"
      ],
      "properties": {
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "ctime_ns_before": { "type": "integer", "minimum": 0 },
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 1 },
        "mode_after": { "const": 256 },
        "mode_before": { "enum": [384, 420] },
        "mtime_ns": { "type": "integer", "minimum": 0 },
        "name": { "enum": ["result.json", "transcript.normalized.json", "whisper.raw.json"] },
        "nlink": { "const": 1 },
        "path": { "$ref": "#/$defs/absolutePath" },
        "role": { "enum": ["result_envelope", "normalized_transcript", "raw_whisper_output"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "adapterValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_result_canonical_sha256",
        "glossary_revision_id",
        "processing_run_id",
        "recipe_id",
        "result_key",
        "result_path",
        "status",
        "work_order_sha256"
      ],
      "properties": {
        "baseline_result_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "glossary_revision_id": { "$ref": "#/$defs/identifier" },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "recipe_id": { "$ref": "#/$defs/identifier" },
        "result_key": { "$ref": "#/$defs/sha256" },
        "result_path": { "$ref": "#/$defs/absolutePath" },
        "status": { "const": "completed" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "catalogValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_count",
        "glossary_revision_id",
        "job_id",
        "model_id",
        "processing_run_id",
        "recipe_id",
        "recording_id",
        "rendition_id",
        "result_envelope_sha256",
        "result_key",
        "segment_count",
        "token_count"
      ],
      "properties": {
        "artifact_count": { "const": 2 },
        "glossary_revision_id": { "$ref": "#/$defs/identifier" },
        "job_id": { "$ref": "#/$defs/identifier" },
        "model_id": { "$ref": "#/$defs/identifier" },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "recipe_id": { "$ref": "#/$defs/identifier" },
        "recording_id": { "$ref": "#/$defs/nullableIdentifier" },
        "rendition_id": { "$ref": "#/$defs/nullableIdentifier" },
        "result_envelope_sha256": { "$ref": "#/$defs/sha256" },
        "result_key": { "$ref": "#/$defs/sha256" },
        "segment_count": { "type": "integer", "minimum": 0 },
        "token_count": { "type": "integer", "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_validation",
        "catalog_free_validation",
        "directory",
        "files",
        "input_sha256",
        "job_id",
        "ordinal",
        "recipe_id",
        "result_canonical_sha256",
        "result_key",
        "result_path",
        "source_ordinal",
        "work_order_physical_sha256",
        "work_order_sha256"
      ],
      "properties": {
        "adapter_validation": { "$ref": "#/$defs/adapterValidation" },
        "catalog_free_validation": { "$ref": "#/$defs/catalogValidation" },
        "directory": { "$ref": "#/$defs/directoryBefore" },
        "files": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/fileBefore" },
            { "$ref": "#/$defs/fileBefore" },
            { "$ref": "#/$defs/fileBefore" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "job_id": { "$ref": "#/$defs/identifier" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "recipe_id": { "$ref": "#/$defs/identifier" },
        "result_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "result_key": { "$ref": "#/$defs/sha256" },
        "result_path": { "$ref": "#/$defs/absolutePath" },
        "source_ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "work_order_physical_sha256": { "$ref": "#/$defs/sha256" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
