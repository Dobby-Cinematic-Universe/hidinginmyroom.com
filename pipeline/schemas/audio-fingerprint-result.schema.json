{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/audio-fingerprint-result-v1.schema.json",
  "title": "Offline FFmpeg Chromaprint result v1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "not": {"pattern": "://"}},
    "timestamp": {"type": "string", "format": "date-time"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "storage_uri", "sha256", "byte_count", "media_id", "artifact_id", "parent_processing_run_id", "duration_ms", "sample_rate_hz", "channels", "sample_format", "unchanged"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"}, "storage_uri": {"type": "string", "pattern": "^file:///"},
        "sha256": {"$ref": "#/$defs/sha256"}, "byte_count": {"type": "integer", "minimum": 1},
        "media_id": {"$ref": "#/$defs/identifier"}, "artifact_id": {"$ref": "#/$defs/identifier"},
        "parent_processing_run_id": {"$ref": "#/$defs/identifier"}, "duration_ms": {"type": "integer", "minimum": 1},
        "sample_rate_hz": {"const": 16000}, "channels": {"const": 1}, "sample_format": {"const": "s16"}, "unchanged": {"const": true}
      }
    },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "path", "sha256", "byte_count", "version_label", "version_output", "version_output_sha256", "build_configuration", "muxer_help", "muxer_help_sha256"],
      "properties": {
        "name": {"const": "ffmpeg"}, "path": {"$ref": "#/$defs/absolutePath"}, "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}, "version_label": {"type": "string", "minLength": 1},
        "version_output": {"type": "string", "minLength": 1}, "version_output_sha256": {"$ref": "#/$defs/sha256"},
        "build_configuration": {"type": ["string", "null"]}, "muxer_help": {"type": "string", "minLength": 1},
        "muxer_help_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selectionWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["window_id", "start_ms", "end_ms"],
      "properties": {"window_id": {"$ref": "#/$defs/identifier"}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}}
    },
    "selection": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "full_track"}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "windows"], "properties": {"mode": {"const": "explicit_windows"}, "windows": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/selectionWindow"}}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "chunk_duration_ms", "hop_ms", "include_partial_tail", "minimum_tail_ms"], "properties": {"mode": {"const": "fixed_chunks"}, "chunk_duration_ms": {"type": "integer", "minimum": 1000}, "hop_ms": {"type": "integer", "minimum": 1}, "include_partial_tail": {"type": "boolean"}, "minimum_tail_ms": {"type": "integer", "minimum": 1}}}
      ]
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "raw_format", "sample_rate_hz", "channels", "threads", "timeout_seconds", "selection"],
      "properties": {
        "algorithm": {"type": "integer", "minimum": 0}, "raw_format": {"const": "ffmpeg_chromaprint_fp_format_raw"},
        "sample_rate_hz": {"const": 16000}, "channels": {"const": 1}, "threads": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1}, "selection": {"$ref": "#/$defs/selection"}
      }
    },
    "expandedWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["window_id", "window_kind", "start_ms", "end_ms"],
      "properties": {"window_id": {"$ref": "#/$defs/identifier"}, "window_kind": {"enum": ["full_track", "explicit_window", "fixed_chunk", "partial_tail_chunk"]}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}}
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["processing_run_id", "execution_nonce", "started_at", "completed_at", "status"],
      "properties": {"processing_run_id": {"$ref": "#/$defs/identifier"}, "execution_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "started_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"$ref": "#/$defs/timestamp"}, "status": {"const": "completed"}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "processing_run_id", "artifact_kind", "path", "storage_uri", "sha256", "byte_count", "schema_version", "visibility", "metadata_json"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"}, "processing_run_id": {"$ref": "#/$defs/identifier"},
        "artifact_kind": {"const": "audio_fingerprint_chromaprint_raw"}, "path": {"$ref": "#/$defs/absolutePath"},
        "storage_uri": {"type": "string", "pattern": "^file:///"}, "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0, "maximum": 67108864}, "schema_version": {"const": 1}, "visibility": {"const": "private"}, "metadata_json": {"type": "string", "minLength": 2}
      }
    },
    "fingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint_id", "implementation_version", "window_id", "window_kind", "start_ms", "end_ms", "algorithm", "raw_format", "sample_rate_hz", "channels", "fingerprint_word_count", "quality_flags", "artifact"],
      "properties": {
        "fingerprint_id": {"$ref": "#/$defs/identifier"}, "implementation_version": {"type": "string", "minLength": 1}, "window_id": {"$ref": "#/$defs/identifier"},
        "window_kind": {"enum": ["full_track", "explicit_window", "fixed_chunk", "partial_tail_chunk"]},
        "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1},
        "algorithm": {"type": "integer", "minimum": 0}, "raw_format": {"const": "ffmpeg_chromaprint_fp_format_raw"},
        "sample_rate_hz": {"const": 16000}, "channels": {"const": 1}, "fingerprint_word_count": {"type": "integer", "minimum": 0},
        "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["recording_id", "rendition_id"],
      "properties": {"recording_id": {"$ref": "#/$defs/identifier"}, "rendition_id": {"$ref": "#/$defs/identifier"}}
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "stage", "implementation_version", "status", "dry_run", "job_id", "recipe_id", "recipe_sha256", "input", "engine", "fingerprint", "expanded_windows", "processing_run", "commands", "fingerprints", "quality_flags", "catalog_context", "result_path", "errors"],
  "properties": {
    "schema_version": {"const": 1}, "stage": {"const": "audio_fingerprint_chromaprint"}, "implementation_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "completed"]}, "dry_run": {"type": "boolean"}, "job_id": {"$ref": "#/$defs/identifier"},
    "recipe_id": {"type": "string", "pattern": "^recipe_audio_fingerprint_[0-9a-f]{32}$"}, "recipe_sha256": {"$ref": "#/$defs/sha256"},
    "input": {"$ref": "#/$defs/input"}, "engine": {"$ref": "#/$defs/engine"}, "fingerprint": {"$ref": "#/$defs/configuration"},
    "expanded_windows": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/expandedWindow"}},
    "processing_run": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/run"}]},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "fingerprints": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/fingerprint"}},
    "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "catalog_context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/context"}]},
    "result_path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/absolutePath"}]}, "errors": {"type": "array", "maxItems": 0}
  }
}
