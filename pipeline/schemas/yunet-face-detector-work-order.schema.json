{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/yunet-face-detector-work-order.schema.json",
  "title": "Private bounded YuNet face-detector work order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "policy",
    "runtime",
    "model",
    "parameters",
    "recording_id",
    "shots",
    "frames",
    "output"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "$ref": "#/$defs/id" },
    "policy": { "$ref": "#/$defs/policy" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "model": { "$ref": "#/$defs/model" },
    "parameters": { "$ref": "#/$defs/parameters" },
    "recording_id": { "$ref": "#/$defs/id" },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/shot" }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/frame" }
    },
    "output": { "$ref": "#/$defs/output" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "properties": {
              "material_scope": { "const": "public_single_shot_pilot_only" }
            },
            "required": ["material_scope"]
          }
        },
        "required": ["policy"]
      },
      "then": {
        "properties": {
          "shots": { "minItems": 1, "maxItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "absolutePath": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "runtimeFilePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_sha256", "expected_byte_count"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "expected_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        }
      }
    },
    "modelFilePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_sha256", "expected_byte_count"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "expected_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "frameFilePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_sha256", "expected_byte_count"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "expected_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "material_scope",
        "network_allowed",
        "embeddings_allowed",
        "identity_decision_allowed",
        "active_speaker_decision_allowed",
        "publication_authority",
        "human_review_required"
      ],
      "properties": {
        "visibility": { "const": "private" },
        "material_scope": {
          "enum": [
            "synthetic_fixture_only",
            "public_single_shot_pilot_only"
          ]
        },
        "network_allowed": { "const": false },
        "embeddings_allowed": { "const": false },
        "identity_decision_allowed": { "const": false },
        "active_speaker_decision_allowed": { "const": false },
        "publication_authority": { "const": "none" },
        "human_review_required": { "const": true }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expected_sha256",
        "expected_byte_count",
        "expected_version"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "expected_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "expected_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "runtimePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wheel", "binary", "expected_version"],
      "properties": {
        "wheel": { "$ref": "#/$defs/runtimeFilePin" },
        "binary": { "$ref": "#/$defs/runtimeFilePin" },
        "expected_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "opencvPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wheel",
        "binary",
        "expected_version",
        "expected_build_information_sha256"
      ],
      "properties": {
        "wheel": { "$ref": "#/$defs/runtimeFilePin" },
        "binary": { "$ref": "#/$defs/runtimeFilePin" },
        "expected_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_build_information_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_root", "python", "opencv", "numpy"],
      "properties": {
        "module_root": { "$ref": "#/$defs/absolutePath" },
        "python": { "$ref": "#/$defs/python" },
        "opencv": { "$ref": "#/$defs/opencvPackage" },
        "numpy": { "$ref": "#/$defs/runtimePackage" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "license",
        "upstream_url",
        "upstream_commit",
        "license_expression"
      ],
      "properties": {
        "artifact": { "$ref": "#/$defs/modelFilePin" },
        "license": { "$ref": "#/$defs/modelFilePin" },
        "upstream_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/opencv/opencv_zoo/",
          "maxLength": 2048
        },
        "upstream_commit": { "$ref": "#/$defs/commit" },
        "license_expression": { "const": "MIT" }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "score_threshold",
        "nms_threshold",
        "top_k",
        "threads",
        "backend",
        "target",
        "frame_period_ms",
        "max_frames",
        "max_detections_per_frame"
      ],
      "properties": {
        "recipe_id": { "const": "yunet_2023mar_opencv_cpu_0.9_0.3_5000_v1" },
        "score_threshold": { "const": 0.9 },
        "nms_threshold": { "const": 0.3 },
        "top_k": { "const": 5000 },
        "threads": { "const": 1 },
        "backend": { "const": "opencv_cpu" },
        "target": { "const": "cpu" },
        "frame_period_ms": { "const": 40 },
        "max_frames": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_detections_per_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "shot_ordinal",
        "start_frame_index",
        "end_frame_index_exclusive",
        "start_timestamp_ms",
        "end_timestamp_ms_exclusive"
      ],
      "properties": {
        "shot_id": { "$ref": "#/$defs/id" },
        "shot_ordinal": { "type": "integer", "minimum": 0, "maximum": 63 },
        "start_frame_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "end_frame_index_exclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000001
        },
        "start_timestamp_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1209600000
        },
        "end_timestamp_ms_exclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1209600001
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "shot_id",
        "frame_index",
        "timestamp_ms",
        "media_type",
        "input"
      ],
      "properties": {
        "frame_id": { "$ref": "#/$defs/id" },
        "shot_id": { "$ref": "#/$defs/id" },
        "frame_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1209600000
        },
        "media_type": { "const": "image/png" },
        "input": { "$ref": "#/$defs/frameFilePin" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": { "root": { "$ref": "#/$defs/absolutePath" } }
    }
  }
}
