{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/visual-fingerprint-work-order-v1.schema.json",
  "title": "Offline sparse visual-fingerprint work order v1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "not": {"pattern": "://"}},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "expected_sha256", "expected_byte_count", "media_id", "artifact_id", "parent_processing_run_id", "duration_ms", "timeline_origin_ms", "video_stream_selector", "sealed"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"}, "expected_sha256": {"$ref": "#/$defs/sha256"},
        "expected_byte_count": {"type": "integer", "minimum": 1}, "media_id": {"$ref": "#/$defs/identifier"},
        "artifact_id": {"$ref": "#/$defs/identifier"}, "parent_processing_run_id": {"$ref": "#/$defs/identifier"},
        "duration_ms": {"type": "integer", "minimum": 1, "maximum": 604800000},
        "timeline_origin_ms": {"type": "integer", "minimum": 0, "maximum": 604800000},
        "video_stream_selector": {"const": "0:v:0"}, "sealed": {"const": true}
      }
    },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["executable", "expected_sha256", "expected_byte_count", "expected_version_output_sha256", "expected_capabilities_output_sha256", "version_label"],
      "properties": {
        "executable": {"$ref": "#/$defs/absolutePath"}, "expected_sha256": {"$ref": "#/$defs/sha256"},
        "expected_byte_count": {"type": "integer", "minimum": 1}, "expected_version_output_sha256": {"$ref": "#/$defs/sha256"},
        "expected_capabilities_output_sha256": {"$ref": "#/$defs/sha256"}, "version_label": {"type": "string", "minLength": 1}
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_id", "window_id", "start_ms", "end_ms", "requested_timestamp_ms", "timestamp_kind"],
      "properties": {
        "sample_id": {"$ref": "#/$defs/identifier"}, "window_id": {"$ref": "#/$defs/identifier"},
        "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1},
        "requested_timestamp_ms": {"type": "integer", "minimum": 0}, "timestamp_kind": {"enum": ["explicit", "keyframe"]}
      }
    },
    "extraction": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "pixel_format", "width", "height", "scale_flags", "threads", "timeout_seconds_per_frame", "max_timestamp_drift_ms", "samples"],
      "properties": {
        "algorithm": {"const": "fixed_q20_dct_phash_8x8_v1"}, "pixel_format": {"const": "gray"},
        "width": {"const": 32}, "height": {"const": 32}, "scale_flags": {"const": "bilinear"}, "threads": {"const": 1},
        "timeout_seconds_per_frame": {"type": "integer", "minimum": 1, "maximum": 600},
        "max_timestamp_drift_ms": {"type": "integer", "minimum": 0, "maximum": 10000},
        "samples": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/sample"}}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["recording_id", "rendition_id"],
      "properties": {"recording_id": {"$ref": "#/$defs/identifier"}, "rendition_id": {"$ref": "#/$defs/identifier"}}
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["root"],
      "properties": {"root": {"$ref": "#/$defs/absolutePath"}}
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "job_id", "input", "engine", "extraction", "catalog_context", "output"],
  "properties": {
    "schema_version": {"const": 1}, "job_id": {"$ref": "#/$defs/identifier"}, "input": {"$ref": "#/$defs/input"},
    "engine": {"$ref": "#/$defs/engine"}, "extraction": {"$ref": "#/$defs/extraction"},
    "catalog_context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/context"}]}, "output": {"$ref": "#/$defs/output"}
  }
}
