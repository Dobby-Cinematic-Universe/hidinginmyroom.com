{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/longform-asr-span-transcript.schema.json",
  "title": "HIMR compact sample-native long-form ASR span transcript v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "work_order", "plan", "span_id", "analysis_sample_count", "language", "segments", "text", "segment_count", "word_count", "review_status", "semantics", "identity_sha256", "document_id"],
  "properties": {
    "kind": {"const": "himr_longform_asr_span_transcript"},
    "schema_version": {"const": 1},
    "work_order": {"$ref": "#/$defs/workOrderBinding"},
    "plan": {"$ref": "#/$defs/planBinding"},
    "span_id": {"type": "string", "pattern": "^lfspan_[0-9a-f]{32}$"},
    "analysis_sample_count": {"type": "integer", "minimum": 1},
    "language": {"const": "en"},
    "segments": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/segment"}},
    "text": {"type": "string", "maxLength": 16777216},
    "segment_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "word_count": {"type": "integer", "minimum": 0, "maximum": 10000000},
    "review_status": {"const": "unreviewed_machine_output"},
    "semantics": {"$ref": "#/$defs/semantics"},
    "identity_sha256": {"$ref": "#/$defs/sha256"},
    "document_id": {"type": "string", "pattern": "^longasrtranscript1_[0-9a-f]{32}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workOrderBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["work_order_id", "identity_sha256"],
      "properties": {"work_order_id": {"type": "string", "pattern": "^longasrwo1_[0-9a-f]{32}$"}, "identity_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "planBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "identity_sha256"],
      "properties": {"plan_id": {"type": "string", "pattern": "^lfplan_[0-9a-f]{32}$"}, "identity_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["temperature_raw", "average_log_probability_raw", "compression_ratio_raw", "no_speech_probability_raw"],
      "properties": {
        "temperature_raw": {"type": ["number", "null"]},
        "average_log_probability_raw": {"type": ["number", "null"]},
        "compression_ratio_raw": {"type": ["number", "null"]},
        "no_speech_probability_raw": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start_sample", "end_sample"],
      "properties": {
        "text": {"type": "string", "maxLength": 16384},
        "start_sample": {"type": ["integer", "null"], "minimum": 0},
        "end_sample": {"type": ["integer", "null"], "minimum": 0},
        "probability_raw": {"type": "number", "minimum": 0, "maximum": 1},
        "timing_clipped": {"const": true},
        "anomaly_flags": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["precedes_segment_start", "extends_beyond_segment_end", "start_regresses_from_previous", "overlaps_previous"]}
        }
      },
      "allOf": [
        {"if": {"properties": {"start_sample": {"type": "null"}}}, "then": {"properties": {"end_sample": {"type": "null"}}}},
        {"if": {"properties": {"start_sample": {"type": "integer"}}}, "then": {"properties": {"end_sample": {"type": "integer"}}}}
      ]
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "start_sample", "end_sample", "text", "words", "scores"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "start_sample": {"type": "integer", "minimum": 0},
        "end_sample": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "maxLength": 16777216},
        "words": {"type": "array", "items": {"$ref": "#/$defs/word"}},
        "scores": {"$ref": "#/$defs/scores"},
        "timing_clipped": {"const": true}
      }
    },
    "semantics": {
      "const": {
        "coordinate_system": "decode_span_local_16000hz_half_open_samples",
        "parent_projection": "add_result_span_analysis_start_sample",
        "recording_projection": "overlap_aware_assembler_required",
        "forced_language": "en",
        "language_selection_basis": "forced_by_execution_work_order",
        "language_detection_performed": false,
        "forced_language_probability": null,
        "raw_model_word_times": "nearest_16000hz_sample_preserved",
        "finite_paired_word_times": "non_inverted_required",
        "word_vs_segment_or_previous": "retained_and_explicitly_flagged",
        "word_timing_flags": ["precedes_segment_start", "extends_beyond_segment_end", "start_regresses_from_previous", "overlaps_previous"]
      }
    }
  }
}
