{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/transform-calibration-receipt-v1.schema.json",
  "title": "Private source/recording transform calibration receipt v1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "not": {"pattern": "://"}},
    "fileUri": {"type": "string", "pattern": "^file:///"},
    "fraction": {"type": "string", "pattern": "^-?[0-9]+/[1-9][0-9]*$"},
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode", "mtime_ns"],
      "properties": {
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "mtime_ns": {"type": "integer"}
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "storage_uri", "sha256", "byte_count", "mode", "nlink", "stat", "unchanged"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "storage_uri": {"$ref": "#/$defs/fileUri"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511},
        "nlink": {"const": 1},
        "stat": {"$ref": "#/$defs/stat"},
        "unchanged": {"const": true}
      }
    },
    "workOrderBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "storage_uri", "sha256", "byte_count", "mode", "nlink", "stat", "unchanged", "canonical_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "storage_uri": {"$ref": "#/$defs/fileUri"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511},
        "nlink": {"const": 1},
        "stat": {"$ref": "#/$defs/stat"},
        "unchanged": {"const": true},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "native_id", "canonical_url", "access_state"],
      "properties": {
        "platform": {"const": "youtube"},
        "native_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "canonical_url": {"type": "string", "pattern": "^https://www\\.youtube\\.com/watch\\?v="},
        "access_state": {"const": "public"}
      }
    },
    "selectedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format_id", "duration", "live_status", "availability", "timestamp", "upload_date"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "format_id": {"type": "string", "pattern": "^[1-9][0-9]{0,4}\\+[1-9][0-9]{0,4}$"},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "live_status": {"enum": ["post_live", "was_live"]},
        "availability": {"const": "public"},
        "timestamp": {"type": "integer", "minimum": 0},
        "upload_date": {"type": "string", "pattern": "^[0-9]{8}$"}
      }
    },
    "ytDlp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "executable_sha256", "version", "stat", "unchanged"],
      "properties": {
        "executable": {"$ref": "#/$defs/absolutePath"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1},
        "stat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["byte_count", "device", "inode", "mtime_ns"],
          "properties": {
            "byte_count": {"type": "integer", "minimum": 1},
            "device": {"type": "integer", "minimum": 0},
            "inode": {"type": "integer", "minimum": 1},
            "mtime_ns": {"type": "integer"}
          }
        },
        "unchanged": {"const": true}
      }
    },
    "probeVideoStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "codec_type", "codec_name", "duration_ms", "bit_rate_bps", "language", "width", "height", "pixel_format", "average_frame_rate"],
      "properties": {
        "index": {"type": ["integer", "null"], "minimum": 0},
        "codec_type": {"const": "video"},
        "codec_name": {"type": ["string", "null"], "maxLength": 1000},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "bit_rate_bps": {"type": ["integer", "null"], "minimum": 0},
        "language": {"type": ["string", "null"], "maxLength": 1000},
        "width": {"type": ["integer", "null"], "minimum": 0},
        "height": {"type": ["integer", "null"], "minimum": 0},
        "pixel_format": {"type": ["string", "null"], "maxLength": 1000},
        "average_frame_rate": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "probeAudioStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "codec_type", "codec_name", "duration_ms", "bit_rate_bps", "language", "sample_rate_hz", "channels", "channel_layout"],
      "properties": {
        "index": {"type": ["integer", "null"], "minimum": 0},
        "codec_type": {"const": "audio"},
        "codec_name": {"type": ["string", "null"], "maxLength": 1000},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "bit_rate_bps": {"type": ["integer", "null"], "minimum": 0},
        "language": {"type": ["string", "null"], "maxLength": 1000},
        "sample_rate_hz": {"type": ["integer", "null"], "minimum": 0},
        "channels": {"type": ["integer", "null"], "minimum": 0},
        "channel_layout": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "acquisitionProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "format", "streams", "tool"],
      "properties": {
        "schema_version": {"const": 1},
        "format": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bit_rate_bps", "duration_ms", "format_long_name", "format_name"],
          "properties": {
            "bit_rate_bps": {"type": "integer", "minimum": 1},
            "duration_ms": {"type": "integer", "minimum": 1},
            "format_long_name": {"type": "string", "minLength": 1},
            "format_name": {"type": "string", "minLength": 1}
          }
        },
        "streams": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/probeVideoStream"},
              {"$ref": "#/$defs/probeAudioStream"}
            ]
          },
          "allOf": [
            {"contains": {"$ref": "#/$defs/probeVideoStream"}, "minContains": 1, "maxContains": 1},
            {"contains": {"$ref": "#/$defs/probeAudioStream"}, "minContains": 1, "maxContains": 1}
          ]
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {"name": {"const": "ffprobe"}, "version": {"type": "string", "minLength": 1}}
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "work_order", "result", "job_id", "work_order_sha256", "source", "selected_remote_metadata", "media", "acquisition_probe", "yt_dlp", "credential_free", "publication_authority", "raw_work_order_sha256", "raw_result_sha256"],
      "properties": {
        "role": {"enum": ["earlier_post_live", "finalized_was_live"]},
        "work_order": {"$ref": "#/$defs/workOrderBinding"},
        "result": {"$ref": "#/$defs/fileBinding"},
        "job_id": {"$ref": "#/$defs/identifier"},
        "work_order_sha256": {"$ref": "#/$defs/sha256"},
        "source": {"$ref": "#/$defs/source"},
        "selected_remote_metadata": {"$ref": "#/$defs/selectedMetadata"},
        "media": {"$ref": "#/$defs/fileBinding"},
        "acquisition_probe": {"$ref": "#/$defs/acquisitionProbe"},
        "yt_dlp": {"$ref": "#/$defs/ytDlp"},
        "credential_free": {"const": true},
        "publication_authority": {"const": "none"},
        "raw_work_order_sha256": {"$ref": "#/$defs/sha256"},
        "raw_result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "storage_uri", "sha256", "byte_count", "mode", "nlink", "stat", "unchanged", "version_line", "unchanged_during_run"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "storage_uri": {"$ref": "#/$defs/fileUri"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511},
        "nlink": {"const": 1},
        "stat": {"$ref": "#/$defs/stat"},
        "unchanged": {"const": true},
        "version_line": {"type": "string", "minLength": 1},
        "unchanged_during_run": {"const": true}
      }
    },
    "pythonExecutable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "storage_uri", "sha256", "byte_count", "mode", "nlink", "stat", "unchanged", "version", "platform"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "storage_uri": {"$ref": "#/$defs/fileUri"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511},
        "nlink": {"const": 1},
        "stat": {"$ref": "#/$defs/stat"},
        "unchanged": {"const": true},
        "version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "root", "tree_sha256", "file_count", "byte_count"],
      "properties": {
        "name": {"enum": ["numpy", "scipy"]},
        "version": {"type": "string", "minLength": 1},
        "root": {"$ref": "#/$defs/absolutePath"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1, "maximum": 20000},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "exactStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "codec_type", "codec_name", "time_base", "start_pts", "start_time", "duration_ts", "duration", "duration_ms", "r_frame_rate", "avg_frame_rate", "nb_frames", "sample_rate", "channels", "width", "height", "pixel_format"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "codec_type": {"enum": ["video", "audio"]},
        "codec_name": {"type": "string", "minLength": 1},
        "time_base": {"$ref": "#/$defs/fraction"},
        "start_pts": {"const": 0},
        "start_time": {"type": "string", "minLength": 1},
        "duration_ts": {"type": "integer", "minimum": 1},
        "duration": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "integer", "minimum": 1},
        "r_frame_rate": {"type": "string"},
        "avg_frame_rate": {"type": "string"},
        "nb_frames": {"type": ["string", "null"]},
        "sample_rate": {"type": ["string", "null"]},
        "channels": {"type": ["integer", "null"]},
        "width": {"type": ["integer", "null"]},
        "height": {"type": ["integer", "null"]},
        "pixel_format": {"type": ["string", "null"]}
      }
    },
    "exactProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "raw_stdout_sha256", "format", "streams", "video_duration_ms", "audio_duration_ms"],
      "properties": {
        "command": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string", "minLength": 1}},
        "raw_stdout_sha256": {"$ref": "#/$defs/sha256"},
        "format": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format_name", "start_time", "duration", "size"],
          "properties": {
            "format_name": {"type": "string", "minLength": 1},
            "start_time": {"type": "string", "minLength": 1},
            "duration": {"type": "string", "minLength": 1},
            "size": {"type": "integer", "minimum": 1}
          }
        },
        "streams": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/exactStream"}},
        "video_duration_ms": {"type": "integer", "minimum": 1},
        "audio_duration_ms": {"type": "integer", "minimum": 1}
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old_start_ms", "finalized_start", "window_ms", "ssim_y", "ssim_u", "ssim_v", "ssim_all", "summary_sha256"],
      "properties": {
        "old_start_ms": {"type": "integer", "minimum": 0},
        "finalized_start": {"$ref": "#/$defs/fraction"},
        "window_ms": {"type": "integer", "minimum": 1},
        "ssim_y": {"type": "number", "minimum": 0, "maximum": 1},
        "ssim_u": {"type": "number", "minimum": 0, "maximum": 1},
        "ssim_v": {"type": "number", "minimum": 0, "maximum": 1},
        "ssim_all": {"type": "number", "minimum": 0, "maximum": 1},
        "summary_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old_start_ms", "target_start", "search_start", "search_radius_ms", "window_ms", "sample_rate_hz", "local_pcm_sha256", "search_pcm_sha256", "local_sample_count", "search_sample_count", "peak_sample_offset", "best_finalized_start", "best_offset_from_old_ms", "normalized_correlation"],
      "properties": {
        "old_start_ms": {"type": "integer", "minimum": 0},
        "target_start": {"$ref": "#/$defs/fraction"},
        "search_start": {"$ref": "#/$defs/fraction"},
        "search_radius_ms": {"type": "integer", "minimum": 1},
        "window_ms": {"type": "integer", "minimum": 1},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "local_pcm_sha256": {"$ref": "#/$defs/sha256"},
        "search_pcm_sha256": {"$ref": "#/$defs/sha256"},
        "local_sample_count": {"type": "integer", "minimum": 1},
        "search_sample_count": {"type": "integer", "minimum": 1},
        "peak_sample_offset": {"type": "integer", "minimum": 0},
        "best_finalized_start": {"$ref": "#/$defs/fraction"},
        "best_offset_from_old_ms": {"type": "number"},
        "normalized_correlation": {"type": "number", "minimum": -1, "maximum": 1}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "checkpoint_ms", "identity_target", "scaled_target", "scaled_drift_ms", "discriminating", "identity_visual", "scaled_visual", "visual_margin", "identity_audio", "scaled_audio", "audio_margin", "contradicts_scaled"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 16},
        "checkpoint_ms": {"type": "integer", "minimum": 0},
        "identity_target": {"$ref": "#/$defs/fraction"},
        "scaled_target": {"$ref": "#/$defs/fraction"},
        "scaled_drift_ms": {"type": "number", "maximum": 0},
        "discriminating": {"type": "boolean"},
        "identity_visual": {"$ref": "#/$defs/visual"},
        "scaled_visual": {"$ref": "#/$defs/visual"},
        "visual_margin": {"type": "number"},
        "identity_audio": {"$ref": "#/$defs/audio"},
        "scaled_audio": {"$ref": "#/$defs/audio"},
        "audio_margin": {"type": "number"},
        "contradicts_scaled": {"type": "boolean"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "implementation_version", "status", "visibility", "receipt_path", "source", "candidate_references", "acquisitions", "tools", "probes", "recipe", "duration_accounting", "comparisons", "conclusions", "safety", "identity_sha256", "receipt_id"],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"const": "private_source_recording_transform_calibration"},
    "implementation_version": {"enum": ["0.1.0", "0.2.0"]},
    "status": {"const": "completed"},
    "visibility": {"const": "private"},
    "receipt_path": {"$ref": "#/$defs/absolutePath"},
    "source": {"$ref": "#/$defs/source"},
    "candidate_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_accessed", "relationship_asserted", "identity", "scaled"],
      "properties": {
        "catalog_accessed": {"const": false},
        "relationship_asserted": {"const": false},
        "identity": {
          "type": "object", "additionalProperties": false,
          "required": ["transform_candidate_id", "candidate_kind", "scale_numerator", "scale_denominator"],
          "properties": {"transform_candidate_id": {"$ref": "#/$defs/identifier"}, "candidate_kind": {"const": "identity_from_acquired_media_duration_hypothesis"}, "scale_numerator": {"const": 1}, "scale_denominator": {"const": 1}}
        },
        "scaled": {
          "type": "object", "additionalProperties": false,
          "required": ["transform_candidate_id", "candidate_kind", "scale_numerator", "scale_denominator"],
          "properties": {"transform_candidate_id": {"$ref": "#/$defs/identifier"}, "candidate_kind": {"const": "linear_scale_to_declared_recording_duration_hypothesis"}, "scale_numerator": {"type": "integer", "minimum": 1}, "scale_denominator": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "acquisitions": {
      "type": "object", "additionalProperties": false, "required": ["earlier", "finalized"],
      "properties": {"earlier": {"$ref": "#/$defs/acquisition"}, "finalized": {"$ref": "#/$defs/acquisition"}}
    },
    "tools": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "python", "ffmpeg", "ffprobe", "numpy", "scipy"],
      "properties": {
        "implementation": {"$ref": "#/$defs/fileBinding"},
        "python": {"$ref": "#/$defs/pythonExecutable"},
        "ffmpeg": {"$ref": "#/$defs/executable"},
        "ffprobe": {"$ref": "#/$defs/executable"},
        "numpy": {"$ref": "#/$defs/package"},
        "scipy": {"$ref": "#/$defs/package"}
      }
    },
    "probes": {"type": "object", "additionalProperties": false, "required": ["earlier", "finalized"], "properties": {"earlier": {"$ref": "#/$defs/exactProbe"}, "finalized": {"$ref": "#/$defs/exactProbe"}}},
    "recipe": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "checkpoints_ms", "visual_window_ms", "audio_window_ms", "identity_audio_search_radius_ms", "scaled_audio_search_radius_ms", "audio_sample_rate_hz", "thresholds"],
      "properties": {
        "algorithm": {"const": "distributed_av_shared_prefix_affine_v1"},
        "checkpoints_ms": {"type": "array", "minItems": 3, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "visual_window_ms": {"type": "integer", "minimum": 1},
        "audio_window_ms": {"type": "integer", "minimum": 1},
        "identity_audio_search_radius_ms": {"type": "integer", "minimum": 1},
        "scaled_audio_search_radius_ms": {"type": "integer", "minimum": 1},
        "audio_sample_rate_hz": {"type": "integer", "minimum": 1},
        "thresholds": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum_identity_ssim", "minimum_identity_audio_correlation", "minimum_visual_margin", "minimum_audio_margin", "maximum_identity_audio_offset_range_ms", "minimum_discriminating_drift_ms", "minimum_contradicting_checkpoints"],
          "properties": {
            "minimum_identity_ssim": {"type": "number", "minimum": 0.98, "maximum": 1},
            "minimum_identity_audio_correlation": {"type": "number", "minimum": 0.95, "maximum": 1},
            "minimum_visual_margin": {"type": "number", "minimum": 0.03, "maximum": 1},
            "minimum_audio_margin": {"type": "number", "minimum": 0.10, "maximum": 1},
            "maximum_identity_audio_offset_range_ms": {"const": 2.0},
            "minimum_discriminating_drift_ms": {"const": 1000.0},
            "minimum_contradicting_checkpoints": {"const": 2}
          }
        }
      }
    },
    "duration_accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["declared_recording_duration_ms", "earlier_video_duration_ms", "earlier_audio_duration_ms", "finalized_video_duration_ms", "finalized_audio_duration_ms", "stale_metadata_delta_ms", "uncovered_finalized_video_tail", "uncovered_finalized_audio_tail_ms"],
      "properties": {
        "declared_recording_duration_ms": {"type": "integer", "minimum": 1},
        "earlier_video_duration_ms": {"type": "integer", "minimum": 1},
        "earlier_audio_duration_ms": {"type": "integer", "minimum": 1},
        "finalized_video_duration_ms": {"type": "integer", "minimum": 1},
        "finalized_audio_duration_ms": {"type": "integer", "minimum": 1},
        "stale_metadata_delta_ms": {"type": "integer", "minimum": 1},
        "uncovered_finalized_video_tail": {"type": "object", "additionalProperties": false, "required": ["boundary", "start_ms", "end_ms", "duration_ms"], "properties": {"boundary": {"const": "half_open"}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}, "duration_ms": {"type": "integer", "minimum": 1}}},
        "uncovered_finalized_audio_tail_ms": {"type": "integer", "minimum": 1}
      }
    },
    "comparisons": {"type": "array", "minItems": 3, "maxItems": 16, "items": {"$ref": "#/$defs/comparison"}},
    "conclusions": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_class", "shared_prefix_identity_mapping_supported", "shared_prefix_mapping", "identity_audio_offset_range_ms", "scaled_candidate_contradicted", "scaled_contradicting_checkpoint_count", "catalog_transform_decision", "review_decision", "publication_decision", "relationship_decision", "timeline_application_allowed", "transcript_projection_allowed", "requires_separate_catalog_promotion_contract"],
      "properties": {
        "evidence_class": {"const": "deterministic_private_machine_calibration_evidence"},
        "shared_prefix_identity_mapping_supported": {"const": true},
        "shared_prefix_mapping": {"type": "object", "additionalProperties": false, "required": ["boundary", "source_start_ms", "source_end_ms", "finalized_start_ms", "finalized_end_ms", "scale_numerator", "scale_denominator", "offset_ms"], "properties": {"boundary": {"const": "half_open"}, "source_start_ms": {"const": 0}, "source_end_ms": {"type": "integer", "minimum": 1}, "finalized_start_ms": {"const": 0}, "finalized_end_ms": {"type": "integer", "minimum": 1}, "scale_numerator": {"const": 1}, "scale_denominator": {"const": 1}, "offset_ms": {"const": 0}}},
        "identity_audio_offset_range_ms": {"type": "number", "minimum": 0, "maximum": 2},
        "scaled_candidate_contradicted": {"const": true},
        "scaled_contradicting_checkpoint_count": {"type": "integer", "minimum": 2},
        "catalog_transform_decision": {"type": "null"},
        "review_decision": {"type": "null"},
        "publication_decision": {"type": "null"},
        "relationship_decision": {"type": "null"},
        "timeline_application_allowed": {"const": false},
        "transcript_projection_allowed": {"const": false},
        "requires_separate_catalog_promotion_contract": {"const": true}
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_opened", "catalog_mutated", "credentials_allowed", "credentials_used", "network_access_by_receipt_producer", "source_acquisitions_used_network", "publication_authority", "relationship_authority", "review_authority", "transcript_text_read", "transcript_text_emitted"],
