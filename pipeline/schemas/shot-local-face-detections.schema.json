{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/shot-local-face-detections.schema.json",
  "title": "Sealed frame-local anonymous face detections",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "recording_id",
    "coordinate_system",
    "detector",
    "authority",
    "shots",
    "frames"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "frame_local_face_detections" },
    "recording_id": { "$ref": "#/$defs/id" },
    "coordinate_system": { "const": "pixel_xywh_top_left" },
    "detector": { "$ref": "#/$defs/detector" },
    "authority": { "$ref": "#/$defs/authority" },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": { "$ref": "#/$defs/shot" }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "recipe_id"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recipe_id": { "$ref": "#/$defs/id" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embeddings_present",
        "identity_state",
        "identity_label",
        "active_speaker_state",
        "active_speaker_score",
        "publication"
      ],
      "properties": {
        "embeddings_present": { "const": false },
        "identity_state": { "const": "unknown" },
        "identity_label": { "type": "null" },
        "active_speaker_state": { "const": "unknown" },
        "active_speaker_score": { "type": "null" },
        "publication": { "const": false }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "shot_ordinal",
        "start_frame_index",
        "end_frame_index_exclusive",
        "start_timestamp_ms",
        "end_timestamp_ms_exclusive"
      ],
      "properties": {
        "shot_id": { "$ref": "#/$defs/id" },
        "shot_ordinal": { "type": "integer", "minimum": 0, "maximum": 49999 },
        "start_frame_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "end_frame_index_exclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000001
        },
        "start_timestamp_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1209600000
        },
        "end_timestamp_ms_exclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1209600001
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detection_id",
        "detection_ordinal",
        "box",
        "landmarks",
        "detector_score",
        "below_64px_width"
      ],
      "properties": {
        "detection_id": { "$ref": "#/$defs/id" },
        "detection_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "box": { "$ref": "#/$defs/box" },
        "landmarks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/point" }
        },
        "detector_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "below_64px_width": { "type": "boolean" }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "shot_id",
        "frame_index",
        "timestamp_ms",
        "width",
        "height",
        "detections"
      ],
      "properties": {
        "frame_id": { "$ref": "#/$defs/id" },
        "shot_id": { "$ref": "#/$defs/id" },
        "frame_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1209600000
        },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "detections": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/detection" }
        }
      }
    }
  }
}
