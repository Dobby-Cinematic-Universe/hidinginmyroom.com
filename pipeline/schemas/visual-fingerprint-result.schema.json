{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/visual-fingerprint-result-v1.schema.json",
  "title": "Offline sparse visual-fingerprint result v1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "not": {"pattern": "://"}},
    "timestampText": {"type": "string", "format": "date-time"},
    "stat": {
      "type": "object", "additionalProperties": false, "required": ["device", "inode", "mtime_ns"],
      "properties": {"device": {"type": "integer"}, "inode": {"type": "integer"}, "mtime_ns": {"type": "integer"}}
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "storage_uri", "sha256", "byte_count", "stat", "unchanged", "media_id", "artifact_id", "parent_processing_run_id", "duration_ms", "timeline_origin_ms", "video_stream_selector", "sealed"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"}, "storage_uri": {"type": "string", "pattern": "^file:///"},
        "sha256": {"$ref": "#/$defs/sha256"}, "byte_count": {"type": "integer", "minimum": 1}, "stat": {"$ref": "#/$defs/stat"},
        "unchanged": {"const": true}, "media_id": {"$ref": "#/$defs/identifier"}, "artifact_id": {"$ref": "#/$defs/identifier"},
        "parent_processing_run_id": {"$ref": "#/$defs/identifier"}, "duration_ms": {"type": "integer", "minimum": 1},
        "timeline_origin_ms": {"type": "integer", "minimum": 0}, "video_stream_selector": {"const": "0:v:0"}, "sealed": {"const": true}
      }
    },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "path", "sha256", "byte_count", "version_label", "version_output", "version_output_sha256", "capabilities_output", "capabilities_output_sha256"],
      "properties": {
        "name": {"const": "ffmpeg"}, "path": {"$ref": "#/$defs/absolutePath"}, "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}, "version_label": {"type": "string", "minLength": 1},
        "version_output": {"type": "string", "minLength": 1}, "version_output_sha256": {"$ref": "#/$defs/sha256"},
        "capabilities_output": {"type": "string", "minLength": 1}, "capabilities_output_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "byte_count", "python_version"],
      "properties": {"path": {"$ref": "#/$defs/absolutePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_count": {"type": "integer", "minimum": 1}, "python_version": {"type": "string", "minLength": 1}}
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_id", "window_id", "start_ms", "end_ms", "requested_timestamp_ms", "timestamp_kind"],
      "properties": {"sample_id": {"$ref": "#/$defs/identifier"}, "window_id": {"$ref": "#/$defs/identifier"}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}, "requested_timestamp_ms": {"type": "integer", "minimum": 0}, "timestamp_kind": {"enum": ["explicit", "keyframe"]}}
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "pixel_format", "width", "height", "scale_flags", "threads", "timeout_seconds_per_frame", "max_timestamp_drift_ms", "samples"],
      "properties": {
        "algorithm": {"const": "fixed_q20_dct_phash_8x8_v1"}, "pixel_format": {"const": "gray"}, "width": {"const": 32}, "height": {"const": 32},
        "scale_flags": {"const": "bilinear"}, "threads": {"const": 1}, "timeout_seconds_per_frame": {"type": "integer", "minimum": 1},
        "max_timestamp_drift_ms": {"type": "integer", "minimum": 0}, "samples": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/sample"}}
      }
    },
    "recipeInput": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_sha256", "expected_byte_count", "media_id", "artifact_id", "parent_processing_run_id", "duration_ms", "timeline_origin_ms", "video_stream_selector"],
      "properties": {"expected_sha256": {"$ref": "#/$defs/sha256"}, "expected_byte_count": {"type": "integer", "minimum": 1}, "media_id": {"$ref": "#/$defs/identifier"}, "artifact_id": {"$ref": "#/$defs/identifier"}, "parent_processing_run_id": {"$ref": "#/$defs/identifier"}, "duration_ms": {"type": "integer", "minimum": 1}, "timeline_origin_ms": {"type": "integer", "minimum": 0}, "video_stream_selector": {"const": "0:v:0"}}
    },
    "recipeEngine": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "version_output_sha256", "capabilities_output_sha256"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "version_output_sha256": {"$ref": "#/$defs/sha256"}, "capabilities_output_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "hashDefinition": {
      "type": "object", "additionalProperties": false, "required": ["grayscale_bytes", "dct_matrix", "coefficients", "dc_bit", "threshold", "bit_order"],
      "properties": {"grayscale_bytes": {"const": 1024}, "dct_matrix": {"const": "committed_signed_q20_cosine_8x32"}, "coefficients": {"const": "top_left_8x8"}, "dc_bit": {"const": 0}, "threshold": {"const": "strictly_greater_than_median_of_63_ac_coefficients"}, "bit_order": {"const": "row_major_most_significant_bit_first"}}
    },
    "recipe": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "stage", "implementation_version", "implementation_sha256", "input", "engine", "extraction", "hash_definition"],
      "properties": {"schema_version": {"const": 1}, "stage": {"const": "visual_fingerprint_extract"}, "implementation_version": {"type": "string", "minLength": 1}, "implementation_sha256": {"$ref": "#/$defs/sha256"}, "input": {"$ref": "#/$defs/recipeInput"}, "engine": {"$ref": "#/$defs/recipeEngine"}, "extraction": {"$ref": "#/$defs/configuration"}, "hash_definition": {"$ref": "#/$defs/hashDefinition"}}
    },
    "decodedTimestamp": {
      "type": "object", "additionalProperties": false,
      "required": ["pts", "duration_pts", "time_base_numerator", "time_base_denominator", "absolute_timestamp_us", "relative_timestamp_us", "relative_timestamp_ms", "duration_us", "is_keyframe"],
      "properties": {"pts": {"type": "integer", "minimum": 0}, "duration_pts": {"type": "integer", "minimum": 1}, "time_base_numerator": {"type": "integer", "minimum": 1}, "time_base_denominator": {"type": "integer", "minimum": 1}, "absolute_timestamp_us": {"type": "integer", "minimum": 0}, "relative_timestamp_us": {"type": "integer"}, "relative_timestamp_ms": {"type": "integer"}, "duration_us": {"type": "integer", "minimum": 1}, "is_keyframe": {"type": "boolean"}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_kind", "path", "storage_uri", "sha256", "byte_count", "width", "height", "pixel_format", "visibility"],
      "properties": {"artifact_id": {"$ref": "#/$defs/identifier"}, "artifact_kind": {"const": "visual_fingerprint_gray32"}, "path": {"$ref": "#/$defs/absolutePath"}, "storage_uri": {"type": "string", "pattern": "^file:///"}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_count": {"const": 1024}, "width": {"const": 32}, "height": {"const": 32}, "pixel_format": {"const": "gray"}, "visibility": {"const": "private"}}
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint_id", "ordinal", "sample_id", "window_id", "start_ms", "end_ms", "requested_timestamp_ms", "timestamp_kind", "decoded_timestamp", "timestamp_drift_us", "algorithm", "phash_bits", "phash_hex", "phash_popcount", "exact_gray_sha256", "quality_flags", "artifact"],
      "properties": {"fingerprint_id": {"$ref": "#/$defs/identifier"}, "ordinal": {"type": "integer", "minimum": 0}, "sample_id": {"$ref": "#/$defs/identifier"}, "window_id": {"$ref": "#/$defs/identifier"}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}, "requested_timestamp_ms": {"type": "integer", "minimum": 0}, "timestamp_kind": {"enum": ["explicit", "keyframe"]}, "decoded_timestamp": {"$ref": "#/$defs/decodedTimestamp"}, "timestamp_drift_us": {"type": "integer", "minimum": 0}, "algorithm": {"const": "fixed_q20_dct_phash_8x8_v1"}, "phash_bits": {"const": 64}, "phash_hex": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "phash_popcount": {"type": "integer", "minimum": 0, "maximum": 64}, "exact_gray_sha256": {"$ref": "#/$defs/sha256"}, "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "artifact": {"$ref": "#/$defs/artifact"}}
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["processing_run_id", "started_at", "completed_at", "status"],
      "properties": {"processing_run_id": {"$ref": "#/$defs/identifier"}, "started_at": {"$ref": "#/$defs/timestampText"}, "completed_at": {"$ref": "#/$defs/timestampText"}, "status": {"const": "completed"}}
    },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["recording_id", "rendition_id"],
      "properties": {"recording_id": {"$ref": "#/$defs/identifier"}, "rendition_id": {"$ref": "#/$defs/identifier"}}
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "stage", "implementation_version", "status", "dry_run", "job_id", "work_order_sha256", "recipe", "recipe_id", "recipe_sha256", "result_key", "implementation", "input", "engine", "configuration", "processing_run", "commands", "frames", "quality_flags", "catalog_context", "result_path", "errors"],
  "properties": {
    "schema_version": {"const": 1}, "stage": {"const": "visual_fingerprint_extract"}, "implementation_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "completed"]}, "dry_run": {"type": "boolean"}, "job_id": {"$ref": "#/$defs/identifier"}, "work_order_sha256": {"$ref": "#/$defs/sha256"},
    "recipe": {"$ref": "#/$defs/recipe"}, "recipe_id": {"type": "string", "pattern": "^recipe_visual_fingerprint_[0-9a-f]{32}$"}, "recipe_sha256": {"$ref": "#/$defs/sha256"}, "result_key": {"$ref": "#/$defs/sha256"},
    "implementation": {"$ref": "#/$defs/implementation"}, "input": {"$ref": "#/$defs/input"}, "engine": {"$ref": "#/$defs/engine"}, "configuration": {"$ref": "#/$defs/configuration"},
    "processing_run": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/run"}]}, "commands": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "frames": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/frame"}}, "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "catalog_context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/context"}]}, "result_path": {"$ref": "#/$defs/absolutePath"}, "errors": {"type": "array", "maxItems": 0}
  }
}
