{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/work-order-v1.json",
  "title": "HIMR media preprocessing work order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "source",
    "output",
    "operations",
    "profile"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_sha256", "first_cataloged_at"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "expected_sha256": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          ]
        },
        "first_cataloged_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time", "maxLength": 100 }
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "pattern": "^/" }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "audio_flac", "proxy", "routing"],
      "properties": {
        "probe": { "const": true },
        "audio_flac": { "type": "boolean" },
        "proxy": { "type": "boolean" },
        "routing": { "type": "boolean" }
      }
    },
    "profile": { "$ref": "#/$defs/profile" }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "ffmpeg_threads",
        "audio_sample_rate_hz",
        "audio_channels",
        "audio_sample_format",
        "flac_compression_level",
        "proxy_width",
        "proxy_height",
        "proxy_fps",
        "proxy_video_codec",
        "proxy_preset",
        "proxy_crf",
        "proxy_audio_codec",
        "proxy_audio_bitrate",
        "scene_threshold_percent",
        "silence_noise_db",
        "silence_min_duration_ms",
        "near_silent_fraction"
      ],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "ffmpeg_threads": { "type": "integer", "minimum": 1, "maximum": 32 },
        "audio_sample_rate_hz": { "const": 16000 },
        "audio_channels": { "const": 1 },
        "audio_sample_format": { "const": "s16" },
        "flac_compression_level": { "type": "integer", "minimum": 0, "maximum": 12 },
        "proxy_width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1280,
          "description": "Runtime validation also caps width multiplied by height at 1280x720 pixels."
        },
        "proxy_height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1280,
          "description": "Runtime validation also caps width multiplied by height at 1280x720 pixels."
        },
        "proxy_fps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "proxy_video_codec": { "type": "string", "minLength": 1 },
        "proxy_preset": { "type": "string", "minLength": 1 },
        "proxy_crf": { "type": "integer", "minimum": 0, "maximum": 51 },
        "proxy_audio_codec": { "type": "string", "minLength": 1 },
        "proxy_audio_bitrate": { "type": "string", "minLength": 1 },
        "scene_threshold_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "silence_noise_db": { "type": "number", "minimum": -100, "maximum": 0 },
        "silence_min_duration_ms": { "type": "integer", "minimum": 1 },
        "near_silent_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
