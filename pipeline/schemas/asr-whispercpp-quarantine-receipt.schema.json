{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/pipeline/asr-whispercpp-quarantine-receipt-v1.json",
  "title": "HIMR quarantined whisper.cpp output-json-full receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "failure_key",
    "invalid_utf8",
    "raw_artifact",
    "lineage",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_kind": { "const": "whispercpp_output_json_full_invalid_utf8" },
    "failure_key": { "$ref": "#/$defs/sha256" },
    "invalid_utf8": { "$ref": "#/$defs/invalidUtf8" },
    "raw_artifact": { "$ref": "#/$defs/rawArtifact" },
    "lineage": { "$ref": "#/$defs/lineage" },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1,
      "maxLength": 4096
    },
    "invalidUtf8": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decoder", "start_byte", "end_byte", "reason"],
      "properties": {
        "decoder": { "const": "utf-8-strict" },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "rawArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "path",
        "storage_uri",
        "byte_count",
        "sha256",
        "visibility"
      ],
      "properties": {
        "artifact_kind": { "const": "whispercpp_output_json_full_quarantine" },
        "path": { "$ref": "#/$defs/path" },
        "storage_uri": { "type": "string", "pattern": "^file:///" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "visibility": { "const": "private" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "work_order_sha256",
        "recipe_id",
        "result_key",
        "adapter_implementation_version",
        "input_sha256",
        "input_artifact_id",
        "parent_processing_run_id",
        "engine_sha256",
        "engine_version",
        "engine_revision"
      ],
      "properties": {
        "job_id": { "$ref": "#/$defs/identifier" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "recipe_id": {
          "type": "string",
          "pattern": "^recipe_asr_whispercpp_[0-9a-f]{32}$"
        },
        "result_key": { "$ref": "#/$defs/sha256" },
        "adapter_implementation_version": { "const": "0.3.0" },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "input_artifact_id": { "$ref": "#/$defs/identifier" },
        "parent_processing_run_id": { "$ref": "#/$defs/identifier" },
        "engine_sha256": { "$ref": "#/$defs/sha256" },
        "engine_version": { "type": "string", "minLength": 1, "maxLength": 500 },
        "engine_revision": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_raw_bytes_preserved",
        "decoded_text_emitted",
        "invalid_bytes_ignored_or_replaced",
        "catalog_writes",
        "publication_authority",
        "visibility"
      ],
      "properties": {
        "exact_raw_bytes_preserved": { "const": true },
        "decoded_text_emitted": { "const": false },
        "invalid_bytes_ignored_or_replaced": { "const": false },
        "catalog_writes": { "const": false },
        "publication_authority": { "const": "none" },
        "visibility": { "const": "private" }
      }
    }
  }
}
