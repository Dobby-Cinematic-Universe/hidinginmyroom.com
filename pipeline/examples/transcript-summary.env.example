# Copy these entries into /srv/himr/.env using a local editor.
# Preserve any existing entries. Never commit the populated .env file.
# Restrict access: chmod 600 /srv/himr/.env
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Exported environment variables take precedence, even when empty.
# The summary CLI reads the repository-root .env lazily for submit/poll/reconcile.
# Alternatively, pass --env-file /absolute/private/summary.env to those commands.
# Values are literal: no variable expansion, shell commands, or multiline values.
# The Gemini -> Sonnet preset does not need an OPENAI_API_KEY.
