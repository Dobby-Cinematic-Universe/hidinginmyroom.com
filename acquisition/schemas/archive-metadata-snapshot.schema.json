{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/acquisition/archive-metadata-snapshot-v1.json",
  "title": "HIMR sealed Archive.org item-metadata snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "snapshot_kind", "observed_at", "request", "http_policy", "items", "assertion_policy", "errors"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "pattern": "^iams_[0-9a-f]{32}$"},
    "snapshot_kind": {"const": "archive_org_item_metadata"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "request": {"$ref": "#/$defs/requestEvidence"},
    "http_policy": {"$ref": "#/$defs/httpPolicy"},
    "items": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/item"}},
    "assertion_policy": {"$ref": "#/$defs/assertionPolicy"},
    "errors": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableHeader": {
      "oneOf": [
        {"type": "string", "maxLength": 1000},
        {"type": "null"}
      ]
    },
    "requestEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "request_sha256", "request_byte_count", "request_file"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^iamr_[0-9a-f]{32}$"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "request_byte_count": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "request_file": {"const": "request.json"}
      }
    },
    "httpPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "accept", "user_agent", "cookies_sent", "authorization_sent"],
      "properties": {
        "method": {"const": "GET"},
        "accept": {"const": "application/json"},
        "user_agent": {"const": "hidinginmyroom-corpus-archive-metadata/1.0 (public metadata research)"},
        "cookies_sent": {"const": false},
        "authorization_sent": {"const": false}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "basis", "request_url", "final_url", "http_status", "started_at", "observed_at", "content_type", "etag", "last_modified", "response_date", "payload_sha256", "byte_count", "payload_file", "item_title", "collections", "file_count"],
      "properties": {
        "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
        "basis": {"enum": ["catalog_archive_item", "catalog_file_hint", "manual_public_lead"]},
        "request_url": {"type": "string", "format": "uri", "pattern": "^https://archive\\.org/metadata/[A-Za-z0-9._~-]+$", "maxLength": 4096},
        "final_url": {"type": "string", "format": "uri", "pattern": "^https://(?:www\\.)?archive\\.org/metadata/[A-Za-z0-9._~-]+$", "maxLength": 4096},
        "http_status": {"const": 200},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "content_type": {"type": "string", "minLength": 1, "maxLength": 200},
        "etag": {"$ref": "#/$defs/nullableHeader"},
        "last_modified": {"$ref": "#/$defs/nullableHeader"},
        "response_date": {"$ref": "#/$defs/nullableHeader"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "payload_file": {"type": "string", "pattern": "^item-[A-Za-z0-9][A-Za-z0-9._-]{0,99}\\.metadata\\.json$"},
        "item_title": {"type": "string", "maxLength": 1000},
        "collections": {"type": "array", "uniqueItems": true, "maxItems": 10000, "items": {"type": "string", "minLength": 1}},
        "file_count": {"type": "integer", "minimum": 0, "maximum": 200000}
      }
    },
    "assertionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "provider_fields_are_content_truth", "media_downloaded", "identity_assertions", "publication_authority"],
      "properties": {
        "state": {"const": "unreviewed_provider_metadata"},
        "provider_fields_are_content_truth": {"const": false},
        "media_downloaded": {"const": false},
        "identity_assertions": {"const": false},
        "publication_authority": {"const": false}
      }
    }
  }
}
