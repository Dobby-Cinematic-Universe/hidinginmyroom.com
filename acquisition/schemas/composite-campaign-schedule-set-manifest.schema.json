{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/acquisition/composite-campaign-schedule-set-manifest-v1.json",
  "title": "HIMR immutable predecessor plus addendum Archive schedule-set composite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "composite_schedule_set_id",
    "identity_sha256",
    "schema_version",
    "composite_kind",
    "materializer",
    "storage_policy",
    "component_order",
    "role_order",
    "flatten_order",
    "components",
    "schedules",
    "component_role_totals",
    "role_totals",
    "coverage_proof",
    "safety"
  ],
  "properties": {
    "composite_schedule_set_id": {
      "type": "string",
      "pattern": "^bgacqcompositeset_[0-9a-f]{32}$"
    },
    "identity_sha256": { "$ref": "#/$defs/sha256" },
    "schema_version": { "const": 1 },
    "composite_kind": {
      "const": "sealed_archive_campaign_composite_schedule_set"
    },
    "materializer": { "$ref": "#/$defs/materializer" },
    "storage_policy": { "$ref": "#/$defs/storage_policy" },
    "component_order": {
      "type": "array",
      "prefixItems": [
        { "const": "predecessor" },
        { "const": "addendum" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "role_order": {
      "type": "array",
      "prefixItems": [
        { "const": "normal_processing" },
        { "const": "cold_acquisition_only_requires_chunking" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "flatten_order": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/predecessor_normal" },
        { "$ref": "#/$defs/addendum_normal" },
        { "$ref": "#/$defs/predecessor_cold" },
        { "$ref": "#/$defs/addendum_cold" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "components": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/predecessor_component" },
        { "$ref": "#/$defs/addendum_component" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "schedules": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/schedule" }
    },
    "component_role_totals": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/predecessor_normal_total" },
        { "$ref": "#/$defs/addendum_normal_total" },
        { "$ref": "#/$defs/predecessor_cold_total" },
        { "$ref": "#/$defs/addendum_cold_total" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "role_totals": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/normal_role_total" },
        { "$ref": "#/$defs/cold_role_total" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "coverage_proof": { "$ref": "#/$defs/coverage_proof" },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 2,
      "maxLength": 16384
    },
    "component": {
      "enum": ["predecessor", "addendum"]
    },
    "role": {
      "enum": [
        "normal_processing",
        "cold_acquisition_only_requires_chunking"
      ]
    },
    "schedule_set_id": {
      "type": "string",
      "pattern": "^bgacqscheduleset_[0-9a-f]{32}$"
    },
    "schedule_id": {
      "type": "string",
      "pattern": "^bgacqsched_[0-9a-f]{32}$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^acqcampaign_[0-9a-f]{32}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^acqplan_[0-9a-f]{32}$"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^acqbundle_[0-9a-f]{32}$"
    },
    "materializer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "himr-archive-composite-schedule-set-materializer"
        },
        "version": { "const": "0.1.0" }
      }
    },
    "storage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_output_root",
        "control_root",
        "composite_schedule_sets_root",
        "source_schedule_storage"
      ],
      "properties": {
        "media_output_root": {
          "const": "/mnt/archive/HIMR/corpus/raw/acquisition-cas"
        },
        "control_root": { "$ref": "#/$defs/absolute_path" },
        "composite_schedule_sets_root": {
          "$ref": "#/$defs/absolute_path"
        },
        "source_schedule_storage": {
          "const": "referenced_in_place_byte_for_byte"
        }
      }
    },
    "flatten_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "role"],
      "properties": {
        "component": { "$ref": "#/$defs/component" },
        "role": { "$ref": "#/$defs/role" }
      }
    },
    "predecessor_normal": {
      "allOf": [
        { "$ref": "#/$defs/flatten_entry" },
        {
          "properties": {
            "component": { "const": "predecessor" },
            "role": { "const": "normal_processing" }
          }
        }
      ]
    },
    "addendum_normal": {
      "allOf": [
        { "$ref": "#/$defs/flatten_entry" },
        {
          "properties": {
            "component": { "const": "addendum" },
            "role": { "const": "normal_processing" }
          }
        }
      ]
    },
    "predecessor_cold": {
      "allOf": [
        { "$ref": "#/$defs/flatten_entry" },
        {
          "properties": {
            "component": { "const": "predecessor" },
            "role": {
              "const": "cold_acquisition_only_requires_chunking"
            }
          }
        }
      ]
    },
    "addendum_cold": {
      "allOf": [
        { "$ref": "#/$defs/flatten_entry" },
        {
          "properties": {
            "component": { "const": "addendum" },
            "role": {
              "const": "cold_acquisition_only_requires_chunking"
            }
          }
        }
      ]
    },
    "component_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_ordinal",
        "component",
        "schedule_set_id",
        "manifest_path",
        "manifest_sha256",
        "manifest_byte_count",
        "campaign_count",
        "epoch_count",
        "schedule_count",
        "selected_count",
        "selected_estimated_bytes",
        "ordered_schedule_reference_sha256",
        "ordered_member_sha256"
      ],
      "properties": {
        "component_ordinal": { "type": "integer", "minimum": 1, "maximum": 2 },
        "component": { "$ref": "#/$defs/component" },
        "schedule_set_id": { "$ref": "#/$defs/schedule_set_id" },
        "manifest_path": { "$ref": "#/$defs/absolute_path" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_byte_count": { "type": "integer", "minimum": 1 },
        "campaign_count": { "const": 2 },
        "epoch_count": { "type": "integer", "minimum": 2, "maximum": 2048 },
        "schedule_count": { "type": "integer", "minimum": 2, "maximum": 2048 },
        "selected_count": { "type": "integer", "minimum": 2 },
        "selected_estimated_bytes": { "type": "integer", "minimum": 2 },
        "ordered_schedule_reference_sha256": { "$ref": "#/$defs/sha256" },
        "ordered_member_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "predecessor_component": {
      "allOf": [
        { "$ref": "#/$defs/component_reference" },
        {
          "properties": {
            "component_ordinal": { "const": 1 },
            "component": { "const": "predecessor" }
          }
        }
      ]
    },
    "addendum_component": {
      "allOf": [
        { "$ref": "#/$defs/component_reference" },
        {
          "properties": {
            "component_ordinal": { "const": 2 },
            "component": { "const": "addendum" }
          }
        }
      ]
    },
    "source_schedule_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule_set_id", "manifest_path", "manifest_sha256"],
      "properties": {
        "schedule_set_id": { "$ref": "#/$defs/schedule_set_id" },
        "manifest_path": { "$ref": "#/$defs/absolute_path" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "manifest_path", "manifest_sha256"],
      "properties": {
        "campaign_id": { "$ref": "#/$defs/campaign_id" },
        "manifest_path": { "$ref": "#/$defs/absolute_path" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch_ordinal",
        "epoch_plan_id",
        "epoch_plan_path",
        "epoch_plan_sha256",
        "bundle_id",
        "bundle_manifest_path",
        "bundle_manifest_sha256",
        "selected_count",
        "selected_estimated_bytes",
        "member_sha256"
      ],
      "properties": {
        "epoch_ordinal": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "epoch_plan_id": { "$ref": "#/$defs/plan_id" },
        "epoch_plan_path": { "$ref": "#/$defs/absolute_path" },
        "epoch_plan_sha256": { "$ref": "#/$defs/sha256" },
        "bundle_id": { "$ref": "#/$defs/bundle_id" },
        "bundle_manifest_path": { "$ref": "#/$defs/absolute_path" },
        "bundle_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "selected_count": { "type": "integer", "minimum": 1 },
        "selected_estimated_bytes": { "type": "integer", "minimum": 1 },
        "member_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule_ordinal",
        "component",
        "component_schedule_ordinal",
        "role",
        "schedule_path",
        "schedule_sha256",
        "schedule_byte_count",
        "schedule_id",
        "schedule_identity_sha256",
        "preprocess_state_root",
        "source_schedule_set",
        "source_campaign",
        "source_epoch"
      ],
      "properties": {
        "schedule_ordinal": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "component": { "$ref": "#/$defs/component" },
        "component_schedule_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "role": { "$ref": "#/$defs/role" },
        "schedule_path": { "$ref": "#/$defs/absolute_path" },
        "schedule_sha256": { "$ref": "#/$defs/sha256" },
        "schedule_byte_count": { "type": "integer", "minimum": 1 },
        "schedule_id": { "$ref": "#/$defs/schedule_id" },
        "schedule_identity_sha256": { "$ref": "#/$defs/sha256" },
        "preprocess_state_root": { "$ref": "#/$defs/absolute_path" },
        "source_schedule_set": { "$ref": "#/$defs/source_schedule_set" },
        "source_campaign": { "$ref": "#/$defs/source_campaign" },
        "source_epoch": { "$ref": "#/$defs/source_epoch" }
      }
    },
    "component_role_total": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "role",
        "campaign_count",
        "epoch_count",
        "schedule_count",
        "selected_count",
        "selected_estimated_bytes",
        "ordered_schedule_reference_sha256",
        "ordered_member_sha256"
      ],
      "properties": {
        "component": { "$ref": "#/$defs/component" },
        "role": { "$ref": "#/$defs/role" },
        "campaign_count": { "const": 1 },
        "epoch_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "schedule_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "selected_count": { "type": "integer", "minimum": 1 },
        "selected_estimated_bytes": { "type": "integer", "minimum": 1 },
        "ordered_schedule_reference_sha256": { "$ref": "#/$defs/sha256" },
        "ordered_member_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "predecessor_normal_total": {
      "allOf": [
        { "$ref": "#/$defs/component_role_total" },
        { "properties": { "component": { "const": "predecessor" }, "role": { "const": "normal_processing" } } }
      ]
    },
    "addendum_normal_total": {
      "allOf": [
        { "$ref": "#/$defs/component_role_total" },
        { "properties": { "component": { "const": "addendum" }, "role": { "const": "normal_processing" } } }
      ]
    },
    "predecessor_cold_total": {
      "allOf": [
        { "$ref": "#/$defs/component_role_total" },
        { "properties": { "component": { "const": "predecessor" }, "role": { "const": "cold_acquisition_only_requires_chunking" } } }
      ]
    },
    "addendum_cold_total": {
      "allOf": [
        { "$ref": "#/$defs/component_role_total" },
        { "properties": { "component": { "const": "addendum" }, "role": { "const": "cold_acquisition_only_requires_chunking" } } }
      ]
    },
    "role_total": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "component_count",
        "campaign_count",
        "epoch_count",
        "schedule_count",
        "selected_count",
        "selected_estimated_bytes"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "component_count": { "const": 2 },
        "campaign_count": { "const": 2 },
        "epoch_count": { "type": "integer", "minimum": 2, "maximum": 2048 },
        "schedule_count": { "type": "integer", "minimum": 2, "maximum": 2048 },
        "selected_count": { "type": "integer", "minimum": 2 },
        "selected_estimated_bytes": { "type": "integer", "minimum": 2 }
      }
    },
    "normal_role_total": {
      "allOf": [
        { "$ref": "#/$defs/role_total" },
        { "properties": { "role": { "const": "normal_processing" } } }
      ]
    },
    "cold_role_total": {
      "allOf": [
        { "$ref": "#/$defs/role_total" },
        { "properties": { "role": { "const": "cold_acquisition_only_requires_chunking" } } }
      ]
    },
    "coverage_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_count",
        "source_schedule_set_count",
        "source_campaign_count",
        "source_epoch_count",
        "schedule_count",
        "source_selected_count",
        "source_selected_estimated_bytes",
        "schedule_selected_count",
        "schedule_selected_estimated_bytes",
        "unique_source_count",
        "unique_recording_count",
        "unique_native_count",
        "source_overlap_count",
        "recording_overlap_count",
        "native_overlap_count",
        "missing_count",
        "unexpected_count",
        "source_schedule_union_sha256",
        "composite_schedule_union_sha256",
        "source_member_union_sha256",
        "composite_member_union_sha256",
        "ordered_schedule_union_identical",
        "ordered_member_union_identical",
        "component_order_exact",
        "flatten_order_exact",
        "schedule_ordinals_contiguous",
        "source_schedule_files_referenced_not_copied"
      ],
      "properties": {
        "component_count": { "const": 2 },
        "source_schedule_set_count": { "const": 2 },
        "source_campaign_count": { "const": 4 },
        "source_epoch_count": { "type": "integer", "minimum": 4, "maximum": 4096 },
        "schedule_count": { "type": "integer", "minimum": 4, "maximum": 4096 },
        "source_selected_count": { "type": "integer", "minimum": 4 },
        "source_selected_estimated_bytes": { "type": "integer", "minimum": 4 },
        "schedule_selected_count": { "type": "integer", "minimum": 4 },
        "schedule_selected_estimated_bytes": { "type": "integer", "minimum": 4 },
        "unique_source_count": { "type": "integer", "minimum": 4 },
        "unique_recording_count": { "type": "integer", "minimum": 4 },
        "unique_native_count": { "type": "integer", "minimum": 4 },
        "source_overlap_count": { "const": 0 },
        "recording_overlap_count": { "const": 0 },
        "native_overlap_count": { "const": 0 },
        "missing_count": { "const": 0 },
        "unexpected_count": { "const": 0 },
        "source_schedule_union_sha256": { "$ref": "#/$defs/sha256" },
        "composite_schedule_union_sha256": { "$ref": "#/$defs/sha256" },
        "source_member_union_sha256": { "$ref": "#/$defs/sha256" },
        "composite_member_union_sha256": { "$ref": "#/$defs/sha256" },
        "ordered_schedule_union_identical": { "const": true },
        "ordered_member_union_identical": { "const": true },
        "component_order_exact": { "const": true },
        "flatten_order_exact": { "const": true },
        "schedule_ordinals_contiguous": { "const": true },
        "source_schedule_files_referenced_not_copied": { "const": true }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_files_only",
        "access_policy",
        "publication_authority",
        "credentials_allowed",
        "network_access_performed",
        "gpu_execution_performed",
        "media_read_performed",
        "media_write_performed",
        "catalog_mutated",
        "scheduling_performed",
        "processes_started",
        "source_schedule_files_copied"
      ],
      "properties": {
        "control_files_only": { "const": true },
        "access_policy": { "const": "sealed_public_archive_work_orders_only" },
        "publication_authority": { "const": "none" },
        "credentials_allowed": { "const": false },
        "network_access_performed": { "const": false },
        "gpu_execution_performed": { "const": false },
        "media_read_performed": { "const": false },
        "media_write_performed": { "const": false },
        "catalog_mutated": { "const": false },
        "scheduling_performed": { "const": false },
        "processes_started": { "const": false },
        "source_schedule_files_copied": { "const": false }
      }
    }
  }
}
