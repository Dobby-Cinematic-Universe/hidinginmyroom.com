{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/acquisition/queue-failure-receipt-v1.json",
  "title": "HIMR sealed-queue acquisition failure receipt",
  "oneOf": [
    { "$ref": "#/$defs/failedAttempt" },
    { "$ref": "#/$defs/quarantine" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000]+$"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_mutated",
        "completed_result_authority",
        "credentials_used",
        "deletion_authority",
        "event_authority",
        "export_authority",
        "publication_authority"
      ],
      "properties": {
        "catalog_mutated": { "const": false },
        "completed_result_authority": { "const": false },
        "credentials_used": { "const": false },
        "deletion_authority": { "const": "none" },
        "event_authority": { "const": "none" },
        "export_authority": { "const": "none" },
        "publication_authority": { "const": "none" }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "schema_version",
        "runner_name",
        "receipt_contract_version",
        "bundle_id",
        "manifest_sha256",
        "ordinal",
        "job_id",
        "work_order_sha256",
        "safety",
        "receipt_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "runner_name": { "const": "himr-acquisition-queue-runner" },
        "receipt_contract_version": { "const": 1 },
        "bundle_id": {
          "type": "string",
          "pattern": "^acqbundle_[0-9a-f]{32}$"
        },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "job_id": {
          "type": "string",
          "pattern": "^acq-[0-9a-f]{32}-[0-9]{6}$"
        },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "safety": { "$ref": "#/$defs/safety" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attemptReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_number", "receipt_sha256", "error"],
      "properties": {
        "attempt_number": { "type": "integer", "minimum": 1, "maximum": 3 },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "failedAttempt": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        {
          "type": "object",
          "required": ["receipt_kind", "attempt_number", "observed_at", "error"],
          "properties": {
            "receipt_kind": { "const": "public_acquisition_failed_attempt" },
            "attempt_number": { "type": "integer", "minimum": 1, "maximum": 3 },
            "observed_at": { "$ref": "#/$defs/timestamp" },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "quarantine": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        {
          "type": "object",
          "required": [
            "receipt_kind",
            "failure_attempt_limit",
            "attempt_receipts",
            "quarantined_at",
            "retry_contract"
          ],
          "properties": {
            "receipt_kind": { "const": "public_acquisition_quarantine" },
            "failure_attempt_limit": { "const": 3 },
            "attempt_receipts": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/attemptReference" }
            },
            "quarantined_at": { "$ref": "#/$defs/timestamp" },
            "retry_contract": {
              "const": "future_sealed_queue_or_explicit_policy_only"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
