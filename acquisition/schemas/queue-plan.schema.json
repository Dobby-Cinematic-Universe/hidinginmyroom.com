{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/acquisition/queue-plan-v1.json",
  "title": "HIMR deterministic acquisition queue plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "schema_version",
    "planned_at",
    "catalog_basis_sha256",
    "catalog_migrations",
    "selection_basis",
    "wiki_scan",
    "limits",
    "safety",
    "summary",
    "candidates"
  ],
  "properties": {
    "plan_id": { "type": "string", "pattern": "^acqplan_[0-9a-f]{32}$" },
    "schema_version": { "const": 1 },
    "planned_at": { "type": "string", "format": "date-time" },
    "catalog_basis_sha256": { "$ref": "#/$defs/sha256" },
    "catalog_migrations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/migration" }
    },
    "selection_basis": { "$ref": "#/$defs/selection_basis" },
    "wiki_scan": { "$ref": "#/$defs/wiki_scan" },
    "limits": { "$ref": "#/$defs/limits" },
    "safety": { "$ref": "#/$defs/safety" },
    "summary": { "$ref": "#/$defs/summary" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullable_sha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "nullable_positive_integer": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "name", "sha256"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "selection_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "manifest_sha256",
        "youtube_video_ids",
        "source_ids",
        "recording_ids",
        "requested_identifiers_already_acquired",
        "requested_identifiers_not_eligible"
      ],
      "properties": {
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "manifest_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "youtube_video_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" }
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "recording_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "requested_identifiers_already_acquired": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "requested_identifiers_not_eligible": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "wiki_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_count", "youtube_ids_cited", "archive_objects_cited"],
      "properties": {
        "root_count": { "type": "integer", "minimum": 0 },
        "youtube_ids_cited": { "type": "integer", "minimum": 0 },
        "archive_objects_cited": { "type": "integer", "minimum": 0 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items",
        "plan_budget_bytes",
        "max_job_bytes",
        "long_recording_ms",
        "youtube_bytes_per_second",
        "youtube_fixed_overhead_bytes",
        "selection_only"
      ],
      "properties": {
        "max_items": { "type": "integer", "minimum": 1 },
        "plan_budget_bytes": { "type": "integer", "minimum": 1 },
        "max_job_bytes": { "type": "integer", "minimum": 1 },
        "long_recording_ms": { "type": "integer", "minimum": 1 },
        "youtube_bytes_per_second": { "type": "integer", "minimum": 1 },
        "youtube_fixed_overhead_bytes": { "type": "integer", "minimum": 1 },
        "selection_only": { "type": "boolean" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_policy",
        "publication_authority",
        "credentials_allowed",
        "network_access_performed",
        "catalog_mutated"
      ],
      "properties": {
        "access_policy": { "const": "public_only" },
        "publication_authority": { "const": "none" },
        "credentials_allowed": { "const": false },
        "network_access_performed": { "const": false },
        "catalog_mutated": { "const": false }
      }
    },
    "count_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "count"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_unacquired_sources",
        "recording_candidates",
        "selected_count",
        "selected_estimated_bytes",
        "deferred_count",
        "already_acquired_recordings",
        "withheld_access_sources",
        "by_queue_state",
        "by_platform",
        "by_priority_tier",
        "by_defer_reason"
      ],
      "properties": {
        "supported_unacquired_sources": { "type": "integer", "minimum": 0 },
        "recording_candidates": { "type": "integer", "minimum": 0 },
        "selected_count": { "type": "integer", "minimum": 0 },
        "selected_estimated_bytes": { "type": "integer", "minimum": 0 },
        "deferred_count": { "type": "integer", "minimum": 0 },
        "already_acquired_recordings": { "type": "integer", "minimum": 0 },
        "withheld_access_sources": { "type": "integer", "minimum": 0 },
        "by_queue_state": {
          "type": "array",
          "items": { "$ref": "#/$defs/count_entry" }
        },
        "by_platform": {
          "type": "array",
          "items": { "$ref": "#/$defs/count_entry" }
        },
        "by_priority_tier": {
          "type": "array",
          "items": { "$ref": "#/$defs/count_entry" }
        },
        "by_defer_reason": {
          "type": "array",
          "items": { "$ref": "#/$defs/count_entry" }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recording_id",
        "source_id",
        "platform",
        "source_kind",
        "native_id",
        "title",
        "canonical_url",
        "adapter",
        "recording_type",
        "duration_ms",
        "estimated_bytes",
        "estimate_basis",
        "expected_byte_count",
        "expected_sha256",
        "source_class",
        "mapping_roles",
        "priority",
        "priority_tier",
        "reason_codes",
        "wiki_reference_count",
        "wiki_reference_paths",
        "queue_state",
        "queue_ordinal",
        "defer_reason"
      ],
      "properties": {
        "recording_id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "platform": { "enum": ["youtube", "internet_archive"] },
        "source_kind": { "type": "string", "minLength": 1 },
        "native_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "adapter": { "enum": ["yt_dlp", "direct_http"] },
        "recording_type": { "type": "string", "minLength": 1 },
        "duration_ms": { "$ref": "#/$defs/nullable_positive_integer" },
        "estimated_bytes": { "type": "integer", "minimum": 1 },
        "estimate_basis": {
          "enum": [
            "provider_declared_byte_count",
            "duration_conservative_rate",
            "job_cap_unknown_duration"
          ]
        },
        "expected_byte_count": { "$ref": "#/$defs/nullable_positive_integer" },
        "expected_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "source_class": { "type": ["string", "null"] },
        "mapping_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "priority": { "type": "integer", "minimum": 1 },
        "priority_tier": {
          "enum": [
            "explicit_selection",
            "wiki_cited",
            "current_public_upload",
            "public_guest_or_clip",
            "short_archive",
            "medium_archive",
            "long_recording"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "wiki_reference_count": { "type": "integer", "minimum": 0 },
        "wiki_reference_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "queue_state": {
          "enum": ["ready", "requires_metadata", "requires_chunking", "review_required"]
        },
        "queue_ordinal": { "$ref": "#/$defs/nullable_positive_integer" },
        "defer_reason": {
          "oneOf": [
            { "type": "null" },
            {
              "enum": [
                "requires_metadata",
                "requires_chunking",
                "review_required",
                "plan_item_limit",
                "plan_byte_budget",
                "outside_explicit_selection"
              ]
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "queue_state": { "const": "ready" },
            "queue_ordinal": { "type": "integer", "minimum": 1 },
            "defer_reason": { "type": "null" }
          }
        },
        {
          "properties": {
            "queue_ordinal": { "type": "null" },
            "defer_reason": {
              "enum": [
                "requires_metadata",
                "requires_chunking",
                "review_required",
                "plan_item_limit",
                "plan_byte_budget",
                "outside_explicit_selection"
              ]
            }
          }
        }
      ]
    }
  }
}
