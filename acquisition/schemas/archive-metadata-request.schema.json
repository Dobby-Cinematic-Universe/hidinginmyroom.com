{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/acquisition/archive-metadata-request-v1.json",
  "title": "HIMR Archive.org metadata target request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "request_kind", "requested_at", "items", "policy"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^iamr_[0-9a-f]{32}$"},
    "request_kind": {"const": "archive_org_metadata_targets"},
    "requested_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/item"}
    },
    "policy": {"$ref": "#/$defs/policy"}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "basis"],
      "properties": {
        "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
        "basis": {"enum": ["catalog_archive_item", "catalog_file_hint", "manual_public_lead"]}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_unauthenticated_metadata_only", "media_download", "cookies_sent", "authorization_sent", "publication_authority"],
      "properties": {
        "public_unauthenticated_metadata_only": {"const": true},
        "media_download": {"const": false},
        "cookies_sent": {"const": false},
        "authorization_sent": {"const": false},
        "publication_authority": {"const": false}
      }
    }
  }
}
