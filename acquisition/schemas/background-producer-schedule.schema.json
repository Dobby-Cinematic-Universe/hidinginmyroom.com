{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/acquisition/background-producer-schedule-v1.json",
  "title": "HIMR sealed background acquisition producer schedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schedule_kind",
    "producer",
    "queue",
    "consumer",
    "policy",
    "safety",
    "schedule_id",
    "identity_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "schedule_kind": { "const": "sealed_public_background_acquisition" },
    "producer": { "$ref": "#/$defs/producer" },
    "queue": { "$ref": "#/$defs/queue" },
    "consumer": { "$ref": "#/$defs/consumer" },
    "policy": { "$ref": "#/$defs/policy" },
    "safety": { "$ref": "#/$defs/scheduleSafety" },
    "schedule_id": {
      "type": "string",
      "pattern": "^bgacqsched_[0-9a-f]{32}$"
    },
    "identity_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source_path",
        "source_sha256",
        "source_byte_count"
      ],
      "properties": {
        "name": { "const": "himr-background-acquisition-producer" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source_path": { "$ref": "#/$defs/absolutePath" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "source_byte_count": { "type": "integer", "minimum": 1 }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "bundle_id", "software"],
      "properties": {
        "manifest_path": { "$ref": "#/$defs/absolutePath" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "bundle_id": {
          "type": "string",
          "pattern": "^acqbundle_[0-9a-f]{32}$"
        },
        "software": { "$ref": "#/$defs/software" }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "acquire", "materializer"],
      "properties": {
        "runner": { "$ref": "#/$defs/softwareComponent" },
        "acquire": { "$ref": "#/$defs/softwareComponent" },
        "materializer": { "$ref": "#/$defs/softwareComponent" }
      }
    },
    "softwareComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256", "byte_count"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preprocess_state_root", "acknowledgement_contract"],
      "properties": {
        "preprocess_state_root": { "$ref": "#/$defs/absolutePath" },
        "acknowledgement_contract": {
          "const": "completed_private_media_preprocess_batch_item_v1"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_network_concurrency",
        "dispatch_order",
        "ready_high_items",
        "ready_low_items",
        "ready_high_bytes",
        "ready_low_bytes",
        "maximum_dispatch_items_per_run",
        "maximum_dispatch_bytes_per_run",
        "maximum_run_seconds",
        "free_space_floor_bytes",
        "reservation_accounting",
        "hysteresis_resume"
      ],
      "properties": {
        "maximum_network_concurrency": { "const": 1 },
        "dispatch_order": {
          "const": "sealed_ordinal_sequential_bounded_failure_isolation"
        },
        "ready_high_items": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "ready_low_items": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "ready_high_bytes": { "type": "integer", "minimum": 1 },
        "ready_low_bytes": { "type": "integer", "minimum": 0 },
        "maximum_dispatch_items_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maximum_dispatch_bytes_per_run": { "type": "integer", "minimum": 1 },
        "maximum_run_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "free_space_floor_bytes": { "type": "integer", "minimum": 0 },
        "reservation_accounting": { "const": "full_sealed_max_job_bytes" },
        "hysteresis_resume": { "const": "both_low_water_conditions" }
      }
    },
    "scheduleSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_policy",
        "catalog_access",
        "catalog_writes",
        "cold_storage_access",
        "credentials_allowed",
        "deletion_authority",
        "discovery_allowed",
        "event_authority",
        "export_authority",
        "identity_authority",
        "publication_authority",
        "substitutions_allowed"
      ],
      "properties": {
        "access_policy": { "const": "sealed_public_work_orders_only" },
        "catalog_access": { "const": "forbidden" },
        "catalog_writes": { "const": false },
        "cold_storage_access": {
          "enum": [
            "forbidden",
            "sealed_queue_media_output_root_write_only"
          ]
        },
        "credentials_allowed": { "const": false },
        "deletion_authority": { "const": "none" },
        "discovery_allowed": { "const": false },
        "event_authority": { "const": "none" },
        "export_authority": { "const": "none" },
        "identity_authority": { "const": "none" },
        "publication_authority": { "const": "none" },
        "substitutions_allowed": { "const": false }
      }
    }
  }
}
