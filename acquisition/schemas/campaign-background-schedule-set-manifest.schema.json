{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/acquisition/campaign-background-schedule-set-manifest-v1.json",
  "title": "HIMR immutable two-role Archive campaign background schedule set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schedule_set_id",
    "identity_sha256",
    "schema_version",
    "schedule_set_kind",
    "materializer",
    "storage_policy",
    "role_order",
    "role_policies",
    "source_campaigns",
    "schedules",
    "role_totals",
    "coverage_proof",
    "safety"
  ],
  "properties": {
    "schedule_set_id": {
      "type": "string",
      "pattern": "^bgacqscheduleset_[0-9a-f]{32}$"
    },
    "identity_sha256": { "$ref": "#/$defs/sha256" },
    "schema_version": { "const": 1 },
    "schedule_set_kind": {
      "const": "sealed_archive_campaign_background_schedule_set"
    },
    "materializer": { "$ref": "#/$defs/materializer" },
    "storage_policy": { "$ref": "#/$defs/storage_policy" },
    "role_order": {
      "type": "array",
      "prefixItems": [
        { "const": "normal_processing" },
        { "const": "cold_acquisition_only_requires_chunking" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "role_policies": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/normal_policy" },
        { "$ref": "#/$defs/cold_only_policy" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "source_campaigns": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/source_campaign" },
            {
              "type": "object",
              "properties": { "role": { "const": "normal_processing" } }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/source_campaign" },
            {
              "type": "object",
              "properties": {
                "role": { "const": "cold_acquisition_only_requires_chunking" }
              }
            }
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "schedules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2048,
      "items": { "$ref": "#/$defs/schedule" }
    },
    "role_totals": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/role_total" },
            {
              "type": "object",
              "properties": { "role": { "const": "normal_processing" } }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/role_total" },
            {
              "type": "object",
              "properties": {
                "role": { "const": "cold_acquisition_only_requires_chunking" }
              }
            }
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "coverage_proof": { "$ref": "#/$defs/coverage_proof" },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 2,
      "maxLength": 16384
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^acqcampaign_[0-9a-f]{32}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^acqplan_[0-9a-f]{32}$"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^acqbundle_[0-9a-f]{32}$"
    },
    "role": {
      "enum": [
        "normal_processing",
        "cold_acquisition_only_requires_chunking"
      ]
    },
    "materializer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "himr-archive-campaign-schedule-set-materializer"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "storage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_output_root",
        "control_root",
        "schedules_root",
        "preprocess_state_root",
        "schedule_sets_root",
        "storage_mode"
      ],
      "properties": {
        "media_output_root": {
          "const": "/mnt/archive/HIMR/corpus/raw/acquisition-cas"
        },
        "control_root": { "$ref": "#/$defs/absolute_path" },
        "schedules_root": { "$ref": "#/$defs/absolute_path" },
        "preprocess_state_root": { "$ref": "#/$defs/absolute_path" },
        "schedule_sets_root": { "$ref": "#/$defs/absolute_path" },
        "storage_mode": { "const": "cold_primary_shared_cas_hot_controls" }
      }
    },
    "policy_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "max_epoch_items",
        "max_epoch_estimated_bytes",
        "maximum_network_concurrency",
        "dispatch_order",
        "ready_high_items",
        "ready_low_items",
        "ready_high_bytes",
        "ready_low_bytes",
        "maximum_dispatch_items_per_run",
        "maximum_dispatch_bytes_per_run",
        "maximum_run_seconds",
        "free_space_floor_bytes",
        "reservation_accounting",
        "hysteresis_resume"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "max_epoch_items": { "type": "integer", "minimum": 1 },
        "max_epoch_estimated_bytes": { "type": "integer", "minimum": 1 },
        "maximum_network_concurrency": { "const": 1 },
        "dispatch_order": {
          "const": "sealed_ordinal_sequential_bounded_failure_isolation"
        },
        "ready_high_items": { "type": "integer", "minimum": 1 },
        "ready_low_items": { "type": "integer", "minimum": 0 },
        "ready_high_bytes": { "type": "integer", "minimum": 1 },
        "ready_low_bytes": { "type": "integer", "minimum": 0 },
        "maximum_dispatch_items_per_run": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_dispatch_bytes_per_run": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_run_seconds": { "const": 14400 },
        "free_space_floor_bytes": { "const": 549755813888 },
        "reservation_accounting": { "const": "full_sealed_max_job_bytes" },
        "hysteresis_resume": { "const": "both_low_water_conditions" }
      }
    },
    "normal_policy": {
      "allOf": [
        { "$ref": "#/$defs/policy_base" },
        {
          "type": "object",
          "properties": {
            "role": { "const": "normal_processing" },
            "max_epoch_items": { "const": 32 },
            "max_epoch_estimated_bytes": { "const": 17179869184 },
            "ready_high_items": { "const": 64 },
            "ready_low_items": { "const": 32 },
            "ready_high_bytes": { "const": 68719476736 },
            "ready_low_bytes": { "const": 34359738368 },
            "maximum_dispatch_items_per_run": { "const": 8 },
            "maximum_dispatch_bytes_per_run": { "const": 68719476736 }
          }
        }
      ]
    },
    "cold_only_policy": {
      "allOf": [
        { "$ref": "#/$defs/policy_base" },
        {
          "type": "object",
          "properties": {
            "role": { "const": "cold_acquisition_only_requires_chunking" },
            "max_epoch_items": { "const": 8 },
            "max_epoch_estimated_bytes": { "const": 137438953472 },
            "ready_high_items": { "const": 1000 },
            "ready_low_items": { "const": 999 },
            "ready_high_bytes": { "const": 4398046511104 },
            "ready_low_bytes": { "const": 3298534883328 },
            "maximum_dispatch_items_per_run": { "const": 8 },
            "maximum_dispatch_bytes_per_run": { "const": 137438953472 }
          }
        }
      ]
    },
    "source_campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "campaign_id",
        "manifest_path",
        "manifest_sha256",
        "manifest_byte_count",
        "epoch_count",
        "selected_count",
        "selected_estimated_bytes",
        "ordered_member_sha256"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "campaign_id": { "$ref": "#/$defs/campaign_id" },
        "manifest_path": { "$ref": "#/$defs/absolute_path" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_byte_count": { "type": "integer", "minimum": 1 },
        "epoch_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "selected_count": { "type": "integer", "minimum": 1 },
        "selected_estimated_bytes": { "type": "integer", "minimum": 1 },
        "ordered_member_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "schedule_source_campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "manifest_path", "manifest_sha256"],
      "properties": {
        "campaign_id": { "$ref": "#/$defs/campaign_id" },
        "manifest_path": { "$ref": "#/$defs/absolute_path" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "schedule_source_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch_ordinal",
        "epoch_plan_id",
        "epoch_plan_path",
        "epoch_plan_sha256",
        "bundle_id",
        "bundle_manifest_path",
        "bundle_manifest_sha256",
        "selected_count",
        "selected_estimated_bytes",
        "member_sha256"
      ],
      "properties": {
        "epoch_ordinal": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "epoch_plan_id": { "$ref": "#/$defs/plan_id" },
        "epoch_plan_path": { "$ref": "#/$defs/absolute_path" },
        "epoch_plan_sha256": { "$ref": "#/$defs/sha256" },
        "bundle_id": { "$ref": "#/$defs/bundle_id" },
        "bundle_manifest_path": { "$ref": "#/$defs/absolute_path" },
        "bundle_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "selected_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "selected_estimated_bytes": { "type": "integer", "minimum": 1 },
        "member_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule_ordinal",
        "role",
        "schedule_path",
        "schedule_sha256",
        "schedule_byte_count",
        "schedule_id",
        "schedule_identity_sha256",
        "preprocess_state_root",
        "source_campaign",
        "source_epoch"
      ],
      "properties": {
        "schedule_ordinal": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "role": { "$ref": "#/$defs/role" },
        "schedule_path": { "$ref": "#/$defs/absolute_path" },
        "schedule_sha256": { "$ref": "#/$defs/sha256" },
        "schedule_byte_count": { "type": "integer", "minimum": 1 },
        "schedule_id": {
          "type": "string",
          "pattern": "^bgacqsched_[0-9a-f]{32}$"
        },
        "schedule_identity_sha256": { "$ref": "#/$defs/sha256" },
        "preprocess_state_root": { "$ref": "#/$defs/absolute_path" },
        "source_campaign": { "$ref": "#/$defs/schedule_source_campaign" },
        "source_epoch": { "$ref": "#/$defs/schedule_source_epoch" }
      }
    },
    "role_total": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "campaign_count",
        "epoch_count",
        "schedule_count",
        "selected_count",
        "selected_estimated_bytes"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "campaign_count": { "const": 1 },
        "epoch_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "schedule_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "selected_count": { "type": "integer", "minimum": 1 },
        "selected_estimated_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "coverage_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_campaign_count",
        "source_epoch_count",
        "schedule_count",
        "source_selected_count",
        "source_selected_estimated_bytes",
        "schedule_selected_count",
        "schedule_selected_estimated_bytes",
        "unique_source_count",
        "overlap_count",
        "missing_count",
        "unexpected_count",
        "source_epoch_union_sha256",
        "schedule_epoch_union_sha256",
        "source_member_union_sha256",
        "schedule_member_union_sha256",
        "ordered_epoch_union_identical",
        "ordered_member_union_identical",
        "roles_exact_and_ordered",
        "source_epochs_contiguous",
        "schedule_ordinals_contiguous"
      ],
      "properties": {
        "source_campaign_count": { "const": 2 },
        "source_epoch_count": { "type": "integer", "minimum": 2, "maximum": 2048 },
        "schedule_count": { "type": "integer", "minimum": 2, "maximum": 2048 },
        "source_selected_count": { "type": "integer", "minimum": 2 },
        "source_selected_estimated_bytes": { "type": "integer", "minimum": 2 },
        "schedule_selected_count": { "type": "integer", "minimum": 2 },
        "schedule_selected_estimated_bytes": { "type": "integer", "minimum": 2 },
        "unique_source_count": { "type": "integer", "minimum": 2 },
        "overlap_count": { "const": 0 },
        "missing_count": { "const": 0 },
        "unexpected_count": { "const": 0 },
        "source_epoch_union_sha256": { "$ref": "#/$defs/sha256" },
        "schedule_epoch_union_sha256": { "$ref": "#/$defs/sha256" },
        "source_member_union_sha256": { "$ref": "#/$defs/sha256" },
        "schedule_member_union_sha256": { "$ref": "#/$defs/sha256" },
        "ordered_epoch_union_identical": { "const": true },
        "ordered_member_union_identical": { "const": true },
        "roles_exact_and_ordered": { "const": true },
        "source_epochs_contiguous": { "const": true },
        "schedule_ordinals_contiguous": { "const": true }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_files_only",
        "access_policy",
        "publication_authority",
        "credentials_allowed",
        "network_access_performed",
        "gpu_execution_performed",
        "media_read_performed",
        "media_write_performed",
        "catalog_mutated",
        "scheduling_performed",
        "processes_started"
      ],
      "properties": {
        "control_files_only": { "const": true },
        "access_policy": { "const": "sealed_public_archive_work_orders_only" },
        "publication_authority": { "const": "none" },
        "credentials_allowed": { "const": false },
        "network_access_performed": { "const": false },
        "gpu_execution_performed": { "const": false },
        "media_read_performed": { "const": false },
        "media_write_performed": { "const": false },
        "catalog_mutated": { "const": false },
        "scheduling_performed": { "const": false },
        "processes_started": { "const": false }
      }
    }
  }
}
