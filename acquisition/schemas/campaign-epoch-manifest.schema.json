{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/acquisition/campaign-epoch-manifest-v1.json",
  "title": "HIMR immutable Archive acquisition campaign epoch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "campaign_relative_path",
    "schema_version",
    "materializer",
    "parent_plan",
    "partition_policy",
    "materialization_policy",
    "coverage_proof",
    "epochs",
    "safety"
  ],
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^acqcampaign_[0-9a-f]{32}$"
    },
    "campaign_relative_path": {
      "type": "string",
      "pattern": "^campaigns/acqcampaign_[0-9a-f]{32}$"
    },
    "schema_version": { "const": 1 },
    "materializer": { "$ref": "#/$defs/materializer" },
    "parent_plan": { "$ref": "#/$defs/parent_plan" },
    "partition_policy": { "$ref": "#/$defs/partition_policy" },
    "materialization_policy": { "$ref": "#/$defs/materialization_policy" },
    "coverage_proof": { "$ref": "#/$defs/coverage_proof" },
    "epochs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/epoch" }
    },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 2,
      "maxLength": 4096
    },
    "materializer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "himr-archive-campaign-epoch-materializer" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "parent_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "path",
        "sha256",
        "byte_count",
        "selected_count",
        "selected_estimated_bytes"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^acqplan_[0-9a-f]{32}$"
        },
        "path": { "$ref": "#/$defs/absolute_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "selected_count": { "type": "integer", "minimum": 1 },
        "selected_estimated_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "partition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "max_epoch_items",
        "max_epoch_estimated_bytes",
        "oversize_single_candidate_policy"
      ],
      "properties": {
        "algorithm": { "const": "stable_greedy_parent_queue_order_v1" },
        "max_epoch_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_epoch_estimated_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "oversize_single_candidate_policy": { "const": "reject" }
      }
    },
    "yt_dlp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "sha256", "byte_count", "format_selector"],
      "properties": {
        "executable": { "$ref": "#/$defs/absolute_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "format_selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "materialization_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_output_root",
        "global_cache_cap_bytes",
        "free_space_floor_bytes",
        "direct_http_timeout_seconds",
        "yt_dlp"
      ],
      "properties": {
        "media_output_root": { "$ref": "#/$defs/absolute_path" },
        "global_cache_cap_bytes": { "type": "integer", "minimum": 1 },
        "free_space_floor_bytes": { "type": "integer", "minimum": 0 },
        "direct_http_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "yt_dlp": { "$ref": "#/$defs/yt_dlp" }
      }
    },
    "coverage_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch_count",
        "parent_selected_count",
        "epoch_union_count",
        "epoch_unique_count",
        "overlap_count",
        "missing_count",
        "unexpected_count",
        "parent_selected_member_sha256",
        "epoch_union_member_sha256",
        "ordered_union_identical",
        "parent_ordinals_contiguous",
        "local_ordinals_contiguous"
      ],
      "properties": {
        "epoch_count": { "type": "integer", "minimum": 1 },
        "parent_selected_count": { "type": "integer", "minimum": 1 },
        "epoch_union_count": { "type": "integer", "minimum": 1 },
        "epoch_unique_count": { "type": "integer", "minimum": 1 },
        "overlap_count": { "const": 0 },
        "missing_count": { "const": 0 },
        "unexpected_count": { "const": 0 },
        "parent_selected_member_sha256": { "$ref": "#/$defs/sha256" },
        "epoch_union_member_sha256": { "$ref": "#/$defs/sha256" },
        "ordered_union_identical": { "const": true },
        "parent_ordinals_contiguous": { "const": true },
        "local_ordinals_contiguous": { "const": true }
      }
    },
    "epoch_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "path", "sha256", "byte_count"],
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^acqplan_[0-9a-f]{32}$"
        },
        "path": { "$ref": "#/$defs/absolute_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "manifest_path",
        "manifest_sha256",
        "manifest_byte_count",
        "work_order_count"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^acqbundle_[0-9a-f]{32}$"
        },
        "manifest_path": { "$ref": "#/$defs/absolute_path" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_byte_count": { "type": "integer", "minimum": 1 },
        "work_order_count": { "type": "integer", "minimum": 1 }
      }
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch_ordinal",
        "parent_queue_ordinal_first",
        "parent_queue_ordinal_last",
        "local_to_parent_ordinal_mapping",
        "parent_queue_ordinals_sha256",
        "selected_count",
        "selected_estimated_bytes",
        "member_sha256",
        "epoch_plan",
        "bundle"
      ],
      "properties": {
        "epoch_ordinal": { "type": "integer", "minimum": 1 },
        "parent_queue_ordinal_first": { "type": "integer", "minimum": 1 },
        "parent_queue_ordinal_last": { "type": "integer", "minimum": 1 },
        "local_to_parent_ordinal_mapping": {
          "const": "parent_queue_ordinal = parent_queue_ordinal_first + local_queue_ordinal - 1"
        },
        "parent_queue_ordinals_sha256": { "$ref": "#/$defs/sha256" },
        "selected_count": { "type": "integer", "minimum": 1 },
        "selected_estimated_bytes": { "type": "integer", "minimum": 1 },
        "member_sha256": { "$ref": "#/$defs/sha256" },
        "epoch_plan": { "$ref": "#/$defs/epoch_plan" },
        "bundle": { "$ref": "#/$defs/bundle" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_files_only",
        "access_policy",
        "publication_authority",
        "credentials_allowed",
        "network_access_performed",
        "gpu_execution_performed",
        "cold_media_written",
        "catalog_mutated",
        "media_deleted"
      ],
      "properties": {
        "control_files_only": { "const": true },
        "access_policy": { "const": "public_only" },
        "publication_authority": { "const": "none" },
        "credentials_allowed": { "const": false },
        "network_access_performed": { "const": false },
        "gpu_execution_performed": { "const": false },
        "cold_media_written": { "const": false },
        "catalog_mutated": { "const": false },
        "media_deleted": { "const": false }
      }
    }
  }
}
