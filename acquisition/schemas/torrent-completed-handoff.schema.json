{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/acquisition/torrent-completed-handoff-v1.json",
  "title": "HIMR completed selected torrent-file catalogue handoff work order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_order_kind",
    "producer",
    "observed_at",
    "bindings",
    "selected_file",
    "verification",
    "media",
    "tooling",
    "catalogue_handoff",
    "policy",
    "work_order_id",
    "work_order_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "work_order_kind": { "const": "torrent_completed_selected_file_handoff" },
    "producer": { "$ref": "#/$defs/producer" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "bindings": { "$ref": "#/$defs/bindings" },
    "selected_file": { "$ref": "#/$defs/selectedFile" },
    "verification": { "$ref": "#/$defs/verification" },
    "media": { "$ref": "#/$defs/media" },
    "tooling": { "$ref": "#/$defs/tooling" },
    "catalogue_handoff": { "$ref": "#/$defs/catalogueHandoff" },
    "policy": { "$ref": "#/$defs/policy" },
    "work_order_id": {
      "type": "string",
      "pattern": "^tch_[0-9a-f]{32}$"
    },
    "work_order_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "nullableString": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "null" }
      ]
    },
    "nullableNonnegativeInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "himr-torrent-completed-handoff" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "selector", "torrent", "session", "control"],
      "properties": {
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan_id", "canonical_sha256", "file_sha256", "byte_count"],
          "properties": {
            "plan_id": {
              "type": "string",
              "pattern": "^tslp_[0-9a-f]{32}$"
            },
            "canonical_sha256": { "$ref": "#/$defs/sha256" },
            "file_sha256": { "$ref": "#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 1 }
          }
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt_id",
            "canonical_sha256",
            "file_sha256",
            "byte_count",
            "selected_file_count"
          ],
          "properties": {
            "receipt_id": {
              "type": "string",
              "pattern": "^a2sr_[0-9a-f]{32}$"
            },
            "canonical_sha256": { "$ref": "#/$defs/sha256" },
            "file_sha256": { "$ref": "#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 1 },
            "selected_file_count": { "type": "integer", "minimum": 1 }
          }
        },
        "torrent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "byte_count",
            "info_hash_sha1",
            "file_count",
            "piece_length_bytes",
            "piece_count",
            "total_bytes"
          ],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 1 },
            "info_hash_sha1": { "$ref": "#/$defs/sha1" },
            "file_count": { "type": "integer", "minimum": 1 },
            "piece_length_bytes": { "type": "integer", "minimum": 1 },
            "piece_count": { "type": "integer", "minimum": 1 },
            "total_bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "byte_count",
            "selector_matches",
            "output_directory_matches",
            "required_safety_options_match"
          ],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 1 },
            "selector_matches": { "const": true },
            "output_directory_matches": { "const": true },
            "required_safety_options_match": { "const": true }
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "byte_count",
            "format_version",
            "extension_marker",
            "recorded_uploaded_bytes"
          ],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 1 },
            "format_version": { "const": 1 },
            "extension_marker": { "const": 1 },
            "recorded_uploaded_bytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "source_kind", "native_id"],
      "properties": {
        "platform": { "const": "bittorrent" },
        "source_kind": { "const": "torrent_file_candidate" },
        "native_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "selectedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "torrent_file_index",
        "aria2_file_index",
        "manifest_path",
        "manifest_path_components_base64",
        "manifest_path_sha256",
        "payload_relative_path",
        "declared_byte_count",
        "media_suffix",
        "first_piece_index",
        "last_piece_index",
        "covering_piece_count",
        "covering_piece_indices_sha256",
        "youtube_video_id",
        "availability_evidence_code",
        "selection_reason",
        "source_identity"
      ],
      "properties": {
        "torrent_file_index": { "type": "integer", "minimum": 0 },
        "aria2_file_index": { "type": "integer", "minimum": 1 },
        "manifest_path": { "$ref": "#/$defs/nonEmptyString" },
        "manifest_path_components_base64": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 5464,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        },
        "manifest_path_sha256": { "$ref": "#/$defs/sha256" },
        "payload_relative_path": { "$ref": "#/$defs/nonEmptyString" },
        "declared_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 68719476736
        },
        "media_suffix": {
          "type": "string",
          "pattern": "^\\.[a-z0-9]{2,5}$"
        },
        "first_piece_index": { "type": "integer", "minimum": 0 },
        "last_piece_index": { "type": "integer", "minimum": 0 },
        "covering_piece_count": { "type": "integer", "minimum": 1 },
        "covering_piece_indices_sha256": { "$ref": "#/$defs/sha256" },
        "youtube_video_id": { "$ref": "#/$defs/nullableString" },
        "availability_evidence_code": { "$ref": "#/$defs/nullableString" },
        "selection_reason": { "$ref": "#/$defs/nullableString" },
        "source_identity": { "$ref": "#/$defs/sourceIdentity" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_receipt_replayed",
        "session_selector_matches",
        "target_is_selected",
        "target_is_boundary_artifact",
        "all_covering_pieces_complete",
        "covering_piece_in_flight_count",
        "authorized_piece_state_only",
        "target_regular_non_symlink_single_link",
        "target_size_matches_manifest",
        "target_metadata_stable",
        "control_stable_double_read",
        "acquisition_snapshot_stable_before_and_after"
      ],
      "properties": {
        "selector_receipt_replayed": { "const": true },
        "session_selector_matches": { "const": true },
        "target_is_selected": { "const": true },
        "target_is_boundary_artifact": { "const": false },
        "all_covering_pieces_complete": { "const": true },
        "covering_piece_in_flight_count": { "const": 0 },
        "authorized_piece_state_only": { "const": true },
        "target_regular_non_symlink_single_link": { "const": true },
        "target_size_matches_manifest": { "const": true },
        "target_metadata_stable": { "const": true },
        "control_stable_double_read": { "const": true },
        "acquisition_snapshot_stable_before_and_after": { "const": true }
      }
    },
    "probeTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "ffprobe" },
        "version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "probeFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_name", "format_long_name", "duration_ms", "bit_rate_bps"],
      "properties": {
        "format_name": { "$ref": "#/$defs/nullableString" },
        "format_long_name": { "$ref": "#/$defs/nullableString" },
        "duration_ms": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "bit_rate_bps": { "$ref": "#/$defs/nullableNonnegativeInteger" }
      }
    },
    "probeStreamVideo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index", "codec_type", "codec_name", "duration_ms", "bit_rate_bps", "language",
        "width", "height", "pixel_format", "average_frame_rate"
      ],
      "properties": {
        "index": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "codec_type": { "const": "video" },
        "codec_name": { "$ref": "#/$defs/nullableString" },
        "duration_ms": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "bit_rate_bps": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "language": { "$ref": "#/$defs/nullableString" },
        "width": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "height": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "pixel_format": { "$ref": "#/$defs/nullableString" },
        "average_frame_rate": { "$ref": "#/$defs/nullableString" }
      }
    },
    "probeStreamAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index", "codec_type", "codec_name", "duration_ms", "bit_rate_bps", "language",
        "sample_rate_hz", "channels", "channel_layout"
      ],
      "properties": {
        "index": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "codec_type": { "const": "audio" },
        "codec_name": { "$ref": "#/$defs/nullableString" },
        "duration_ms": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "bit_rate_bps": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "language": { "$ref": "#/$defs/nullableString" },
        "sample_rate_hz": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "channels": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "channel_layout": { "$ref": "#/$defs/nullableString" }
      }
    },
    "probeStreamOther": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "codec_type", "codec_name", "duration_ms", "bit_rate_bps", "language"],
      "properties": {
        "index": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "codec_type": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "not": { "enum": ["video", "audio"] }
            },
            { "type": "null" }
          ]
        },
        "codec_name": { "$ref": "#/$defs/nullableString" },
        "duration_ms": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "bit_rate_bps": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "language": { "$ref": "#/$defs/nullableString" }
      }
    },
    "normalizedProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tool", "format", "streams"],
      "properties": {
        "schema_version": { "const": 1 },
        "tool": { "$ref": "#/$defs/probeTool" },
        "format": { "$ref": "#/$defs/probeFormat" },
        "streams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/probeStreamVideo" },
              { "$ref": "#/$defs/probeStreamAudio" },
              { "$ref": "#/$defs/probeStreamOther" }
            ]
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_id", "sha256", "byte_count", "media_kind", "mime_type",
        "container", "duration_ms", "normalized_probe"
      ],
      "properties": {
        "media_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "media_kind": { "enum": ["video", "audio"] },
        "mime_type": { "$ref": "#/$defs/nullableString" },
        "container": { "$ref": "#/$defs/nullableString" },
        "duration_ms": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "normalized_probe": { "$ref": "#/$defs/normalizedProbe" }
      }
    },
    "ffprobeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count", "version", "command_contract"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "command_contract": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ffprobe"],
      "properties": {
        "ffprobe": { "$ref": "#/$defs/ffprobeBinding" }
      }
    },
    "catalogueHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_action", "source_identity", "source_must_preexist", "media_id",
        "requires_separate_catalogue_import", "catalogue_import_performed",
        "media_admitted", "publication_authority"
      ],
      "properties": {
        "required_action": {
          "const": "resolve_existing_source_identity_copy_to_canonical_cache_and_admit_verified_rendition"
        },
        "source_identity": { "$ref": "#/$defs/sourceIdentity" },
        "source_must_preexist": { "const": true },
        "media_id": {
          "type": "string",
          "pattern": "^media_sha256_[0-9a-f]{64}$"
        },
        "requires_separate_catalogue_import": { "const": true },
        "catalogue_import_performed": { "const": false },
        "media_admitted": { "const": false },
        "publication_authority": { "const": false }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_actions_performed", "torrent_client_invoked", "torrent_process_inspected",
        "torrent_state_mutated", "catalogue_mutated", "media_admitted", "payload_executed",
        "only_selected_payload_opened", "unselected_payload_files_opened",
        "selected_payload_bytes_hashed", "publication_authority",
        "human_review_required_before_catalogue_import"
      ],
      "properties": {
        "network_actions_performed": { "const": false },
        "torrent_client_invoked": { "const": false },
        "torrent_process_inspected": { "const": false },
        "torrent_state_mutated": { "const": false },
        "catalogue_mutated": { "const": false },
        "media_admitted": { "const": false },
        "payload_executed": { "const": false },
        "only_selected_payload_opened": { "const": true },
        "unselected_payload_files_opened": { "const": 0 },
        "selected_payload_bytes_hashed": { "type": "integer", "minimum": 1 },
        "publication_authority": { "const": false },
        "human_review_required_before_catalogue_import": { "const": true }
      }
    }
  }
}
