{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/acquisition/archive-metadata-delta-v1.json",
  "title": "HIMR Archive.org item-metadata snapshot delta v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["delta_id", "schema_version", "delta_kind", "observed_at", "previous", "current", "summary", "items", "assertion_policy"],
  "properties": {
    "delta_id": {"type": "string", "pattern": "^iamd_[0-9a-f]{32}$"},
    "schema_version": {"const": 1},
    "delta_kind": {"const": "archive_org_item_metadata_delta"},
    "observed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "previous": {"$ref": "#/$defs/snapshotEvidence"},
    "current": {"$ref": "#/$defs/snapshotEvidence"},
    "summary": {"$ref": "#/$defs/summary"},
    "items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/item"}},
    "assertion_policy": {"$ref": "#/$defs/assertionPolicy"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "snapshotEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "snapshot_sha256"],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^iams_[0-9a-f]{32}$"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added_items", "removed_items", "changed_items", "unchanged_items", "added_files", "removed_files", "changed_files"],
      "properties": {
        "added_items": {"type": "integer", "minimum": 0},
        "removed_items": {"type": "integer", "minimum": 0},
        "changed_items": {"type": "integer", "minimum": 0},
        "unchanged_items": {"type": "integer", "minimum": 0},
        "added_files": {"type": "integer", "minimum": 0},
        "removed_files": {"type": "integer", "minimum": 0},
        "changed_files": {"type": "integer", "minimum": 0}
      }
    },
    "fileNames": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 200000,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "state", "previous_payload_sha256", "current_payload_sha256", "added_files", "removed_files", "changed_files"],
      "properties": {
        "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
        "state": {"enum": ["added", "removed", "changed", "unchanged"]},
        "previous_payload_sha256": {"$ref": "#/$defs/nullableSha256"},
        "current_payload_sha256": {"$ref": "#/$defs/nullableSha256"},
        "added_files": {"$ref": "#/$defs/fileNames"},
        "removed_files": {"$ref": "#/$defs/fileNames"},
        "changed_files": {"$ref": "#/$defs/fileNames"}
      }
    },
    "assertionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "content_change_asserted", "publication_authority"],
      "properties": {
        "state": {"const": "unreviewed_provider_metadata_delta"},
        "content_change_asserted": {"const": false},
        "publication_authority": {"const": false}
      }
    }
  }
}
