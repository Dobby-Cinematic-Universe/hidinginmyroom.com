#!/usr/bin/python3
"""Fixed Python entrypoint for the rolling Archive pipeline."""

from pathlib import Path
import hashlib
import os
import stat
import sys


ACQUISITION_ROOT = Path(__file__).resolve().parent.parent
EXPECTED_SOURCES = {
    "archive_rolling_pipeline.py": "16598bcfa56d8fb08c0459089c1d884a5bb606bb58785e4c007a6471ee5c8b68",
    "archive_preprocess_handoff.py": "ab7706e9ac152e6a431ee828409ab609363c3347de051a13c64702b7d38dbf7a",
}


def verify_source(name: str, expected_sha256: str) -> None:
    path = ACQUISITION_ROOT / name
    before = path.lstat()
    if (
        stat.S_ISLNK(before.st_mode)
        or not stat.S_ISREG(before.st_mode)
        or before.st_uid != os.geteuid()
        or before.st_nlink != 1
        or stat.S_IMODE(before.st_mode) & 0o022
    ):
        raise RuntimeError(f"rolling pipeline source is unsafe: {name}")
    descriptor = os.open(
        path,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        opened = os.fstat(descriptor)
        body = bytearray()
        while len(body) < opened.st_size:
            chunk = os.read(descriptor, opened.st_size - len(body))
            if not chunk:
                break
            body.extend(chunk)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    current = path.lstat()
    identity = lambda value: (
        value.st_dev,
        value.st_ino,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
        value.st_mode,
        value.st_nlink,
        value.st_uid,
    )
    if (
        len(body) != before.st_size
        or identity(before) != identity(opened)
        or identity(opened) != identity(after)
        or identity(after) != identity(current)
        or hashlib.sha256(body).hexdigest() != expected_sha256
    ):
        raise RuntimeError(f"rolling pipeline source differs from its launcher pin: {name}")


for source_name, source_sha256 in EXPECTED_SOURCES.items():
    verify_source(source_name, source_sha256)

sys.path.insert(0, str(ACQUISITION_ROOT))

from archive_rolling_pipeline import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
