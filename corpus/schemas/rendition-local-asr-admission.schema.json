{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/corpus/rendition-local-asr-admission-v1.json",
  "title": "HIMR private rendition-local ASR admission plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "bridge_version",
    "plan_sha256",
    "result",
    "catalog_context",
    "coordinate_contract",
    "transform_candidates",
    "statistics",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["validated", "admitted"] },
    "bridge_version": { "const": "rendition-local-asr-bridge/1" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "result": { "$ref": "#/$defs/result" },
    "catalog_context": { "$ref": "#/$defs/catalogContext" },
    "coordinate_contract": { "$ref": "#/$defs/coordinateContract" },
    "transform_candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/transformCandidate" }
    },
    "statistics": { "$ref": "#/$defs/statistics" },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "mediaId": {
      "type": "string",
      "pattern": "^media_sha256_[0-9a-f]{64}$"
    },
    "fileUri": {
      "type": "string",
      "pattern": "^file:///"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asr_result_uri",
        "raw_sha256",
        "canonical_sha256",
        "byte_count",
        "result_key",
        "processing_run_id",
        "input_artifact_id",
        "local_window_result_uri",
        "local_window_result_sha256",
        "local_revision_id"
      ],
      "properties": {
        "asr_result_uri": { "$ref": "#/$defs/fileUri" },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "result_key": { "$ref": "#/$defs/sha256" },
        "processing_run_id": { "$ref": "#/$defs/identifier" },
        "input_artifact_id": { "$ref": "#/$defs/identifier" },
        "local_window_result_uri": { "$ref": "#/$defs/fileUri" },
        "local_window_result_sha256": { "$ref": "#/$defs/sha256" },
        "local_revision_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "catalogContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recording_id",
        "rendition_id",
        "source_id",
        "source_media_id",
        "source_rendition_id",
        "recording_declared_duration_ms",
        "source_media_duration_ms",
        "duration_delta_ms"
      ],
      "properties": {
        "recording_id": { "$ref": "#/$defs/identifier" },
        "rendition_id": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "source_media_id": { "$ref": "#/$defs/mediaId" },
        "source_rendition_id": { "$ref": "#/$defs/identifier" },
        "recording_declared_duration_ms": { "type": "integer", "minimum": 1 },
        "source_media_duration_ms": { "type": "integer", "minimum": 1 },
        "duration_delta_ms": { "type": "integer" }
      }
    },
    "sourceTimeMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "source_start_ms",
        "source_end_ms",
        "artifact_zero_maps_to_source_ms",
        "coordinate_precision",
        "extraction_method",
        "byte_exact_source_fragment"
      ],
      "properties": {
        "boundary": { "const": "half_open" },
        "source_start_ms": { "type": "integer", "minimum": 0 },
        "source_end_ms": { "type": "integer", "minimum": 1 },
        "artifact_zero_maps_to_source_ms": { "type": "integer", "minimum": 0 },
        "coordinate_precision": { "const": "integer_millisecond_contract" },
        "extraction_method": { "const": "ffmpeg_accurate_seek_transcode" },
        "byte_exact_source_fragment": { "const": false }
      }
    },
    "coordinateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_system",
        "boundary",
        "requested_start_ms",
        "requested_end_ms",
        "input_duration_ms",
        "max_segment_end_ms",
        "input_boundary_overrun_ms",
        "source_time_mapping",
        "artifact_source_duration_delta_ms",
        "max_segment_source_end_ms",
        "source_boundary_overrun_ms",
        "source_mapping_state",
        "recording_transform_state",
        "recording_coordinates_asserted"
      ],
      "properties": {
        "coordinate_system": { "const": "rendition_media_ms" },
        "boundary": { "const": "half_open" },
        "requested_start_ms": { "const": 0 },
        "requested_end_ms": { "type": "integer", "minimum": 1 },
        "input_duration_ms": { "type": "integer", "minimum": 1 },
        "max_segment_end_ms": { "type": "integer", "minimum": 0 },
        "input_boundary_overrun_ms": { "type": "integer", "minimum": 0 },
        "source_time_mapping": { "$ref": "#/$defs/sourceTimeMapping" },
        "artifact_source_duration_delta_ms": { "type": "integer" },
        "max_segment_source_end_ms": { "type": "integer", "minimum": 0 },
        "source_boundary_overrun_ms": { "type": "integer", "minimum": 0 },
        "source_mapping_state": {
          "const": "integer_contract_not_boundary_calibrated"
        },
        "recording_transform_state": { "const": "unresolved" },
        "recording_coordinates_asserted": { "const": false }
      }
    },
    "transformCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transform_candidate_id",
        "review_task_id",
        "candidate_kind",
        "source_start_ms",
        "source_end_ms",
        "proposed_recording_start_ms",
        "proposed_recording_end_ms",
        "scale_numerator",
        "scale_denominator",
        "declared_recording_duration_ms",
        "acquired_media_duration_ms",
        "duration_delta_ms",
        "evidence_state",
        "timeline_application_allowed",
        "relationship_asserted",
        "created_at",
        "timestamp_basis",
        "human_review_required"
      ],
      "properties": {
        "transform_candidate_id": { "$ref": "#/$defs/identifier" },
        "review_task_id": { "$ref": "#/$defs/identifier" },
        "candidate_kind": {
          "enum": [
            "identity_from_acquired_media_duration_hypothesis",
            "linear_scale_to_declared_recording_duration_hypothesis"
          ]
        },
        "source_start_ms": { "const": 0 },
        "source_end_ms": { "type": "integer", "minimum": 1 },
        "proposed_recording_start_ms": { "const": 0 },
        "proposed_recording_end_ms": { "type": "integer", "minimum": 1 },
        "scale_numerator": { "type": "integer", "minimum": 1 },
        "scale_denominator": { "type": "integer", "minimum": 1 },
        "declared_recording_duration_ms": { "type": "integer", "minimum": 1 },
        "acquired_media_duration_ms": { "type": "integer", "minimum": 1 },
        "duration_delta_ms": { "type": "integer" },
        "evidence_state": { "const": "hypothesis_only_unreviewed" },
        "timeline_application_allowed": { "const": false },
        "relationship_asserted": { "const": false },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "timestamp_basis": { "const": "source_media_first_cataloged_at" },
        "human_review_required": { "const": true }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_runs",
        "run_inputs",
        "artifacts",
        "rendition_local_revisions",
        "rendition_local_segments",
        "rendition_local_words",
        "rendition_local_import_receipts",
        "transform_candidates",
        "review_tasks",
        "recording_scoped_transcript_revisions",
        "timeline_map_spans",
        "publication_decisions"
      ],
      "properties": {
        "processing_runs": { "const": 1 },
        "run_inputs": { "const": 1 },
        "artifacts": { "const": 2 },
        "rendition_local_revisions": { "const": 1 },
        "rendition_local_segments": { "type": "integer", "minimum": 0 },
        "rendition_local_words": { "type": "integer", "minimum": 0 },
        "rendition_local_import_receipts": { "const": 1 },
        "transform_candidates": { "type": "integer", "minimum": 1, "maximum": 2 },
        "review_tasks": { "type": "integer", "minimum": 1, "maximum": 2 },
        "recording_scoped_transcript_revisions": { "const": 0 },
        "timeline_map_spans": { "const": 0 },
        "publication_decisions": { "const": 0 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "publication_authority",
        "identity_authority",
        "network_access_performed",
        "credentials_used",
        "source_boundary_calibrated",
        "transform_applied",
        "transcript_text_in_plan"
      ],
      "properties": {
        "visibility": { "const": "private" },
        "publication_authority": { "const": "none" },
        "identity_authority": { "const": "none" },
        "network_access_performed": { "const": false },
        "credentials_used": { "const": false },
        "source_boundary_calibrated": { "const": false },
        "transform_applied": { "const": false },
        "transcript_text_in_plan": { "const": false }
      }
    }
  }
}
