{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/corpus/entity-event-map-manifest-v1.json",
  "title": "Private source-anchored entity/event map manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "created_at",
    "created_by",
    "basis",
    "entities",
    "aliases",
    "appearances",
    "events",
    "event_dates",
    "event_participants",
    "event_relations",
    "event_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": { "$ref": "#/$defs/identifier" },
    "created_at": { "$ref": "#/$defs/canonicalUtcTimestamp" },
    "created_by": { "type": "string", "minLength": 1, "maxLength": 500 },
    "basis": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "entities": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/entity" }
    },
    "aliases": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/alias" }
    },
    "appearances": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/appearance" }
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/event" }
    },
    "event_dates": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/eventDate" }
    },
    "event_participants": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/eventParticipant" }
    },
    "event_relations": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/eventRelation" }
    },
    "event_evidence": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/eventEvidence" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "slug": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "canonicalUtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nullableIdentifier": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "nullableDay": {
      "oneOf": [
        { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        { "type": "null" }
      ]
    },
    "dateValue": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$" },
        { "type": "null" }
      ]
    },
    "metadata": {
      "type": "object",
      "propertyNames": { "not": { "const": "_entity_event_map" } },
      "additionalProperties": true
    },
    "localEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "path", "sha256", "byte_count"],
          "properties": {
            "artifact_id": { "$ref": "#/$defs/identifier" },
            "path": { "type": "string", "pattern": "^/", "minLength": 2 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "byte_count": { "type": "integer", "minimum": 0 }
          }
        },
        { "type": "null" }
      ]
    },
    "evidenceBasisKind": {
      "enum": [
        "direct_media_observation",
        "subject_unverified_claim",
        "third_party_unverified_claim",
        "documentary_context"
      ]
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type",
        "canonical_label",
        "slug",
        "privacy_classification",
        "metadata"
      ],
      "properties": {
        "entity_id": { "$ref": "#/$defs/identifier" },
        "entity_type": {
          "enum": [
            "person",
            "community_figure",
            "animal",
            "place",
            "organization",
            "platform",
            "term",
            "object",
            "unknown"
          ]
        },
        "canonical_label": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "slug": { "$ref": "#/$defs/slug" },
        "privacy_classification": {
          "enum": [
            "public_figure",
            "living_private_person",
            "deceased_person",
            "non_person",
            "unknown"
          ]
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_alias_id",
        "entity_id",
        "alias",
        "alias_kind",
        "source_id",
        "valid_from",
        "valid_to",
        "sensitive",
        "privacy_review_required"
      ],
      "properties": {
        "entity_alias_id": { "$ref": "#/$defs/identifier" },
        "entity_id": { "$ref": "#/$defs/identifier" },
        "alias": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "alias_kind": {
          "enum": [
            "name",
            "nickname",
            "display_name",
            "username",
            "handle",
            "account_handle",
            "historical_name",
            "other"
          ]
        },
        "source_id": { "$ref": "#/$defs/identifier" },
        "valid_from": { "$ref": "#/$defs/nullableDay" },
        "valid_to": { "$ref": "#/$defs/nullableDay" },
        "sensitive": { "type": "boolean" },
        "privacy_review_required": { "type": "boolean" }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appearance_id",
        "entity_id",
        "source_id",
        "recording_id",
        "rendition_id",
        "start_ms",
        "end_ms",
        "appearance_role",
        "evidence_basis_kind",
        "transcript_revision_id",
        "local_evidence",
        "basis"
      ],
      "properties": {
        "appearance_id": { "$ref": "#/$defs/identifier" },
        "entity_id": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "recording_id": { "$ref": "#/$defs/identifier" },
        "rendition_id": { "$ref": "#/$defs/identifier" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "appearance_role": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidence_basis_kind": { "$ref": "#/$defs/evidenceBasisKind" },
        "transcript_revision_id": { "$ref": "#/$defs/nullableIdentifier" },
        "local_evidence": { "$ref": "#/$defs/localEvidence" },
        "basis": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "canonical_label", "slug", "event_kind", "description", "metadata"],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "canonical_label": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "slug": { "$ref": "#/$defs/slug" },
        "event_kind": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 16384 },
            { "type": "null" }
          ]
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "eventDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_date_id",
        "event_id",
        "date_kind",
        "value_start",
        "value_end",
        "precision",
        "basis",
        "certainty"
      ],
      "properties": {
        "event_date_id": { "$ref": "#/$defs/identifier" },
        "event_id": { "$ref": "#/$defs/identifier" },
        "date_kind": { "type": "string", "minLength": 1, "maxLength": 500 },
        "value_start": { "$ref": "#/$defs/dateValue" },
        "value_end": { "$ref": "#/$defs/dateValue" },
        "precision": { "enum": ["day", "month", "year", "range", "circa", "unknown"] },
        "basis": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "certainty": { "enum": ["certain", "probable", "uncertain", "disputed"] }
      }
    },
    "eventParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "entity_id", "participant_role"],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "entity_id": { "$ref": "#/$defs/identifier" },
        "participant_role": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "eventRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_relation_id", "from_event_id", "relation_kind", "to_event_id", "basis"],
      "properties": {
        "event_relation_id": { "$ref": "#/$defs/identifier" },
        "from_event_id": { "$ref": "#/$defs/identifier" },
        "relation_kind": { "type": "string", "minLength": 1, "maxLength": 500 },
        "to_event_id": { "$ref": "#/$defs/identifier" },
        "basis": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    },
    "eventEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_evidence_id",
        "event_id",
        "source_id",
        "recording_id",
        "rendition_id",
        "start_ms",
        "end_ms",
        "support_kind",
        "evidence_basis_kind",
        "transcript_revision_id",
        "local_evidence",
        "basis"
      ],
      "properties": {
        "event_evidence_id": { "$ref": "#/$defs/identifier" },
        "event_id": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "recording_id": { "$ref": "#/$defs/identifier" },
        "rendition_id": { "$ref": "#/$defs/identifier" },
        "start_ms": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "end_ms": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "support_kind": { "enum": ["direct", "contextual", "corroborating", "contradicting"] },
        "evidence_basis_kind": { "$ref": "#/$defs/evidenceBasisKind" },
        "transcript_revision_id": { "$ref": "#/$defs/nullableIdentifier" },
        "local_evidence": { "$ref": "#/$defs/localEvidence" },
        "basis": { "type": "string", "minLength": 1, "maxLength": 8192 }
      },
      "allOf": [
        {
          "if": { "properties": { "start_ms": { "type": "null" } } },
          "then": { "properties": { "end_ms": { "type": "null" } } }
        },
        {
          "if": { "properties": { "end_ms": { "type": "null" } } },
          "then": { "properties": { "start_ms": { "type": "null" } } }
        }
      ]
    }
  }
}
