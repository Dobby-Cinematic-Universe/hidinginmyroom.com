{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/corpus/schemas/public-entity-event-graph-v1.json",
  "title": "HIMR reviewed public entity/event graph shard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "generated_at",
    "counts",
    "entities",
    "events",
    "appearances",
    "event_participants",
    "event_dates",
    "event_relations",
    "event_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "entity_event_graph" },
    "generated_at": { "$ref": "#/$defs/utcTimestamp" },
    "counts": { "$ref": "#/$defs/counts" },
    "entities": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/entity" }
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/event" }
    },
    "appearances": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/appearance" }
    },
    "event_participants": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/participant" }
    },
    "event_dates": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/eventDate" }
    },
    "event_relations": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/eventRelation" }
    },
    "event_evidence": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/eventEvidence" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "slug": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 512 },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:19|20)[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "events",
        "appearances",
        "event_participants",
        "event_dates",
        "event_relations",
        "event_evidence"
      ],
      "properties": {
        "entities": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "events": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "appearances": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "event_participants": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "event_dates": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "event_relations": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "event_evidence": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "recordingAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recording_id", "slug", "title"],
      "properties": {
        "recording_id": { "$ref": "#/$defs/identifier" },
        "slug": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "sourceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "platform", "url", "native_id"],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "platform": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096,
          "pattern": "^https?://"
        },
        "native_id": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "renditionAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendition_id", "time_basis"],
      "properties": {
        "rendition_id": { "$ref": "#/$defs/identifier" },
        "time_basis": { "const": "rendition_media_ms" }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recording", "source", "rendition"],
      "properties": {
        "recording": { "$ref": "#/$defs/recordingAnchor" },
        "source": { "$ref": "#/$defs/sourceAnchor" },
        "rendition": { "$ref": "#/$defs/renditionAnchor" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "slug", "label", "entity_type"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/identifier" },
        "slug": { "$ref": "#/$defs/slug" },
        "label": { "$ref": "#/$defs/label" },
        "entity_type": {
          "enum": [
            "person",
            "community_figure",
            "animal",
            "place",
            "organization",
            "platform",
            "term",
            "object",
            "unknown"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "slug", "label"],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "slug": { "$ref": "#/$defs/slug" },
        "label": { "$ref": "#/$defs/label" }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appearance_id",
        "entity_id",
        "label",
        "start_ms",
        "end_ms",
        "anchor"
      ],
      "properties": {
        "appearance_id": { "$ref": "#/$defs/identifier" },
        "entity_id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/label" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "anchor": { "$ref": "#/$defs/anchor" }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_participant_id", "event_id", "entity_id", "label"],
      "properties": {
        "event_participant_id": { "$ref": "#/$defs/identifier" },
        "event_id": { "$ref": "#/$defs/identifier" },
        "entity_id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/label" }
      }
    },
    "dateValue": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"
    },
    "eventDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_date_id",
        "event_id",
        "label",
        "value_start",
        "value_end",
        "precision",
        "certainty"
      ],
      "properties": {
        "event_date_id": { "$ref": "#/$defs/identifier" },
        "event_id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/label" },
        "value_start": { "$ref": "#/$defs/dateValue" },
        "value_end": { "$ref": "#/$defs/dateValue" },
        "precision": { "enum": ["day", "month", "year", "range", "circa", "unknown"] },
        "certainty": { "enum": ["certain", "probable", "uncertain", "disputed"] }
      }
    },
    "eventRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_relation_id", "from_event_id", "to_event_id", "label"],
      "properties": {
        "event_relation_id": { "$ref": "#/$defs/identifier" },
        "from_event_id": { "$ref": "#/$defs/identifier" },
        "to_event_id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/label" }
      }
    },
    "nullableMillisecond": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "eventEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_evidence_id",
        "event_id",
        "label",
        "support_kind",
        "start_ms",
        "end_ms",
        "anchor"
      ],
      "properties": {
        "event_evidence_id": { "$ref": "#/$defs/identifier" },
        "event_id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/label" },
        "support_kind": { "enum": ["direct", "contextual", "corroborating", "contradicting"] },
        "start_ms": { "$ref": "#/$defs/nullableMillisecond" },
        "end_ms": { "$ref": "#/$defs/nullableMillisecond" },
        "anchor": { "$ref": "#/$defs/anchor" }
      }
    }
  }
}
