{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/corpus/reviewer-admin-manifest-v1.json",
  "title": "Private reviewer administration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "created_at",
    "authorized_by",
    "basis",
    "registrations",
    "state_changes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": { "$ref": "#/$defs/identifier" },
    "created_at": { "$ref": "#/$defs/utcTimestamp" },
    "authorized_by": { "$ref": "#/$defs/identifier" },
    "basis": { "$ref": "#/$defs/basis" },
    "registrations": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/registration" }
    },
    "state_changes": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stateChange" }
    }
  },
  "anyOf": [
    { "properties": { "registrations": { "minItems": 1 } } },
    { "properties": { "state_changes": { "minItems": 1 } } }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "displayLabel": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120,
      "pattern": "^(?!.*  )[A-Za-z0-9](?:[A-Za-z0-9 .,'()_-]{0,118})[A-Za-z0-9)]$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_registration_id",
        "reviewer_id",
        "display_label",
        "reviewer_kind",
        "registered_at",
        "basis"
      ],
      "properties": {
        "reviewer_registration_id": { "$ref": "#/$defs/identifier" },
        "reviewer_id": { "$ref": "#/$defs/identifier" },
        "display_label": { "$ref": "#/$defs/displayLabel" },
        "reviewer_kind": {
          "enum": ["human", "automated_policy", "imported_legacy"]
        },
        "registered_at": { "$ref": "#/$defs/utcTimestamp" },
        "basis": { "$ref": "#/$defs/basis" }
      }
    },
    "stateChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_state_change_id",
        "reviewer_id",
        "active",
        "changed_at",
        "basis"
      ],
      "properties": {
        "reviewer_state_change_id": { "$ref": "#/$defs/identifier" },
        "reviewer_id": { "$ref": "#/$defs/identifier" },
        "active": { "type": "boolean" },
        "changed_at": { "$ref": "#/$defs/utcTimestamp" },
        "basis": { "$ref": "#/$defs/basis" }
      }
    }
  }
}
