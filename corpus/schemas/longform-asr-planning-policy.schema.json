{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/corpus/longform-asr-planning-policy.schema.json",
  "title": "Long-form ASR direct and adaptive planning policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "direct_max_samples", "adaptive"],
  "properties": {
    "kind": {"const": "himr_longform_asr_planning_policy"},
    "schema_version": {"const": 1},
    "direct_max_samples": {"$ref": "#/$defs/positive_integer"},
    "adaptive": {"$ref": "#/$defs/adaptive"}
  },
  "$defs": {
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "adaptive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_core_samples",
        "min_core_samples",
        "max_core_samples",
        "boundary_search_samples",
        "padding_samples",
        "max_span_count"
      ],
      "properties": {
        "target_core_samples": {"$ref": "#/$defs/positive_integer"},
        "min_core_samples": {"$ref": "#/$defs/positive_integer"},
        "max_core_samples": {"$ref": "#/$defs/positive_integer"},
        "boundary_search_samples": {"$ref": "#/$defs/nonnegative_integer"},
        "padding_samples": {"$ref": "#/$defs/nonnegative_integer"},
        "max_span_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "description": "The planner additionally enforces min <= target <= max, direct_max >= max, and padding <= max."
    }
  }
}
