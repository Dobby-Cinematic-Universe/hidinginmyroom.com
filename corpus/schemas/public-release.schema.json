{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/corpus/schemas/public-release-v1.json",
  "title": "HIMR static corpus metadata release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "generated_at",
    "counts",
    "recordings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "type": "string", "pattern": "^release_[a-f0-9]{24}$" },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:19|20)[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordings", "sources", "transcript_revisions", "segments"],
      "properties": {
        "recordings": { "type": "integer", "minimum": 0 },
        "sources": { "type": "integer", "minimum": 0 },
        "transcript_revisions": { "type": "integer", "minimum": 0 },
        "segments": { "type": "integer", "minimum": 0 }
      }
    },
    "recordings": {
      "type": "array",
      "items": { "$ref": "#/$defs/recording" }
    }
  },
  "$defs": {
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recording_id",
        "slug",
        "title",
        "date_label",
        "date_year",
        "date_basis",
        "duration_ms",
        "recording_type",
        "review_state",
        "sources",
        "transcript_revisions"
      ],
      "properties": {
        "recording_id": { "type": "string", "pattern": "^rec_[a-f0-9]{32}$" },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "title": { "type": "string", "minLength": 1 },
        "date_label": { "type": ["string", "null"] },
        "date_year": { "type": ["integer", "null"] },
        "date_basis": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "recording_type": {
          "enum": [
            "video",
            "livestream",
            "short",
            "guest_appearance",
            "compilation",
            "unknown"
          ]
        },
        "review_state": {
          "enum": ["metadata_only", "unreviewed", "reviewed", "disputed"]
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "transcript_revisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transcript_revision" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "platform", "url", "native_id", "access_state"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^src_[a-f0-9]{32}$" },
        "platform": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "native_id": { "type": "string", "minLength": 1 },
        "access_state": { "const": "public" }
      }
    },
    "transcript_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "revision_kind",
        "language",
        "review_state",
        "machine_generated",
        "unreviewed",
        "verified_quotation",
        "disclaimer_code",
        "lifecycle_state",
        "lifecycle_history",
        "segments"
      ],
      "properties": {
        "revision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "revision_kind": {
          "enum": [
            "raw_asr",
            "contextual_asr",
            "human_verbatim",
            "readability_edit"
          ]
        },
        "language": { "type": "string", "minLength": 1 },
        "review_state": {
          "enum": ["machine", "human_corrected", "media_checked", "disputed"]
        },
        "machine_generated": { "type": "boolean" },
        "unreviewed": { "type": "boolean" },
        "verified_quotation": { "const": false },
        "disclaimer_code": {
          "enum": [
            "machine_generated_unreviewed_not_verified_quotation_v1",
            "disputed_transcript_not_verified_quotation_v1",
            "reviewed_transcript_not_fact_checked_v1",
            "retracted_transcript_text_withdrawn_v1"
          ]
        },
        "lifecycle_state": {
          "enum": ["active", "retracted", "disputed", "reinstated"]
        },
        "lifecycle_history": {
          "type": "array",
          "items": { "$ref": "#/$defs/transcript_lifecycle_entry" }
        },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/segment" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "review_state": { "const": "machine" } } },
          "then": {
            "properties": {
              "machine_generated": { "const": true },
              "unreviewed": { "const": true }
            }
          },
          "else": {
            "properties": {
              "unreviewed": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": {
              "revision_kind": { "enum": ["raw_asr", "contextual_asr"] }
            }
          },
          "then": {
            "properties": {
              "machine_generated": { "const": true }
            }
          },
          "else": {
            "if": {
              "properties": {
                "review_state": { "not": { "const": "machine" } }
              }
            },
            "then": {
              "properties": {
                "machine_generated": { "const": false }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "lifecycle_state": { "const": "retracted" } }
          },
          "then": {
            "properties": {
              "segments": { "maxItems": 0 },
              "disclaimer_code": {
                "const": "retracted_transcript_text_withdrawn_v1"
              }
            }
          },
          "else": {
            "if": {
              "anyOf": [
                {
                  "properties": { "lifecycle_state": { "const": "disputed" } }
                },
                {
                  "properties": { "review_state": { "const": "disputed" } }
                }
              ]
            },
            "then": {
              "properties": {
                "disclaimer_code": {
                  "const": "disputed_transcript_not_verified_quotation_v1"
                }
              }
            },
            "else": {
              "if": {
                "properties": { "review_state": { "const": "machine" } }
              },
              "then": {
                "properties": {
                  "disclaimer_code": {
                    "const": "machine_generated_unreviewed_not_verified_quotation_v1"
                  }
                }
              },
              "else": {
                "properties": {
                  "disclaimer_code": {
                    "const": "reviewed_transcript_not_fact_checked_v1"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "transcript_lifecycle_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason_code", "decided_at", "explanation"],
      "properties": {
        "state": { "enum": ["retracted", "disputed", "reinstated"] },
        "reason_code": {
          "enum": [
            "transcription_error",
            "speaker_misattribution",
            "source_mismatch",
            "privacy",
            "rights",
            "sensitivity",
            "editorial_decision",
            "other"
          ]
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:19|20)[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
        },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "start_ms",
        "end_ms",
        "text",
        "speaker_label",
        "confidence_band",
        "calibrated_probability"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" },
        "speaker_label": { "type": ["string", "null"] },
        "confidence_band": { "enum": ["low", "medium", "high", "human", null] },
        "calibrated_probability": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
