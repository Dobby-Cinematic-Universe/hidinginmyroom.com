{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/private-solo-voice-attestation-manifest.schema.json",
  "title": "Private solo-voice human attestation manifest",
  "description": "Validation returns the stable-read SHA-256 of these exact bytes. Applying import requires that digest as a separate expected-input capability; an in-manifest self-declared digest is intentionally forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "created_at",
    "authorized_by",
    "basis",
    "subjects",
    "privacy_reviews",
    "speaker_decisions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": { "$ref": "#/$defs/identifier" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "authorized_by": { "$ref": "#/$defs/text500" },
    "basis": { "$ref": "#/$defs/text8192" },
    "subjects": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/subject" }
    },
    "privacy_reviews": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/privacyReview" }
    },
    "speaker_decisions": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/speakerDecision" }
    }
  },
  "anyOf": [
    { "properties": { "subjects": { "minItems": 1 } } },
    { "properties": { "privacy_reviews": { "minItems": 1 } } },
    { "properties": { "speaker_decisions": { "minItems": 1 } } }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "text500": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "text8192": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "subject": {
      "type": "object",
      "description": "The importer and database additionally require end_ms > start_ms; standard JSON Schema cannot compare sibling numeric values.",
      "additionalProperties": false,
      "required": [
        "solo_voice_subject_id",
        "entity_id",
        "source_id",
        "recording_id",
        "rendition_id",
        "media_id",
        "media_sha256",
        "start_ms",
        "end_ms",
        "coordinate_system"
      ],
      "properties": {
        "solo_voice_subject_id": { "$ref": "#/$defs/identifier" },
        "entity_id": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "recording_id": { "$ref": "#/$defs/identifier" },
        "rendition_id": { "$ref": "#/$defs/identifier" },
        "media_id": { "$ref": "#/$defs/identifier" },
        "media_sha256": { "$ref": "#/$defs/sha256" },
        "start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "coordinate_system": { "const": "rendition_media_ms" }
      }
    },
    "privacyAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "named_voice_personal_data_reviewed",
        "private_storage_only",
        "public_export_approved",
        "biometric_artifacts_used",
        "machine_identity_outputs_used"
      ],
      "properties": {
        "named_voice_personal_data_reviewed": { "const": true },
        "private_storage_only": { "const": true },
        "public_export_approved": { "const": false },
        "biometric_artifacts_used": { "const": false },
        "machine_identity_outputs_used": { "const": false }
      }
    },
    "privacyReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solo_voice_privacy_review_id",
        "review_decision_id",
        "solo_voice_subject_id",
        "decision",
        "reviewer_id",
        "reviewed_at",
        "basis",
        "privacy_attestation"
      ],
      "properties": {
        "solo_voice_privacy_review_id": { "$ref": "#/$defs/identifier" },
        "review_decision_id": { "$ref": "#/$defs/identifier" },
        "solo_voice_subject_id": { "$ref": "#/$defs/identifier" },
        "decision": {
          "enum": ["clear_private_use", "withhold"]
        },
        "reviewer_id": { "$ref": "#/$defs/identifier" },
        "reviewed_at": { "$ref": "#/$defs/timestamp" },
        "basis": { "$ref": "#/$defs/text8192" },
        "privacy_attestation": { "$ref": "#/$defs/privacyAttestation" }
      }
    },
    "directAudioAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation",
        "audio_directly_perceived",
        "reviewed_entire_interval",
        "exactly_one_live_human_speaker",
        "overlap_detected",
        "playback_detected",
        "tts_detected",
        "synthetic_voice_detected",
        "unknown_audio_origin_detected",
        "source_metadata_used_as_identity_evidence",
        "channel_context_used_as_identity_evidence",
        "transcript_text_used_as_identity_evidence",
        "machine_identity_output_used",
        "machine_confidence_used",
        "speaking_face_claimed"
      ],
      "properties": {
        "attestation": {
          "const": "I directly listened to the complete anchored interval and identify exactly one live human voice as the named entity without relying on source or channel context, transcript text, machine identity output, or machine confidence."
        },
        "audio_directly_perceived": { "const": true },
        "reviewed_entire_interval": { "const": true },
        "exactly_one_live_human_speaker": { "const": true },
        "overlap_detected": { "const": false },
        "playback_detected": { "const": false },
        "tts_detected": { "const": false },
        "synthetic_voice_detected": { "const": false },
        "unknown_audio_origin_detected": { "const": false },
        "source_metadata_used_as_identity_evidence": { "const": false },
        "channel_context_used_as_identity_evidence": { "const": false },
        "transcript_text_used_as_identity_evidence": { "const": false },
        "machine_identity_output_used": { "const": false },
        "machine_confidence_used": { "const": false },
        "speaking_face_claimed": { "const": false }
      }
    },
    "speakerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solo_voice_attestation_decision_id",
        "review_decision_id",
        "solo_voice_subject_id",
        "decision",
        "reviewer_id",
        "decided_at",
        "basis",
        "direct_audio_attestation"
      ],
      "properties": {
        "solo_voice_attestation_decision_id": { "$ref": "#/$defs/identifier" },
        "review_decision_id": { "$ref": "#/$defs/identifier" },
        "solo_voice_subject_id": { "$ref": "#/$defs/identifier" },
        "decision": {
          "enum": ["assert", "withdraw", "reject", "dispute"]
        },
        "reviewer_id": { "$ref": "#/$defs/identifier" },
        "decided_at": { "$ref": "#/$defs/timestamp" },
        "basis": { "$ref": "#/$defs/text8192" },
        "direct_audio_attestation": {
          "oneOf": [
            { "$ref": "#/$defs/directAudioAttestation" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decision": { "const": "assert" } },
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "direct_audio_attestation": {
                "$ref": "#/$defs/directAudioAttestation"
              }
            }
          },
          "else": {
            "properties": {
              "direct_audio_attestation": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
