{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/corpus/private-acquisition-seal-v1.json",
  "title": "HIMR private acquisition artifact seal plan or receipt",
  "oneOf": [
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "handlingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_scope",
        "publication_disposition",
        "publication_authority",
        "basis"
      ],
      "properties": {
        "storage_scope": { "const": "private_canonical_cache" },
        "publication_disposition": {
          "enum": ["no_publication_authority", "never_publish"]
        },
        "publication_authority": { "const": "none" },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^[^\\u0000]+$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "platform", "source_kind", "native_id", "access_state"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^source_[0-9a-f]{32}$" },
        "platform": { "type": "string", "minLength": 1 },
        "source_kind": { "type": "string", "minLength": 1 },
        "native_id": { "type": "string", "minLength": 1 },
        "access_state": { "const": "unknown" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "relative_path", "sha256", "byte_count",
        "current_mode", "required_mode"
      ],
      "properties": {
        "role": { "enum": ["work_order", "result", "media"] },
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "current_mode": { "type": "string", "pattern": "^[0-7]{4}$" },
        "required_mode": { "const": "0600" }
      }
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "current_mode", "required_mode"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+)$"
        },
        "current_mode": { "type": "string", "pattern": "^[0-7]{4}$" },
        "required_mode": { "const": "0700" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "work_order_sha256",
        "result_canonical_sha256", "media_id", "media_sha256",
        "media_byte_count", "source", "handling_policy",
        "source_byte_identity_claimed", "artifacts", "directories"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "private_acquisition_seal_plan" },
        "work_order_sha256": { "$ref": "#/$defs/sha256" },
        "result_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "media_id": { "type": "string", "pattern": "^media_sha256_[0-9a-f]{64}$" },
        "media_sha256": { "$ref": "#/$defs/sha256" },
        "media_byte_count": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/source" },
        "handling_policy": { "$ref": "#/$defs/handlingPolicy" },
        "source_byte_identity_claimed": { "const": false },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "directories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/directory" }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "validated_at", "plan_sha256", "plan",
        "sealed_artifacts", "sealed_directories"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "private_acquisition_seal_receipt" },
        "validated_at": { "type": "string", "format": "date-time" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "plan": { "$ref": "#/$defs/plan" },
        "sealed_artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/artifact" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role", "relative_path", "sha256", "byte_count",
                  "current_mode", "required_mode"
                ],
                "properties": {
                  "role": { "enum": ["work_order", "result", "media"] },
                  "relative_path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
                  },
                  "sha256": { "$ref": "#/$defs/sha256" },
                  "byte_count": { "type": "integer", "minimum": 1 },
                  "current_mode": { "const": "0600" },
                  "required_mode": { "const": "0600" }
                }
              }
            ]
          }
        },
        "sealed_directories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/directory" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["relative_path", "current_mode", "required_mode"],
                "properties": {
                  "relative_path": {
                    "type": "string",
                    "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+)$"
                  },
                  "current_mode": { "const": "0700" },
                  "required_mode": { "const": "0700" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
