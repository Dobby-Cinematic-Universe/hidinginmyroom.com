{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/corpus/longform-asr-plan.schema.json",
  "title": "Deterministic long-form ASR execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "planner_version",
    "plan_id",
    "identity_sha256",
    "strategy",
    "recording",
    "boundary_candidates",
    "policy",
    "input_digests",
    "execution_contract",
    "spans",
    "coverage"
  ],
  "properties": {
    "kind": {"const": "himr_longform_asr_plan"},
    "schema_version": {"const": 1},
    "planner_version": {"const": "himr-longform-asr-planner/1"},
    "plan_id": {"type": "string", "pattern": "^lfplan_[0-9a-f]{32}$"},
    "identity_sha256": {"$ref": "#/$defs/sha256"},
    "strategy": {"enum": ["direct", "adaptive_spans"]},
    "recording": {"$ref": "#/$defs/recording"},
    "boundary_candidates": {
      "type": "array",
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/boundary_candidate"}
    },
    "policy": {"$ref": "#/$defs/policy"},
    "input_digests": {"$ref": "#/$defs/input_digests"},
    "execution_contract": {"$ref": "#/$defs/execution_contract"},
    "spans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/span"}
    },
    "coverage": {"$ref": "#/$defs/coverage"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recording_id", "media_id", "input"],
      "properties": {
        "recording_id": {"$ref": "#/$defs/identifier"},
        "media_id": {"$ref": "#/$defs/identifier"},
        "input": {"$ref": "#/$defs/input"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "byte_count",
        "sample_rate_hz",
        "channels",
        "total_samples",
        "duration_ms"
      ],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"$ref": "#/$defs/positive_integer"},
        "sample_rate_hz": {"const": 16000},
        "channels": {"const": 1},
        "total_samples": {"$ref": "#/$defs/positive_integer"},
        "duration_ms": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "boundary_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample", "kind", "confidence_millionths"],
      "properties": {
        "sample": {"$ref": "#/$defs/positive_integer"},
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "confidence_millionths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "direct_max_samples", "adaptive"],
      "properties": {
        "kind": {"const": "himr_longform_asr_planning_policy"},
        "schema_version": {"const": 1},
        "direct_max_samples": {"$ref": "#/$defs/positive_integer"},
        "adaptive": {"$ref": "#/$defs/adaptive_policy"}
      }
    },
    "adaptive_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_core_samples",
        "min_core_samples",
        "max_core_samples",
        "boundary_search_samples",
        "padding_samples",
        "max_span_count"
      ],
      "properties": {
        "target_core_samples": {"$ref": "#/$defs/positive_integer"},
        "min_core_samples": {"$ref": "#/$defs/positive_integer"},
        "max_core_samples": {"$ref": "#/$defs/positive_integer"},
        "boundary_search_samples": {"$ref": "#/$defs/nonnegative_integer"},
        "padding_samples": {"$ref": "#/$defs/nonnegative_integer"},
        "max_span_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "input_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recording_manifest_sha256", "planning_policy_sha256"],
      "properties": {
        "recording_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "planning_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_input",
        "audio_chunk_materialization",
        "coordinate_space",
        "core_ownership",
        "interval_semantics",
        "sample_rate_hz",
        "timestamp_authority"
      ],
      "properties": {
        "analysis_input": {"const": "direct_read_from_single_parent_media"},
        "audio_chunk_materialization": {"const": "forbidden"},
        "coordinate_space": {"const": "decoded_parent_pcm_samples"},
        "core_ownership": {"const": "exactly_one_span"},
        "interval_semantics": {"const": "zero_based_half_open"},
        "sample_rate_hz": {"const": 16000},
        "timestamp_authority": {"const": "integer_sample_coordinates"}
      }
    },
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_left_samples",
        "requested_right_samples",
        "applied_left_samples",
        "applied_right_samples",
        "clipped_left_samples",
        "clipped_right_samples"
      ],
      "properties": {
        "requested_left_samples": {"$ref": "#/$defs/nonnegative_integer"},
        "requested_right_samples": {"$ref": "#/$defs/nonnegative_integer"},
        "applied_left_samples": {"$ref": "#/$defs/nonnegative_integer"},
        "applied_right_samples": {"$ref": "#/$defs/nonnegative_integer"},
        "clipped_left_samples": {"$ref": "#/$defs/nonnegative_integer"},
        "clipped_right_samples": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_id",
        "ordinal",
        "analysis_start_sample",
        "analysis_end_sample",
        "core_start_sample",
        "core_end_sample",
        "boundary_reason",
        "boundary_confidence_millionths",
        "padding"
      ],
      "properties": {
        "span_id": {"type": "string", "pattern": "^lfspan_[0-9a-f]{32}$"},
        "ordinal": {"$ref": "#/$defs/nonnegative_integer"},
        "analysis_start_sample": {"$ref": "#/$defs/nonnegative_integer"},
        "analysis_end_sample": {"$ref": "#/$defs/positive_integer"},
        "core_start_sample": {"$ref": "#/$defs/nonnegative_integer"},
        "core_end_sample": {"$ref": "#/$defs/positive_integer"},
        "boundary_reason": {
          "type": "string",
          "pattern": "^(?:fixed_target|recording_end|candidate_[a-z][a-z0-9_]{0,63})$"
        },
        "boundary_confidence_millionths": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0, "maximum": 1000000}
          ]
        },
        "padding": {"$ref": "#/$defs/padding"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recording_start_sample",
        "recording_end_sample",
        "recording_sample_count",
        "core_sample_count_sum",
        "core_gap_samples",
        "core_overlap_samples",
        "analysis_sample_count_sum",
        "analysis_unique_sample_count",
        "analysis_overlap_samples",
        "padding_sample_count_sum",
        "span_count"
      ],
      "properties": {
        "recording_start_sample": {"const": 0},
        "recording_end_sample": {"$ref": "#/$defs/positive_integer"},
        "recording_sample_count": {"$ref": "#/$defs/positive_integer"},
        "core_sample_count_sum": {"$ref": "#/$defs/positive_integer"},
        "core_gap_samples": {"const": 0},
        "core_overlap_samples": {"const": 0},
        "analysis_sample_count_sum": {"$ref": "#/$defs/positive_integer"},
        "analysis_unique_sample_count": {"$ref": "#/$defs/positive_integer"},
        "analysis_overlap_samples": {"$ref": "#/$defs/nonnegative_integer"},
        "padding_sample_count_sum": {"$ref": "#/$defs/nonnegative_integer"},
        "span_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    }
  }
}
