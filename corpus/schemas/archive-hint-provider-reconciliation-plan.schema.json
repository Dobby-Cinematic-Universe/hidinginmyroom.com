        "provider_declared_duration_ms": {"$ref": "#/$defs/nonnegative_integer"},
        "provider_declared_crc32": {"$ref": "#/$defs/crc32"},
        "provider_declared_md5": {"$ref": "#/$defs/md5"},
        "provider_declared_sha1": {"$ref": "#/$defs/sha1"},
