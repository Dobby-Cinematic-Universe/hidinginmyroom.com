{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/corpus/archive-hint-provider-reconciliation-plan.schema.json",
  "title": "Private Archive URL hint to provider-source reconciliation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_kind",
    "planner_version",
    "inputs",
    "catalog_binding",
    "scope",
    "candidates",
    "statistics",
    "policy",
    "plan_id",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_kind": {"const": "archive_hint_provider_source_reconciliation_review_plan"},
    "planner_version": {"const": "archive_hint_provider_reconciliation_plan_v1"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "catalog_binding": {"$ref": "#/$defs/catalog_binding"},
    "scope": {"$ref": "#/$defs/scope"},
    "candidates": {
      "type": "array",
      "minItems": 221,
      "maxItems": 221,
      "items": {"$ref": "#/$defs/candidate"}
