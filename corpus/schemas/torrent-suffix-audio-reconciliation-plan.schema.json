{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/corpus/torrent-suffix-audio-reconciliation-plan.schema.json",
  "title": "Private torrent format-label-video and audio-only locator plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_kind",
    "planner_version",
    "inputs",
    "catalog_binding",
    "scope",
    "candidates",
    "statistics",
    "policy",
    "plan_id",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_kind": {"const": "torrent_suffix_audio_youtube_reconciliation_review_plan"},
    "planner_version": {"const": "torrent_suffix_audio_plan_v1"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "catalog_binding": {"$ref": "#/$defs/catalog_binding"},
    "scope": {"$ref": "#/$defs/scope"},
    "candidates": {
      "type": "array",
      "maxItems": 50000,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "statistics": {"$ref": "#/$defs/statistics"},
    "policy": {"$ref": "#/$defs/policy"},
    "plan_id": {"type": "string", "pattern": "^tsap_[0-9a-f]{32}$"},
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stable_id": {"type": "string", "pattern": "^[a-z]+_[0-9a-f]{32}$"},
    "nullable_stable_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/stable_id"}
      ]
    },
    "nonnegative_integer": {"type": "integer", "minimum": 0},
    "youtube_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"},
    "directory_label": {
      "enum": [
        "YouTube Videos",
        "Old YouTube Livestreams",
        "New YouTube Livestreams",
        "New New YouTube Livestreams"
      ]
    },
    "resolution_state": {
      "enum": [
        "missing_native_source",
        "native_source_without_unique_recording",
        "unique_native_recording"
      ]
    },
    "raw_components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 5464,
        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "torrent_sha256",
        "torrent_byte_count",
        "torrent_filename",
        "info_hash_sha1",
        "discovery_sha256",
        "discovery_byte_count",
        "discovery_filename",
        "combined_import_input_sha256"
      ],
      "properties": {
        "torrent_sha256": {"$ref": "#/$defs/sha256"},
        "torrent_byte_count": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "torrent_filename": {"type": "string", "minLength": 1, "maxLength": 255},
        "info_hash_sha1": {"$ref": "#/$defs/sha1"},
        "discovery_sha256": {"$ref": "#/$defs/sha256"},
        "discovery_byte_count": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "discovery_filename": {"type": "string", "minLength": 1, "maxLength": 255},
        "combined_import_input_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "catalog_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "torrent_manifest_source_id",
        "torrent_import_batch_id",
        "torrent_importer_name",
        "torrent_importer_version",
        "observed_at"
      ],
      "properties": {
        "torrent_manifest_source_id": {"$ref": "#/$defs/stable_id"},
        "torrent_import_batch_id": {"$ref": "#/$defs/stable_id"},
        "torrent_importer_name": {"const": "torrent_manifest_metadata"},
        "torrent_importer_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory_labels", "accepted_lanes"],
      "properties": {
        "directory_labels": {
          "const": [
            "YouTube Videos",
            "Old YouTube Livestreams",
            "New YouTube Livestreams",
            "New New YouTube Livestreams"
          ]
        },
        "accepted_lanes": {"const": ["format_label_video", "audio_only"]}
      }
    },
    "format_label_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "calibration_state", "raw_score", "calibrated_probability"],
      "properties": {
        "profile": {"const": "uncalibrated_format_label_filename_locator"},
        "calibration_state": {"const": "not_calibrated"},
        "raw_score": {"type": "null"},
        "calibrated_probability": {"type": "null"}
      }
    },
    "audio_only_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "calibration_state", "raw_score", "calibrated_probability"],
      "properties": {
        "profile": {"const": "uncalibrated_audio_only_filename_locator"},
        "calibration_state": {"const": "not_calibrated"},
        "raw_score": {"type": "null"},
        "calibrated_probability": {"type": "null"}
      }
    },
    "format_label_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_route",
        "review_priority",
        "review_method",
        "automatic_catalog_admission"
      ],
      "properties": {
        "review_route": {"const": "torrent_format_label_video_locator_review"},
        "review_priority": {"const": 55},
        "review_method": {"const": "filename_provenance_then_video_content_identity"},
        "automatic_catalog_admission": {"const": false}
      }
    },
    "audio_only_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_route",
        "review_priority",
        "review_method",
        "automatic_catalog_admission"
      ],
      "properties": {
        "review_route": {"const": "torrent_audio_only_locator_review"},
        "review_priority": {"const": 50},
        "review_method": {"const": "filename_provenance_then_audio_content_identity"},
        "automatic_catalog_admission": {"const": false}
      }
    },
    "format_label_lane_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_kind", "lane", "file_extension", "format_label", "evidence_basis", "confidence", "routing"],
      "properties": {
        "candidate_kind": {"const": "torrent_format_label_video_to_youtube_locator"},
        "lane": {"const": "format_label_video"},
        "file_extension": {"enum": ["mp4", "webm", "ogv", "mkv", "mov", "m4v"]},
        "format_label": {"const": "480p"},
        "evidence_basis": {"const": "terminal_filename_bracket_before_480p_label_and_video_extension"},
        "confidence": {"$ref": "#/$defs/format_label_confidence"},
        "routing": {"$ref": "#/$defs/format_label_routing"}
      }
    },
    "audio_only_lane_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_kind", "lane", "file_extension", "format_label", "evidence_basis", "confidence", "routing"],
      "properties": {
        "candidate_kind": {"const": "torrent_audio_only_to_youtube_locator"},
        "lane": {"const": "audio_only"},
        "file_extension": {"const": "m4a"},
        "format_label": {"const": "none"},
        "evidence_basis": {"const": "terminal_filename_bracket_before_m4a_audio_extension"},
        "confidence": {"$ref": "#/$defs/audio_only_confidence"},
        "routing": {"$ref": "#/$defs/audio_only_routing"}
      }
    },
    "lane_contract": {
      "oneOf": [
        {"$ref": "#/$defs/format_label_lane_contract"},
        {"$ref": "#/$defs/audio_only_lane_contract"}
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_candidate_id",
        "lane_contract",
        "torrent_manifest_source_id",
        "torrent_file_source_id",
        "torrent_file_index",
        "directory_label",
        "manifest_path",
        "manifest_path_components_base64",
        "manifest_path_sha256",
        "byte_count",
        "youtube_video_id",
        "locator_target_type",
        "locator_target_id",
        "youtube_source_id",
        "youtube_recording_id",
        "mapped_recording_ids",
        "resolution_state",
        "requires_human_review",
        "relationship_asserted",
        "merge_performed",
        "publication_authority",
        "payload_downloaded_or_read"
      ],
      "properties": {
        "plan_candidate_id": {"type": "string", "pattern": "^tsc_[0-9a-f]{32}$"},
        "lane_contract": {"$ref": "#/$defs/lane_contract"},
        "torrent_manifest_source_id": {"$ref": "#/$defs/stable_id"},
        "torrent_file_source_id": {"$ref": "#/$defs/stable_id"},
        "torrent_file_index": {"$ref": "#/$defs/nonnegative_integer"},
        "directory_label": {"$ref": "#/$defs/directory_label"},
        "manifest_path": {"type": "string", "minLength": 1, "maxLength": 16384},
        "manifest_path_components_base64": {"$ref": "#/$defs/raw_components"},
        "manifest_path_sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"$ref": "#/$defs/nonnegative_integer"},
        "youtube_video_id": {"$ref": "#/$defs/youtube_id"},
        "locator_target_type": {"enum": ["source", "youtube_video_id"]},
        "locator_target_id": {"type": "string", "minLength": 11, "maxLength": 36},
        "youtube_source_id": {"$ref": "#/$defs/nullable_stable_id"},
        "youtube_recording_id": {"$ref": "#/$defs/nullable_stable_id"},
        "mapped_recording_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        },
        "resolution_state": {"$ref": "#/$defs/resolution_state"},
        "requires_human_review": {"const": true},
        "relationship_asserted": {"const": false},
        "merge_performed": {"const": false},
        "publication_authority": {"const": false},
        "payload_downloaded_or_read": {"const": false}
      }
    },
    "lane_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_label_video", "audio_only"],
      "properties": {
        "format_label_video": {"$ref": "#/$defs/nonnegative_integer"},
        "audio_only": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "directory_lane_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_label_video", "audio_only", "total"],
      "properties": {
        "format_label_video": {"$ref": "#/$defs/nonnegative_integer"},
        "audio_only": {"$ref": "#/$defs/nonnegative_integer"},
        "total": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "directory_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "YouTube Videos",
        "Old YouTube Livestreams",
        "New YouTube Livestreams",
        "New New YouTube Livestreams"
      ],
      "properties": {
        "YouTube Videos": {"$ref": "#/$defs/directory_lane_count"},
        "Old YouTube Livestreams": {"$ref": "#/$defs/directory_lane_count"},
        "New YouTube Livestreams": {"$ref": "#/$defs/directory_lane_count"},
        "New New YouTube Livestreams": {"$ref": "#/$defs/directory_lane_count"}
      }
    },
    "resolution_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_native_source",
        "native_source_without_unique_recording",
        "unique_native_recording"
      ],
      "properties": {
        "missing_native_source": {"$ref": "#/$defs/nonnegative_integer"},
        "native_source_without_unique_recording": {"$ref": "#/$defs/nonnegative_integer"},
        "unique_native_recording": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "rejected_suffix_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_label_invalid_id_tokens",
        "audio_only_invalid_id_tokens",
        "ambiguous_or_noncanonical_suffixes"
      ],
      "properties": {
        "format_label_invalid_id_tokens": {"$ref": "#/$defs/nonnegative_integer"},
        "audio_only_invalid_id_tokens": {"$ref": "#/$defs/nonnegative_integer"},
        "ambiguous_or_noncanonical_suffixes": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_file_records_scanned",
        "scoped_file_records",
        "candidates_total",
        "candidates_by_lane",
        "distinct_youtube_video_ids",
        "distinct_ids_by_lane",
        "cross_lane_distinct_ids",
        "candidates_by_directory",
        "resolution_state_counts",
        "rejected_suffix_counts",
        "payload_files_read",
        "payload_bytes_read",
        "catalog_rows_written",
        "review_tasks_created",
        "source_or_recording_mutations",
        "source_relations",
        "recording_relations",
        "recording_merges",
        "publication_decisions",
        "identity_assertions",
        "claims"
      ],
      "properties": {
        "provider_file_records_scanned": {"$ref": "#/$defs/nonnegative_integer"},
        "scoped_file_records": {"$ref": "#/$defs/nonnegative_integer"},
        "candidates_total": {"$ref": "#/$defs/nonnegative_integer"},
        "candidates_by_lane": {"$ref": "#/$defs/lane_counts"},
        "distinct_youtube_video_ids": {"$ref": "#/$defs/nonnegative_integer"},
        "distinct_ids_by_lane": {"$ref": "#/$defs/lane_counts"},
        "cross_lane_distinct_ids": {"$ref": "#/$defs/nonnegative_integer"},
        "candidates_by_directory": {"$ref": "#/$defs/directory_counts"},
        "resolution_state_counts": {"$ref": "#/$defs/resolution_counts"},
        "rejected_suffix_counts": {"$ref": "#/$defs/rejected_suffix_counts"},
        "payload_files_read": {"const": 0},
        "payload_bytes_read": {"const": 0},
        "catalog_rows_written": {"const": 0},
        "review_tasks_created": {"const": 0},
        "source_or_recording_mutations": {"const": 0},
        "source_relations": {"const": 0},
        "recording_relations": {"const": 0},
        "recording_merges": {"const": 0},
        "publication_decisions": {"const": 0},
        "identity_assertions": {"const": 0},
        "claims": {"const": 0}
      }
    },
    "capacity_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["torrent_bytes", "discovery_bytes", "torrent_files", "scoped_files", "candidates"],
      "properties": {
        "torrent_bytes": {"const": 33554432},
        "discovery_bytes": {"const": 1048576},
        "torrent_files": {"const": 100000},
        "scoped_files": {"const": 50000},
        "candidates": {"const": 50000}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_only",
        "catalog_admission_implemented",
        "sealed_terminal_bracket_lane_modified",
        "exact_suffix_grammars_only",
        "invalid_id_tokens_accepted",
        "ambiguous_suffix_variants_accepted",
        "torrent_paths_are_content_truth",
        "payload_download_or_read",
        "requires_human_review",
        "relationship_asserted",
        "merge_performed",
        "publication_authority",
        "capacity_limits"
      ],
      "properties": {
        "plan_only": {"const": true},
        "catalog_admission_implemented": {"const": false},
        "sealed_terminal_bracket_lane_modified": {"const": false},
        "exact_suffix_grammars_only": {"const": true},
        "invalid_id_tokens_accepted": {"const": false},
        "ambiguous_suffix_variants_accepted": {"const": false},
        "torrent_paths_are_content_truth": {"const": false},
        "payload_download_or_read": {"const": false},
        "requires_human_review": {"const": true},
        "relationship_asserted": {"const": false},
        "merge_performed": {"const": false},
        "publication_authority": {"const": false},
        "capacity_limits": {"$ref": "#/$defs/capacity_limits"}
      }
    }
  }
}
