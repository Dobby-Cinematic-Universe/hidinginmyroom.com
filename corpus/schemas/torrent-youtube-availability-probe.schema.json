{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/corpus/torrent-youtube-availability-probe.schema.json",
  "title": "Credential-free YouTube no-download availability probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_kind",
    "request_sha256",
    "observed_at",
    "producer",
    "network_policy",
    "outcomes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "probe_kind": {"const": "youtube_no_download_availability_probe_v1"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "observed_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "executable_sha256", "invocation_flags"],
      "properties": {
        "tool": {"const": "yt-dlp"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "invocation_flags": {
          "const": [
            "--ignore-config",
            "--skip-download",
            "--no-playlist",
            "--no-warnings",
            "--dump-single-json"
          ]
        }
      }
    },
    "network_policy": {"$ref": "#/$defs/network_policy"},
    "outcomes": {
      "type": "array",
      "maxItems": 50000,
      "items": {"$ref": "#/$defs/outcome"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "youtube_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"},
    "youtube_url": {
      "type": "string",
      "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cookies_sent",
        "authorization_sent",
        "media_payload_downloaded",
        "playlist_expansion"
      ],
      "properties": {
        "cookies_sent": {"const": false},
        "authorization_sent": {"const": false},
        "media_payload_downloaded": {"const": false},
        "playlist_expansion": {"const": false}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "youtube_video_id",
        "canonical_url",
        "availability_state",
        "evidence_code"
      ],
      "properties": {
        "youtube_video_id": {"$ref": "#/$defs/youtube_id"},
        "canonical_url": {"$ref": "#/$defs/youtube_url"},
        "availability_state": {
          "enum": ["available", "unavailable", "indeterminate"]
        },
        "evidence_code": {
          "enum": [
            "metadata_resolved",
            "private",
            "removed",
            "video_unavailable",
            "sign_in_required",
            "network_error",
            "rate_limited",
            "extractor_error"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"availability_state": {"const": "available"}}
          },
          "then": {
            "properties": {"evidence_code": {"const": "metadata_resolved"}}
          }
        },
        {
          "if": {
            "properties": {"availability_state": {"const": "unavailable"}}
          },
          "then": {
            "properties": {
              "evidence_code": {
                "enum": ["private", "removed", "video_unavailable"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"availability_state": {"const": "indeterminate"}}
          },
          "then": {
            "properties": {
              "evidence_code": {
                "enum": [
                  "sign_in_required",
                  "network_error",
                  "rate_limited",
                  "extractor_error"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
