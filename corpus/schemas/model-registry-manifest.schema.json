{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/corpus/model-registry-manifest-v1.json",
  "title": "Private model registry manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "created_at",
    "registered_by",
    "basis",
    "models"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "registered_by": { "type": "string", "minLength": 1, "maxLength": 500 },
    "basis": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "task",
        "name",
        "version",
        "weights_path",
        "weights_sha256",
        "weights_byte_count",
        "license_label",
        "configuration_json"
      ],
      "properties": {
        "model_id": { "$ref": "#/$defs/identifier" },
        "task": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "version": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "weights_path": { "type": "string", "pattern": "^/" },
        "weights_sha256": { "$ref": "#/$defs/sha256" },
        "weights_byte_count": { "type": "integer", "minimum": 1 },
        "license_label": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "configuration_json": {
          "type": "object",
          "additionalProperties": true,
          "required": ["source"],
          "properties": {
            "source": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        }
      }
    }
  }
}
