{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/corpus/schemas/public-entity-event-graph-manifest-v1.json",
  "title": "HIMR isolated public entity/event graph manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "release_id",
    "generated_at",
    "counts",
    "graph_shard"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "entity_event_graph_manifest" },
    "release_id": {
      "type": "string",
      "pattern": "^graph_release_[a-f0-9]{24}$"
    },
    "generated_at": { "$ref": "#/$defs/utcTimestamp" },
    "counts": { "$ref": "#/$defs/counts" },
    "graph_shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^graph/graph-[a-f0-9]{16}\\.json$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:19|20)[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "events",
        "appearances",
        "event_participants",
        "event_dates",
        "event_relations",
        "event_evidence"
      ],
      "properties": {
        "entities": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "events": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "appearances": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "event_participants": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "event_dates": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "event_relations": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "event_evidence": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    }
  }
}
