---
import type { SiteLink } from '../data/links';

interface Props {
  link: SiteLink;
}

const { link } = Astro.props;
---

<a
  class={`link-card link-card--${link.tone}${link.wide ? ' link-card--wide' : ''}`}
  href={link.href}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="link-card__mark" aria-hidden="true">{link.mark}</span>
  <span class="link-card__copy">
    <span class="link-card__topline">
      <span class="link-card__label">{link.label}</span>
      {link.note && <span class="link-card__note">{link.note}</span>}
    </span>
    <strong>{link.handle}</strong>
    <span class="link-card__description">{link.description}</span>
  </span>
  <svg class="link-card__arrow" aria-hidden="true" viewBox="0 0 20 20">
    <path d="M6 4h10v10M16 4 4 16"></path>
  </svg>
</a>
