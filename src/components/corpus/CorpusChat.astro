---
const privatePilot=import.meta.env.DEV;
const enabled=privatePilot||import.meta.env.PUBLIC_RAG_ENABLED==='true';
const endpoint=privatePilot?'/api/private-rag':import.meta.env.PUBLIC_RAG_ENDPOINT||'';
const sitekey=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY||'';
const full=Astro.url.pathname==='/corpus/ask/';
if(enabled&&!privatePilot&&(!/^https:\/\/[^/]+\/query$/.test(endpoint)||!sitekey))throw Error('Public RAG requires HTTPS endpoint and Turnstile site key.');
---
{enabled && <div id="corpus-chat" class:list={['corpus-chat',{'chat-full':full}]} data-endpoint={endpoint} data-public={String(!privatePilot)} data-full={String(full)}>
  {!full && <button class="chat-launch" aria-label="Open corpus chat" aria-expanded="false" aria-controls="chat-panel"><span aria-hidden="true">✦</span> Ask the corpus</button>}
  <section id="chat-panel" class="chat-panel" role={full?'region':'dialog'} aria-label="Corpus chat" hidden={!full}>
    <header class="chat-header"><div><strong>Ask the corpus</strong><small>Find answers. Follow the sources.</small></div><div class="chat-tools"><button data-action="clear" aria-label="Clear conversation">New</button>{!full && <><a href="/corpus/ask/" aria-label="Open full chat page">↗</a><button data-action="hide" title="Restore from the footer" aria-label="Hide chat button">Hide</button><button data-action="close" aria-label="Minimize chat">−</button></>}</div></header>
    <div class="chat-messages" tabindex="0" aria-label="Conversation"><div class="chat-welcome"><span class="chat-spark" aria-hidden="true">✦</span><h2>Explore the archive</h2><p>Ask a specific question or find a passage. Answers link back to the recordings.</p><div class="chat-examples"><button type="button">What does Daniel say about being unemployed?</button><button type="button">Find recordings about living in Japan</button></div></div></div>
    <div class="chat-status" role="status" aria-live="polite"></div>
    <form class="chat-compose"><label class="chat-sr" for="chat-question">Your question</label><textarea id="chat-question" required minlength="3" maxlength="600" rows="2" placeholder="Ask about the archive…"></textarea>
      {!privatePilot && <div class="cf-turnstile" data-sitekey={sitekey} data-action="corpus-query" data-theme="dark"></div>}
      <div class="chat-compose-bar"><label>Mode <select aria-label="Response mode"><option value="answer">Answer with sources</option><option value="search">Find passages</option></select></label><button class="chat-stop" type="button" hidden>Stop</button><button class="chat-send" type="submit">Send ↑</button></div>
    </form>
    <p class="chat-note">AI can be wrong. Each question searches independently. Chat stays in this tab; questions go to Cloudflare. <a href="/corpus/">Search instead</a>.</p>
  </section>
  {!privatePilot && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</div>}
<script src="../../lib/corpus/chat.ts"></script>
<style is:global>
  .corpus-chat{font-size:14px;line-height:1.55;position:fixed;bottom:1.5rem;right:1.5rem;z-index:200;color:var(--corpus-text)}.corpus-chat [hidden]{display:none!important}.corpus-chat button,.corpus-chat select,.corpus-chat textarea{font:inherit}.corpus-chat button,.corpus-chat select{cursor:pointer}.corpus-chat :is(button,a,select,textarea):focus-visible{outline:2px solid var(--corpus-accent);outline-offset:3px}
  .chat-launch{display:flex;gap:.6rem;align-items:center;background:#90e0ef;color:#08212a;border:1px solid #b4edf6;border-radius:2rem;padding:.85rem 1.2rem;font-weight:750!important;box-shadow:0 8px 32px #0006}.chat-launch span{font-size:1.35rem}.chat-panel{width:450px;max-width:calc(100vw - 3rem);height:min(740px,calc(100dvh - 3rem));display:flex;flex-direction:column;border:1px solid #3b566b;background:#101a28;border-radius:1.1rem;box-shadow:0 18px 70px #0009;overflow:hidden}
  .chat-header{display:flex;align-items:center;justify-content:space-between;gap:.6rem;padding:1rem;border-bottom:1px solid var(--corpus-line);background:#162436;flex-shrink:0}.chat-header strong{font-size:1.05rem}.chat-header small{display:block;color:var(--corpus-muted);font-size:.76rem}.chat-tools{display:flex;align-items:center;gap:.2rem}.chat-tools button,.chat-tools a{border:0;background:transparent;color:var(--corpus-muted);padding:.5rem;border-radius:.4rem;text-decoration:none;font-size:.8rem}.chat-tools :is(button,a):hover{background:#ffffff12;color:white}
  .chat-messages{flex:1;overflow:auto;overscroll-behavior:contain;padding:1.1rem;min-height:0;scrollbar-width:thin}.chat-welcome{padding:1.5rem .5rem}.chat-spark{font-size:2rem;color:var(--corpus-accent)}.chat-welcome h2{font-size:1.4rem;margin:.5rem 0}.chat-welcome p{color:var(--corpus-muted)}.chat-examples{display:grid;gap:.6rem;margin-top:1.5rem}.chat-examples button{background:#1b2b3e;color:var(--corpus-text);border:1px solid #32465d;border-radius:.7rem;text-align:left;padding:.8rem}.chat-examples button:hover{border-color:var(--corpus-accent)}
  .chat-message{margin:0 0 1.1rem}.chat-role{font-size:.72rem;font-weight:750;color:var(--corpus-muted);margin-bottom:.3rem;text-transform:uppercase;letter-spacing:.07em}.chat-message p{white-space:pre-wrap;overflow-wrap:anywhere;margin:.4rem 0}.chat-user{margin-left:2rem;background:#233d51;padding:.7rem .9rem;border-radius:.85rem .85rem .15rem .85rem}.chat-assistant{padding:.3rem 0}.chat-error{color:#ffd199}.chat-citation{display:inline-block;padding:0 .22rem;background:#263e50;border-radius:.2rem;text-decoration:none;color:var(--corpus-accent)}
  .chat-sources{display:grid;gap:.45rem;margin-top:.8rem}.chat-source{border:1px solid var(--corpus-line);border-radius:.55rem;padding:.5rem .7rem;background:#142131}.chat-source summary{cursor:pointer;color:var(--corpus-muted);font-size:.78rem;margin-top:.25rem}.chat-source a{font-size:.83rem;color:var(--corpus-accent);text-decoration:none}.chat-source p{font-size:.8rem;color:var(--corpus-muted);max-height:15rem;overflow:auto}.chat-status{min-height:1.5rem;padding:0 1rem;font-size:.78rem;color:var(--corpus-accent)}
  .chat-compose{margin:.3rem .85rem .4rem;border:1px solid #425d73;border-radius:.75rem;background:#0b1522;flex-shrink:0}.chat-compose:focus-within{border-color:var(--corpus-accent)}.chat-compose textarea{display:block;width:100%;padding:.8rem;border:0;outline:none!important;resize:vertical;max-height:8rem;min-height:4rem;background:transparent;color:var(--corpus-text)}.chat-compose-bar{display:flex;justify-content:space-between;align-items:center;gap:.5rem;padding:.5rem}.chat-compose-bar label{font-size:.72rem;color:var(--corpus-muted)}.chat-compose select{max-width:10rem;border:0;background:#152334;color:var(--corpus-text);padding:.4rem;border-radius:.35rem}.chat-send{background:var(--corpus-accent);color:#09232c;border:0;border-radius:.5rem;padding:.5rem .8rem;font-weight:700!important}.chat-stop{background:transparent;color:var(--corpus-text);border:1px solid var(--corpus-line);border-radius:.4rem;padding:.4rem}.chat-send:disabled{opacity:.45;cursor:wait}.chat-note{font-size:.68rem;color:var(--corpus-muted);padding:0 1rem .7rem;margin:0;flex-shrink:0}.chat-note a{color:var(--corpus-muted)}.chat-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  .chat-full{position:static;max-width:58rem;margin:1.5rem auto}.chat-full .chat-panel{width:100%;max-width:none;height:min(800px,80dvh);min-height:480px;box-shadow:none}.chat-full .chat-messages{padding:1.5rem 2rem}.chat-full .chat-welcome{max-width:34rem;margin:auto}
  @media(max-width:600px){.corpus-chat{right:.65rem;bottom:max(.65rem,env(safe-area-inset-bottom))}.chat-panel{width:calc(100vw - 1.3rem);max-width:none;height:calc(100dvh - 1.3rem);border-radius:.8rem}.chat-full .chat-panel{width:100%;min-height:480px;height:78dvh}.chat-full .chat-messages{padding:1rem}.chat-launch{padding:.7rem 1rem}}
</style>
