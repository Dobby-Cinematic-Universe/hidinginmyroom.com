---
import AnalysisRelationships from './AnalysisRelationships.astro';
import AnalysisRobustness from './AnalysisRobustness.astro';
import AnalysisDiscovery from './AnalysisDiscovery.astro';
import AnalysisPassageInsights from './AnalysisPassageInsights.astro';
import AnalysisFactorDiagnostics from './AnalysisFactorDiagnostics.astro';
import AnalysisTemporalComparisons from './AnalysisTemporalComparisons.astro';
import AnalysisChartFrame from './AnalysisChartFrame.astro';
---
<section class="analysis-explorer" data-analysis-root aria-label="Transcript score explorer">
  <p role="status" aria-live="polite" data-status>Loading the score release…</p>
  <div data-content hidden>
    <aside class="scope-note"><p>Scores are model judgments about transcript text; predicted reception is not an observed audience response. Open a recording's evidence to inspect its source passages.</p><details><summary>Interpretation and uncertainty limits</summary><p>These scores do not establish a person's enduring personality, mental health, private emotional state, or the truth of a statement. Classification outputs, including text-to-speech indicators, are model inferences and may be false positives; they do not independently verify audio or production methods. Short excerpts may provide especially weak evidence. Speaker labels and transcript wording may be wrong. The score ranges shown follow the release method and are not automatically statistical confidence intervals. Factor names are provisional descriptions of this fitted model.</p></details></aside>
    <details class="section-jumps"><summary>Jump to an analysis</summary><nav class="explorer-nav" aria-label="Analysis sections">
      <div><span>Browse and explore</span><a href="#analysis-videos">Video rankings</a><a href="#analysis-trend">Scores over time</a><a href="#analysis-discovery">Recording maps and similarity</a><a href="#analysis-relationships">Question relationships</a><a href="#analysis-map">Question map</a></div>
      <div><span>Look more closely</span><a href="#analysis-passage-insights">Passage variability</a><a href="#analysis-temporal-comparisons">Time, genre and candidate shifts</a><a href="#analysis-correlations">Full correlations</a></div>
      <div><span>Model and methods</span><a href="#analysis-factors">Factor loadings</a><a href="#analysis-factor-diagnostics">Residuals and dimensionality</a><a href="#analysis-robustness">Robustness</a><a href="/corpus/analysis/methods/">Methods</a></div>
    </nav></details>
    <section id="analysis-videos" aria-labelledby="video-scores-title"><h2 id="video-scores-title">Videos by dimension</h2>
    <p class="chart-note">These filters apply to this table and <a href="#analysis-trend">Scores over time</a>. Other views use their own selectors and analysis cohorts.</p>
    <form class="controls" data-controls>
      <fieldset class="dimension-controls"><legend>Choose what to compare</legend>
      <label>Dimension type<select name="kind"><option value="question">Numeric question</option><option value="factor">Estimated factor</option><option value="classification">Classification / yes-no</option></select></label>
      <label>Dimension<select name="metric"></select></label>
      </fieldset>
      <fieldset><legend>Choose recordings</legend>
      <label>Year<select name="year"><option value="">All years</option></select></label>
      <label>Category<select name="category"><option value="">All categories</option></select></label>
      <label>Find a video<input name="text" type="search" placeholder="Search title or category" /></label>
      </fieldset>
      <details class="dimension-explanation" data-rubric><summary data-rubric-title>Question rubric</summary><aside class="factor-description" data-factor-description hidden aria-live="polite"></aside><div data-rubric-content></div></details>
      <div class="table-toolbar" aria-label="Table sorting and size">
      <label>Sort<select name="sort"><option value="score">Score</option><option value="date">Recording date</option><option value="title">Title</option></select></label>
      <label>Order<select name="direction"><option value="desc">Highest score first</option><option value="asc">Lowest score first</option></select></label>
      <label>Rows per page<select data-page-size><option value="20" selected>20 recordings</option><option value="50">50 recordings</option><option value="100">100 recordings</option></select></label>
      </div>
    </form>
      <p data-video-count role="status"></p>
      <div class="table-scroll"><table><thead><tr><th scope="col">Recording</th><th scope="col">Date</th><th scope="col">Recording category</th><th scope="col">Score / outcome</th><th scope="col">Range / option probabilities</th><th scope="col">Coverage</th></tr></thead><tbody data-video-rows></tbody></table></div>
      <nav class="analysis-pager" data-pager aria-label="Score results pages" hidden><button type="button" data-prev>Previous</button><span data-page role="status"></span><button type="button" data-next>Next</button></nav>
      <details data-selected hidden><summary data-selected-title>Selected recording evidence</summary><div data-evidence></div></details>
    </section>
    <section id="analysis-trend" aria-labelledby="trend-title"><h2 id="trend-title">Scores over time</h2>
      <p class="trend-context" data-trend-context aria-live="polite"></p><a class="trend-change" href="#analysis-videos">Change dimension or filters</a>
      <div class="trend-controls"><label for="trend-interval"><span>Time interval</span><select id="trend-interval" data-interval><option value="year">Year</option><option value="month">Month</option></select></label><label for="trend-stability" data-trend-method-control hidden><span>Factor stability method</span><select id="trend-stability" data-trend-method aria-describedby="trend-method-status"><option value="month_cluster">Whole-month resampling</option><option value="adjacent_month_blocks_3">Three observed-month blocks (sensitivity)</option></select></label></div>
      <p id="trend-method-status" class="chart-note" data-trend-method-status hidden></p>
      <p class="chart-note" data-trend-summary></p><p class="trend-empty" data-trend-empty role="status" hidden></p>
      <AnalysisChartFrame label="Scores over time chart" minWidth="48rem"><svg data-trend viewBox="0 0 760 320" role="img" aria-label="Mean dimension scores over recording time"></svg></AnalysisChartFrame>
      <details data-trend-values><summary>View all period values and recording mix</summary><div class="table-scroll"><table><thead><tr><th scope="col">Period</th><th scope="col">Mean</th><th scope="col">Range (see trend method)</th><th scope="col">Recordings</th><th scope="col">Mean coverage</th><th scope="col">Recording categories</th></tr></thead><tbody data-trend-rows></tbody></table></div></details>
      <details><summary>Trend method, uncertainty and date coverage</summary><p class="chart-note" data-trend-note></p><p class="warning" data-date-warning></p></details>
    </section>
    <AnalysisDiscovery />
    <AnalysisRelationships />
    <section id="analysis-map" aria-labelledby="mds-title"><h2 id="mds-title">Question map</h2><p class="chart-note" data-mds-note></p><AnalysisChartFrame label="Question map" minWidth="48rem"><svg data-mds viewBox="0 0 760 600" role="img" aria-label="Two-dimensional map of question short names"></svg></AnalysisChartFrame><ul class="mds-legend" data-mds-legend aria-label="Question domain colors"></ul><p data-map-selection role="status"></p></section>
    <AnalysisPassageInsights />
    <AnalysisTemporalComparisons />
    <section id="analysis-correlations" aria-labelledby="correlation-title"><h2 id="correlation-title">Question correlations</h2><p data-correlation-note class="chart-note"></p><p class="chart-note">Open the full matrix to inspect exact pair values.</p><details data-correlation-details><summary>Open full correlation matrix (loads on demand)</summary><div class="table-scroll"><table class="matrix"><caption>Hover, focus, or select a cell to see the correlation and paired sample size. Diagonal values are self-correlations.</caption><thead data-correlation-head></thead><tbody data-correlation-body></tbody></table></div><p role="status" data-pair-detail></p></details></section>
    <section id="analysis-factors" aria-labelledby="factor-title"><h2 id="factor-title">Exploratory factor loadings</h2><p class="chart-note">Loadings are oblique pattern coefficients, not correlations; depending on the fitted model, they may exceed −1 to +1. Intervals and factor labels follow the release method and are not proof of a universal or “true” personality dimension.</p><div data-factors></div><details><summary>Analysis diagnostics</summary><pre data-diagnostics></pre></details></section>
    <AnalysisFactorDiagnostics />
    <AnalysisRobustness />
    <details class="release-details"><summary>Release identity and provenance</summary><div class="release-meta" data-release-meta></div></details>
  </div>
</section>

<script>
  import { filterAndSortVideos, groupTimeSeries, hrefAtTime, largestFactorLoadings, scoreFor, trendInterpretation, validateAnalysisRelease } from '../../lib/analysis/explorer.mjs';
  import type { AnalysisQuestion, AnalysisRelease, AnalysisVideo } from '../../lib/analysis/explorer.mjs';
  import factorAnnotations from '../../data/analysis/factor-descriptions.json';
  import { factorDisplayLabel, resolveFactorDescriptions } from '../../lib/analysis/factor-descriptions.mjs';
  import type { FactorDescription } from '../../lib/analysis/factor-descriptions.mjs';
  import { validatePassageData } from '../../lib/analysis/passage-data.mjs';
  import type { AnalysisPassageData } from '../../lib/analysis/passage-data.mjs';
  import { validatePassageShardIndex, validatePassageShardBytes } from '../../lib/analysis/passage-shards.mjs';
  import type { PassageShardDescriptor } from '../../lib/analysis/passage-shards.mjs';
  import { loadAnalysisSupplement } from '../../lib/analysis/supplement.mjs';
  import type { AnalysisSupplement } from '../../lib/analysis/supplement.mjs';
  import { selectJointTrendSeries } from '../../lib/analysis/joint-trend-ui.mjs';
  const root = document.querySelector<HTMLElement>('[data-analysis-root]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const content = root.querySelector<HTMLElement>('[data-content]')!;
    const controls = root.querySelector<HTMLFormElement>('[data-controls]')!;
    const kindSelect = controls.elements.namedItem('kind') as HTMLSelectElement;
    const metricSelect = controls.elements.namedItem('metric') as HTMLSelectElement;
    const yearSelect = controls.elements.namedItem('year') as HTMLSelectElement;
    const categorySelect = controls.elements.namedItem('category') as HTMLSelectElement;
    let release: AnalysisRelease;
    let supplement: AnalysisSupplement | null = null;
    let factorDescriptions: Record<string, FactorDescription> = {};
    let selectedId: string | undefined;
    let selectedVideo: AnalysisVideo | undefined;
    const passageCache = new Map<string, PassageRelease>();
    let passageShardIndex: Map<string, PassageShardDescriptor> | null = null;
    const passageShardCache = new Map<string, Map<string, PassageRelease>>();
    const selectedNode = root.querySelector<HTMLDetailsElement>('[data-selected]')!;
    const pager=root.querySelector<HTMLElement>('[data-pager]')!;
    const pageSizeSelect=root.querySelector<HTMLSelectElement>('[data-page-size]')!;
    const previous=root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next=root.querySelector<HTMLButtonElement>('[data-next]')!;
    const intervalSelect=root.querySelector<HTMLSelectElement>('[data-interval]')!;
    const trendMethodSelect=root.querySelector<HTMLSelectElement>('[data-trend-method]')!;
    let currentPage=1;
      let pageSize=Number(pageSizeSelect.value);
    const n = (tag: string, text?: string) => { const e = document.createElement(tag); if (text !== undefined) e.textContent = text; return e; };
    const fmt = (value: number | null | undefined) => value == null || !Number.isFinite(value) ? '—' : value.toLocaleString(undefined, { maximumFractionDigits: 3 });
    const fmtTime = (milliseconds:number) => { const total=Math.floor(milliseconds/1000),hours=Math.floor(total/3600),minutes=Math.floor(total%3600/60),seconds=total%60;return `${hours}:${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`; };
    const humanize = (value:string) => value.replace(/[_-]+/g,' ').replace(/\s+/g,' ').trim().replace(/\b\w/g,c=>c.toLocaleUpperCase()).replace(/\bTts\b/g,'TTS').replace(/\bNoul\b/g,'No/Yes');
    const dateBasisLabel = (value:string) => ({unknown:'Unknown / unverified',retained_archive_metadata:'Archive metadata',archive_filename:'Archive filename'} as Record<string,string>)[value]??humanize(value);
    const uncertaintyLabel = (value:string|null|undefined) => ({model_rating_range:'Passage-mixture rating range (not a mean interval)',bootstrap_stability:'Bootstrap stability range',bootstrap_stability_range:'Bootstrap stability range',bootstrap_stability_unavailable:'Stability range unavailable',insufficient_or_inapplicable:'Insufficient evidence or not applicable',passage_distribution_not_video_probability:'Passage-score distribution (not a video probability)'} as Record<string,string>)[value??'']??(value?humanize(value):'Uncertainty not stated');
    const option = (label: string, value: string) => { const e=n('option',label) as HTMLOptionElement; e.value=value; return e; };
    function metrics() { return kindSelect.value === 'factor' ? release.analysis.factors.map(f => ({id:f.id,label:factorDisplayLabel(f,factorDescriptions)})) : release.questions.filter(q=>kindSelect.value==='classification'?q.type==='choice'||q.type==='noul':q.type==='score').map(q => ({id:q.id,label:`${q.short_name} · ${humanize(q.domain)}`})); }
    function activeQuestions() { const allowed = new Set(release.analysis.question_ids); return release.questions.filter(q => allowed.has(q.id)&&q.type==='score'); }
    function updateRubric(){
      const question=release.questions.find(q=>q.id===metricSelect.value);
      const factor=release.analysis.factors.find(f=>f.id===metricSelect.value);
      const description=factor&&kindSelect.value==='factor'?factorDescriptions[factor.id]:undefined;
      const interpretation=root.querySelector<HTMLElement>('[data-factor-description]')!;interpretation.replaceChildren();interpretation.hidden=!description;
      if(description&&factor){
        interpretation.append(n('h3',`${factor.id} · ${description.label}`),n('p',`Provisional interpretation: ${description.description}`));
        for(const [label,text] of [['Higher scores',description.higher],['Lower scores',description.lower]]){const p=n('p');p.append(n('strong',`${label}: `),n('span',text));interpretation.append(p);}
        interpretation.append(n('p','These descriptions summarize this fitted text model, not verified personal traits. Signs are arbitrary; higher is not inherently better or worse.'));
      }
      const host=root.querySelector<HTMLElement>('[data-rubric-content]')!;host.replaceChildren();
      root.querySelector<HTMLElement>('[data-rubric-title]')!.textContent=question?`Question rubric: ${question.short_name}`:`Factor definition: ${factor?.id??'No dimension selected'}`;
      if(question){host.append(n('p',question.instructions));if(Array.isArray(question.criteria)){const list=n('ol');for(const [i,anchor] of question.criteria.entries())list.append(n('li',`${i}: ${anchor}`));host.append(list);}else{const list=n('dl');for(const [key,description] of Object.entries(question.criteria)){list.append(n('dt',humanize(key)),n('dd',description));}host.append(list);}}
      else if(factor){
        host.append(n('p',`${factor.label===factor.id?'':`${factor.id}: `}${factor.label}. Loadings summarize the estimated relation between eligible numeric questions and this exploratory factor. Factor scores are regression-estimated coordinates from standardized questions, not 0–4 rubric ratings. Their sign is arbitrary; higher is not inherently better or worse.`));
        const leaders=largestFactorLoadings(factor,release.questions),label=n('p','Six largest absolute pattern coefficients (sign retained):'),list=n('ul');
        for(const item of leaders){const signed=item.loading>0?`+${fmt(item.loading)}`:fmt(item.loading);list.append(n('li',`${item.short_name}: ${signed}`));}
        host.append(label,list);const link=n('a','Jump to the full factor loading tables') as HTMLAnchorElement;link.href='#analysis-factors';host.append(link);
      }
    }
    function renderVideos() {
      const selectedMetric=metricSelect.value, kind=kindSelect.value as 'question'|'factor'|'classification';
      const values=Object.fromEntries(new FormData(controls)) as Record<string,string>;
      const nominal=kind==='classification'&&release.questions.find(q=>q.id===selectedMetric)?.type==='choice';
      const sortSelect=controls.elements.namedItem('sort') as HTMLSelectElement;
      sortSelect.querySelector<HTMLOptionElement>('option[value="score"]')!.textContent=nominal?'Outcome':'Score';
      const directionLabels=values.sort==='title'||(values.sort==='score'&&nominal)?['Z–A','A–Z']:values.sort==='date'?['Newest first','Oldest first']:['Highest score first','Lowest score first'];
      const directionSelect=controls.elements.namedItem('direction') as HTMLSelectElement;
      for(const choice of Array.from(directionSelect.options))choice.textContent=directionLabels[choice.value==='desc'?0:1];
      const rows=filterAndSortVideos(release.videos,values,kind,selectedMetric);
      const body=root.querySelector<HTMLTableSectionElement>('[data-video-rows]')!; body.replaceChildren();
      const pages=Math.max(1,Math.ceil(rows.length/pageSize));currentPage=Math.min(currentPage,pages);
      for(const video of rows.slice((currentPage-1)*pageSize,currentPage*pageSize)) {
        const score=scoreFor(video,selectedMetric,kind), tr=n('tr');
        const titleCell=n('th') as HTMLTableCellElement; titleCell.scope='row'; const a=n('a',video.title) as HTMLAnchorElement; a.href=video.href; titleCell.append(a);
        const link=n('button','Evidence') as HTMLButtonElement; link.type='button'; link.className='evidence-button'; link.addEventListener('click',()=>showEvidence(video)); titleCell.append(link);
        const date=n('td',`${video.date ?? 'Date unresolved'} · ${dateBasisLabel(video.date_basis)}`);
        const category=n('td',video.category ? humanize(video.category) : 'Unclassified');
        const descriptor=release.questions.find(q=>q.id===selectedMetric);
        const value=n('td',kind==='classification'&&descriptor?.type==='choice'?(score?.choice?humanize(score.choice):'Unknown'):kind==='classification'&&descriptor?.type==='noul'?(score?.value==null?'—':`${fmt(score.value*100)}%`):fmt(score?.value));
        const range=n('td',kind==='classification'&&descriptor?.type==='choice'?Object.entries(score?.probabilities??{}).sort((a,b)=>b[1]-a[1]).slice(0,3).map(([key,p])=>`${humanize(key)} ${fmt(p*100)}%`).join(' · ')||'—':score?.low != null || score?.high != null ? `${fmt(score.low)}–${fmt(score.high)} · ${uncertaintyLabel(score.uncertainty)}` : score?.uncertainty?uncertaintyLabel(score.uncertainty):'—');
        const coverage=n('td',`${fmt(video.coverage*100)}% transcript coverage${score?.coverage == null ? '' : ` · ${fmt(score.coverage*100)}% item coverage`}`);
        tr.append(titleCell,date,category,value,range,coverage); body.append(tr);
      }
      root.querySelector<HTMLElement>('[data-video-count]')!.textContent=`${rows.length.toLocaleString()} of ${release.videos.length.toLocaleString()} recordings · showing ${rows.length?(currentPage-1)*pageSize+1:0}–${Math.min(currentPage*pageSize,rows.length)} · sorted by ${values.sort==='score'&&nominal?'outcome':values.sort} · missing sort values last`;
      pager.hidden=pages<=1;previous.disabled=currentPage===1;next.disabled=currentPage===pages;pager.querySelector<HTMLElement>('[data-page]')!.textContent=`Page ${currentPage} of ${pages}`;
      if(selectedId&&!rows.some(v=>v.recording_id===selectedId)) { selectedNode.hidden=true; selectedId=undefined; }
    }
    function showEvidence(video: AnalysisVideo) {
      selectedId=video.recording_id; selectedVideo=video; selectedNode.hidden=false; selectedNode.open=true;
      root.querySelector<HTMLElement>('[data-selected-title]')!.textContent=`Evidence and question scores: ${video.title}`;
      const panel=root.querySelector<HTMLElement>('[data-evidence]')!; panel.replaceChildren();
      const p=n('p',`Recording date: ${video.date??'unresolved'} (${dateBasisLabel(video.date_basis)}). Scores refer to transcript revision ${video.revision_id}. Overall transcript coverage: ${fmt(video.coverage*100)}%.`); panel.append(p);
      const textQuality=video.classifications?.class_transcript_quality?.choice;
      if(textQuality==='substantial_noise'||textQuality==='unintelligible') {
        const warning=n('p',`Text-quality caution: the model classified this recording's text as ${humanize(textQuality).toLowerCase()}. Transcription problems may affect every score, including hypothetical audience confusion. This quality label is itself unverified.`);
        warning.className='warning'; panel.append(warning);
      }
      if(video.scored_passage) {
        const source=n('p'),anchor=video.scored_passage,link=n('a',`${anchor.label} [${fmtTime(anchor.start_ms)}–${fmtTime(anchor.end_ms)}]`) as HTMLAnchorElement;
        source.append(n('strong','Shared source passage: '),link);
        link.href=hrefAtTime(anchor.href,anchor.start_ms,video.revision_id,anchor.segment_id);link.target='_blank';link.rel='noopener noreferrer';panel.append(source);
      }
      const list=n('ul');
      for(const question of release.questions) {
        if(question.type!=='score') continue;
        const score=scoreFor(video,question.id,'question'); if(!score) continue;
        const li=n('li'),strong=n('strong',`${question.short_name}: ${fmt(score.value)}${score.low!=null||score.high!=null?` (${fmt(score.low)}–${fmt(score.high)})`:''}`);
        li.append(strong,n('span',` — ${humanize(question.domain)}; item coverage ${score.coverage==null?'not reported':`${fmt(score.coverage*100)}%`}; ${uncertaintyLabel(score.uncertainty)}`));
        list.append(li);
      }
      for(const question of release.questions.filter(q=>q.type==='choice')){
        const classification=video.classifications?.[question.id];if(!classification)continue;
        const li=n('li'),choice=classification.choice??'Unknown',description=typeof question.criteria==='object'&&!Array.isArray(question.criteria)?question.criteria[choice]:'',strong=n('strong',`${question.short_name}: ${humanize(choice)}`);
        li.append(strong,n('span',` — ${description}; item coverage ${classification.coverage==null?'not reported':`${fmt(classification.coverage*100)}%`}; confidence ${fmt(classification.confidence)}`));
        const options=n('ul');for(const [key,probability] of Object.entries(classification.probabilities))options.append(n('li',`${humanize(key)}: ${fmt(probability*100)}%`));li.append(options);list.append(li);
      }
      for(const question of release.questions.filter(q=>q.type==='noul')){
        const probability=video.noul_scores?.[question.id];if(probability===undefined||probability===null)continue;
        const li=n('li');li.append(n('strong',`${question.short_name}: ${fmt(probability*100)}% probability`),n('span',` — ${question.instructions}`));list.append(li);
      }
      if(!list.childElementCount) list.append(n('li','No question scores or classifications are included for this recording.'));
      const scoreDetails=n('details') as HTMLDetailsElement,scoreSummary=n('summary','All included question scores and classifications');scoreDetails.append(scoreSummary,list);panel.append(scoreDetails);
      const passageDetails=n('details') as HTMLDetailsElement;passageDetails.className='passage-details';
      const passageSummary=n('summary','Explore passage scores within this recording');
      const passagePanel=n('div');passagePanel.className='passage-panel';passagePanel.setAttribute('data-passage-panel','');
      passageDetails.append(passageSummary,passagePanel);panel.append(passageDetails);
      passageDetails.addEventListener('toggle',()=>{if(passageDetails.open)void loadPassages(video,passagePanel);},{once:true});
      selectedNode.scrollIntoView({block:'nearest',behavior:'smooth'});
    }
    type PassageRelease=AnalysisPassageData;
    function numericPassageQuestions(){return release.questions.filter(q=>q.type==='score');}
    async function loadPassages(video:AnalysisVideo,host:HTMLElement){
      host.replaceChildren(n('p','Loading passage scores…'));
      try{
        let data=passageCache.get(video.recording_id);
        if(!data){
          if(passageShardIndex){
            const descriptor=passageShardIndex.get(video.recording_id);
            if(!descriptor)throw new Error('Passage scores are incompatible with this release.');
            let recordings=passageShardCache.get(descriptor.id);
            if(!recordings){
              const response=await fetch(descriptor.url);
              if(!response.ok)throw new Error('Passage scores could not be loaded.');
              recordings=await validatePassageShardBytes(new Uint8Array(await response.arrayBuffer()),descriptor,release);
              passageShardCache.set(descriptor.id,recordings);
              while(passageShardCache.size>2)passageShardCache.delete(passageShardCache.keys().next().value!);
            }
            data=recordings.get(video.recording_id);
            if(!data)throw new Error('Passage scores are incompatible with this release.');
          }else{
            const response=await fetch(`/corpus/analysis/passages/${encodeURIComponent(video.recording_id)}.json`);
            if(!response.ok)throw new Error(response.status===404?'Passage scores are unavailable for this recording.':'Passage scores could not be loaded.');
            data=validatePassageData(await response.json(),release,video);
          }
          passageCache.set(video.recording_id,data);
          while(passageCache.size>32)passageCache.delete(passageCache.keys().next().value!);
        }
        if(selectedVideo?.recording_id!==video.recording_id)return;
        if(!data.passages.length){host.replaceChildren(n('p','No passage scores are available for this recording.'));return;}
        drawPassageExplorer(data,host);
      }catch(error){host.replaceChildren(n('p',error instanceof Error?error.message:'Passage scores could not be loaded.'));}
    }
    function drawPassageExplorer(data:PassageRelease,host:HTMLElement){
      data.passages.sort((a,b)=>a.start_ms-b.start_ms||a.chunk_index-b.chunk_index);
      const questions=numericPassageQuestions().filter(q=>data.passages.some(p=>p.scores[q.id]?.value!=null));
      if(!questions.length){host.replaceChildren(n('p','No applicable scored question values are available for this recording.'));return;}
      const toolbar=n('div');toolbar.className='passage-toolbar';const label=n('label','Scored question');label.className='passage-question-label';const select=n('select') as HTMLSelectElement;select.setAttribute('aria-label','Passage timeline question');
      for(const question of questions){const opt=option(`${question.short_name} · ${humanize(question.domain)}`,question.id);select.append(opt);}
      const activeQuestion=release.questions.some(q=>q.id===metricSelect.value&&questions.some(pq=>pq.id===q.id))?metricSelect.value:questions[0]?.id;
      if(activeQuestion)select.value=activeQuestion;label.append(select);toolbar.append(label);
      const note=n('p','The horizontal axis uses recording time. Points show passage scores; vertical bars show score levels with nonzero probability, not confidence intervals. Gaps in available scores break the line. Select a point or table heading to open that timestamp and transcript revision.');note.className='chart-note';
