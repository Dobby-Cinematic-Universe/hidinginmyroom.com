        historical.hidden=!release.historical_input;
        historical.textContent=release.historical_input?`Scores use the earlier transcript inputs from ${release.generated_at.slice(0,10)}. Reviewed speaker labels and some transcripts have since changed; scores and fitted dimensions have not been recalculated. Passage links open the current recording at the original scored time, where wording or segmentation may differ.`:'';
        const meta=root.querySelector<HTMLElement>('[data-release-meta]')!;meta.textContent=`${release.status==='pilot'?'Pilot':'Complete'} · ${release.coverage.scored_recordings.toLocaleString()} / ${release.coverage.total_recordings.toLocaleString()} recordings scored · ${release.coverage.scored_chunks.toLocaleString()} / ${release.coverage.total_chunks.toLocaleString()} ${release.design?`passages of ${release.design.window_words} words`:'transcript chunks'} · ${release.model}${release.design?.second_rater?` (second model ${release.design.second_rater.model})`:''} · ${release.generated_at} · questionnaire ${release.questionnaire_version}`;
        if(!release.analysis.factors.length)kindSelect.value='question';
        metricSelect.replaceChildren(...metrics().map(m=>option(m.label,m.id)));
        if(windowed()){for(const name of ['kind-control','length-control','design-options'])root.querySelector<HTMLElement>(`[data-${name}]`)!.hidden=false;}
        const subjectQuestion=release.questions.find(q=>q.id==='class_subject');
        if(subjectQuestion&&!Array.isArray(subjectQuestion.criteria)){(controls.elements.namedItem('subject') as HTMLSelectElement).append(...Object.keys(subjectQuestion.criteria).filter(key=>release.videos.some(v=>v.classifications?.class_subject?.choice===key)).map(key=>option(humanize(key),key)));root.querySelector<HTMLElement>('[data-subject-control]')!.hidden=false;}
        const years=[...new Set(release.videos.flatMap(v=>recordingDate(v)?[recordingDate(v)!.slice(0,4)]:[]))].sort().reverse();yearSelect.append(...years.map(y=>option(y,y)),...(release.videos.some(v=>!recordingDate(v))?[option('Undated','undated')]:[]));
        const categories=[...new Set(release.videos.flatMap(v=>v.category?[v.category]:[]))].sort();categorySelect.append(...categories.map(c=>option(humanize(c),c)));
        controls.addEventListener('input',()=>{currentPage=1;render();});controls.addEventListener('change',(event)=>{if(event.target===kindSelect){metricSelect.replaceChildren(...metrics().map(m=>option(m.label,m.id)));}currentPage=1;render();});
        pageSizeSelect.addEventListener('change',()=>{pageSize=Number(pageSizeSelect.value);currentPage=1;renderVideos();});
        intervalSelect.addEventListener('change',()=>drawTrend());
        trendMethodSelect.addEventListener('change',()=>drawTrend());
        previous.addEventListener('click',()=>{currentPage=Math.max(1,currentPage-1);renderVideos();pager.scrollIntoView({block:'nearest'});});
        next.addEventListener('click',()=>{currentPage++;renderVideos();pager.scrollIntoView({block:'nearest'});});
        document.addEventListener('analysis-select-recording',(event)=>{
          const id=(event as CustomEvent<{recording_id?:unknown}>).detail?.recording_id;
          if(typeof id!=='string')return;
          const video=release.videos.find(item=>item.recording_id===id);
          if(video)showEvidence(video);
        });
      const correlationDetails=root.querySelector<HTMLDetailsElement>('[data-correlation-details]')!;correlationDetails.addEventListener('toggle',()=>{if(correlationDetails.open&&correlationDetails.dataset.rendered!=='true'){drawCorrelations();correlationDetails.dataset.rendered='true';}});
      drawMds();drawFactors();drawTrendAgreement();render();
        root.querySelector<HTMLElement>('[data-diagnostics]')!.textContent=JSON.stringify(release.analysis.diagnostics,null,2);
      } catch (error) { if(import.meta.env.DEV) console.error('Analysis preview load failed',error); status.hidden=false;status.textContent='The transcript scoring release could not be loaded or failed validation.'; }
    }
    void init();
</script>

