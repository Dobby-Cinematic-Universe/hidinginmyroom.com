    function selectQuestion(q:AnalysisQuestion){kindSelect.value='question';metricSelect.replaceChildren(...metrics().map(m=>option(m.label,m.id)));metricSelect.value=q.id;currentPage=1;render();}
    function render() { currentPage=1;updateRubric();renderVideos();drawTrend(); }
    async function shardDigest(videos:AnalysisVideo[]) {
      const bytes=new TextEncoder().encode(JSON.stringify(videos)),digest=await crypto.subtle.digest('SHA-256',bytes);
      return [...new Uint8Array(digest)].map(byte=>byte.toString(16).padStart(2,'0')).join('').slice(0,16);
    }
    async function init() {
      try {
        const response=await fetch('/corpus/analysis/data.json',{cache:'no-cache'}); if(!response.ok) throw new Error('release unavailable');
        const payload=await response.json() as {available:boolean;release?:Omit<AnalysisRelease,'videos'>;video_shards?:{id:string;url:string;count:number}[];passage_shards?:unknown};
        if(!payload.available||!payload.release){status.textContent='No transcript scoring release is published yet. This explorer will show results after a reviewed score release is prepared.';return;}
        if(import.meta.env.PROD&&payload.passage_shards===undefined)throw new Error('Published passage index is missing or incompatible with this release.');
        if(!Array.isArray(payload.video_shards)||payload.video_shards.some((s,i)=>!/^\d{3,}-[a-f0-9]{16}$/.test(s.id)||!s.id.startsWith(`${String(i).padStart(3,'0')}-`)||s.url!==`/corpus/analysis/shards/${s.id}.json`||!Number.isInteger(s.count)||s.count<1||s.count>100))throw new Error('Invalid score shard index.');
        const videos:AnalysisVideo[]=[];
        for(let start=0;start<payload.video_shards.length;start+=3){
          const batch=payload.video_shards.slice(start,start+3);
          const responses=await Promise.all(batch.map(async shard=>{status.textContent=`Loading transcript analysis data… ${Math.min(start+batch.length,payload.video_shards!.length)} of ${payload.video_shards!.length} groups`;const result=await fetch(shard.url);if(!result.ok)throw new Error('score shard unavailable');const data=await result.json();if(data.schema_version!==1||data.shard_id!==shard.id||data.corpus_release_id!==payload.release!.corpus_release_id||!Array.isArray(data.videos)||data.videos.length!==shard.count||await shardDigest(data.videos as AnalysisVideo[])!==shard.id.slice(shard.id.indexOf('-')+1))throw new Error('invalid or stale score shard');return data.videos as AnalysisVideo[]}));
          for(const shardRows of responses)videos.push(...shardRows);
        }
        release=validateAnalysisRelease({...payload.release,videos});passageShardIndex=validatePassageShardIndex(payload.passage_shards,release);factorDescriptions=await resolveFactorDescriptions(release,factorAnnotations);supplement=await loadAnalysisSupplement(release);document.dispatchEvent(new CustomEvent('analysis-release-ready',{detail:{release,supplement,diagnostics:supplement?.map_diagnostics}})); status.textContent='';status.hidden=true;content.hidden=false;
        const meta=root.querySelector<HTMLElement>('[data-release-meta]')!;meta.textContent=`${release.status==='pilot'?'Pilot':'Complete'} · ${release.coverage.scored_recordings.toLocaleString()} / ${release.coverage.total_recordings.toLocaleString()} recordings scored · ${release.coverage.scored_chunks.toLocaleString()} / ${release.coverage.total_chunks.toLocaleString()} transcript chunks · ${release.model} · ${release.generated_at} · questionnaire ${release.questionnaire_version}`;
        metricSelect.replaceChildren(...metrics().map(m=>option(m.label,m.id)));
        const years=[...new Set(release.videos.flatMap(v=>v.date?[v.date.slice(0,4)]:[]))].sort().reverse();yearSelect.append(...years.map(y=>option(y,y)),option('Undated','undated'));
        const categories=[...new Set(release.videos.flatMap(v=>v.category?[v.category]:[]))].sort();categorySelect.append(...categories.map(c=>option(humanize(c),c)));
        controls.addEventListener('input',()=>{currentPage=1;render();});controls.addEventListener('change',(event)=>{if(event.target===kindSelect){metricSelect.replaceChildren(...metrics().map(m=>option(m.label,m.id)));}currentPage=1;render();});
        pageSizeSelect.addEventListener('change',()=>{pageSize=Number(pageSizeSelect.value);currentPage=1;renderVideos();});
        intervalSelect.addEventListener('change',()=>drawTrend());
        trendMethodSelect.addEventListener('change',()=>drawTrend());
        previous.addEventListener('click',()=>{currentPage=Math.max(1,currentPage-1);renderVideos();pager.scrollIntoView({block:'nearest'});});
        next.addEventListener('click',()=>{currentPage++;renderVideos();pager.scrollIntoView({block:'nearest'});});
        document.addEventListener('analysis-select-recording',(event)=>{
          const id=(event as CustomEvent<{recording_id?:unknown}>).detail?.recording_id;
          if(typeof id!=='string')return;
          const video=release.videos.find(item=>item.recording_id===id);
          if(video)showEvidence(video);
        });
      const correlationDetails=root.querySelector<HTMLDetailsElement>('[data-correlation-details]')!;correlationDetails.addEventListener('toggle',()=>{if(correlationDetails.open&&correlationDetails.dataset.rendered!=='true'){drawCorrelations();correlationDetails.dataset.rendered='true';}});
      drawMds();drawFactors();render();
        root.querySelector<HTMLElement>('[data-diagnostics]')!.textContent=JSON.stringify(release.analysis.diagnostics,null,2);
      } catch (error) { if(import.meta.env.DEV) console.error('Analysis preview load failed',error); status.hidden=false;status.textContent='The transcript scoring release could not be loaded or failed validation.'; }
    }
    void init();
</script>

