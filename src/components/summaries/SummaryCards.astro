---
import type { summaryCard } from '../../lib/summaries/release';
import { periodLabel } from '../../lib/summaries/schema.mjs';
import InlineSummary from './InlineSummary.astro';
interface Props { cards: ReturnType<typeof summaryCard>[] }
const { cards } = Astro.props;
---
<ul class="summary-cards">
  {cards.map((card) => <li>
    <span class="summary-kicker">{card.kind === 'transcript' ? 'Recording' : card.kind} · {card.kind === 'archive' ? 'Selected archive' : periodLabel(card.period)}</span>
    <h3><a href={card.href}>{card.title}</a></h3>
    <p>{card.excerpt}</p>
    {card.kind === 'transcript' && <InlineSummary id={card.id} />}
  </li>)}
</ul>
<style is:global>
  .summary-cards { display: grid; grid-template-columns: repeat(auto-fill,minmax(min(100%,19rem),1fr)); gap: 1rem; list-style: none; margin: 1rem 0; padding: 0; }
  .summary-cards li { padding: 1.3rem; border: 1px solid var(--corpus-line); border-radius: .65rem; background: var(--corpus-panel); overflow-wrap: anywhere; }
  .summary-cards li:hover { border-color: var(--corpus-accent); }
  .summary-cards h3 { margin: .5rem 0; font-size: 1.1rem; line-height: 1.4; }
  .summary-cards p { color: var(--corpus-muted); margin-bottom: 0; font-size: .9rem; }
  .summary-kicker { text-transform: uppercase; font-size: .7rem; letter-spacing: .08em; color: var(--corpus-muted); }
</style>
