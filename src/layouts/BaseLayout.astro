---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Hiding In My Room — Community Site',
  description =
    'A community-built home for Hiding In My Room: the primary HIMR channel link, HIMR communities, and a growing transcript-sourced wiki.',
} = Astro.props;

// Avoid emitting localhost canonicals until a production domain is configured.
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta name="twitter:card" content="summary" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/jpeg" href="/images/wiki/daniel-channel-avatar-2026-08-25.jpg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
