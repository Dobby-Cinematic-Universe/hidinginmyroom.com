---
import PassageExplorer from '../../../components/corpus/PassageExplorer.astro';
import CorpusLayout from '../../../layouts/CorpusLayout.astro';
---
<CorpusLayout title="Passage explorer | HIMR transcript analysis" description="Explore single transcript passages: what they are about year by year, how one recording changes from passage to passage, how passages that name a topic are worded, and a search by wording.">
  <nav class="corpus-breadcrumbs" aria-label="Breadcrumb"><a href="/corpus/">Corpus</a><span aria-hidden="true">/</span><a href="/corpus/analysis/">Transcript analysis</a><span aria-hidden="true">/</span><span aria-current="page">Passage explorer</span></nav>
  <header class="passage-header">
    <p class="corpus-eyebrow">Transcript research explorer · passages</p>
    <h1>Explore single passages</h1>
    <p>Four views on passages of 500 words: what they are about year by year, how one recording changes from passage to passage, how passages that name a topic are worded, and a search by wording. Each passage links to its place in the transcript.</p>
    <div class="passage-actions"><a href="/corpus/analysis/">Recordings and dimensions</a><a href="/corpus/analysis/methods/">Methods and interpretation</a><a href="/corpus/analysis/validation/">Human rating studies</a></div>
  </header>
  <PassageExplorer />
</CorpusLayout>
<style>
  .passage-header{max-width:62rem;padding-block:.4rem .7rem}.passage-header h1{font-size:clamp(1.8rem,4vw,2.8rem);line-height:1.08;letter-spacing:-.04em;margin-block:.45rem .65rem}.passage-header>p:last-of-type{max-width:75ch;color:var(--corpus-muted);font-size:.95rem;line-height:1.55;margin-block:.5rem}.passage-actions{display:flex;align-items:center;flex-wrap:wrap;gap:1rem;margin-top:.45rem;font-size:.9rem}
</style>
