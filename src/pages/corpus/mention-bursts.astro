---
import CorpusLayout from '../../layouts/CorpusLayout.astro';
import { mentionBursts } from '../../lib/corpus/reader-extras';

const bursts = await mentionBursts();
const subjects = [...new Set(bursts.map((b) => b.subject))]
  .map((subject) => ({ subject, type: bursts.find((b) => b.subject === subject)!.type, rows: bursts.filter((b) => b.subject === subject) }))
  .sort((a, b) => a.rows[0].start.localeCompare(b.rows[0].start) || a.subject.localeCompare(b.subject));
const monthNo = (m: string) => Number(m.slice(0, 4)) * 12 + Number(m.slice(5, 7)) - 1;
const first = Math.min(...bursts.map((b) => monthNo(b.start)), 2016 * 12), last = Math.max(...bursts.map((b) => monthNo(b.end)), 2026 * 12) + 1;
const W = 900, L = 150, R = 12, T = 22, rowH = 15, H = T + subjects.length * rowH + 8;
const x = (m: number) => L + ((m - first) / (last - first)) * (W - L - R);
const years = Array.from({ length: Math.floor(last / 12) - Math.ceil(first / 12) + 1 }, (_, i) => Math.ceil(first / 12) + i);
const colour = { game: 'var(--corpus-accent)', product: 'var(--corpus-warning)', platform: '#c4a1ff' } as const;
const label = { game: 'Games', product: 'Products and brands', platform: 'Platforms' } as const;
const kind = { game: 'Game', product: 'Product', platform: 'Platform' } as const;
const span = (b: { start: string; end: string; end_known: boolean }) => `${b.start} to ${b.end}${b.end_known ? '' : ' (archive thins out; end unknown)'}`;
---
<CorpusLayout title="What was talked about when | HIMR Public Corpus" description="Stretches of months in which the transcripts name a game, product or platform unusually often.">
  <nav class="corpus-breadcrumbs" aria-label="Breadcrumb"><a href="/corpus/">Corpus</a><span aria-hidden="true">/</span><span aria-current="page">What was talked about when</span></nav>
  <header class="bursts-header">
    <p class="corpus-eyebrow">Mentions over time</p>
    <h1>What was talked about when</h1>
    <p>Stretches of months in which the machine transcripts name a game, product or platform far more often than usual. A stretch says that a name comes up a lot. It is not a dated event, and it says nothing about why.</p>
  </header>
  {bursts.length === 0 ? <p class="corpus-muted">No mention data is attached to this release.</p> : <article class="bursts-copy">
    <figure>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Timeline of stretches in which each subject is named unusually often. The table below gives the same information.">
        {years.map((y) => <><line x1={x(y * 12)} x2={x(y * 12)} y1={T - 6} y2={H - 4} class="grid" /><text x={x(y * 12)} y={T - 10} text-anchor="middle">{y}</text></>)}
        {subjects.map((s, i) => <>
          <text x={L - 8} y={T + i * rowH + 10} text-anchor="end">{s.subject}</text>
          {s.rows.map((b) => <rect x={x(monthNo(b.start))} width={Math.max(3, x(monthNo(b.end) + 1) - x(monthNo(b.start)))} y={T + i * rowH + 2} height={rowH - 5} rx="2" fill={colour[s.type]} opacity={b.both_transcript_kinds ? 1 : 0.55}><title>{`${s.subject}: ${span(b)} · named in ${b.recordings} recordings`}</title></rect>)}
        </>)}
      </svg>
      <figcaption>{(['game', 'product', 'platform'] as const).map((t) => <span class="key"><i style={`background:${colour[t]}`}></i>{label[t]}</span>)}<span class="note">Paler bars fall in a period covered by only one kind of transcript, so they could not be checked across transcript kinds.</span></figcaption>
    </figure>
    <section aria-labelledby="table-title">
      <h2 id="table-title">All stretches</h2>
      <table>
        <thead><tr><th scope="col">Subject</th><th scope="col">Kind</th><th scope="col">Months</th><th scope="col">Length</th><th scope="col">Recordings naming it</th><th scope="col">Rate compared with other times</th></tr></thead>
        <tbody>{bursts.map((b) => <tr><td>{b.subject}</td><td>{kind[b.type]}</td><td>{span(b)}</td><td>{b.months} {b.months === 1 ? 'month' : 'months'}</td><td>{b.recordings}</td><td>{b.ratio === null ? '—' : `${b.ratio}×`}</td></tr>)}</tbody>
      </table>
    </section>
    <section aria-labelledby="limits-title">
      <h2 id="limits-title">How to read this</h2>
      <ul>
        <li>Names are matched as written in machine transcripts. Misheard names are missed, and a name read aloud from a viewer's message counts as a mention.</li>
        <li>Rates are per amount of speech, so a month with many long streams does not count for more.</li>
        <li>Only strong stretches are shown: ones heavier than 99% of those that appear when recording dates are shuffled.</li>
        <li>Before 2019 the archive holds too little speech per month to detect a stretch. A blank there is missing data.</li>
        <li>Only games, products and platforms are shown. People and places are left out.</li>
      </ul>
    </section>
  </article>}
</CorpusLayout>
<style>
  .bursts-header{max-width:52rem;margin-bottom:1.5rem}.bursts-header h1{margin:.2rem 0 .6rem}.bursts-header p:last-child{color:var(--corpus-muted)}
  .bursts-copy{display:grid;gap:2rem;max-width:64rem}.bursts-copy>*{min-width:0}.bursts-copy h2{margin:0 0 .6rem}
  figure{margin:0;padding:.8rem;border:1px solid var(--corpus-line);border-radius:.5rem;background:var(--corpus-panel);overflow-x:auto}
  svg{display:block;width:100%;min-width:44rem;height:auto}svg text{fill:var(--corpus-muted);font-size:10px}svg :global(.grid){stroke:var(--corpus-line);stroke-width:1}
  figcaption{margin-top:.5rem;color:var(--corpus-muted);font-size:.8rem}.key{display:inline-flex;align-items:center;gap:.35rem;margin-right:1rem}.key i{display:inline-block;width:.8rem;height:.5rem;border-radius:2px}.note{display:block;margin-top:.25rem}
  table{width:100%;border-collapse:collapse;font-size:.85rem;font-variant-numeric:tabular-nums}th,td{text-align:left;padding:.35rem .6rem;border-bottom:1px solid var(--corpus-line)}th{color:var(--corpus-muted);font-weight:600}td:first-child,td:nth-child(3),td:nth-child(4){white-space:nowrap}
  li{margin:.3rem 0;color:var(--corpus-muted)}
  @media (max-width:40rem){table{display:block;overflow-x:auto}}
</style>
