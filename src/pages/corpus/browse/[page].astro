---
import RecordingList from '../../../components/corpus/RecordingList.astro';
import RecordingBrowser from '../../../components/corpus/RecordingBrowser.astro';
import CorpusLayout from '../../../layouts/CorpusLayout.astro';
import { loadCorpusCatalog } from '../../../lib/corpus/release';
import type { CorpusRecordingSummary } from '../../../lib/corpus/types';

const PAGE_SIZE = 100;

interface Props {
  recordings: CorpusRecordingSummary[];
  pageNumber: number;
  pageCount: number;
  total: number;
}

export async function getStaticPaths() {
  // Astro hoists getStaticPaths into a generated module, so values captured from
  // frontmatter scope are not available there. Keep the route-build constant local.
  const pageSize = 100;
  const catalog = await loadCorpusCatalog();
  const recordings = [...catalog.recordings].sort((a,b)=>(b.date_label||'').localeCompare(a.date_label||'')||a.title.localeCompare(b.title));
  const pageCount = Math.ceil(recordings.length / pageSize);

  return Array.from({ length: pageCount }, (_, index) => {
    const pageNumber = index + 1;
    return {
      params: { page: String(pageNumber) },
      props: {
        recordings: recordings.slice(index * pageSize, pageNumber * pageSize),
        pageNumber,
        pageCount,
        total: recordings.length,
      },
    };
  });
}

const { recordings, pageNumber, pageCount, total } = Astro.props;
const firstOrdinal = (pageNumber - 1) * PAGE_SIZE + 1;
const lastOrdinal = firstOrdinal + recordings.length - 1;
const previousPath = pageNumber > 1 ? `/corpus/browse/${pageNumber - 1}/` : undefined;
const nextPath = pageNumber < pageCount ? `/corpus/browse/${pageNumber + 1}/` : undefined;
---

<CorpusLayout
  title={`Published recordings · Page ${pageNumber} · HIMR Public Corpus`}
  description={`Browse publication-cleared HIMR corpus recordings ${firstOrdinal} through ${lastOrdinal} of ${total}.`}
>
  <nav class="browse-crumbs" aria-label="Breadcrumb">
    <a href="/corpus/">Corpus</a>
    <span aria-hidden="true">/</span>
    <span>Published recordings</span>
  </nav>

  <header class="browse-heading">
    <div>
      <p class="corpus-eyebrow">Explore the corpus</p>
      <h1>Browse recordings</h1>
    </div>
    <p>
      {total.toLocaleString('en-US')} recordings
    </p>
  </header>

  {pageNumber===1 ? <RecordingBrowser /> : <p><a href="/corpus/browse/1/">Search and filter all recordings →</a></p>}
  <div data-static-browse>
  <p>Showing {firstOrdinal}–{lastOrdinal} · newest first</p>
  <RecordingList recordings={recordings} />

  <nav class="browse-pagination" aria-label="Recording pages">
    {previousPath ? <a rel="prev" href={previousPath}>← Previous</a> : <span>← Previous</span>}
    <strong>Page {pageNumber.toLocaleString('en-US')} of {pageCount.toLocaleString('en-US')}</strong>
    {nextPath ? <a rel="next" href={nextPath}>Next →</a> : <span>Next →</span>}
  </nav>
  </div>
</CorpusLayout>

<style>
  .browse-crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--corpus-muted);
    font-size: 0.82rem;
  }

  .browse-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .browse-heading h1,
  .browse-heading > p {
    margin: 0;
  }

  .browse-heading h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .browse-heading > p {
    color: var(--corpus-muted);
    font-size: 0.85rem;
  }

  .browse-pagination {
    display: grid;
    grid-template-columns: minmax(7rem, 1fr) auto minmax(7rem, 1fr);
    gap: 1rem;
    align-items: center;
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--corpus-line);
    border-radius: 0.45rem;
    background: var(--corpus-panel);
    font-size: 0.86rem;
  }

  .browse-pagination > :last-child {
    text-align: right;
  }

  .browse-pagination span {
    color: var(--corpus-muted);
  }

  @media (max-width: 40rem) {
    .browse-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .browse-pagination {
      grid-template-columns: 1fr 1fr;
    }

    .browse-pagination strong {
      grid-column: 1 / -1;
      grid-row: 1;
      text-align: center;
    }
  }
</style>
