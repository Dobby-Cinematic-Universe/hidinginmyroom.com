---
import CorpusLayout from '../../layouts/CorpusLayout.astro';
import { loadChannelHistory } from '../../lib/corpus/channel-history';

const history = await loadChannelHistory();
const channels = history.channels.filter((c) => c.readings.length > 1);
const views = history.early_views;
const fmt = (n: number) => n.toLocaleString('en-US');
const compact = (n: number) => (n >= 1000 ? `${Math.round(n / 1000)}k` : String(n));
const dayNumber = (d: string) => Date.parse(d) / 864e5;

// Subscriber chart geometry (one shared time axis, one line per channel).
const W = 760, H = 300, L = 52, R = 14, T = 14, B = 30;
const monthlySubs = (c: (typeof channels)[number]) => c.monthly.filter((m) => m.subscribers !== null) as { date: string; subscribers: number }[];
// Axis ranges cover the archived readings and the month-end values from archived Social Blade pages.
const all = [...channels.flatMap((c) => c.readings), ...channels.flatMap((c) => monthlySubs(c))];
const x0 = Math.min(...all.map((r) => dayNumber(r.date))), x1 = Math.max(...all.map((r) => dayNumber(r.date)));
const yMax = Math.ceil(Math.max(1, ...all.map((r) => r.subscribers)) / 20000) * 20000;
const px = (d: string) => L + ((dayNumber(d) - x0) / Math.max(1, x1 - x0)) * (W - L - R);
const py = (v: number) => T + (1 - v / yMax) * (H - T - B);
const years = all.length ? Array.from({ length: Number(all.map((r) => r.date).sort().at(-1)!.slice(0, 4)) - Number(all.map((r) => r.date).sort()[0].slice(0, 4)) }, (_, i) => Number(all.map((r) => r.date).sort()[0].slice(0, 4)) + i + 1) : [];
const yTicks = Array.from({ length: yMax / 20000 + 1 }, (_, i) => i * 20000);
const stroke = { main: 'var(--corpus-accent)', second: 'var(--corpus-warning)' } as const;

// Early-view chart geometry (median with interquartile range per half-year).
const vMax = Math.max(1, ...views.map((v) => v.p75));
const band = (W - L - R) / Math.max(1, views.length);
const vy = (v: number) => T + (1 - v / vMax) * (H - T - B);
const vTicks = [0, 0.25, 0.5, 0.75, 1].map((f) => Math.round((vMax * f) / 1000) * 1000);

// Total-view chart geometry: month-end values (line) and readings from archived About pages (dots).
const monthlyViews = (c: (typeof channels)[number]) => c.monthly.filter((m) => m.views !== null) as { date: string; views: number }[];
const viewChannels = channels.filter((c) => monthlyViews(c).length > 0 || c.view_readings.length > 0);
const viewPoints = viewChannels.flatMap((c) => [...monthlyViews(c), ...c.view_readings]);
const t0 = Math.min(...viewPoints.map((r) => dayNumber(r.date))), t1 = Math.max(...viewPoints.map((r) => dayNumber(r.date)));
const tMax = Math.ceil(Math.max(1, ...viewPoints.map((r) => r.views)) / 5e6) * 5e6;
const tx = (d: string) => L + ((dayNumber(d) - t0) / Math.max(1, t1 - t0)) * (W - L - R);
const ty = (v: number) => T + (1 - v / tMax) * (H - T - B);
const tTicks = Array.from({ length: tMax / 5e6 + 1 }, (_, i) => i * 5e6);
const tYears = viewPoints.length ? Array.from({ length: Number(viewPoints.map((r) => r.date).sort().at(-1)!.slice(0, 4)) - Number(viewPoints.map((r) => r.date).sort()[0].slice(0, 4)) }, (_, i) => Number(viewPoints.map((r) => r.date).sort()[0].slice(0, 4)) + i + 1) : [];
const millions = (n: number) => (n >= 1e6 ? `${n / 1e6}M` : String(n));
const signed = (n: number) => `${n < 0 ? '−' : '+'}${fmt(Math.abs(n))}`;
// Largest fall and rise between two consecutive month-end totals.
const swings = (rows: { date: string; views: number }[]) => {
  const steps = rows.slice(1).map((r, i) => ({ from: rows[i].date, to: r.date, change: r.views - rows[i].views }));
  if (!steps.length) return undefined;
  return { fall: steps.reduce((a, b) => (b.change < a.change ? b : a)), rise: steps.reduce((a, b) => (b.change > a.change ? b : a)), falls: steps.filter((x) => x.change < 0).length, steps: steps.length };
};
// The column header names the site, so each link says only the capture year and which page it is.
const pageName = (url: string) => (url.endsWith('/monthly') ? 'monthly page' : 'summary page');

// Milestones table: first reading, last reading of each year, and the highest reading.
const milestones = (readings: (typeof channels)[number]['readings']) => {
  const keep = new Map<string, (typeof readings)[number]>();
  keep.set('first', readings[0]);
  for (const r of readings) keep.set(r.date.slice(0, 4), r);
  const peak = readings.reduce((a, b) => (b.subscribers > a.subscribers ? b : a));
  return { rows: [...new Set(keep.values())], peak };
};
---
<CorpusLayout title="Channel history | HIMR Public Corpus" description="Subscriber counts, total views and typical early view counts for the channels, read from archived copies of their public pages and of a statistics site.">
  <nav class="corpus-breadcrumbs" aria-label="Breadcrumb"><a href="/corpus/">Corpus</a><span aria-hidden="true">/</span><span aria-current="page">Channel history</span></nav>
  <header class="history-header">
    <p class="corpus-eyebrow">Archived public channel pages</p>
    <h1>Channel history</h1>
    <p>Subscriber counts, total views and typical early view counts, read from copies of the channels' public YouTube pages saved by the Internet Archive's Wayback Machine, with month-end values from archived copies of the statistics site Social Blade. Each value links to the archived page or pages it comes from. The numbers describe what those pages displayed.</p>
  </header>

  {channels.length === 0 ? <p class="corpus-muted">No channel history is attached to this release.</p> : <article class="history-copy">
    <section aria-labelledby="subs-title">
      <h2 id="subs-title">Subscribers</h2>
      <figure>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Subscriber counts over time for ${channels.map((c) => c.label).join(' and ')}. The table below gives the values.`}>
          {yTicks.map((t) => <><line x1={L} x2={W - R} y1={py(t)} y2={py(t)} class="grid" /><text x={L - 6} y={py(t) + 4} text-anchor="end">{compact(t)}</text></>)}
          {years.map((y) => <text x={px(`${y}-01-01`)} y={H - 10} text-anchor="middle">{y}</text>)}
          {channels.map((c) => monthlySubs(c).length > 1 && <polyline fill="none" stroke={stroke[c.key]} stroke-width="1" stroke-opacity=".5" points={monthlySubs(c).map((m) => `${px(m.date).toFixed(1)},${py(m.subscribers).toFixed(1)}`).join(' ')} />)}
          {channels.map((c) => <>
            <polyline fill="none" stroke={stroke[c.key]} stroke-width="2" points={c.readings.map((r) => `${px(r.date).toFixed(1)},${py(r.subscribers).toFixed(1)}`).join(' ')} />
            {c.readings.map((r) => <circle cx={px(r.date)} cy={py(r.subscribers)} r="2.2" fill={stroke[c.key]}><title>{`${c.label}: ${fmt(r.subscribers)} on ${r.date}`}</title></circle>)}
          </>)}
        </svg>
        <figcaption>{channels.map((c, i) => <span class="key"><i style={`background:${stroke[c.key]}`}></i>{c.label} ({c.readings.length} readings)</span>)}<span class="note">Dots are archived readings. Lines join them and do not show what happened in between.{channels.some((c) => monthlySubs(c).length > 1) && ' Thin lines are month-end values from archived Social Blade pages, listed under Total views.'}</span></figcaption>
      </figure>
      <p class="corpus-muted">In the tables, "about" marks counts that YouTube showed rounded.</p>
      {channels.map((c) => { const m = milestones(c.readings); return <>
        <h3>{c.label}</h3>
        <p>First archived reading: {fmt(c.readings[0].subscribers)} on {c.readings[0].date}. Highest: {fmt(m.peak.subscribers)} on {m.peak.date}. Latest: {fmt(c.readings.at(-1)!.subscribers)} on {c.readings.at(-1)!.date}.</p>
        <table>
          <thead><tr><th scope="col">Archived on</th><th scope="col">Subscribers shown</th><th scope="col">Source</th></tr></thead>
          <tbody>{m.rows.map((r) => <tr><td>{r.date}</td><td>{r.rounded_to > 1 && <span class="corpus-muted">about </span>}{fmt(r.subscribers)}</td><td><a href={r.source} target="_blank" rel="noopener noreferrer">Archived page</a></td></tr>)}</tbody>
        </table>
        <details><summary>All {c.readings.length} readings</summary>
          <table>
            <thead><tr><th scope="col">Archived on</th><th scope="col">Subscribers shown</th><th scope="col">Source</th></tr></thead>
            <tbody>{c.readings.map((r) => <tr><td>{r.date}</td><td>{fmt(r.subscribers)}</td><td><a href={r.source} target="_blank" rel="noopener noreferrer">Archived page</a></td></tr>)}</tbody>
          </table>
        </details>
      </>; })}
    </section>

    {viewChannels.length > 0 && <section aria-labelledby="total-views-title">
      <h2 id="total-views-title">Total views</h2>
      <p>The channel's public view counter. It counts public videos only, so it falls when videos are removed or made private and rises again when they return. Month-end values come from archived copies of the statistics site Social Blade, which recorded the counter each day. Single readings come from archived copies of the channel's own About page.</p>
      <figure>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Total public views over time for ${viewChannels.map((c) => c.label).join(' and ')}. The tables below give the values.`}>
          {tTicks.map((t) => <><line x1={L} x2={W - R} y1={ty(t)} y2={ty(t)} class="grid" /><text x={L - 6} y={ty(t) + 4} text-anchor="end">{millions(t)}</text></>)}
          {tYears.map((y) => <text x={tx(`${y}-01-01`)} y={H - 10} text-anchor="middle">{y}</text>)}
          {viewChannels.map((c) => <>
            {monthlyViews(c).length > 1 && <polyline fill="none" stroke={stroke[c.key]} stroke-width="2" points={monthlyViews(c).map((m) => `${tx(m.date).toFixed(1)},${ty(m.views).toFixed(1)}`).join(' ')} />}
            {c.view_readings.map((r) => <circle cx={tx(r.date)} cy={ty(r.views)} r="3" fill={stroke[c.key]} stroke="var(--corpus-panel)" stroke-width="1"><title>{`${c.label}: ${fmt(r.views)} views on ${r.date} (About page)`}</title></circle>)}
          </>)}
        </svg>
        <figcaption>{viewChannels.map((c) => <span class="key"><i style={`background:${stroke[c.key]}`}></i>{c.label}</span>)}<span class="note">Lines are month-end values from archived Social Blade pages. Dots are single readings from archived About pages; nothing is known between them.</span></figcaption>
      </figure>
      {viewChannels.map((c) => { const rows = monthlyViews(c); const sw = swings(rows); return <>
        <h3>{c.label}</h3>
        {rows.length > 1 && sw && <p>Month-end values run from {rows[0].date} to {rows.at(-1)!.date}. The total fell between two month-ends in {sw.falls} of {sw.steps} months. Largest fall: {signed(sw.fall.change)} between {sw.fall.from} and {sw.fall.to}. Largest rise: {signed(sw.rise.change)} between {sw.rise.from} and {sw.rise.to}.{c.monthly_views_uncertainty ? ` These month-end totals share one offset of at most ${fmt(c.monthly_views_uncertainty)} views; the changes between them are exact.` : ''}</p>}
        {c.view_readings.length > 0 && <table>
          <thead><tr><th scope="col">Archived on</th><th scope="col">Total views shown</th><th scope="col">Source</th></tr></thead>
          <tbody>{c.view_readings.map((r) => <tr><td>{r.date}</td><td>{fmt(r.views)}</td><td><a href={r.source} target="_blank" rel="noopener noreferrer">Archived About page</a></td></tr>)}</tbody>
        </table>}
        {c.monthly.length > 0 && <details><summary>All {c.monthly.length} month-end values</summary>
          <table>
            <thead><tr><th scope="col">Month end</th><th scope="col">Subscribers</th><th scope="col">Total views</th><th scope="col">Archived Social Blade pages</th></tr></thead>
            <tbody>{c.monthly.map((m) => <tr><td>{m.date}</td><td>{m.subscribers === null ? '—' : <>{(m.rounded_to ?? 1) > 1 && <span class="corpus-muted">about </span>}{fmt(m.subscribers)}</>}</td><td>{m.views === null ? '—' : fmt(m.views)}</td><td class="sources">{m.sources.map((u, i) => <>{i > 0 && ', '}<a href={u} target="_blank" rel="noopener noreferrer">{u.slice(28, 32)} {pageName(u)}</a></>)}</td></tr>)}</tbody>
          </table>
        </details>}
      </>; })}
    </section>}

    {channels.some((c) => c.names?.length > 0) && <section aria-labelledby="names-title">
      <h2 id="names-title">Channel names</h2>
      <p>The name each channel's page showed on the days it was archived. A change is known only as the interval between the last capture with the old name and the first with the new one.</p>
      {channels.filter((c) => c.names?.length > 0).map((c) => <>
        <h3>{c.label}</h3>
        <table>
          <thead><tr><th scope="col">Name shown</th><th scope="col">First seen</th><th scope="col">Last seen</th><th scope="col">Changed between</th><th scope="col">Source</th></tr></thead>
          <tbody>{c.names.map((n) => <tr><td>{n.name ?? <span class="corpus-muted">Renamed (name not shown here)</span>}</td><td>{n.first_seen}</td><td>{n.last_seen}</td><td>{n.changed_after ? `${n.changed_after} and ${n.changed_before}` : '—'}</td><td><a href={n.source} target="_blank" rel="noopener noreferrer">Archived page</a></td></tr>)}</tbody>
        </table>
      </>)}
    </section>}

    {views.length > 0 && <section aria-labelledby="views-title">
      <h2 id="views-title">Typical views about a month after upload</h2>
      <p>For each half-year, the median view count shown for a video roughly one month after it was published, across both channels. The bar is the median; the line spans the middle half of videos. Only videos with an archived reading at about that age are counted.</p>
      <figure>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Median views about one month after upload, by half-year. The table below gives the values.">
          {vTicks.map((t) => <><line x1={L} x2={W - R} y1={vy(t)} y2={vy(t)} class="grid" /><text x={L - 6} y={vy(t) + 4} text-anchor="end">{compact(t)}</text></>)}
          {views.map((v, i) => <>
            <rect x={L + i * band + band * 0.2} width={band * 0.6} y={vy(v.median_views)} height={Math.max(0, H - B - vy(v.median_views))} rx="2" fill="var(--corpus-accent-strong)"><title>{`${v.period}: median ${fmt(v.median_views)} views (${v.videos} videos)`}</title></rect>
            <line x1={L + i * band + band / 2} x2={L + i * band + band / 2} y1={vy(v.p75)} y2={vy(v.p25)} stroke="var(--corpus-text)" stroke-width="1.5" />
            {(i % 2 === 0 || views.length <= 10) && <text x={L + i * band + band / 2} y={H - 10} text-anchor="middle">{v.period.replace('H', ' H')}</text>}
          </>)}
        </svg>
      </figure>
      <table>
        <thead><tr><th scope="col">Half-year</th><th scope="col">Videos counted</th><th scope="col">Median views</th><th scope="col">Middle half</th><th scope="col">Per 1,000 subscribers</th></tr></thead>
        <tbody>{views.map((v) => <tr><td>{v.period.replace('H', ' H')}</td><td>{v.videos}</td><td>{fmt(v.median_views)}</td><td>{fmt(v.p25)}–{fmt(v.p75)}</td><td>{v.per_1000_subscribers === null ? '—' : fmt(v.per_1000_subscribers)}</td></tr>)}</tbody>
      </table>
    </section>}

    <section aria-labelledby="limits-title">
      <h2 id="limits-title">How to read this</h2>
      <ul>
        <li>Readings exist only for days on which a page happened to be archived. Gaps between readings can be months long, so the timing of rises and falls is approximate.</li>
        <li>YouTube rounds public subscriber counts. Since late 2019 the pages show three significant figures, so small changes are invisible.</li>
        <li>View counts are those displayed in archived video listings. A video's age at the reading is worked out from the listing's relative display (such as "3 weeks ago") and is approximate.</li>
        <li>Videos that were never captured in a listing at about one month old are not counted, so the view figures cover a subset of uploads.</li>
        <li>Month-end values are worked out from the monthly changes that Social Blade showed for the same channel, and agree with its daily tables wherever both exist. That site's days end at midnight US Eastern time, and channel-page readings are dated by the day of capture, so the two can be a day apart.</li>
        <li>Total views cover public videos only. A fall means that views left the public total, as when videos are removed or made private. It does not mean that fewer people watched.</li>
        <li>These are counts displayed by the platform. They say nothing about why they changed.</li>
      </ul>
    </section>
  </article>}
</CorpusLayout>
<style>
  .history-header{max-width:52rem;margin-bottom:1.5rem}.history-header h1{margin:.2rem 0 .6rem}.history-header p:last-child{color:var(--corpus-muted)}
  .history-copy{display:grid;gap:2rem;max-width:60rem}.history-copy h2{margin:0 0 .6rem}.history-copy h3{margin:1.2rem 0 .3rem;font-size:1rem}
  figure{margin:0 0 1rem;padding:.8rem;border:1px solid var(--corpus-line);border-radius:.5rem;background:var(--corpus-panel)}
  figure{overflow-x:auto}svg{display:block;width:100%;min-width:34rem;height:auto}.note{display:block;margin-top:.25rem}td:first-child,td:last-child,th{white-space:nowrap}td.sources{white-space:normal}svg text{fill:var(--corpus-muted);font-size:11px}svg :global(.grid){stroke:var(--corpus-line);stroke-width:1}
  figcaption{margin-top:.5rem;color:var(--corpus-muted);font-size:.8rem}.key{display:inline-flex;align-items:center;gap:.35rem;margin-right:1rem}.key i{display:inline-block;width:.8rem;height:.2rem;border-radius:1px}
  table{width:100%;border-collapse:collapse;font-size:.85rem;font-variant-numeric:tabular-nums}th,td{text-align:left;padding:.35rem .6rem;border-bottom:1px solid var(--corpus-line)}th{color:var(--corpus-muted);font-weight:600}
  details{margin-top:.6rem}summary{cursor:pointer;color:var(--corpus-accent);font-size:.85rem}li{margin:.3rem 0;color:var(--corpus-muted)}
  .history-copy>*{min-width:0}
  @media (max-width:40rem){th,td{padding:.3rem .35rem}table{display:block;overflow-x:auto}}
</style>
