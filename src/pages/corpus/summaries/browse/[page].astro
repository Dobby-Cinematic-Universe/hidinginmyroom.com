---
import CorpusLayout from '../../../../layouts/CorpusLayout.astro';
import SummaryCards from '../../../../components/summaries/SummaryCards.astro';
import SummaryNotice from '../../../../components/summaries/SummaryNotice.astro';
import { loadSummaryRelease, summaryCard } from '../../../../lib/summaries/release';
export async function getStaticPaths() {
  const rows = [...(await loadSummaryRelease()).summaries].sort((a,b) => (b.period ?? '').localeCompare(a.period ?? ''));
  const pages = Math.max(1,Math.ceil(rows.length/48));
  return Array.from({length:pages},(_,i) => ({params:{page:String(i+1)},props:{cards:rows.slice(i*48,(i+1)*48).map(summaryCard),page:i+1,pages}}));
}
const { cards, page, pages } = Astro.props;
---
<CorpusLayout title={`Summary library · page ${page} | HIMR`}>
  <a href="/corpus/summaries/">← Summaries</a>
  <h1>Summary library</h1><p>Page {page} of {pages}</p>
  <SummaryNotice /><SummaryCards cards={cards} />
  {cards.length === 0 && <p>No summaries have been released yet.</p>}
  <nav class="library-pagination" aria-label="Library pages">
    {page > 1 ? <a rel="prev" href={`/corpus/summaries/browse/${page-1}/`}>← Previous</a> : <span aria-disabled="true">← Previous</span>}
    <strong>Page {page} of {pages}</strong>
    {page < pages ? <a rel="next" href={`/corpus/summaries/browse/${page+1}/`}>Next →</a> : <span aria-disabled="true">Next →</span>}
  </nav>
</CorpusLayout>
<style>
  .library-pagination { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .75rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--corpus-line); }
  .library-pagination a, .library-pagination span { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; padding: .6rem .9rem; border: 1px solid var(--corpus-line); border-radius: .4rem; background: var(--corpus-panel); font-size: .85rem; line-height: 1.3; text-decoration: none; }
  .library-pagination span { color: var(--corpus-muted); opacity: .55; }
  .library-pagination a:hover { border-color: var(--corpus-accent); }
  .library-pagination strong { color: var(--corpus-muted); font-size: .85rem; font-weight: 500; }
  @media (max-width: 30rem) { .library-pagination { justify-content: center; } .library-pagination strong { order: -1; flex-basis: 100%; text-align: center; } }
</style>
