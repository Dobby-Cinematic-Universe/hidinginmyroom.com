{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/evaluation/interval-proposal-request-v1.json",
  "title": "ASR-blind interval proposal request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "manifest_sha256",
    "request_id",
    "created_at",
    "cohort_id",
    "cohort_manifest_sha256",
    "policy",
    "safety",
    "recordings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_kind": { "const": "interval_proposal_request" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "request_id": { "type": "string", "pattern": "^proposal_request_[0-9a-f]{32}$" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "cohort_id": { "$ref": "#/$defs/identifier" },
    "cohort_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "policy": { "$ref": "#/$defs/policy" },
    "safety": { "$ref": "#/$defs/safety" },
    "recordings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/recording" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "mediaId": { "type": "string", "pattern": "^media_sha256_[0-9a-f]{64}$" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_duration_ms",
        "minimum_interval_duration_ms",
        "max_intervals_per_recording",
        "max_total_intervals",
        "max_total_duration_ms",
        "minimum_gap_ms",
        "periodic_stride_ms",
        "max_silence_fraction_millionths"
      ],
      "properties": {
        "interval_duration_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "minimum_interval_duration_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "max_intervals_per_recording": { "type": "integer", "minimum": 1, "maximum": 32 },
        "max_total_intervals": { "type": "integer", "minimum": 1, "maximum": 384 },
        "max_total_duration_ms": { "type": "integer", "minimum": 1, "maximum": 28800000 },
        "minimum_gap_ms": { "type": "integer", "minimum": 0, "maximum": 120000 },
        "periodic_stride_ms": { "type": "integer", "minimum": 1, "maximum": 172800000 },
        "max_silence_fraction_millionths": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_basis",
        "asr_output_inputs_allowed",
        "transcript_inputs_allowed",
        "direct_media_content_inspection_allowed",
        "output_path_allowed",
        "catalog_write_allowed",
        "freeze_authority",
        "reference_quality_authority"
      ],
      "properties": {
        "selection_basis": { "const": "sealed_media_metadata_scene_silence_routing_only" },
        "asr_output_inputs_allowed": { "const": false },
        "transcript_inputs_allowed": { "const": false },
        "direct_media_content_inspection_allowed": { "const": false },
        "output_path_allowed": { "const": false },
        "catalog_write_allowed": { "const": false },
        "freeze_authority": { "const": "none" },
        "reference_quality_authority": { "const": "none" }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_kind",
        "source_offset_ms",
        "source_end_ms",
        "local_window_result_path",
        "local_window_result_sha256"
      ],
      "properties": {
        "binding_kind": { "enum": ["full_rendition", "local_window"] },
        "source_offset_ms": { "type": "integer", "minimum": 0, "maximum": 172800000 },
        "source_end_ms": { "type": "integer", "minimum": 1, "maximum": 172800000 },
        "local_window_result_path": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^/", "minLength": 2 }
          ]
        },
        "local_window_result_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "recording_id",
        "source_id",
        "source_native_id",
        "source_locator",
        "rendition_id",
        "rendition_kind",
        "parent_media_id",
        "parent_media_sha256",
        "parent_media_byte_count",
        "parent_media_duration_ms",
        "analysis_media_id",
        "analysis_media_sha256",
        "analysis_media_byte_count",
        "analysis_media_duration_ms",
        "preprocess_result_path",
        "preprocess_result_sha256",
        "timeline"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/identifier" },
        "recording_id": { "type": "string", "pattern": "^rec_[0-9a-f]{32}$" },
        "source_id": { "type": "string", "pattern": "^src_[0-9a-f]{32}$" },
        "source_native_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
        "source_locator": { "type": "string", "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$" },
        "rendition_id": { "type": "string", "pattern": "^rnd_[0-9a-f]{32}$" },
        "rendition_kind": { "$ref": "#/$defs/identifier" },
        "parent_media_id": { "$ref": "#/$defs/mediaId" },
        "parent_media_sha256": { "$ref": "#/$defs/sha256" },
        "parent_media_byte_count": { "type": "integer", "minimum": 1 },
        "parent_media_duration_ms": { "type": "integer", "minimum": 1, "maximum": 172800000 },
        "analysis_media_id": { "$ref": "#/$defs/mediaId" },
        "analysis_media_sha256": { "$ref": "#/$defs/sha256" },
        "analysis_media_byte_count": { "type": "integer", "minimum": 1 },
        "analysis_media_duration_ms": { "type": "integer", "minimum": 1, "maximum": 172800000 },
        "preprocess_result_path": { "type": "string", "pattern": "^/", "minLength": 2 },
        "preprocess_result_sha256": { "$ref": "#/$defs/sha256" },
        "timeline": { "$ref": "#/$defs/timeline" }
      }
    }
  }
}
