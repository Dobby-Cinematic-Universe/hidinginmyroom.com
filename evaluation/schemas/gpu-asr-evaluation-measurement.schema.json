{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/evaluation/gpu-asr-evaluation-measurement-v1.json",
  "title": "HIMR private GPU ASR evaluation measurement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "manifest_sha256",
    "measurement_id",
    "created_at",
    "system_output_id",
    "system_output_manifest_sha256",
    "profile_identity_sha256",
    "hardware",
    "protocol",
    "metrics",
    "source_receipt_sha256s",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_kind": { "const": "gpu_asr_evaluation_measurement" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "measurement_id": {
      "type": "string",
      "pattern": "^gpu_measurement_[0-9a-f]{32}$"
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "system_output_id": {
      "type": "string",
      "pattern": "^system_output_[0-9a-f]{32}$"
    },
    "system_output_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "profile_identity_sha256": { "$ref": "#/$defs/sha256" },
    "hardware": { "$ref": "#/$defs/hardware" },
    "protocol": { "$ref": "#/$defs/protocol" },
    "metrics": { "$ref": "#/$defs/metrics" },
    "source_receipt_sha256s": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "bounded_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_uuid", "gpu_name", "physical_vram_bytes"],
      "properties": {
        "gpu_uuid": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^GPU-"
        },
        "gpu_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "physical_vram_bytes": { "$ref": "#/$defs/positive_integer" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "evaluated_audio_duration_ms",
        "includes_model_load",
        "includes_audio_preflight",
        "includes_result_publication",
        "warmup_runs",
        "measured_runs"
      ],
      "properties": {
        "protocol_id": { "$ref": "#/$defs/id" },
        "evaluated_audio_duration_ms": { "$ref": "#/$defs/positive_integer" },
        "includes_model_load": { "type": "boolean" },
        "includes_audio_preflight": { "type": "boolean" },
        "includes_result_publication": { "type": "boolean" },
        "warmup_runs": { "$ref": "#/$defs/bounded_integer" },
        "measured_runs": { "$ref": "#/$defs/positive_integer" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_wall_time_ms",
        "gpu_sample_span_ms",
        "gpu_active_time_ms",
        "peak_process_vram_bytes",
        "estimated_energy_millijoules"
      ],
      "properties": {
        "runner_wall_time_ms": { "$ref": "#/$defs/positive_integer" },
        "gpu_sample_span_ms": { "$ref": "#/$defs/positive_integer" },
        "gpu_active_time_ms": { "$ref": "#/$defs/bounded_integer" },
        "peak_process_vram_bytes": { "$ref": "#/$defs/positive_integer" },
        "estimated_energy_millijoules": { "$ref": "#/$defs/bounded_integer" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technology_pins_are_run_metadata",
        "automatic_promotion_authority"
      ],
      "properties": {
        "technology_pins_are_run_metadata": { "const": true },
        "automatic_promotion_authority": { "const": "none" }
      }
    }
  }
}
