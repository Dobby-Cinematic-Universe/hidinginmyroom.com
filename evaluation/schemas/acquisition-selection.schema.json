{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/evaluation/acquisition-selection-v1.json",
  "title": "HIMR transcript evaluation acquisition queue selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "youtube_video_ids",
    "source_ids",
    "recording_ids"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "purpose": { "const": "transcript_evaluation_candidate_acquisition" },
    "youtube_video_ids": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/youtube_id" }
    },
    "source_ids": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source_id" }
    },
    "recording_ids": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/recording_id" }
    }
  },
  "$defs": {
    "youtube_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{32}$"
    },
    "recording_id": {
      "type": "string",
      "pattern": "^rec_[0-9a-f]{32}$"
    }
  }
}
