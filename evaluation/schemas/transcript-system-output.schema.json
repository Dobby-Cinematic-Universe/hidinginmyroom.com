{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/evaluation/transcript-system-output-v1.json",
  "title": "HIMR private frozen-interval transcript system output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "manifest_sha256",
    "system_output_id",
    "freeze_id",
    "freeze_manifest_sha256",
    "created_at",
    "system",
    "scoring_profile",
    "privacy",
    "recordings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_kind": { "const": "transcript_system_output" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "system_output_id": {
      "type": "string",
      "pattern": "^system_output_[0-9a-f]{32}$"
    },
    "freeze_id": { "$ref": "#/$defs/id" },
    "freeze_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "system": { "$ref": "#/$defs/system" },
    "scoring_profile": { "$ref": "#/$defs/scoring_profile" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "recordings": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/recording" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$" },
    "recording_id": { "type": "string", "pattern": "^rec_[0-9a-f]{32}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nullable_score": {
      "type": ["number", "null"],
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "system_label",
        "model_id",
        "run_manifest_sha256",
        "revision_kind",
        "resource_profile"
      ],
      "properties": {
        "system_id": { "$ref": "#/$defs/id" },
        "system_label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_id": { "$ref": "#/$defs/id" },
        "run_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "revision_kind": { "enum": ["raw_asr", "contextual_asr"] },
        "resource_profile": {
          "enum": ["cpu_bronze", "local_gpu", "remote_gpu", "other_measured"]
        }
      }
    },
    "term_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term_set_revision_id", "language", "terms"],
      "properties": {
        "term_set_revision_id": { "$ref": "#/$defs/id" },
        "language": {
          "type": "string",
          "pattern": "^(?:[a-z]{2,3}|und)(?:-[A-Za-z0-9]{2,8})*$"
        },
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "method", "replicates", "seed", "confidence_level"],
      "properties": {
        "unit": { "const": "recording_family" },
        "method": { "const": "recording_family_percentile_v1" },
        "replicates": { "type": "integer", "minimum": 200, "maximum": 10000 },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "confidence_level": { "const": 0.95 }
      }
    },
    "scoring_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalization_profile", "term_set", "bootstrap"],
      "properties": {
        "normalization_profile": {
          "const": "unicode_nfkc_casefold_lexical_v1"
        },
        "term_set": { "$ref": "#/$defs/term_set" },
        "bootstrap": { "$ref": "#/$defs/bootstrap" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_transcript_text",
        "storage_policy",
        "publication_authority"
      ],
      "properties": {
        "contains_transcript_text": { "const": true },
        "storage_policy": { "const": "private_only" },
        "publication_authority": { "const": "none" }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word_id", "text", "start_ms", "end_ms", "raw_score"],
      "properties": {
        "word_id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "start_ms": { "type": ["integer", "null"], "minimum": 0 },
        "end_ms": { "type": ["integer", "null"], "minimum": 1 },
        "raw_score": { "$ref": "#/$defs/nullable_score" }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "start_ms",
        "end_ms",
        "text",
        "raw_score",
        "words"
      ],
      "properties": {
        "segment_id": { "$ref": "#/$defs/id" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "maxLength": 200000 },
        "raw_score": { "$ref": "#/$defs/nullable_score" },
        "words": {
          "type": "array",
          "maxItems": 20000,
          "items": { "$ref": "#/$defs/word" }
        }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_id",
        "start_ms",
        "end_ms",
        "state",
        "speech_presence_raw_score",
        "segments"
      ],
      "properties": {
        "interval_id": { "$ref": "#/$defs/id" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "state": { "const": "completed" },
        "speech_presence_raw_score": { "$ref": "#/$defs/nullable_score" },
        "segments": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/segment" }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_ms", "cpu_time_ms", "peak_rss_bytes"],
      "properties": {
        "wall_time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "cpu_time_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "peak_rss_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recording_id",
        "recording_family_id",
        "split",
        "evaluated_audio_duration_ms",
        "resources",
        "intervals"
      ],
      "properties": {
        "recording_id": { "$ref": "#/$defs/recording_id" },
        "recording_family_id": { "$ref": "#/$defs/id" },
        "split": { "enum": ["calibration", "scoring"] },
        "evaluated_audio_duration_ms": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/$defs/resources" },
        "intervals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interval" }
        }
      }
    }
  }
}
