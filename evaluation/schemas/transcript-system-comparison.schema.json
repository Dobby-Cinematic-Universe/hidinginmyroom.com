{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/evaluation/transcript-system-comparison-v1.json",
  "title": "HIMR private paired ASR candidate comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "manifest_sha256",
    "comparison_id",
    "created_at",
    "implementation",
    "inputs",
    "systems",
    "comparability",
    "paired_accuracy_metrics",
    "condition_accuracy",
    "gpu_efficiency",
    "decision_support",
    "warnings",
    "publication",
    "contains_transcript_text",
    "automatic_promotion_authority"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_kind": { "const": "transcript_system_comparison" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "comparison_id": {
      "type": "string",
      "pattern": "^transcript_system_comparison_[0-9a-f]{32}$"
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "implementation": { "$ref": "#/$defs/implementation" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "challenger"],
      "properties": {
        "baseline": { "$ref": "#/$defs/system" },
        "challenger": { "$ref": "#/$defs/system" }
      }
    },
    "comparability": { "$ref": "#/$defs/comparability" },
    "paired_accuracy_metrics": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/paired_metric" }
    },
    "condition_accuracy": {
      "type": "array",
      "minItems": 11,
      "items": { "$ref": "#/$defs/condition_accuracy" }
    },
    "gpu_efficiency": { "$ref": "#/$defs/gpu_efficiency" },
    "decision_support": { "$ref": "#/$defs/decision_support" },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "storage_policy"],
      "properties": {
        "status": { "const": "withheld" },
        "storage_policy": { "const": "private_only" }
      }
    },
    "contains_transcript_text": { "const": false },
    "automatic_promotion_authority": { "const": "none" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nullable_number": { "type": ["number", "null"] },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_sha256", "python_version", "unicode_version"],
      "properties": {
        "name": { "const": "himr-asr-candidate-comparator" },
        "version": { "type": "string", "minLength": 1 },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "python_version": { "type": "string", "minLength": 1 },
        "unicode_version": { "type": "string", "minLength": 1 }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_id",
        "cohort_manifest_sha256",
        "freeze_id",
        "freeze_manifest_sha256",
        "adjudication_id",
        "adjudication_manifest_sha256",
        "baseline_system_output_id",
        "baseline_system_output_manifest_sha256",
        "challenger_system_output_id",
        "challenger_system_output_manifest_sha256",
        "baseline_gpu_measurement_id",
        "baseline_gpu_measurement_manifest_sha256",
        "challenger_gpu_measurement_id",
        "challenger_gpu_measurement_manifest_sha256"
      ],
      "properties": {
        "cohort_id": { "$ref": "#/$defs/id" },
        "cohort_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "freeze_id": { "$ref": "#/$defs/id" },
        "freeze_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "adjudication_id": { "$ref": "#/$defs/id" },
        "adjudication_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "baseline_system_output_id": { "$ref": "#/$defs/system_output_id" },
        "baseline_system_output_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "challenger_system_output_id": { "$ref": "#/$defs/system_output_id" },
        "challenger_system_output_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "baseline_gpu_measurement_id": { "$ref": "#/$defs/measurement_id" },
        "baseline_gpu_measurement_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "challenger_gpu_measurement_id": { "$ref": "#/$defs/measurement_id" },
        "challenger_gpu_measurement_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "system_output_id": {
      "type": "string",
      "pattern": "^system_output_[0-9a-f]{32}$"
    },
    "measurement_id": {
      "type": "string",
      "pattern": "^gpu_measurement_[0-9a-f]{32}$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_id", "system_label", "model_id", "run_manifest_sha256", "revision_kind", "resource_profile"],
      "properties": {
        "system_id": { "$ref": "#/$defs/id" },
        "system_label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_id": { "$ref": "#/$defs/id" },
        "run_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "revision_kind": { "enum": ["raw_asr", "contextual_asr"] },
        "resource_profile": { "enum": ["cpu_bronze", "local_gpu", "remote_gpu", "other_measured"] }
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_frozen_reference",
        "same_recording_family_map",
        "same_scoring_profile",
        "same_gpu_hardware",
        "same_gpu_measurement_protocol",
        "technology_pins_used_for_run_integrity_only"
      ],
      "properties": {
        "same_frozen_reference": { "const": true },
        "same_recording_family_map": { "const": true },
        "same_scoring_profile": { "const": true },
        "same_gpu_hardware": { "const": true },
        "same_gpu_measurement_protocol": { "const": true },
        "technology_pins_used_for_run_integrity_only": { "const": true }
      }
    },
    "ci_available": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "method", "unit", "confidence_level", "replicates", "lower", "upper"],
      "properties": {
        "state": { "const": "available" },
        "method": { "const": "recording_family_paired_percentile_v1" },
        "unit": { "const": "recording_family" },
        "confidence_level": { "const": 0.95 },
        "replicates": { "type": "integer", "minimum": 200, "maximum": 10000 },
        "lower": { "type": "number" },
        "upper": { "type": "number" }
      }
    },
    "ci_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": { "const": "not_available" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "ci": {
      "oneOf": [
        { "$ref": "#/$defs/ci_available" },
        { "$ref": "#/$defs/ci_unavailable" }
      ]
    },
    "paired_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "direction",
        "baseline",
        "challenger",
        "challenger_minus_baseline",
        "relative_change",
        "paired_delta_confidence_interval",
        "paired_relative_change_confidence_interval"
      ],
      "properties": {
        "metric": {
          "enum": [
            "word_error_rate",
            "character_error_rate",
            "himr_term_recall",
            "himr_false_insertions_per_media_hour",
            "nonspeech_segments_per_hour",
            "p95_absolute_boundary_error_ms"
          ]
        },
        "direction": { "enum": ["lower_is_better", "higher_is_better"] },
        "baseline": { "$ref": "#/$defs/nullable_number" },
        "challenger": { "$ref": "#/$defs/nullable_number" },
        "challenger_minus_baseline": { "$ref": "#/$defs/nullable_number" },
        "relative_change": { "$ref": "#/$defs/nullable_number" },
        "paired_delta_confidence_interval": { "$ref": "#/$defs/ci" },
        "paired_relative_change_confidence_interval": { "$ref": "#/$defs/ci" }
      }
    },
    "condition_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_count", "recording_family_count", "duration_ms", "reference_word_count", "minimum_recording_families", "minimum_reference_words"],
      "properties": {
        "interval_count": { "type": "integer", "minimum": 0 },
        "recording_family_count": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "reference_word_count": { "type": "integer", "minimum": 0 },
        "minimum_recording_families": { "const": 2 },
        "minimum_reference_words": { "const": 100 }
      }
    },
    "condition_accuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "value", "evaluation_state", "coverage", "word_error_rate", "undercoverage_reason"],
      "properties": {
        "dimension": { "enum": ["language", "code_switch", "speaker_overlap", "playback_speech", "noise"] },
        "value": { "type": "string", "minLength": 1 },
        "evaluation_state": { "enum": ["available", "undercovered"] },
        "coverage": { "$ref": "#/$defs/condition_coverage" },
        "word_error_rate": {
          "oneOf": [
            { "$ref": "#/$defs/paired_metric" },
            { "type": "null" }
          ]
        },
        "undercoverage_reason": { "type": ["string", "null"] }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_uuid", "gpu_name", "physical_vram_bytes"],
      "properties": {
        "gpu_uuid": { "type": "string", "pattern": "^GPU-", "maxLength": 128 },
        "gpu_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "physical_vram_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "evaluated_audio_duration_ms", "includes_model_load", "includes_audio_preflight", "includes_result_publication", "warmup_runs", "measured_runs"],
      "properties": {
        "protocol_id": { "$ref": "#/$defs/id" },
        "evaluated_audio_duration_ms": { "type": "integer", "minimum": 1 },
        "includes_model_load": { "type": "boolean" },
        "includes_audio_preflight": { "type": "boolean" },
        "includes_result_publication": { "type": "boolean" },
        "warmup_runs": { "type": "integer", "minimum": 0 },
        "measured_runs": { "type": "integer", "minimum": 1 }
      }
    },
    "efficiency_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_audio_duration_ms",
        "runner_wall_time_ms",
        "gpu_sample_span_ms",
        "gpu_active_time_ms",
        "runner_wall_real_time_factor",
        "gpu_active_real_time_factor",
        "media_hours_per_runner_hour",
        "media_hours_per_active_gpu_hour",
        "peak_process_vram_bytes",
        "estimated_energy_millijoules",
        "estimated_wh_per_media_hour"
      ],
      "properties": {
        "evaluated_audio_duration_ms": { "type": "integer", "minimum": 1 },
        "runner_wall_time_ms": { "type": "integer", "minimum": 1 },
        "gpu_sample_span_ms": { "type": "integer", "minimum": 1 },
        "gpu_active_time_ms": { "type": "integer", "minimum": 0 },
        "runner_wall_real_time_factor": { "type": "number", "minimum": 0 },
        "gpu_active_real_time_factor": { "type": "number", "minimum": 0 },
        "media_hours_per_runner_hour": { "type": "number", "exclusiveMinimum": 0 },
        "media_hours_per_active_gpu_hour": { "$ref": "#/$defs/nullable_number" },
        "peak_process_vram_bytes": { "type": "integer", "minimum": 1 },
        "estimated_energy_millijoules": { "type": "integer", "minimum": 0 },
        "estimated_wh_per_media_hour": { "type": "number", "minimum": 0 }
      }
    },
    "gpu_efficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware", "protocol", "baseline", "challenger", "challenger_minus_baseline_runner_wall_rtf", "challenger_minus_baseline_estimated_wh_per_media_hour"],
      "properties": {
        "hardware": { "$ref": "#/$defs/hardware" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "baseline": { "$ref": "#/$defs/efficiency_row" },
        "challenger": { "$ref": "#/$defs/efficiency_row" },
        "challenger_minus_baseline_runner_wall_rtf": { "type": "number" },
        "challenger_minus_baseline_estimated_wh_per_media_hour": { "type": "number" }
      }
    },
    "noninferiority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "thresholds", "absolute_upper", "relative_upper", "reason"],
      "properties": {
        "status": { "enum": ["demonstrated", "not_demonstrated", "not_evaluable"] },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum_absolute_wer_increase", "maximum_relative_wer_increase"],
          "properties": {
            "maximum_absolute_wer_increase": { "const": 0.005 },
            "maximum_relative_wer_increase": { "const": 0.03 }
          }
        },
        "absolute_upper": { "$ref": "#/$defs/nullable_number" },
        "relative_upper": { "$ref": "#/$defs/nullable_number" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "condition_safeguard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "undercovered_conditions", "conditions_with_paired_wer_regression", "overall_wer_can_override_condition_regression"],
      "properties": {
        "status": { "enum": ["condition_regression_detected", "not_evaluable_due_to_undercoverage", "no_condition_regression_detected"] },
        "undercovered_conditions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "conditions_with_paired_wer_regression": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "overall_wer_can_override_condition_regression": { "const": false }
      }
    },
    "repetition_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_candidate_interval_count", "challenger_candidate_interval_count", "review_state", "unattended_promotion_blocked"],
      "properties": {
        "baseline_candidate_interval_count": { "type": "integer", "minimum": 0 },
        "challenger_candidate_interval_count": { "type": "integer", "minimum": 0 },
        "review_state": { "enum": ["not_required", "human_review_required"] },
        "unattended_promotion_blocked": { "type": "boolean" }
      }
    },
    "decision_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy_signal", "wer_noninferiority", "condition_safeguard", "repetition_review", "efficiency_signal", "baseline_failed_quality_gates", "challenger_failed_quality_gates", "automatic_promotion_authorized", "selection_policy"],
      "properties": {
        "accuracy_signal": { "enum": ["challenger_improves_wer", "challenger_regresses_wer", "wer_difference_inconclusive", "not_evaluable"] },
        "wer_noninferiority": { "$ref": "#/$defs/noninferiority" },
        "condition_safeguard": { "$ref": "#/$defs/condition_safeguard" },
        "repetition_review": { "$ref": "#/$defs/repetition_review" },
        "efficiency_signal": { "enum": ["challenger_faster", "challenger_slower", "observed_tie"] },
        "baseline_failed_quality_gates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "challenger_failed_quality_gates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "automatic_promotion_authorized": { "const": false },
        "selection_policy": { "const": "accuracy_first_then_efficiency_with_human_promotion" }
      }
    }
  }
}
