{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/evaluation/interval-freeze-v1.json",
  "title": "HIMR media-bound transcript evaluation interval freeze v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "manifest_sha256",
    "freeze_id",
    "cohort_id",
    "cohort_manifest_sha256",
    "created_at",
    "frozen_at",
    "selection_attestation",
    "split_policy",
    "reference_state",
    "recordings",
    "accounting"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_kind": { "const": "interval_freeze" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "freeze_id": { "$ref": "#/$defs/id" },
    "cohort_id": { "$ref": "#/$defs/id" },
    "cohort_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "frozen_at": { "$ref": "#/$defs/timestamp" },
    "selection_attestation": { "$ref": "#/$defs/selection_attestation" },
    "split_policy": { "$ref": "#/$defs/split_policy" },
    "reference_state": { "const": "interval_selection_only_no_reference_text" },
    "recordings": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/recording" }
    },
    "accounting": { "$ref": "#/$defs/accounting" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$" },
    "uuid_id": { "type": "string", "pattern": "^(src|rec|rnd)_[0-9a-f]{32}$" },
    "media_id": { "type": "string", "pattern": "^media_sha256_[0-9a-f]{64}$" },
    "youtube_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "split": { "enum": ["calibration", "scoring"] },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language_tags", "code_switch", "speaker_overlap", "playback_speech", "noise"],
      "properties": {
        "language_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z]{2,3}|und)(?:-[A-Za-z0-9]{2,8})*$"
          }
        },
        "code_switch": { "type": "boolean" },
        "speaker_overlap": { "type": "boolean" },
        "playback_speech": { "type": "boolean" },
        "noise": { "enum": ["clean", "light", "moderate", "heavy", "unknown"] }
      }
    },
    "selection_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_without_asr_output_inspection",
        "attestor_id",
        "attested_at",
        "selection_basis",
        "protocol_revision"
      ],
      "properties": {
        "selected_without_asr_output_inspection": { "const": true },
        "attestor_id": { "$ref": "#/$defs/id" },
        "attested_at": { "$ref": "#/$defs/timestamp" },
        "selection_basis": { "const": "source_metadata_and_direct_media_only" },
        "protocol_revision": { "$ref": "#/$defs/id" }
      }
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "no_segment_leakage", "scoring_and_calibration_disjoint", "stratification_dimensions"],
      "properties": {
        "unit": { "const": "recording" },
        "no_segment_leakage": { "const": true },
        "scoring_and_calibration_disjoint": { "const": true },
        "stratification_dimensions": {
          "const": ["language", "code_switch", "speaker_overlap", "playback_speech", "noise"]
        }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_id", "start_ms", "end_ms", "stratum_id", "flags"],
      "properties": {
        "interval_id": { "$ref": "#/$defs/id" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "stratum_id": { "$ref": "#/$defs/id" },
        "flags": { "$ref": "#/$defs/flags" }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "recording_id",
        "source_id",
        "source_native_id",
        "source_locator",
        "media_id",
        "media_sha256",
        "media_byte_count",
        "media_duration_ms",
        "rendition_id",
        "rendition_kind",
        "timeline_coordinate_system",
        "split",
        "intervals"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/id" },
        "recording_id": { "$ref": "#/$defs/uuid_id" },
        "source_id": { "$ref": "#/$defs/uuid_id" },
        "source_native_id": { "$ref": "#/$defs/youtube_id" },
        "source_locator": {
          "type": "string",
          "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"
        },
        "media_id": { "$ref": "#/$defs/media_id" },
        "media_sha256": { "$ref": "#/$defs/sha256" },
        "media_byte_count": { "type": "integer", "minimum": 1 },
        "media_duration_ms": { "type": "integer", "minimum": 1 },
        "rendition_id": { "$ref": "#/$defs/uuid_id" },
        "rendition_kind": { "$ref": "#/$defs/id" },
        "timeline_coordinate_system": { "const": "rendition_media_ms" },
        "split": { "$ref": "#/$defs/split" },
        "intervals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/interval" }
        }
      }
    },
    "split_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split", "recording_count", "interval_count", "duration_ms"],
      "properties": {
        "split": { "$ref": "#/$defs/split" },
        "recording_count": { "type": "integer", "minimum": 1 },
        "interval_count": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "stratum_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stratum_id", "flags", "recording_count", "interval_count", "duration_ms"],
      "properties": {
        "stratum_id": { "$ref": "#/$defs/id" },
        "flags": { "$ref": "#/$defs/flags" },
        "recording_count": { "type": "integer", "minimum": 1 },
        "interval_count": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recording_count", "interval_count", "total_duration_ms", "splits", "strata"],
      "properties": {
        "recording_count": { "const": 12 },
        "interval_count": { "type": "integer", "minimum": 12 },
        "total_duration_ms": { "type": "integer", "minimum": 1 },
        "splits": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/split_accounting" }
        },
        "strata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stratum_accounting" }
        }
      }
    }
  }
}
