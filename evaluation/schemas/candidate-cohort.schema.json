{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hidinginmyroom.com/schemas/evaluation/candidate-cohort-v1.json",
  "title": "HIMR transcript evaluation candidate cohort v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "manifest_sha256",
    "cohort_id",
    "state",
    "created_at",
    "purpose",
    "expected_recording_count",
    "selection_policy",
    "candidates",
    "exclusions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_kind": { "const": "candidate_cohort" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "cohort_id": { "$ref": "#/$defs/id" },
    "state": { "const": "candidate_unfrozen" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "purpose": { "const": "asr_transcript_evaluation" },
    "expected_recording_count": { "const": 12 },
    "selection_policy": { "$ref": "#/$defs/selection_policy" },
    "candidates": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exclusion" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
    },
    "uuid_id": {
      "type": "string",
      "pattern": "^(src|rec)_[0-9a-f]{32}$"
    },
    "youtube_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_basis",
        "asr_outputs_may_be_inspected_for_selection",
        "reference_freeze_required_before_system_output_inspection",
        "split_unit"
      ],
      "properties": {
        "candidate_basis": { "const": "public_source_locators_only" },
        "asr_outputs_may_be_inspected_for_selection": { "const": false },
        "reference_freeze_required_before_system_output_inspection": { "const": true },
        "split_unit": { "const": "recording" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "recording_id",
        "source_id",
        "platform",
        "source_kind",
        "native_id",
        "public_locator",
        "eligibility_state"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/id" },
        "recording_id": { "$ref": "#/$defs/uuid_id" },
        "source_id": { "$ref": "#/$defs/uuid_id" },
        "platform": { "const": "youtube" },
        "source_kind": { "const": "youtube_video" },
        "native_id": { "$ref": "#/$defs/youtube_id" },
        "public_locator": {
          "type": "string",
          "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"
        },
        "eligibility_state": {
          "enum": ["unresolved", "eligible", "ineligible"]
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_id", "reason_code", "note"],
      "properties": {
        "native_id": { "$ref": "#/$defs/youtube_id" },
        "reason_code": {
          "enum": ["access_controlled", "private", "removed", "out_of_scope"]
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
