{
  "name": "himr-community-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "node scripts/check-public-release.mjs && cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.9",
    "astro": "^7.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/three": "^0.185.4",
    "cross-env": "^10.1.0",
    "typescript": "^6.0.3"
  }
}
